{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fsusblog-design-conformance:ui-dispatch-receipt:v2",
  "title": "fsusblog-design-conformance.ui-dispatch-receipt.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "stagePolicyDigest",
    "repository",
    "stageRole",
    "stagePhase",
    "classificationReceiptDigest",
    "workPlanDigest",
    "sliceDigest",
    "compiledPromptDigest",
    "executionRouteDecisionDigest",
    "slicePolicyDigest",
    "routingPolicyDigest",
    "executionShape",
    "firstRequiredAction",
    "firstReadTargets",
    "firstWritablePath",
    "allowedPaths",
    "forbiddenPaths",
    "explicitNonGoals",
    "requiredFocusedCommands",
    "requiredRenderProbes",
    "checkpointThresholds",
    "completionPredicate",
    "continuationPredicate",
    "actualModel",
    "actualEffort",
    "actualProfile",
    "targetWorktree",
    "targetWorktreeDigest",
    "candidateSha",
    "candidateIdentityDigest",
    "requiredSkills",
    "designAuthorityDigests",
    "fsusUIBaselineDigest",
    "writeLease",
    "status",
    "receiptDigest"
  ],
  "properties": {
    "schema": {
      "const": "fsusblog-design-conformance.ui-dispatch-receipt.v2"
    },
    "repository": {
      "const": "Ozwasyd/FsusBlog"
    },
    "stageRole": {
      "const": "ui-ux-implementer"
    },
    "stagePhase": {
      "const": "ui-implementation"
    },
    "classificationReceiptDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "workPlanDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sliceDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "compiledPromptDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "executionRouteDecisionDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "slicePolicyDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "routingPolicyDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "executionShape": {
      "type": "string",
      "minLength": 1
    },
    "firstRequiredAction": {
      "type": "string",
      "minLength": 1
    },
    "firstReadTargets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "firstWritablePath": {
      "type": "string",
      "minLength": 1
    },
    "allowedPaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbiddenPaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "explicitNonGoals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requiredFocusedCommands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requiredRenderProbes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checkpointThresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxInvestigationCommands",
        "maxNoArtifactCommands"
      ],
      "properties": {
        "maxInvestigationCommands": {
          "type": "integer",
          "minimum": 1
        },
        "maxNoArtifactCommands": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "completionPredicate": {
      "type": "string",
      "minLength": 1
    },
    "continuationPredicate": {
      "type": "string",
      "minLength": 1
    },
    "actualModel": {
      "type": "string",
      "minLength": 1
    },
    "actualEffort": {
      "type": "string",
      "minLength": 1
    },
    "actualProfile": {
      "type": "string",
      "minLength": 1
    },
    "targetWorktree": {
      "type": "string",
      "minLength": 1
    },
    "targetWorktreeDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidateSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "candidateIdentityDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "requiredSkills": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "digest"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "designAuthorityDigests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "fsusUIBaselineDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "writeLease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leaseId",
        "scope"
      ],
      "properties": {
        "leaseId": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "const": "implementation-only"
        }
      }
    },
    "status": {
      "const": "verified"
    },
    "receiptDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stagePolicyDigest": {
      "$ref": "urn:fsusblog-design-conformance:ui-execution-profiles:v2#/$defs/stagePolicyDigest"
    }
  },
  "allOf": [
    {
      "$ref": "urn:fsusblog-design-conformance:ui-execution-profiles:v2#/$defs/implementation"
    }
  ]
}
