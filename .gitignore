# ==========================================
# 1. 逻辑自洽：通用规则与 IDE
# ==========================================
.vs/
.vscode/
.idea/
.github/
*.user
*.suo
*.userosscache
*.sln.docstates
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.tmp
*.temp

# 排除根目录下的启动设置
launchSettings.json

# 逻辑自洽：从截图看，根目录出现了编译产生的 bin 和 obj 文件夹
/bin/
/obj/
/publish/
/dist/
/data/
**/bin/
**/obj/
**/publish/
**/dist/
**/out/
**/node_modules/
**/.cache/
**/.tmp/
**/tmp/
**/temp/
**/coverage/
**/.eslintcache
**/*.tsbuildinfo
**/TestResults/

# --- 核心安全保障：环境变量隔离 (2026-02-21) ---
# 排除所有真实的敏感环境变量文件
.env
.env.production
.env.local
.env.*.local
# 逻辑自洽：强行允许提交环境变量模板，作为生产环境的配置参考
!.env.production-template

# ==========================================
# 2. FsusBlog.Client (Vue 3 / Vite)
# ==========================================
FsusBlog.Client/node_modules/
FsusBlog.Client/dist/
FsusBlog.Client/dist-ssr/
FsusBlog.Client/src/wasm/dist/
FsusBlog.Client/.vite/
FsusBlog.Client/.cache/

# 逻辑自洽：截图显示前端使用了 .esproj，会生成 MSBuild 风格的编译目录
FsusBlog.Client/[Bb]in/
FsusBlog.Client/[Oo]bj/

# 逻辑自洽：排除本地生成的 Docker 镜像压缩包
*.tar
FsusBlog.Client/*.tar

# 安全性保障：排除开发环境特定配置
FsusBlog.Client/.env.development
FsusBlog.Client/.env.local
FsusBlog.Client/npm-debug.log*
FsusBlog.Client/yarn-debug.log*
FsusBlog.Client/yarn-error.log*
FsusBlog.Client/pnpm-debug.log*

# 性能最大化：排除自动导入插件生成的类型声明文件（由 Unplugin 生成）
FsusBlog.Client/auto-imports.d.ts
FsusBlog.Client/components.d.ts

# ==========================================
# 3. FsusBlog.Server (ASP.NET Core 10)
# ==========================================
FsusBlog.Server/[Bb]in/
FsusBlog.Server/[Oo]bj/

# 安全性保障：排除包含本地开发敏感数据库配置的文件
# 注意：appsettings.json 和 appsettings.Production.json 必须提交到 Git 以供 Docker 构建
FsusBlog.Server/appsettings.Development.json
FsusBlog.Server/publish/

# 逻辑自洽：根据企划书，系统使用 Lucene.NET 检索
# 必须排除本地生成的索引文件，防止污染仓库
FsusBlog.Server/wwwroot/index/
FsusBlog.Server/LuceneIndex/
*.index

# 逻辑自洽：系统集成 Serilog 异步日志 
# 排除所有按天滚动的日志文件
FsusBlog.Server/logs/
*.log
*.pid
*.seed
*.out
*.err

