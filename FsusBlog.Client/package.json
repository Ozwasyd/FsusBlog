{
  "name": "fsusblog-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:debug": "npm run ensure:wasm && vite --host 0.0.0.0 --port 3000",
    "deps:wasm-codec": "bash ./scripts/install-wasm-codec-deps.sh",
    "ensure:wasm": "node ./scripts/ensure-wasm.mjs ensure",
    "build:wasm": "bash ./wasm/build.sh",
    "build:release": "node ./scripts/build.mjs",
    "check:markdown-wasm": "node ./scripts/check-markdown-wasm.mjs",
    "check:markdown-wasm-runtime": "node ./scripts/check-markdown-wasm-runtime.mjs",
    "check:image-codec-wasm": "node ./scripts/check-image-codec-wasm.mjs",
    "check:image-codec-wasm-runtime": "node ./scripts/check-image-codec-wasm-runtime.mjs",
    "check:modern-standards": "node ./scripts/check-modern-standards.mjs",
    "check:result-boundaries": "node ./scripts/check-result-boundaries.mjs",
    "check:error-code-alignment": "node ./scripts/check-error-code-alignment.mjs",
    "check:security-consistency": "node ./scripts/check-security-consistency.mjs",
    "check:server-try-catch": "node ./scripts/check-server-try-catch.mjs",
    "check:sse-runtime": "node ./scripts/check-sse-runtime.mjs",
    "check:sw-search-runtime": "node ./scripts/check-sw-search-runtime.mjs",
    "check:views-constraints": "node ./scripts/check-views-constraints.mjs",
    "check:markdown-no-js-path": "node ./scripts/check-markdown-no-js-path.mjs",
    "check:aot": "npm run check:markdown-wasm && npm run check:markdown-wasm-runtime && npm run check:image-codec-wasm && npm run check:image-codec-wasm-runtime && npm run check:markdown-no-js-path && node ./scripts/aot-regression.mjs",
    "rebuild:public-hydration": "node ./scripts/rebuild-public-hydration-bundle.mjs",
    "check:public-hydration": "node ./scripts/check-public-hydration-identity.mjs && node ./scripts/public-hydration-smoke.mjs",
    "check:public-hydration-rebuild": "node ./scripts/check-public-hydration-rebuild.mjs && node ./scripts/check-public-renderer-version-sync.mjs && node ./scripts/check-public-pageid-coverage.mjs",
    "check:public-seo-smoke": "node ./scripts/public-seo-smoke.mjs",
    "warm:public-aot": "node ./scripts/warm-public-aot-cache.mjs",
    "check:binary-smoke": "node ./scripts/binary-smoke.mjs",
    "check:binary-smoke:auth": "node ./scripts/binary-smoke-auth.mjs",
    "prepare:binary-smoke:auth-users": "node ./scripts/prepare-auth-smoke-users.mjs",
    "prepare:playwright:fixtures": "node ./scripts/discover-playwright-fixtures.mjs",
    "check:spa:routes": "npm run ensure:wasm && npx playwright test e2e/spa-routes.spec.ts",
    "check:acceptance": "npm run ensure:wasm && npm run build && npm run check:security-consistency && npm run check:server-try-catch && npm run check:sse-runtime && npm run check:aot && npm run check:public-hydration",
    "check:full-regression": "bash ./scripts/full-regression.sh",
    "build": "npm run build:release",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ctrl/tinycolor": "^3.4.1",
    "@element-plus/icons-vue": "^2.3.2",
    "@fingerprintjs/fingerprintjs": "^5.0.1",
    "@floating-ui/dom": "^1.0.1",
    "@fontsource-variable/noto-sans-jp": "^5.2.10",
    "@fontsource/google-sans": "^5.2.1",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@fontsource/noto-sans-tc": "^5.2.9",
    "@ozwasyd/element-plus": "latest",
    "@popperjs/core": "npm:@sxzz/popperjs-es@^2.11.7",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@unhead/vue": "^3.0.4",
    "@vue/server-renderer": "^3.5.28",
    "@vueuse/core": "^9.1.0",
    "async-validator": "^4.2.5",
    "axios": "^1.15.0",
    "dayjs": "^1.11.3",
    "echarts": "^6.0.0",
    "katex": "^0.16.38",
    "lodash-es": "^4.17.21",
    "lodash-unified": "^1.0.2",
    "memoize-one": "^6.0.0",
    "normalize-wheel-es": "^1.2.0",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "tailwindcss": "^4.1.18",
    "vue": "^3.5.25",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.10.1",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/tsconfig": "^0.8.1",
    "sass-embedded": "^1.97.3",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^7.3.2",
    "vue-tsc": "^3.1.5"
  }
}
