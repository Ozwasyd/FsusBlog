{
  "name": "fsusblog-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:debug": "npm run ensure:wasm && vite --host 0.0.0.0 --port 3000",
    "test:fast": "bash ../tools/test.sh fast",
    "test:integration": "bash ../tools/test.sh integration",
    "test:ci": "bash ../tools/test.sh ci",
    "test:release": "bash ../tools/test.sh release",
    "test:acceptance": "bash ../tools/test.sh acceptance",
    "test:visual": "bash ../tools/test.sh visual",
    "test:production": "bash ../tools/test.sh production",
    "deps:wasm-codec": "bash ./scripts/install-wasm-codec-deps.sh",
    "ensure:wasm": "node ./scripts/ensure-wasm.mjs ensure",
    "build:wasm": "bash ./wasm/build.sh",
    "build:release": "node ./scripts/build.mjs",
    "check:markdown-wasm": "node ./tests/checks/wasm/check-markdown-wasm.mjs",
    "check:markdown-wasm-runtime": "node ./tests/checks/wasm/check-markdown-wasm-runtime.mjs",
    "check:markdown-extreme": "node ./tests/checks/resilience/check-markdown-extreme.mjs",
    "check:image-codec-wasm": "node ./tests/checks/wasm/check-image-codec-wasm.mjs",
    "check:image-codec-wasm-runtime": "node ./tests/checks/wasm/check-image-codec-wasm-runtime.mjs",
    "check:modern-standards": "node ./tests/checks/static/check-modern-standards.mjs",
    "check:result-boundaries": "node ./tests/checks/static/check-result-boundaries.mjs",
    "check:error-code-alignment": "node ./tests/checks/static/check-error-code-alignment.mjs",
    "check:no-runtime-message-branching": "node ./tests/checks/static/check-no-runtime-message-branching.mjs",
    "check:security-consistency": "node ./tests/checks/static/check-security-consistency.mjs",
    "check:server-try-catch": "node ./tests/checks/static/check-server-try-catch.mjs",
    "check:sse-runtime": "node ./tests/checks/runtime/check-sse-runtime.mjs",
    "check:sw-search-runtime": "node ./tests/checks/public/check-sw-search-runtime.mjs",
    "check:search-runtime": "node ./tests/checks/public/check-search-runtime.mjs",
    "check:views-constraints": "node ./tests/checks/static/check-views-constraints.mjs",
    "check:markdown-no-js-path": "node ./tests/checks/wasm/check-markdown-no-js-path.mjs",
    "check:aot": "npm run check:markdown-wasm && npm run check:markdown-wasm-runtime && npm run check:image-codec-wasm && npm run check:image-codec-wasm-runtime && npm run check:markdown-no-js-path && node ./tests/checks/public/aot-regression.mjs",
    "rebuild:public-hydration": "node ./scripts/rebuild-public-hydration-bundle.mjs",
    "check:public-hydration": "node ./tests/checks/public/check-public-hydration-identity.mjs && node ./tests/checks/public/public-hydration-smoke.mjs",
    "check:public-hydration-rebuild": "node ./tests/checks/public/check-public-hydration-rebuild.mjs && node ./tests/checks/public/check-public-renderer-version-sync.mjs && node ./tests/checks/public/check-public-pageid-coverage.mjs",
    "check:public-seo-smoke": "node ./tests/checks/public/public-seo-smoke.mjs",
    "warm:public-aot": "node ./scripts/warm-public-aot-cache.mjs",
    "check:binary-smoke": "node ./tests/checks/runtime/binary-smoke.mjs",
    "check:binary-smoke:auth": "node ./tests/checks/runtime/binary-smoke-auth.mjs",
    "check:auth-session-smoke": "node ./tests/checks/runtime/auth-session-smoke.mjs",
    "check:runtime-regression": "npm run check:auth-session-smoke && npm run check:sse-runtime && npm run check:binary-smoke && npm run check:public-hydration-rebuild",
    "prepare:binary-smoke:auth-users": "node ./tests/fixtures/prepare-auth-smoke-users.mjs",
    "prepare:playwright:fixtures": "node ./tests/fixtures/discover-playwright-fixtures.mjs",
    "check:spa:routes": "npm run ensure:wasm && npx playwright test tests/e2e/acceptance/spa-routes.spec.ts",
    "check:acceptance:public": "npm run ensure:wasm && npx playwright test tests/e2e/acceptance/public-routes.spec.ts",
    "check:acceptance:console": "npm run ensure:wasm && npx playwright test tests/e2e/acceptance/user-console.spec.ts tests/e2e/acceptance/admin-console.spec.ts",
    "check:acceptance:markdown-extreme": "npm run ensure:wasm && npx playwright test tests/e2e/resilience/markdown-extreme.spec.ts",
    "check:acceptance:e2e": "npm run check:acceptance:public && npm run check:acceptance:console",
    "check:visual:public": "npm run ensure:wasm && npx playwright test tests/e2e/visual/public-visual.spec.ts",
    "check:visual:console": "npm run ensure:wasm && npx playwright test tests/e2e/visual/console-visual.spec.ts",
    "check:visual:theme": "npm run check:visual:public && npm run check:visual:console",
    "check:visual:mobile": "npm run check:visual:public && npm run check:visual:console",
    "check:acceptance:visual": "npm run check:visual:public && npm run check:visual:console",
    "check:security:auth-mfa": "node ./tests/checks/security/check-auth-mfa-smoke.mjs",
    "check:security:permissions": "node ./tests/checks/security/check-permission-matrix.mjs",
    "check:security": "npm run check:auth-session-smoke && npm run check:security:auth-mfa && npm run check:security:permissions && npm run check:a11y:smoke",
    "check:resilience:runtime": "node ./tests/checks/resilience/check-runtime-resilience.mjs",
    "check:resilience:upload": "node ./tests/checks/resilience/check-upload-resilience.mjs",
    "check:resilience": "npm run check:resilience:runtime && npm run check:markdown-extreme && npm run check:acceptance:markdown-extreme && npm run check:resilience:upload && npm run check:sse-runtime && npm run check:search-runtime",
    "check:load:public-api": "node ./tests/checks/load/check-load-public-api.mjs",
    "check:load": "npm run check:load:public-api",
    "check:a11y:smoke": "node ./tests/checks/runtime/check-a11y-smoke.mjs",
    "check:acceptance": "echo '[deprecated] use npm run test:release' >&2 && npm run test:release",
    "check:full-regression": "bash ./scripts/full-regression.sh",
    "build": "npm run build:release",
    "preview": "vite preview --host 0.0.0.0 --port 8080"
  },
  "dependencies": {
    "@ctrl/tinycolor": "^3.4.1",
    "@element-plus/icons-vue": "^2.3.2",
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@floating-ui/dom": "^1.0.1",
    "@fontsource-variable/noto-sans-jp": "^5.2.10",
    "@fontsource/google-sans": "^5.2.1",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@fontsource/noto-sans-tc": "^5.2.9",
    "@ozwasyd/element-plus": "^1.2.0",
    "@popperjs/core": "npm:@sxzz/popperjs-es@^2.11.7",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@unhead/vue": "^3.0.4",
    "@vue/server-renderer": "^3.5.32",
    "@vueuse/core": "^9.1.0",
    "async-validator": "^4.2.5",
    "axios": "^1.15.0",
    "dayjs": "^1.11.3",
    "echarts": "^6.0.0",
    "katex": "^0.16.45",
    "lodash-es": "^4.17.21",
    "lodash-unified": "^1.0.2",
    "memoize-one": "^6.0.0",
    "normalize-wheel-es": "^1.2.0",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "tailwindcss": "^4.2.2",
    "vue": "^3.5.32",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.12.2",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.8.1",
    "sass-embedded": "^1.99.0",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^7.3.2",
    "vue-tsc": "^3.2.6"
  }
}
