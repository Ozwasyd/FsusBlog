: 100%;\n        background: #ffffff;\n        color: #09090b;\n        font-family: \u0022Google Sans\u0022, \u0022Noto Sans SC\u0022, \u0022Noto Sans TC\u0022, \u0022Noto Sans JP\u0022, ui-sans-serif, system-ui, sans-serif;\n        -webkit-font-smoothing: subpixel-antialiased;\n        text-rendering: optimizeLegibility;\n      }\n\n      #fsus-aot-shell,\n      #fsus-aot-shell * {\n        box-sizing: border-box;\n      }\n\n      /* \u516C\u5F00\u9875 AOT \u9996\u5C4F\u5951\u7EA6\uFF1A\u5373\u4F7F\u5916\u94FE\u6837\u5F0F\u5EF6\u8FDF/\u5931\u6548\uFF0C\u4E5F\u4FDD\u6301\u57FA\u7840\u53EF\u8BFB\u5E03\u5C40 */\n      #fsus-aot-shell a {\n        color: #27272a;\n        text-decoration: none;\n      }\n\n      #fsus-aot-shell .mono-link,\n      #fsus-aot-shell .active-link {\n        font-size: 0.875rem;\n      }\n\n      #fsus-aot-shell .active-link {\n        color: #09090b;\n        font-weight: 700;\n      }\n\n      #fsus-aot-shell .ui-article-card {\n        display: flex;\n        flex-direction: column;\n        gap: 0.75rem;\n      }\n\n      #fsus-aot-shell .ui-article-title {\n        font-size: 1.35rem;\n        line-height: 1.3;\n        font-weight: 700;\n        color: #09090b;\n      }\n\n      #fsus-aot-shell .ui-article-summary {\n        font-size: 0.96rem;\n        line-height: 1.75;\n        color: #52525b;\n      }\n\n      #fsus-aot-shell .ui-pagination {\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        margin-top: 2rem;\n        padding-top: 1rem;\n        border-top: 1px solid #f4f4f5;\n      }\n\n      #global-loader {\n        position: fixed;\n        inset: 0;\n        z-index: 9999;\n        background-color: #ffffff; /* \u7EAF\u767D\u80CC\u666F */\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        /* \u4E3A App.vue \u4E2D\u7684\u900F\u660E\u5EA6\u53D8\u5316\u63D0\u4F9B\u5E73\u6ED1\u8FC7\u6E21 */\n        transition: opacity 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94); \n      }\n\n      #global-loader[hidden] {\n        display: none;\n      }\n\n      .loader-content {\n        display: flex;\n        flex-direction: column;\n        align-items: center;\n        gap: 16px;\n      }\n\n      /* \u7B49\u5BBD\u3001\u6781\u7EC6\u3001\u5BBD\u5B57\u8DDD\u7684\u7070\u8272\u6587\u5B57 */\n      .loader-text {\n        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \u0022Liberation Mono\u0022, \u0022Courier New\u0022, monospace;\n        font-size: 10px;\n        font-weight: 700;\n        letter-spacing: 0.3em;\n        color: #a1a1aa; /* \u5BF9\u5E94 Tailwind \u7684 zinc-400 */\n        text-transform: uppercase;\n        animation: pulse-text 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;\n      }\n\n      /* \u8FDB\u5EA6\u6761\u8F68\u9053\uFF1A\u6781\u6D45\u7684\u7070\u8272 */\n      .loader-bar-container {\n        width: 64px;\n        height: 1px;\n        background-color: #f4f4f5; /* \u5BF9\u5E94 zinc-100 */\n        overflow: hidden;\n        position: relative;\n      }\n\n      /* \u8FDB\u5EA6\u6761\u6ED1\u5757\uFF1A\u6781\u5177\u91CD\u91CF\u611F\u7684\u7EAF\u9ED1 */\n      .loader-bar {\n        position: absolute;\n        inset: 0;\n        background-color: #09090b; /* \u5BF9\u5E94 zinc-950 */\n        animation: slide-bar 1.5s cubic-bezier(0.4, 0, 0.6, 1) infinite;\n      }\n\n      @keyframes pulse-text {\n        0%, 100% { opacity: 1; }\n        50% { opacity: 0.3; }\n      }\n\n      @keyframes slide-bar {\n        0% { transform: translateX(-100%); }\n        100% { transform: translateX(100%); }\n      }\n    \u003C/style\u003E\n      \u003Clink rel=\u0022stylesheet\u0022 href=\u0022/src/assets/critical-public.css\u0022 data-fsus-style=\u0022public-critical-dev\u0022 /\u003E\n  \u003C/head\u003E\n  \u003Cbody data-fsus-public-first-paint=\u0022true\u0022 data-fsus-public-shell=\u0022true\u0022\u003E\n    \n    \u003Cdiv id=\u0022global-loader\u0022 hidden aria-hidde