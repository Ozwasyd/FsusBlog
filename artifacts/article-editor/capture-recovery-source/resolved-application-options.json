{
  "compilerOptions": {
    "strict": true,
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "scope": "original full application static configuration, no qualification"
}
