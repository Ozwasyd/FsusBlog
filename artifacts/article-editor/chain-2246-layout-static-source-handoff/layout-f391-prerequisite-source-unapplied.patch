+    }
+
+    public replace(handle: ArticleAttachmentPendingHandle, file: MarkdownAttachmentInputFile,
+        port: ArticleAttachmentTransactionPort): readonly ArticleAttachmentPendingHandle[]
+    {
+        const entry = this.findPending(handle);
