index 000000000..307457046
--- /dev/null
+++ b/src/frontend/src/services/authoring/articleEditorSurfaceRuntime.ts
@@ -0,0 +1,191 @@
+import { initMarkdownRuntime } from '@/fsusui/markdown';
+
+import type { ArticleDocumentContextAdapter } from './articleDocumentContext';
+import type { ArticleEditorContinuityAdapter, ArticleEditorContinuityReceipt } from './articleEditorContinuity';
+import type { ArticleEditorRuntimeBinding } from './articleEditorRuntimeBinding';
+import type { ArticleEditorSurface } from './articleEditorSurface';
+import type { ArticleLiveCapabilityEnvironment, ArticleLiveCapabilityRequest, ArticleLiveCapabilitySession, ArticleLiveCapabilityState } from './articleLiveCapability';
+
+type TransitionArguments = Parameters<ArticleEditorContinuityAdapter['transitionSurface']>;
+type Initialization = Awaited<ReturnType<typeof initMarkdownRuntime>>;
+
+export interface ArticleEditorSurfaceRuntimeState extends ArticleLiveCapabilityState
+{
+    readonly desiredSurface: ArticleEditorSurface;
+    readonly escaped: boolean;
+    readonly pending: ArticleEditorContinuityReceipt | null;
+    readonly documentCurrent: boolean;
+}
+
+/**
+ * Product actions over the sole Writer binding. Preference is read from its existing owner,
+ * never stored here. The host presents the returned target only for awaiting-ack admission,
+ * then supplies actual focus/viewport acknowledgement to canonical continuity.
+ */
+export class ArticleEditorSurfaceRuntime
+{
+    private escaped = false;
+    private recoveryRequest: ArticleLiveCapabilityRequest | null = null;
+    private pendingRef: string | null = null;
+    private disposed = false;
+    private readonly unsubscribe: () => void;
+    private readonly owner: ArticleDocumentContextAdapter;
+    private readonly binding: ArticleEditorRuntimeBinding;
+    private readonly capabilities: ArticleLiveCapabilitySession;
+    private readonly readPreference: () => unknown;
+
+    public constructor(
+        owner: ArticleDocumentContextAdapter,
+        binding: ArticleEditorRuntimeBinding,
+        capabilities: ArticleLiveCapabilitySession,
+        readPreference: () => unknown
+    )
+    {
+        this.owner = owner;
+        this.binding = binding;
+        this.capabilities = capabilities;
+        this.readPreference = readPreference;
+        this.assertCurrent();
+        let document = owner.context;
+        this.unsubscribe = owner.subscribeContext(current =>
+        {
+            if (current?.documentId !== document.documentId || current.documentEpoch !== document.documentEpoch
+                || current.siteScope !== document.siteScope || current.userScope !== document.userScope)
+            {
+                this.capabilities.cancel();
+                this.escaped = false;
+                this.recoveryRequest = null;
+                this.cancelPending();
+                if (current !== null)
+                {
+                    document = current;
+                }
+            }
+        });
+    }
+
+    public get state(): ArticleEditorSurfaceRuntimeState
+    {
+        const policy = this.capabilities.state(this.readPreference());
+        const pending = this.pendingRef === null ? null
+            : this.binding.continuity.receipts.slice().reverse().find(receipt => receipt.requestRef === this.pendingRef) ?? null;
+        return Object.freeze({
+            ...policy,
+            desiredSurface: this.escaped ? 'source' as const : policy.effectiveSurface,
+            escaped: this.escaped,
+            pending,
+            documentCurrent: !this.disposed && this.owner.isCurrentContext(this.binding.context)
+        });
+    }
+
+    public beginCapability(environment: ArticleLiveCapabilityEnvironment): ArticleLiveCapabilityRequest
+    {
+        this.assertCurrent();
+        return this.capabilities.begin(environment);
+    }
+
+    /** Typed producer results alone authorize Live; runtime initialization never supplies a capability. */
+    public receiveCapability(request: ArticleLiveCapabilityRequest, value: unknown): ReturnType<ArticleLiveCapabilitySession['commit']>
+    {
+        this.assertCurrent();
+        const admission = this.capabilities.commit(request, value);
+        if (admission === 'accepted' && request === this.recoveryRequest)
+        {
+            const capability = this.capabilities.state(this.readPreference()).capability;
+            if (capability === 'supported' || capability === 'feature-degraded')
+            {
+                this.escaped = false;
+            }
+            this.recoveryRequest = null;
+        }
+        return admission;
+    }
+
+    /** Explicit user Source escape is session-only, including a local feature-degradation escape. */
+    public escapeToSource(capture: TransitionArguments[2], restore: TransitionArguments[3]): ArticleEditorContinuityReceipt | null
+    {
+        this.assertCurrent();
+        this.escaped = true;
+        return this.applyDecision(capture, restore);
+    }
+
+    /**
+     * Execute the existing public runtime initialization, retaining Source until a fresh typed
+     * capability arrives. The returned native result is diagnostic, never a recovery receipt.
+     */
+    public async recover(environment: ArticleLiveCapabilityEnvironment): Promise<{
+        request: ArticleLiveCapabilityRequest;
+        initialization: Initialization;
+        admission: 'current' | 'stale';
+    }>
+    {
+        this.assertCurrent();
+        const request = this.capabilities.begin(environment);
+        this.recoveryRequest = request;
+        const initialization = await initMarkdownRuntime();
+        const current = !this.disposed && this.recoveryRequest === request && !request.signal.aborted
+            && this.owner.isCurrentContext(request.document);
+        return { request, initialization, admission: current ? 'current' : 'stale' };
+    }
+
+    /** Execute canonical transition/dispatch admission. Same-document tools keep their own restoration bookmark. */
+    public applyDecision(capture: TransitionArguments[2], restore: TransitionArguments[3]): ArticleEditorContinuityReceipt | null
+    {
+        this.assertCurrent();
+        const state = this.state;
+        if (state.pending && ['planned', 'awaiting-ack', 'paused'].includes(state.pending.status))
+        {
+            const intent = this.binding.anchors.userIntent;
+            const current = this.owner.isCurrentContext(state.pending.before.document)
+                && state.pending.anchorCommand?.intent.generation === intent.generation;
+            if (state.pending.targetSurface === state.desiredSurface && current
+                && (state.pending.status !== 'paused' || intent.state === 'manual'))
+            {
+                return state.pending;
+            }
+            this.cancelPending();
+        }
+        this.pendingRef = null;
+        if (capture.surface === state.desiredSurface || capture.tool !== 'none')
+        {
+            return null;
+        }
+        const planned = this.binding.continuity.transitionSurface(state.desiredSurface,
+            this.binding.positionBinding(), capture, restore);
+        this.pendingRef = planned.requestRef;
+        return planned.status === 'planned' ? this.binding.continuity.apply(planned.requestRef) : planned;
+    }
+
+    /** Withdraw only this domain's plan; no editor, attachment, tool or document lease is released. */
+    public cancelPending(): void
+    {
+        if (this.pendingRef !== null)
+        {
+            this.binding.continuity.cancelRestoration(this.pendingRef);
+            this.pendingRef = null;
+        }
+    }
+
+    public dispose(): void
+    {
+        if (this.disposed)
+        {
+            return;
+        }
+        this.disposed = true;
+        this.unsubscribe();
+        this.cancelPending();
+        this.capabilities.cancel();
+        this.recoveryRequest = null;
+    }
+
+    private assertCurrent(): void
+    {
+        if (this.disposed || !this.owner.isCurrentContext(this.binding.context))
+        {
+            throw new Error('article-editor-surface-runtime-stale');
+        }
+        // This existing method also rejects a released Writer binding before any native side effect.
+        this.binding.positionBinding();
+    }
+}
diff --git a/src/frontend/src/services/authoring/articleFsusUiRenderProducer.ts b/src/frontend/src/services/authoring/articleFsusUiRenderProducer.ts
new file mode 100644
index 000000000..aa9900dd2
--- /dev/null
+++ b/src/frontend/src/services/authoring/articleFsusUiRenderProducer.ts
@@ -0,0 +1,182 @@
+import {
+    MARKDOWN_RENDERER_VERSION,
+    createMarkdownEditorProjection,
+    resolveMarkdownSourceIdentity,
+    renderMarkdownWithFsusRuntime,
+    type MarkdownEditorProjectionResult,
+    type MarkdownSafeRenderResult
+} from '@/fsusui/markdown';
+
+import { articleDocumentContextSchema } from './articleDocumentContext';
+import {
+    type ArticleRenderProducer,
+    type ArticleRenderRequest,
+    type ArticleRenderResult,
+    validateArticleRenderResult
+} from './articleRenderCache';
+import { calculateOpenArticleDocumentDigest as digest } from './openArticleDocumentRegistry';
+
+export interface ArticleFsusUiRenderConfiguration {
+    readonly allowLatex: boolean;
+    readonly allowMermaid: boolean;
+    readonly baseUrl: string | null;
+}
+
+interface RetainedFsusUiPair {
+    readonly render: MarkdownSafeRenderResult;
+    readonly projection: MarkdownEditorProjectionResult;
+}
+
+interface RetainedFsusUiResult {
+    readonly request: ArticleRenderRequest;
+    readonly result: ArticleRenderResult;
+    readonly pair: Readonly<RetainedFsusUiPair>;
+}
+
+const freezeProjection = <T extends object>(value: T): T =>
+{
+    for (const child of Object.values(value))
+    {
+        if (child && typeof child === 'object')
+        {
+            freezeProjection(child);
+        }
+    }
+    return Object.freeze(value);
+};
+
+// The only body-bearing objects retained are canonical public FsusUI results.
+export class ArticleFsusUiRenderProducer implements ArticleRenderProducer
+{
+    private readonly results = new Map<string, RetainedFsusUiResult>();
+    private sequence = 0;
+    private readonly configuration: ArticleFsusUiRenderConfiguration;
+    private readonly readSource: (request: ArticleRenderRequest) => string;
+    private readonly maxResultBytes: number;
+
+    public constructor(
+        readSource: (request: ArticleRenderRequest) => string,
+        configuration: ArticleFsusUiRenderConfiguration,
+        maxResultBytes: number
+    )
+    {
+        this.readSource = readSource;
+        this.maxResultBytes = maxResultBytes;
+        if (!Number.isSafeInteger(maxResultBytes) || maxResultBytes < 1
+            || Object.keys(configuration).sort().join(',') !== 'allowLatex,allowMermaid,baseUrl'
+            || typeof configuration.allowLatex !== 'boolean' || typeof configuration.allowMermaid !== 'boolean'
+            || (configuration.baseUrl !== null && typeof configuration.baseUrl !== 'string'))
+        {
+            throw new Error('article-render-producer-input-invalid');
+        }
+        this.configuration = Object.freeze({ ...configuration });
+    }
+
+    public async render(request: ArticleRenderRequest): Promise<ArticleRenderResult>
+    {
+        const failure = (reason: string, status: 'fatal' | 'projection-failed' = 'fatal'): ArticleRenderResult => ({
+            contextDigest: request.context.contextDigest, requestId: request.requestId, identity: request.identity,
+            status, reason, resultRef: null, resultDigest: null,
+            fallbackRefs: [], longTaskRefs: [], layoutObservationRefs: []
+        });
+        if (request.signal.aborted)
+        {
+            throw new Error('render-canceled');
+        }
+        const source = this.readSource(request);
+        if (digest({ schema: articleDocumentContextSchema, content: source }) !== request.context.contentDigest
+            || request.identity.rendererVersion !== MARKDOWN_RENDERER_VERSION
+            || request.identity.projectionVersion !== MARKDOWN_RENDERER_VERSION
+            || request.identity.featureConfigurationDigest !== digest(this.configuration))
+        {
+            return failure('render-identity-mismatch');
+        }
+        // The public renderer has no AbortSignal parameter: cancellation guards its admission.
+        const rendered = await renderMarkdownWithFsusRuntime({ source, mode: 'editor', ...this.configuration });
+        if (request.signal.aborted)
+        {
+            throw new Error('render-canceled');
+        }
+        if (!rendered.ok)
+        {
+            return failure('fsusui-render-failed');
+        }
+        let projection: MarkdownEditorProjectionResult;
+        try
+        {
+            projection = freezeProjection(createMarkdownEditorProjection(source));
+            // Projection uses the public source-only identity; render identity also binds mode/features/baseUrl.
+            if (projection.identity.rawSource !== rendered.value.rawSource
+                || projection.identity.normalizedSource !== rendered.value.normalizedSource
+                || projection.identity.version !== rendered.value.rendererVersion
+                || projection.identity.parser !== rendered.value.parser
+                || projection.identity.sourceIdentity !== resolveMarkdownSourceIdentity(source)
+                || rendered.value.sourceIdentity !== resolveMarkdownSourceIdentity({ source, mode: 'editor', ...this.configuration }))
+            {
+                return failure('projection-identity-mismatch', 'projection-failed');
+            }
+        }
+        catch
+        {
+            return failure('fsusui-projection-failed', 'projection-failed');
+        }
+        if (request.signal.aborted)
+        {
+            throw new Error('render-canceled');
+        }
+        const size = new TextEncoder().encode(JSON.stringify({ render: rendered.value, projection })).byteLength;
+        if (size > this.maxResultBytes || this.results.size >= 2)
+        {
+            return failure('render-retention-limit');
+        }
+        this.sequence += 1;
+        const resultRef = `fsusui-render:${request.context.documentId}:${this.sequence.toString(36)}`;
+        const result: ArticleRenderResult = Object.freeze({
+            contextDigest: request.context.contextDigest, requestId: request.requestId, identity: request.identity,
+            status: projection.diagnostics.length ? 'partial' : 'valid',
+            reason: projection.diagnostics.length ? 'fsusui-node-fallback' : null,
+            resultRef, resultDigest: digest({ render: rendered.value, projection }),
+            // The complete public projection keeps every diagnostic; the metadata ref list is bounded.
+            fallbackRefs: Object.freeze([...new Set(projection.diagnostics.map(item => item.blockIdentity))].slice(0, 64)),
+            longTaskRefs: Object.freeze([]), layoutObservationRefs: Object.freeze([])
+        });
+        if (!validateArticleRenderResult(result))
+        {
+            return failure('fsusui-result-invalid');
+        }
+        this.results.set(resultRef, { request, result, pair: Object.freeze({ render: rendered.value, projection }) });
+        return result;
+    }
+
+    public verify(request: ArticleRenderRequest, result: ArticleRenderResult): boolean
+    {
+        if (!validateArticleRenderResult(result))
+        {
+            return false;
+        }
+        if (result.resultRef === null)
+        {
+            return result.contextDigest === request.context.contextDigest
+            && result.requestId === request.requestId && digest(result.identity) === digest(request.identity);
+        }
+        const retained = this.results.get(result.resultRef);
+        return retained?.request === request && digest(retained.result) === digest(result)
+            && result.resultDigest === digest(retained.pair);
+    }
+
+    public resolve(result: ArticleRenderResult): Readonly<RetainedFsusUiPair> | null
+    {
+        const retained = result.resultRef ? this.results.get(result.resultRef) : null;
+        if (!retained || digest(retained.result) !== digest(result)
+            || result.resultDigest !== digest(retained.pair))
+        {
+            return null;
+        }
+        return retained.pair;
+    }
+
+    public release(resultRef: string): void
+    {
+        this.results.delete(resultRef);
+    }
+}
diff --git a/src/frontend/src/services/authoring/articleLiveCapability.ts b/src/frontend/src/services/authoring/articleLiveCapability.ts
new file mode 100644
index 000000000..528cb0e68
--- /dev/null
+++ b/src/frontend/src/services/authoring/articleLiveCapability.ts
@@ -0,0 +1,188 @@
+import {
+    markdownLiveCapabilities,
+    readMarkdownLiveCapability
+} from '@ozwasyd/element-plus';
+
+
+import {
+    readArticleEditorSurfacePreference,
+    type ArticleEditorSurface,
+    type ArticleEditorSurfacePreference
+} from './articleEditorSurface';
+import { calculateOpenArticleDocumentDigest as digest } from './openArticleDocumentRegistry';
+
+import type { ArticleDocumentContext, ArticleDocumentContextAdapter, ArticleDocumentTaskLease } from './articleDocumentContext';
+import type { MarkdownLiveCapability, MarkdownLiveCapabilityResult } from '@ozwasyd/element-plus';
+
+export interface ArticleLiveCapabilityEnvironment
+{
+    readonly rendererVersion: string;
+    readonly projectionVersion: string;
+    readonly featureDigest: string;
+    readonly runtimeIdentity: string;
+    readonly platformIdentity: string;
+}
+
+export interface ArticleLiveCapabilityRequest
+{
+    readonly document: ArticleDocumentContext;
+    readonly environment: ArticleLiveCapabilityEnvironment;
+    readonly signal: AbortSignal;
+}
+
+export interface ArticleLiveCapabilityState
+{
+    readonly capability: MarkdownLiveCapability | null;
+    readonly effectiveSurface: ArticleEditorSurface;
+    readonly preference: ArticleEditorSurfacePreference;
+    readonly reason: 'capability-pending' | 'invalid-capability' | MarkdownLiveCapability | null;
+    readonly localEscape: MarkdownLiveCapabilityResult | null;
+    readonly recovery: 'request-current-capability' | 'source-escape' | 'none';
+}
+
+const environmentKeys = ['rendererVersion', 'projectionVersion', 'featureDigest', 'runtimeIdentity', 'platformIdentity'];
+const capabilityKeys = ['capability', 'documentIdentity', 'revision', 'reason', 'affectedRange', 'nodeId', 'stale', 'aborted'];
+
+function validPublicCapability(value: unknown): value is MarkdownLiveCapabilityResult
+{
+    if (value === null || typeof value !== 'object' || Array.isArray(value))
+    {
+        return false;
+    }
+    const item = value as Record<string, unknown>;
+    if (Object.keys(item).some(key => !capabilityKeys.includes(key))
+        || !markdownLiveCapabilities.includes(item.capability as MarkdownLiveCapability)
+        || !Number.isSafeInteger(item.revision) || Number(item.revision) < 0
+        || item.documentIdentity === null || typeof item.documentIdentity !== 'object')
+    {
+        return false;
+    }
+    const identity = item.documentIdentity as Record<string, unknown>;
+    if (Array.isArray(identity) || Object.keys(identity).length !== 2 || typeof identity.id !== 'string' || !identity.id
+        || !Number.isSafeInteger(identity.epoch) || Number(identity.epoch) < 1)
+    {
+        return false;
+    }
+    if (item.reason !== undefined && typeof item.reason !== 'string'
+        || item.nodeId !== undefined && (typeof item.nodeId !== 'string' || !item.nodeId)
+        || item.stale !== undefined && typeof item.stale !== 'boolean'
+        || item.aborted !== undefined && typeof item.aborted !== 'boolean')
+    {
+        return false;
+    }
+    if (item.affectedRange !== undefined)
+    {
+        if (item.affectedRange === null || typeof item.affectedRange !== 'object')
+        {
+            return false;
+        }
+        const range = item.affectedRange as Record<string, unknown>;
+        if (Array.isArray(range) || Object.keys(range).length !== 2 || !Number.isSafeInteger(range.start) || Number(range.start) < 0
+            || !Number.isSafeInteger(range.end) || Number(range.end) < Number(range.start))
+        {
+            return false;
+        }
+    }
+    return true;
+}
+
+/**
+ * Product policy over the real public typed capability. The document owner supplies cancellation
+ * and revision isolation. No editor, content, persistence, retry command or capability producer is created here.
+ */
+export class ArticleLiveCapabilitySession
+{
+    private request: ArticleLiveCapabilityRequest | null = null;
+    private lease: ArticleDocumentTaskLease | null = null;
+    private decision: { document: ArticleDocumentContext; environment: ArticleLiveCapabilityEnvironment; result: MarkdownLiveCapabilityResult | null; invalid: boolean; } | null = null;
+
+    private readonly owner: ArticleDocumentContextAdapter;
+
+    public constructor(owner: ArticleDocumentContextAdapter)
+    {
+        this.owner = owner;
+    }
+
+    public begin(environment: ArticleLiveCapabilityEnvironment): ArticleLiveCapabilityRequest
+    {
+        if (Object.keys(environment).length !== environmentKeys.length
+            || !environmentKeys.every(key => typeof environment[key as keyof ArticleLiveCapabilityEnvironment] === 'string'
+                && environment[key as keyof ArticleLiveCapabilityEnvironment].length > 0)
+            || !/^[a-f0-9]{64}$/u.test(environment.featureDigest))
+        {
+            throw new Error('article-live-capability-environment-invalid');
+        }
+        if (this.decision !== null && digest(this.decision.environment) !== digest(environment))
+        {
+            this.decision = null;
+        }
+        this.cancel();
+        this.lease = this.owner.beginTask('feature', 'article-live-capability', 'v1.0');
+        this.request = Object.freeze({ document: this.owner.context, environment: Object.freeze({ ...environment }), signal: this.lease.signal });
+        return this.request;
+    }
+
+    public commit(request: ArticleLiveCapabilityRequest, value: unknown): 'accepted' | 'invalid' | 'stale'
+    {
+        if (request !== this.request || !this.lease?.isCurrent() || request.signal.aborted
+            || !this.owner.isCurrentContext(request.document))
+        {
+            return 'stale';
+        }
+        if (!validPublicCapability(value))
+        {
+            this.decision = { document: request.document, environment: request.environment, result: null, invalid: true };
+            this.lease.complete(request.document.sourceRevision);
+            return 'invalid';
+        }
+        try
+        {
+            readMarkdownLiveCapability(value, { documentIdentity: this.owner.documentIdentity, revision: this.owner.context.sourceRevision });
+        }
+        catch
+        {
+            return 'stale';
+        }
+        const result = Object.freeze({
+            ...value,
+            documentIdentity: Object.freeze({ ...value.documentIdentity }),
+            ...(value.affectedRange === undefined ? {} : { affectedRange: Object.freeze({ ...value.affectedRange }) })
+        });
+        if (!this.lease.accept(result).accepted)
+        {
+            return 'stale';
+        }
+        this.decision = { document: request.document, environment: request.environment, result, invalid: false };
+        return 'accepted';
+    }
+
+    public state(preference: unknown): ArticleLiveCapabilityState
+    {
+        const current = this.owner.context;
+        const resolved = readArticleEditorSurfacePreference(preference, current);
+        // A capability survives edits as session policy; node/range escapes require the exact revision.
+        const decision = this.decision?.document.documentId === current.documentId
+            && this.decision.document.documentEpoch === current.documentEpoch
+            && this.decision.document.editorSessionId === current.editorSessionId
+            && this.decision.document.siteScope === current.siteScope && this.decision.document.userScope === current.userScope
+            ? this.decision
+            : null;
+        const capability = decision?.result?.capability ?? null;
+        const live = capability === 'supported' || capability === 'feature-degraded';
+        return Object.freeze({
+            capability,
+            effectiveSurface: resolved.surface === 'source' || !live ? 'source' : 'live',
+            preference: resolved,
+            reason: decision?.invalid ? 'invalid-capability' : capability === 'supported' ? null : capability ?? 'capability-pending',
+            localEscape: capability === 'feature-degraded' && decision?.document.sourceRevision === current.sourceRevision ? decision.result : null,
+            recovery: live ? capability === 'feature-degraded' ? 'source-escape' : 'none' : 'request-current-capability'
+        });
+    }
+
+    public cancel(): void
+    {
+        this.lease?.cancel('capability-canceled');
+        this.lease = null;
+        this.request = null;
+    }
+}
