+const origins: readonly ArticleAnchorOrigin[] = ['refresh', 'surface', 'tool', 'outline', 'search', 'attachment', 'typewriter', 'sync'];
+const finite = (value: unknown): value is number => typeof value === 'number' && Number.isFinite(value);
