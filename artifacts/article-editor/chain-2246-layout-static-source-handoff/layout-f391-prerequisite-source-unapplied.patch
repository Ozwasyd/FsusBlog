+        if (!this.disposed && sameDocument(request.context, this.adapter.context))
+        {
+            this.receiptLog.push(receipt);
+            while (this.receiptLog.length > this.policy.maxReceipts)
+            {
+                this.receiptLog.shift();
+            }
+        }
+        return receipt;
+    }
+
+    private clearEntry(): void
+    {
+        const old = this.entry;
+        this.entry = null;
+        this.entryRequest = null;
+        if (old?.result.resultRef)
+        {
+            this.producer.release(old.result.resultRef);
+        }
+    }
+}
diff --git a/src/frontend/src/services/authoring/articleRenderRefreshPolicy.ts b/src/frontend/src/services/authoring/articleRenderRefreshPolicy.ts
new file mode 100644
index 000000000..1383a4c29
--- /dev/null
+++ b/src/frontend/src/services/authoring/articleRenderRefreshPolicy.ts
@@ -0,0 +1,186 @@
+import { MARKDOWN_RENDERER_VERSION, createMarkdownEditorProjection } from '@/fsusui/markdown';
+
+import {
+    articleDocumentContextSchema, validateArticleDocumentContext,
+    type ArticleDocumentContext
+} from './articleDocumentContext';
+import { calculateOpenArticleDocumentDigest as digest } from './openArticleDocumentRegistry';
+
+export const articleRenderRefreshDecisionSchema = 'fsusblog.article-render-refresh-decision.v1' as const;
+export const articleRenderSourceByteLimit = 80 * 1024;
+export const articleRenderEstimatedNodeLimit = 3000;
+
+export interface ArticleRenderRefreshDecision {
+    readonly schema: typeof articleRenderRefreshDecisionSchema;
+    readonly contextDigest: string;
+    readonly sourceDigest: string;
+    readonly sourceRevision: number;
+    readonly projectionVersion: string;
+    readonly sourceUtf8Bytes: number;
+    readonly byteMeasurement: 'exact' | 'lower-bound';
+    readonly lineCount: number | null;
+    readonly estimatedNodeUnits: number | null;
+    readonly nodeMeasurement: 'not-run' | 'exact' | 'lower-bound';
+    readonly allowed: boolean;
+    readonly reason: 'render-source-byte-limit' | 'render-estimated-node-limit' | 'render-policy-projection-failed' | null;
+    readonly decisionDigest: string;
+}
+
+// Content-free, weak provenance: serialized/re-digested caller decisions cannot authorize rendering.
+const producedDecisions = new WeakSet<ArticleRenderRefreshDecision>();
+const decisionKeys = ['schema', 'contextDigest', 'sourceDigest', 'sourceRevision', 'projectionVersion',
+    'sourceUtf8Bytes', 'byteMeasurement', 'lineCount', 'estimatedNodeUnits', 'nodeMeasurement',
+    'allowed', 'reason', 'decisionDigest'];
+const isDigest = (value: unknown): value is string => typeof value === 'string' && /^[a-f0-9]{64}$/u.test(value);
+const isCount = (value: unknown): value is number => typeof value === 'number' && Number.isSafeInteger(value) && value >= 0;
+
+export function validateArticleRenderRefreshDecision(value: unknown): value is ArticleRenderRefreshDecision
+{
+    if (!value || typeof value !== 'object' || Array.isArray(value)
+        || Object.keys(value).length !== decisionKeys.length || !decisionKeys.every(key => Object.hasOwn(value, key)))
+    {
+        return false;
+    }
+    const decision = value as ArticleRenderRefreshDecision;
+    if (decision.schema !== articleRenderRefreshDecisionSchema || !isDigest(decision.contextDigest)
+        || !isDigest(decision.sourceDigest) || !isDigest(decision.decisionDigest)
+        || !isCount(decision.sourceRevision) || decision.projectionVersion !== MARKDOWN_RENDERER_VERSION
+        || !isCount(decision.sourceUtf8Bytes) || !['exact', 'lower-bound'].includes(decision.byteMeasurement)
+        || typeof decision.allowed !== 'boolean')
+    {
+        return false;
+    }
+    const { decisionDigest, ...unsigned } = decision;
+    if (decisionDigest !== digest(unsigned))
+    {
+        return false;
+    }
+    if (decision.sourceUtf8Bytes > articleRenderSourceByteLimit)
+    {
+        return !decision.allowed && decision.reason === 'render-source-byte-limit'
+            && decision.lineCount === null && decision.estimatedNodeUnits === null && decision.nodeMeasurement === 'not-run';
+    }
+    if (decision.byteMeasurement !== 'exact' || !isCount(decision.lineCount))
+    {
+        return false;
+    }
+    if (decision.reason === 'render-policy-projection-failed')
+    {
+        return !decision.allowed && decision.estimatedNodeUnits === null && decision.nodeMeasurement === 'not-run';
+    }
+    if (!isCount(decision.estimatedNodeUnits) || decision.estimatedNodeUnits < decision.lineCount)
+    {
+        return false;
+    }
+    return decision.estimatedNodeUnits > articleRenderEstimatedNodeLimit
+        ? !decision.allowed && decision.reason === 'render-estimated-node-limit'
+            && ['exact', 'lower-bound'].includes(decision.nodeMeasurement)
+        : decision.allowed && decision.reason === null && decision.nodeMeasurement === 'exact';
+}
+
+export function admitArticleRenderRefreshDecision(
+    decision: ArticleRenderRefreshDecision,
+    context: ArticleDocumentContext,
+    projectionVersion: string
+): boolean
+{
+    return producedDecisions.has(decision) && validateArticleRenderRefreshDecision(decision)
+        && decision.contextDigest === context.contextDigest && decision.sourceDigest === context.contentDigest
+        && decision.sourceRevision === context.sourceRevision && decision.projectionVersion === projectionVersion;
+}
+
+// Sole threshold producer. Syntax facts belong to FsusUI; this computes a resource budget, not an AST/DOM.
+export function evaluateArticleRenderRefreshPolicy(context: ArticleDocumentContext, source: string): ArticleRenderRefreshDecision
+{
+    if (!validateArticleDocumentContext(context) || typeof source !== 'string'
+        || digest({ schema: articleDocumentContextSchema, content: source }) !== context.contentDigest)
+    {
+        throw new Error('article-render-policy-source-invalid');
+    }
+    // Four extra bytes fit any next UTF-8 scalar. Above-limit results honestly report a lower bound.
+    const encoded = new TextEncoder().encodeInto(source, new Uint8Array(articleRenderSourceByteLimit + 4));
+    const sourceUtf8Bytes = encoded.written;
+    let lineCount: number | null = null;
+    let estimatedNodeUnits: number | null = null;
+    let nodeMeasurement: ArticleRenderRefreshDecision['nodeMeasurement'] = 'not-run';
+    let reason: ArticleRenderRefreshDecision['reason'] = 'render-source-byte-limit';
+    if (sourceUtf8Bytes <= articleRenderSourceByteLimit)
+    {
+        lineCount = source.length === 0 ? 0 : 1;
+        for (let index = 0; index < source.length; index += 1)
+        {
+            if (source.charCodeAt(index) === 10)
+            {
+                lineCount += 1;
+            }
+        }
+        estimatedNodeUnits = lineCount;
+        nodeMeasurement = 'lower-bound';
+        reason = 'render-estimated-node-limit';
+        if (estimatedNodeUnits <= articleRenderEstimatedNodeLimit)
+        {
+            try
+            {
+                const projection = createMarkdownEditorProjection(source);
+                if (projection.identity.rawSource !== source || projection.identity.version !== MARKDOWN_RENDERER_VERSION)
+                {
+                    throw new Error('article-render-policy-projection-invalid');
+                }
+                const listMarkers = new Set<string>();
+                for (const node of projection.nodes)
+                {
+                    if (node.kind === 'heading')
+                    {
+                        estimatedNodeUnits += 2;
+                    }
+                    else if (node.kind === 'list' || node.kind === 'task')
+                    {
+                        for (const marker of node.rawMarkerRanges)
+                        {
+                            const key = `${marker.start}:${marker.end}`;
+                            if (!listMarkers.has(key))
+                            {
+                                listMarkers.add(key);
+                                estimatedNodeUnits += 2;
+                            }
+                        }
+                    }
+                    else if (node.kind === 'table')
+                    {
+                        estimatedNodeUnits += (node.table?.rows.length ?? 0) * 3;
+                    }
+                    else if (node.diagnosticCode === 'unclosed-code-fence' || node.diagnosticCode === 'unclosed-mermaid')
+                    {
+                        estimatedNodeUnits += 30;
+                    }
+                    else if (node.kind === 'code' || node.kind === 'mermaid')
+                    {
+                        estimatedNodeUnits += node.rawMarkerRanges.filter(marker => marker.end - marker.start >= 3).length * 30;
+                    }
+                    if (estimatedNodeUnits > articleRenderEstimatedNodeLimit)
+                    {
+                        break;
+                    }
+                }
+                if (estimatedNodeUnits <= articleRenderEstimatedNodeLimit)
+                {
+                    nodeMeasurement = 'exact';
+                    reason = null;
+                }
+            }
+            catch
+            {
+                estimatedNodeUnits = null;
+                nodeMeasurement = 'not-run';
+                reason = 'render-policy-projection-failed';
+            }
+        }
+    }
+    const unsigned = { schema: articleRenderRefreshDecisionSchema, contextDigest: context.contextDigest,
+        sourceDigest: context.contentDigest, sourceRevision: context.sourceRevision, projectionVersion: MARKDOWN_RENDERER_VERSION,
+        sourceUtf8Bytes, byteMeasurement: encoded.read === source.length ? 'exact' as const : 'lower-bound' as const,
+        lineCount, estimatedNodeUnits, nodeMeasurement, allowed: reason === null, reason };
+    const decision = Object.freeze({ ...unsigned, decisionDigest: digest(unsigned) });
+    producedDecisions.add(decision);
+    return decision;
+}
diff --git a/src/frontend/src/services/authoring/articleSearchRevealPresentation.ts b/src/frontend/src/services/authoring/articleSearchRevealPresentation.ts
new file mode 100644
index 000000000..28aa96f75
--- /dev/null
+++ b/src/frontend/src/services/authoring/articleSearchRevealPresentation.ts
@@ -0,0 +1,79 @@
+import {
+    validateArticleAnchorCommand,
+    type ArticleAnchorCommand,
+    type ArticleAnchorRestoreKind
+} from './articleAnchorContext';
+import { validateArticleDocumentContext, type ArticleDocumentContext, type ArticleDocumentTaskLease } from './articleDocumentContext';
+
+import type { ArticleEditorRuntimeBinding } from './articleEditorRuntimeBinding';
+
+export interface ArticleSearchRevealPresentation {
+    readonly status: ArticleAnchorCommand['status'];
+    readonly precision: ArticleAnchorRestoreKind | null;
+    readonly exact: boolean;
+    readonly approximate: boolean;
+    readonly reason: string | null;
+    readonly commandDigest: string | null;
+}
+
+/**
+ * Project the canonical search reveal outcome for UI consumption. This does not
+ * create anchors, execute commands, revalidate server results or record visits.
+ * Internal index evaluations/candidates/raw ranges are not admitted commands;
+ * only the canonical anchor validator decides whether an input is a command.
+ * The shared runtime must still admit/execute the original command at use time.
+ */
+export function projectArticleSearchReveal(
+    command: unknown,
+    binding: ArticleEditorRuntimeBinding,
+    lease: ArticleDocumentTaskLease
+): ArticleSearchRevealPresentation
+{
+    const reject = (reason: string): ArticleSearchRevealPresentation => Object.freeze({
+        status: 'rejected', precision: null, exact: false, approximate: false,
+        reason, commandDigest: null
+    });
+    try
+    {
+        if (!validateArticleAnchorCommand(command))
+        {
+            return reject('search-reveal-command-invalid');
+        }
+        if (command.origin !== 'search')
+        {
+            return reject('search-reveal-origin-mismatch');
+        }
+        let current: ArticleDocumentContext;
+        try
+        {
+            current = binding.positionBinding().document;
+        }
+        catch
+        {
+            return reject('search-reveal-binding-unavailable');
+        }
+        if (!validateArticleDocumentContext(current) || binding.context.contextDigest !== current.contextDigest
+            || command.document.contextDigest !== current.contextDigest)
+        {
+            return reject('search-reveal-context-stale');
+        }
+        if (lease.envelope.kind !== 'search' || !lease.isCurrent() || lease.signal.aborted
+            || lease.envelope.context.contextDigest !== current.contextDigest)
+        {
+            return reject('search-reveal-lease-stale');
+        }
+        return Object.freeze({
+            status: command.status,
+            precision: command.kind,
+            exact: command.status === 'ready' && command.kind === 'exact',
+            approximate: command.approximate,
+            reason: command.reason,
+            commandDigest: command.contentDigest
+        });
+    }
+    catch
+    {
+        // Never expose an exception payload from an invalid boundary value.
+        return reject('search-reveal-command-invalid');
+    }
+}
diff --git a/src/frontend/src/services/authoring/articleWriterMountedEditorSource.ts b/src/frontend/src/services/authoring/articleWriterMountedEditorSource.ts
new file mode 100644
index 000000000..5f7b1f7bc
--- /dev/null
+++ b/src/frontend/src/services/authoring/articleWriterMountedEditorSource.ts
@@ -0,0 +1,82 @@
+import type { ArticleDocumentContext, ArticleDocumentContextAdapter } from './articleDocumentContext';
+import type { ArticleEditorContinuityPort, ArticleEditorMountedSessionPort } from './articleEditorContinuity';
+import type { ArticleWorkspaceMountedEditorSource } from './articleWorkspaceMountedEditorResolver';
+import type { OpenArticleDocumentRegistry } from './openArticleDocumentRegistry';
+
+/** Project the original context into the existing workspace reference vocabulary; this is not an identity or permission issuer. */
+export function projectArticleWriterWorkspaceDocument(document: ArticleDocumentContext):
+NonNullable<ReturnType<ArticleWorkspaceMountedEditorSource['readDocumentBinding']>>
+{
+    return Object.freeze({
+        identity: Object.freeze({ articleId: document.articleId, draftId: document.draftId, documentId: document.documentId }),
+        documentContext: Object.freeze({ documentEpoch: document.documentEpoch,
+            sourceRevision: `source-revision:${document.sourceRevision}`, draftRevision: document.draftRevision })
+    });
+}
+
+/** Borrow one actual Writer mount and the original document/registry owners; retain no second mount, body or session index. */
+export function createArticleWriterMountedEditorSource(
+    owner: ArticleDocumentContextAdapter,
+    registry: OpenArticleDocumentRegistry,
+    editor: ArticleEditorContinuityPort,
+    readMountedEditor: () => ArticleEditorMountedSessionPort | null,
+    isActive: () => boolean
+): ArticleWorkspaceMountedEditorSource
+{
+    const readMounted = (editorSessionRef: string): ArticleEditorMountedSessionPort | null =>
+    {
+        if (!isActive())
+        {
+            return null;
+        }
+        const document = owner.context;
+        const association = registry.listEntries().find(entry =>
+            entry.editorSessionRef === editorSessionRef && entry.identity.articleId === document.articleId
+            && entry.identity.draftId === document.draftId && entry.identity.documentId === document.documentId);
+        if (!owner.isCurrentContext(document) || !association)
+        {
+            return null;
+        }
+        const registryRevision = registry.getRevision();
+        const mounted = readMountedEditor();
+        if (mounted !== editor || !isActive() || !owner.isCurrentContext(document))
+        {
+            return null;
+        }
+        // The caller's mounted read may synchronously change the original association.
+        // Refuse it before getSession can bind this native editor to the borrowed ref.
+        const currentAssociation = registry.getEntry(association.tabId);
+        return registry.getRevision() === registryRevision && currentAssociation?.editorSessionRef === editorSessionRef
+            && currentAssociation.identity.articleId === document.articleId
+            && currentAssociation.identity.draftId === document.draftId
+            && currentAssociation.identity.documentId === document.documentId ? mounted : null;
+    };
+    return Object.freeze({
+        readMountedEditor: readMounted,
+        readDocumentBinding: (editorSessionRef: string) =>
+        {
+            const mounted = readMounted(editorSessionRef);
+            if (!mounted)
+            {
+                return null;
+            }
+            const document = owner.context;
+            const session = mounted.getSession(editorSessionRef);
+            const observed = session.inspectDocumentState();
+            if (observed.documentIdentity.id !== document.documentId || observed.documentIdentity.epoch !== document.documentEpoch
+                || observed.revision !== document.sourceRevision || readMounted(editorSessionRef) !== mounted
+                || !owner.isCurrentContext(document) || mounted.getSession(editorSessionRef) !== session)
+            {
+                return null;
+            }
+            const current = session.inspectDocumentState();
+            if (current.documentIdentity.id !== observed.documentIdentity.id
+                || current.documentIdentity.epoch !== observed.documentIdentity.epoch || current.revision !== observed.revision
+                || !isActive() || !owner.isCurrentContext(document))
+            {
+                return null;
+            }
+            return projectArticleWriterWorkspaceDocument(document);
+        }
+    });
+}
