+    private static IReadOnlyList<T>? Snapshot<T>(IReadOnlyList<T> values, int maximum)
+    {
+        int count = values.Count;
+        if (count < 0 || count > maximum)
+        {
+            return null;
+        }
+        T[] snapshot = new T[count];
+        for (int index = 0; index < count; index++)
