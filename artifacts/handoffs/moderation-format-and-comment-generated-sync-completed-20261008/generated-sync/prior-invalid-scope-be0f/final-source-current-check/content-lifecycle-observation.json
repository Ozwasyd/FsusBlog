    "article.scheduled.preDueCurrent": {
      "factId": "article.scheduled.pre-due-current-publication",
      "schemaVersion": 1,
      "subject": "scheduled transition before due",
      "predicate": "preserves",
      "object": "old current publication coordinate",
      "direction": "subject-to-object",
      "condition": "an article already has a current publication and pendingPublicationAt is still in the future",
