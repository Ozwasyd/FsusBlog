+using System.Runtime.InteropServices;
+
+using FsusBlog.Server.Infrastructure.Memory.Devices;
+
+namespace FsusBlog.Server.Infrastructure.Memory.Platform;
+
+internal interface IGpuMetalApi
+{
+    void RetainReference();
+    void ReleaseReference();
+    GpuDeviceIdentity Identity(nint device, Version osVersion, Architecture architecture);
+    ulong MaximumBufferLength(nint device);
+    void RetainObject(nint value);
+    void ReleaseObject(nint value);
+    nint CreateQueue(nint device);
+    nint CreateBuffer(nint device, ulong bytes, bool shared, bool cpuReadback);
+    ulong AllocatedSize(nint buffer);
+    nint Contents(nint buffer);
+    nint CreateCommand(nint queue);
+    void EncodeCopy(nint command, nint source, nint destination, ulong bytes);
+    void Commit(nint command);
+    ulong Status(nint command);
+}
+
+/// <summary>64-bit macOS 14 Objective-C/Metal ABI. Every delegate uses its actual fixed native signature.</summary>
+/// <remarks>API source: Apple metal-cpp macOS14/iOS17, commit 807c2cf7d2df9d30117d1031049af75733f535a2,
+/// Metal/MTLDevice.hpp, MTLBlitCommandEncoder.hpp, MTLCommandBuffer.hpp, MTLResource.hpp and Foundation/NSTypes.hpp.
+/// NS::UInteger is pointer-width; only the explicitly bound 64-bit profiles use ulong here.</remarks>
+internal sealed class GpuMetalNativeApi : IGpuMetalApi
+{
+    private readonly IGpuNativeLibrary _metal;
+    private readonly IGpuNativeLibrary _objectiveC;
+    private readonly CopyDevices _copyDevices;
+    private readonly RegisterSelector _registerSelector;
+    private readonly PoolPush _poolPush;
+    private readonly PoolPop _poolPop;
+    private readonly SendPointer _pointer;
+    private readonly SendInteger _integer;
+    private readonly SendBoolean _boolean;
+    private readonly SendResponds _responds;
+    private readonly SendIndex _index;
+    private readonly SendBuffer _buffer;
+    private readonly SendVoid _void;
+    private readonly SendCopy _copy;
+    private readonly Dictionary<string, nint> _selectors = new(StringComparer.Ordinal);
+    private nint _devices;
+    private int _references = 1;
+
+    public GpuMetalNativeApi(IGpuNativeLibrary metal, IGpuNativeLibrary objectiveC)
+    {
+        _metal = metal;
+        _objectiveC = objectiveC;
+        _copyDevices = metal.Bind<CopyDevices>("MTLCopyAllDevices");
+        _registerSelector = objectiveC.Bind<RegisterSelector>("sel_registerName");
+        _poolPush = objectiveC.Bind<PoolPush>("objc_autoreleasePoolPush");
+        _poolPop = objectiveC.Bind<PoolPop>("objc_autoreleasePoolPop");
+        _pointer = objectiveC.Bind<SendPointer>("objc_msgSend");
+        _integer = objectiveC.Bind<SendInteger>("objc_msgSend");
+        _boolean = objectiveC.Bind<SendBoolean>("objc_msgSend");
+        _responds = objectiveC.Bind<SendResponds>("objc_msgSend");
+        _index = objectiveC.Bind<SendIndex>("objc_msgSend");
+        _buffer = objectiveC.Bind<SendBuffer>("objc_msgSend");
+        _void = objectiveC.Bind<SendVoid>("objc_msgSend");
+        _copy = objectiveC.Bind<SendCopy>("objc_msgSend");
+        foreach (string selector in new[] { "respondsToSelector:", "count", "objectAtIndex:", "retain", "release",
+            "registryID", "name", "UTF8String", "hasUnifiedMemory", "maxBufferLength", "newCommandQueue",
+            "newBufferWithLength:options:", "allocatedSize", "contents", "commandBuffer", "blitCommandEncoder",
+            "copyFromBuffer:sourceOffset:toBuffer:destinationOffset:size:", "endEncoding", "commit", "status" })
+        {
+            _selectors.Add(selector, Nonzero(_registerSelector(selector), "register-selector"));
+        }
+    }
+
+    public int DeviceCount
+    {
+        get; private set;
+    }
+
+    public int Discover(int maximumDevices)
+    {
+        using var pool = Pool();
+        _devices = _copyDevices();
+        if (_devices == 0)
+        {
+            throw new GpuDriverException("copy-all-metal-devices", -1);
+        }
+        Require(_devices, "count", "objectAtIndex:");
+        ulong count = _integer(_devices, Selector("count"));
+        if (count > (ulong)maximumDevices)
+        {
+            throw new GpuMetalDeviceLimitException();
+        }
+        DeviceCount = checked((int)count);
+        return DeviceCount;
+    }
+
+    public nint GetDevice(int index)
+    {
+        if ((uint)index >= (uint)DeviceCount)
+        {
+            throw new ArgumentOutOfRangeException(nameof(index));
+        }
+        return Nonzero(_index(_devices, Selector("objectAtIndex:"), (ulong)index), "get-metal-device");
+    }
+
+    public GpuDeviceIdentity Identity(nint device, Version osVersion, Architecture architecture)
+    {
+        using var pool = Pool();
+        Require(device, "registryID", "name", "hasUnifiedMemory", "maxBufferLength", "newCommandQueue",
+            "newBufferWithLength:options:");
+        ulong registry = _integer(device, Selector("registryID"));
+        if (registry == 0)
+        {
+            throw new GpuDriverException("metal-registry-identity-missing", -1);
+        }
+        nint name = Nonzero(_pointer(device, Selector("name")), "metal-name");
+        Require(name, "UTF8String");
+        string text = Marshal.PtrToStringUTF8(Nonzero(_pointer(name, Selector("UTF8String")), "metal-name-utf8"))
+            ?? throw new GpuDriverException("metal-name-utf8", -1);
+        return new($"Metal/macOS14/{architecture}", $"{osVersion}/registry:{registry:x16}", text, 1400,
+            _boolean(device, Selector("hasUnifiedMemory")) != 0);
+    }
+
+    public ulong MaximumBufferLength(nint device) => _integer(device, Selector("maxBufferLength"));
+    public void RetainReference() => Interlocked.Increment(ref _references);
+
+    public void ReleaseReference()
+    {
+        if (Interlocked.Decrement(ref _references) == 0)
+        {
+            if (_devices != 0)
+            {
+                ReleaseObject(_devices);
+            }
+            _objectiveC.Dispose();
+            _metal.Dispose();
+        }
+    }
+
+    public void RetainObject(nint value) => Nonzero(_pointer(value, Selector("retain")), "retain-metal-object");
+    public void ReleaseObject(nint value) => _void(value, Selector("release"));
+
+    public nint CreateQueue(nint device)
+    {
+        using var pool = Pool();
+        nint queue = Nonzero(_pointer(device, Selector("newCommandQueue")), "new-metal-queue");
+        try
+        {
+            Require(queue, "commandBuffer");
+            return queue;
+        }
+        catch
+        {
+            ReleaseObject(queue);
+            throw;
+        }
+    }
+
+    public nint CreateBuffer(nint device, ulong bytes, bool shared, bool cpuReadback)
+    {
+        using var pool = Pool();
+        // MTLResourceStorageModePrivate = 2 << 4; shared upload uses CPUCacheModeWriteCombined = 1.
+        ulong options = shared ? cpuReadback ? 0UL : 1UL : 32UL;
+        nint buffer = _buffer(device, Selector("newBufferWithLength:options:"), bytes, options);
+        if (buffer == 0)
+        {
+            // newBuffer returns nil when allocation cannot be made; no object was created.
+            throw new GpuAllocationRejectedException();
+        }
+        try
+        {
+            Require(buffer, "allocatedSize");
+            if (shared)
+            {
+                Require(buffer, "contents");
+            }
+            return buffer;
+        }
+        catch
+        {
+            ReleaseObject(buffer);
+            throw;
+        }
+    }
+
+    public nint Contents(nint buffer) => Nonzero(_pointer(buffer, Selector("contents")), "metal-shared-contents");
+    public ulong AllocatedSize(nint buffer) => _integer(buffer, Selector("allocatedSize"));
+
+    public nint CreateCommand(nint queue)
+    {
+        using var pool = Pool();
+        nint command = Nonzero(_pointer(queue, Selector("commandBuffer")), "metal-command-buffer");
+        Require(command, "blitCommandEncoder", "commit", "status");
+        // commandBuffer is autoreleased; retain explicitly before the scoped pool drains.
+        RetainObject(command);
+        return command;
+    }
+
+    public void EncodeCopy(nint command, nint source, nint destination, ulong bytes)
+    {
+        using var pool = Pool();
+        nint encoder = Nonzero(_pointer(command, Selector("blitCommandEncoder")), "metal-blit-encoder");
+        Require(encoder, "copyFromBuffer:sourceOffset:toBuffer:destinationOffset:size:", "endEncoding");
+        try
+        {
+            _copy(encoder, Selector("copyFromBuffer:sourceOffset:toBuffer:destinationOffset:size:"),
+                source, 0, destination, 0, bytes);
+        }
+        finally
+        {
+            _void(encoder, Selector("endEncoding"));
+        }
+    }
+
+    public void Commit(nint command)
+    {
+        using var pool = Pool();
+        _void(command, Selector("commit"));
+    }
+
+    public ulong Status(nint command) => _integer(command, Selector("status"));
+
+    private void Require(nint value, params string[] selectors)
+    {
+        foreach (string selector in selectors)
+        {
+            if (_responds(value, Selector("respondsToSelector:"), Selector(selector)) == 0)
+            {
+                throw new EntryPointNotFoundException($"Metal object lacks required selector {selector}.");
+            }
+        }
+    }
+
+    private nint Selector(string selector) => _selectors[selector];
+    private AutoreleasePool Pool() => new(_poolPop, Nonzero(_poolPush(), "metal-autorelease-pool"));
+    private static nint Nonzero(nint value, string operation)
+        => value != 0 ? value : throw new GpuDriverException(operation, -1);
+
+    private readonly struct AutoreleasePool(PoolPop pop, nint handle) : IDisposable
+    {
+        public void Dispose() => pop(handle);
+    }
+
+    [UnmanagedFunctionPointer(CallingConvention.Cdecl)]
+    private delegate nint CopyDevices();
+    [UnmanagedFunctionPointer(CallingConvention.Cdecl)]
+    private delegate nint RegisterSelector([MarshalAs(UnmanagedType.LPUTF8Str)] string name);
+    [UnmanagedFunctionPointer(CallingConvention.Cdecl)]
+    private delegate nint PoolPush();
+    [UnmanagedFunctionPointer(CallingConvention.Cdecl)]
+    private delegate void PoolPop(nint pool);
+    [UnmanagedFunctionPointer(CallingConvention.Cdecl)]
+    private delegate nint SendPointer(nint value, nint selector);
+    [UnmanagedFunctionPointer(CallingConvention.Cdecl)]
+    private delegate ulong SendInteger(nint value, nint selector);
+    [UnmanagedFunctionPointer(CallingConvention.Cdecl)]
+    private delegate byte SendBoolean(nint value, nint selector);
+    [UnmanagedFunctionPointer(CallingConvention.Cdecl)]
+    private delegate byte SendResponds(nint value, nint selector, nint argument);
+    [UnmanagedFunctionPointer(CallingConvention.Cdecl)]
+    private delegate nint SendIndex(nint value, nint selector, ulong index);
+    [UnmanagedFunctionPointer(CallingConvention.Cdecl)]
+    private delegate nint SendBuffer(nint value, nint selector, ulong length, ulong options);
+    [UnmanagedFunctionPointer(CallingConvention.Cdecl)]
+    private delegate void SendVoid(nint value, nint selector);
+    [UnmanagedFunctionPointer(CallingConvention.Cdecl)]
+    private delegate void SendCopy(nint value, nint selector, nint source, ulong sourceOffset,
+        nint destination, ulong destinationOffset, ulong bytes);
+}
diff --git a/src/backend/Infrastructure/Memory/Platform/GpuMetalSession.cs b/src/backend/Infrastructure/Memory/Platform/GpuMetalSession.cs
new file mode 100644
index 000000000..675fae438
--- /dev/null
+++ b/src/backend/Infrastructure/Memory/Platform/GpuMetalSession.cs
@@ -0,0 +1,375 @@
+using System.Runtime.InteropServices;
+
+using FsusBlog.Server.Infrastructure.Memory.Devices;
+
+namespace FsusBlog.Server.Infrastructure.Memory.Platform;
+
+/// <summary>Metal object custody only; the common GPU owner supplies accounting and admission.</summary>
+internal sealed class GpuMetalSession : IGpuDriverSession, IGpuMetalAllocationObservation
+{
+    private readonly object _gate = new();
+    private readonly IGpuMetalApi _api;
+    private readonly nint _device;
+    private readonly nint _queue;
+    private readonly ulong _maximumBufferLength;
+    private readonly Dictionary<GpuDeviceAddress, long> _devices = new();
+    private readonly Dictionary<GpuHostAddress, HostBuffer> _hosts = new();
+    private readonly Dictionary<GpuSubmission, SubmissionState> _submissions = new();
+    private bool _disposed;
+    private bool _faulted;
+    private bool _queueReleased;
+    private bool _deviceReleased;
+
+    public GpuMetalSession(IGpuMetalApi api, nint device, Version osVersion, Architecture architecture)
+    {
+        _api = api;
+        _device = device;
+        api.RetainReference();
+        bool deviceRetained = false;
+        try
+        {
+            Identity = api.Identity(device, osVersion, architecture);
+            _maximumBufferLength = api.MaximumBufferLength(device);
+            if (_maximumBufferLength == 0)
+            {
+                throw new GpuDriverException("metal-max-buffer-length-missing", -1);
+            }
+            api.RetainObject(device);
+            deviceRetained = true;
+            _queue = api.CreateQueue(device);
+            if (_queue == 0)
+            {
+                throw new GpuDriverException("new-metal-queue", -1);
+            }
+        }
+        catch
+        {
+            if (deviceRetained)
+            {
+                api.ReleaseObject(device);
+            }
+            api.ReleaseReference();
+            throw;
+        }
+    }
+
+    public GpuDeviceIdentity Identity
+    {
+        get;
+    }
+
+    public ulong? ObservedDeviceCapacity(GpuDeviceAddress address)
+    {
+        lock (_gate)
+        {
+            EnsureAlive();
+            ValidateDevice(address, 0);
+            ulong observed = _api.AllocatedSize(unchecked((nint)address.Value));
+            return observed == 0 ? null : observed;
+        }
+    }
+
+    public ulong? ObservedHostCapacity(GpuHostAddress address)
+    {
+        lock (_gate)
+        {
+            EnsureAlive();
+            HostBuffer buffer = ValidateHost(address, 0);
+            ulong observed = _api.AllocatedSize(buffer.Handle);
+            return observed == 0 ? null : observed;
+        }
+    }
+
+    public GpuDeviceAddress AllocateDevice(long bytes)
+    {
+        ValidateSize(bytes);
+        lock (_gate)
+        {
+            EnsureAvailable();
+            nint buffer = _api.CreateBuffer(_device, (ulong)bytes, shared: false, cpuReadback: false);
+            var address = new GpuDeviceAddress(unchecked((ulong)buffer));
+            try
+            {
+                if (buffer == 0)
+                {
+                    throw new GpuAllocationRejectedException();
+                }
+                _devices.Add(address, bytes);
+                return address;
+            }
+            catch
+            {
+                if (buffer != 0)
+                {
+                    _api.ReleaseObject(buffer);
+                }
+                throw;
+            }
+        }
+    }
+
+    public void FreeDevice(GpuDeviceAddress address)
+    {
+        lock (_gate)
+        {
+            EnsureAlive();
+            ValidateDevice(address, 0);
+            if (_submissions.Values.Any(value => value.Device == address))
+            {
+                throw new InvalidOperationException("Metal private buffer is held by a submission.");
+            }
+            _api.ReleaseObject(unchecked((nint)address.Value));
+            _devices.Remove(address);
+        }
+    }
+
+    public GpuHostAddress AllocateHost(long bytes, bool cpuReadback)
+    {
+        ValidateSize(bytes);
+        lock (_gate)
+        {
+            EnsureAvailable();
+            nint buffer = _api.CreateBuffer(_device, (ulong)bytes, shared: true, cpuReadback);
+            try
+            {
+                if (buffer == 0)
+                {
+                    throw new GpuAllocationRejectedException();
+                }
+                // Only shared MTLBuffer.contents supplies a real CPU address; private handles remain opaque.
+                var address = new GpuHostAddress(_api.Contents(buffer));
+                if (address.Value == 0)
+                {
+                    throw new GpuDriverException("metal-shared-contents", -1);
+                }
+                _hosts.Add(address, new(buffer, bytes));
+                return address;
+            }
+            catch
+            {
+                if (buffer != 0)
+                {
+                    _api.ReleaseObject(buffer);
+                }
+                throw;
+            }
+        }
+    }
+
+    public void FreeHost(GpuHostAddress address)
+    {
+        lock (_gate)
+        {
+            EnsureAlive();
+            HostBuffer buffer = ValidateHost(address, 0);
+            EnsureHostIdle(address);
+            _api.ReleaseObject(buffer.Handle);
+            _hosts.Remove(address);
+        }
+    }
+
+    public unsafe void WriteHost(GpuHostAddress address, ReadOnlySpan<byte> source)
+    {
+        lock (_gate)
+        {
+            EnsureAvailable();
+            ValidateHost(address, source.Length);
+            EnsureHostIdle(address);
+            source.CopyTo(new Span<byte>((void*)address.Value, source.Length));
+        }
+    }
+
+    public unsafe void ReadHost(GpuHostAddress address, Span<byte> destination)
+    {
+        lock (_gate)
+        {
+            EnsureAvailable();
+            ValidateHost(address, destination.Length);
+            EnsureHostIdle(address);
+            new ReadOnlySpan<byte>((void*)address.Value, destination.Length).CopyTo(destination);
+        }
+    }
+
+    public GpuSubmission SubmitUpload(GpuHostAddress source, GpuDeviceAddress destination, long bytes)
+        => Submit(source, destination, bytes, upload: true);
+
+    public GpuSubmission SubmitReadback(GpuDeviceAddress source, GpuHostAddress destination, long bytes)
+        => Submit(destination, source, bytes, upload: false);
+
+    private GpuSubmission Submit(GpuHostAddress host, GpuDeviceAddress device, long bytes, bool upload)
+    {
+        ValidateSize(bytes);
+        lock (_gate)
+        {
+            EnsureAvailable();
+            HostBuffer buffer = ValidateHost(host, bytes);
+            ValidateDevice(device, bytes);
+            EnsureHostIdle(host);
+            nint command = _api.CreateCommand(_queue);
+            if (command == 0)
+            {
+                throw new GpuDriverException("metal-command-buffer", -1);
+            }
+            var submission = new GpuSubmission(_queue, command);
+            var state = new SubmissionState(host, device);
+            _submissions.Add(submission, state);
+            try
+            {
+                nint privateBuffer = unchecked((nint)device.Value);
+                _api.EncodeCopy(command, upload ? buffer.Handle : privateBuffer,
+                    upload ? privateBuffer : buffer.Handle, (ulong)bytes);
+                // Register every hold before commit: a throw cannot prove asynchronous work did not start.
+                _api.Commit(command);
+                state.Committed = true;
+                return submission;
+            }
+            catch
+            {
+                state.Uncertain = true;
+                _faulted = true;
+                throw;
+            }
+        }
+    }
+
+    public GpuCompletion Query(GpuSubmission submission)
+    {
+        lock (_gate)
+        {
+            EnsureAlive();
+            SubmissionState state = GetSubmission(submission);
+            if (state.Uncertain || !state.Committed)
+            {
+                return GpuCompletion.Uncertain;
+            }
+            if (state.Completed)
+            {
+                return GpuCompletion.Complete;
+            }
+            try
+            {
+                // MTLCommandBufferStatus: NotEnqueued 0, Enqueued 1, Committed 2, Scheduled 3, Completed 4, Error 5.
+                ulong status = _api.Status(submission.Event);
+                if (status == 4)
+                {
+                    state.Completed = true;
+                    return GpuCompletion.Complete;
+                }
+                if (status <= 3)
+                {
+                    return GpuCompletion.Pending;
+                }
+            }
+            catch (GpuDriverException)
+            {
+                // Failure to observe completion never authorizes releasing either buffer.
+            }
+            state.Uncertain = true;
+            _faulted = true;
+            return GpuCompletion.Uncertain;
+        }
+    }
+
+    public void ReleaseSubmission(GpuSubmission submission)
+    {
+        lock (_gate)
+        {
+            if (Query(submission) != GpuCompletion.Complete)
+            {
+                throw new InvalidOperationException("Metal command completion is not certain.");
+            }
+            _api.ReleaseObject(submission.Event);
+            _submissions.Remove(submission);
+        }
+    }
+
+    public void Dispose()
+    {
+        lock (_gate)
+        {
+            if (_disposed)
+            {
+                return;
+            }
+            if (_devices.Count != 0 || _hosts.Count != 0 || _submissions.Count != 0)
+            {
+                throw new InvalidOperationException("Metal buffers or commands still own this session.");
+            }
+            if (!_queueReleased)
+            {
+                _api.ReleaseObject(_queue);
+                _queueReleased = true;
+            }
+            if (!_deviceReleased)
+            {
+                _api.ReleaseObject(_device);
+                _deviceReleased = true;
+            }
+            _disposed = true;
+            _api.ReleaseReference();
+        }
+    }
+
+    private HostBuffer ValidateHost(GpuHostAddress address, long bytes)
+        => _hosts.TryGetValue(address, out HostBuffer buffer) && bytes <= buffer.Length ? buffer
+            : throw new ArgumentOutOfRangeException(nameof(address));
+
+    private void ValidateDevice(GpuDeviceAddress address, long bytes)
+    {
+        if (!_devices.TryGetValue(address, out long length) || bytes > length)
+        {
+            throw new ArgumentOutOfRangeException(nameof(address));
+        }
+    }
+
+    private void ValidateSize(long bytes)
+    {
+        if (bytes <= 0 || (ulong)bytes > _maximumBufferLength || (ulong)bytes > nuint.MaxValue)
+        {
+            throw new ArgumentOutOfRangeException(nameof(bytes));
+        }
+    }
+
+    private void EnsureHostIdle(GpuHostAddress address)
+    {
+        if (_submissions.Values.Any(value => value.Host == address))
+        {
+            throw new InvalidOperationException("Metal shared buffer is held by a submission.");
+        }
+    }
+
+    private SubmissionState GetSubmission(GpuSubmission submission)
+        => _submissions.TryGetValue(submission, out SubmissionState? state) ? state
+            : throw new InvalidOperationException("Command belongs to another session or was released.");
+
+    private void EnsureAlive() => ObjectDisposedException.ThrowIf(_disposed, this);
+
+    private void EnsureAvailable()
+    {
+        EnsureAlive();
+        if (_faulted)
+        {
+            throw new InvalidOperationException("Metal session is quarantined after an uncertain operation.");
+        }
+    }
+
+    private readonly record struct HostBuffer(nint Handle, long Length);
+
+    private sealed class SubmissionState(GpuHostAddress host, GpuDeviceAddress device)
+    {
+        public GpuHostAddress Host { get; } = host;
+        public GpuDeviceAddress Device { get; } = device;
+        public bool Committed
+        {
+            get; set;
+        }
+        public bool Completed
+        {
+            get; set;
+        }
+        public bool Uncertain
+        {
+            get; set;
+        }
+    }
+}
diff --git a/src/backend/Infrastructure/Memory/Platform/GpuNativeDiscovery.cs b/src/backend/Infrastructure/Memory/Platform/GpuNativeDiscovery.cs
new file mode 100644
index 000000000..9a1078f7b
--- /dev/null
+++ b/src/backend/Infrastructure/Memory/Platform/GpuNativeDiscovery.cs
@@ -0,0 +1,233 @@
+using System.Runtime.InteropServices;
+
+using FsusBlog.Server.Infrastructure.Memory.Capabilities;
+using FsusBlog.Server.Infrastructure.Memory.Devices;
+
+namespace FsusBlog.Server.Infrastructure.Memory.Platform;
+
+public enum GpuNativeBackend
+{
+    Cuda12,
+    Hip6
+}
+
+public enum GpuDiscoveryOutcome
+{
+    Disabled,
+    MissingLibrary,
+    NoDevice,
+    PermissionDenied,
+    ApiMismatch,
+    UnsupportedPlatform,
+    DeviceLimitExceeded,
+    DriverFault,
+    Discovered
+}
+
+/// <summary>Explicit loader inputs; these are not release or runtime qualification.</summary>
+public sealed class GpuNativeLoadPolicy
+{
+    public GpuNativeLoadPolicy(GpuNativeBackend backend, IEnumerable<string> approvedLibraryPaths,
+        IEnumerable<int> approvedApiVersions, int maximumDevices)
+    {
+        if (!Enum.IsDefined(backend))
+        {
+            throw new ArgumentOutOfRangeException(nameof(backend));
+        }
+        ArgumentNullException.ThrowIfNull(approvedLibraryPaths);
+        ArgumentNullException.ThrowIfNull(approvedApiVersions);
+        if (maximumDevices <= 0)
+        {
+            throw new ArgumentOutOfRangeException(nameof(maximumDevices));
+        }
+        Backend = backend;
+        MaximumDevices = maximumDevices;
+        string[] paths = approvedLibraryPaths.Distinct(StringComparer.Ordinal).ToArray();
+        if (paths.Length == 0 || paths.Any(path => !Path.IsPathFullyQualified(path)
+            || !string.Equals(path, Path.GetFullPath(path), StringComparison.Ordinal)))
+        {
+            throw new ArgumentException("An explicit finite list of canonical absolute library paths is required.");
+        }
+        int[] versions = approvedApiVersions.Distinct().ToArray();
+        if (versions.Length == 0 || versions.Any(version => backend == GpuNativeBackend.Cuda12
+                ? version < 12000 || version >= 13000
+                : version < 60000000 || version >= 70000000))
+        {
+            throw new ArgumentException("Exact API versions within the selected ABI profile are required.");
+        }
+        ApprovedLibraryPaths = Array.AsReadOnly(paths);
+        ApprovedApiVersions = Array.AsReadOnly(versions);
+    }
+
+    public GpuNativeBackend Backend
+    {
+        get;
+    }
+    public int MaximumDevices
+    {
+        get;
+    }
+    public IReadOnlyList<string> ApprovedLibraryPaths
+    {
+        get;
+    }
+    public IReadOnlyList<int> ApprovedApiVersions
+    {
+        get;
+    }
+}
+
+/// <summary>The caller owns discovered sessions. Discovery alone never admits allocation.</summary>
+public sealed record GpuNativeDiscoveryResult(GpuDiscoveryOutcome Outcome,
+    IReadOnlyList<IGpuDriverSession> Sessions, int? NativeCode = null)
+{
+    public MemoryQualification Qualification => MemoryQualification.NotVerified;
+}
+
+/// <summary>Auto discovery of all devices exposed by the caller-approved CUDA 12 or HIP 6 ABI and loader policy.</summary>
+public static class GpuNativeDiscovery
+{
+    public static GpuNativeDiscoveryResult Discover(MemoryCapabilityMode mode, GpuNativeLoadPolicy policy)
+        => Discover(mode, policy, new GpuSystemLibraryLoader());
+
+    internal static GpuNativeDiscoveryResult Discover(MemoryCapabilityMode mode,
+        GpuNativeLoadPolicy policy, IGpuNativeLibraryLoader loader)
+    {
+        MemoryCapabilityPolicy.Validate(mode);
+        if (mode == MemoryCapabilityMode.Disabled)
+        {
+            return new(GpuDiscoveryOutcome.Disabled, Array.Empty<IGpuDriverSession>());
+        }
+        ArgumentNullException.ThrowIfNull(policy);
+        ArgumentNullException.ThrowIfNull(loader);
+        // INTEROP: This increment binds the Linux 64-bit ABI only, not an inferred OS matrix.
+        if (!OperatingSystem.IsLinux() || RuntimeInformation.ProcessArchitecture != Architecture.X64)
+        {
+            return new(GpuDiscoveryOutcome.UnsupportedPlatform, Array.Empty<IGpuDriverSession>());
+        }
+        foreach (string path in policy.ApprovedLibraryPaths)
+        {
+            IGpuNativeLibrary? library;
+            try
+            {
+                library = loader.TryLoad(path);
+            }
+            catch (UnauthorizedAccessException)
+            {
+                return new(GpuDiscoveryOutcome.PermissionDenied, Array.Empty<IGpuDriverSession>());
+            }
+            catch (BadImageFormatException)
+            {
+                return new(GpuDiscoveryOutcome.ApiMismatch, Array.Empty<IGpuDriverSession>());
+            }
+            if (library is null)
+            {
+                continue;
+            }
+            var sessions = new List<IGpuDriverSession>();
+            GpuNativeApi? api = null;
+            try
+            {
+                api = policy.Backend == GpuNativeBackend.Cuda12
+                    ? new GpuCudaNativeApi(library, policy)
+                    : new GpuHipNativeApi(library, policy);
+                int count = api.GetDeviceCount();
+                if (count > policy.MaximumDevices)
+                {
+                    api.Release();
+                    return new(GpuDiscoveryOutcome.DeviceLimitExceeded, Array.Empty<IGpuDriverSession>());
+                }
+                for (int ordinal = 0; ordinal < count; ordinal++)
+                {
+                    sessions.Add(new GpuNativeSession(api, ordinal));
+                }
+                api.Release();
+                return new(count == 0 ? GpuDiscoveryOutcome.NoDevice : GpuDiscoveryOutcome.Discovered,
+                    sessions.AsReadOnly());
+            }
+            catch (GpuDriverException exception)
+            {
+                foreach (IGpuDriverSession session in sessions)
+                {
+                    session.Dispose();
+                }
+                if (api is null)
+                {
+                    library.Dispose();
+                }
+                else
+                {
+                    api.Release();
+                }
+                return new(exception.NativeCode == 100 ? GpuDiscoveryOutcome.NoDevice
+                    : policy.Backend == GpuNativeBackend.Cuda12 && exception.NativeCode == 800
+                        ? GpuDiscoveryOutcome.PermissionDenied : GpuDiscoveryOutcome.DriverFault,
+                    Array.Empty<IGpuDriverSession>(), exception.NativeCode);
+            }
+            catch (EntryPointNotFoundException)
+            {
+                foreach (IGpuDriverSession session in sessions)
+                {
+                    session.Dispose();
+                }
+                if (api is null)
+                {
+                    library.Dispose();
+                }
+                else
+                {
+                    api.Release();
+                }
+                return new(GpuDiscoveryOutcome.ApiMismatch, Array.Empty<IGpuDriverSession>());
+            }
+        }
+        return new(GpuDiscoveryOutcome.MissingLibrary, Array.Empty<IGpuDriverSession>());
+    }
+}
+
+internal interface IGpuNativeLibraryLoader
+{
+    IGpuNativeLibrary? TryLoad(string absolutePath);
+}
+
+internal interface IGpuNativeLibrary : IDisposable
+{
+    string AbsolutePath
+    {
+        get;
+    }
+    T Bind<T>(string symbol) where T : Delegate;
+}
+
+internal sealed class GpuSystemLibraryLoader : IGpuNativeLibraryLoader
+{
+    public IGpuNativeLibrary? TryLoad(string absolutePath)
+    {
+        try
+        {
+            return new Library(absolutePath, NativeLibrary.Load(absolutePath));
+        }
+        catch (DllNotFoundException)
+        {
+            return null;
+        }
+    }
+
+    private sealed class Library(string absolutePath, nint handle) : IGpuNativeLibrary
+    {
+        private nint _handle = handle;
+        public string AbsolutePath => absolutePath;
+
+        public T Bind<T>(string symbol) where T : Delegate
+            => Marshal.GetDelegateForFunctionPointer<T>(NativeLibrary.GetExport(_handle, symbol));
+
+        public void Dispose()
+        {
+            nint owned = Interlocked.Exchange(ref _handle, 0);
+            if (owned != 0)
+            {
+                NativeLibrary.Free(owned);
+            }
+        }
+    }
+}
diff --git a/src/backend/Infrastructure/Memory/Platform/GpuNativeSession.cs b/src/backend/Infrastructure/Memory/Platform/GpuNativeSession.cs
new file mode 100644
index 000000000..1d3b9946a
--- /dev/null
+++ b/src/backend/Infrastructure/Memory/Platform/GpuNativeSession.cs
@@ -0,0 +1,577 @@
+using FsusBlog.Server.Infrastructure.Memory.Capabilities;
+using FsusBlog.Server.Infrastructure.Memory.Devices;
+
+namespace FsusBlog.Server.Infrastructure.Memory.Platform;
+
+internal abstract class GpuNativeApi(IGpuNativeLibrary library)
+{
+    private int _references = 1;
+    public string LibraryPath => library.AbsolutePath;
+    public abstract string Backend
+    {
+        get;
+    }
+    public int Version
+    {
+        get; protected set;
+    }
+
+    public void Retain() => Interlocked.Increment(ref _references);
+    public void Release()
+    {
+        if (Interlocked.Decrement(ref _references) == 0)
+        {
+            library.Dispose();
+        }
+    }
+    protected T Bind<T>(string symbol) where T : Delegate => library.Bind<T>(symbol);
+    protected void VerifyVersion(GpuNativeLoadPolicy policy, int version)
+    {
+        if (!policy.ApprovedApiVersions.Contains(version))
+        {
+            throw new EntryPointNotFoundException($"Unapproved {Backend} API version {version}.");
+        }
+        Version = version;
+    }
+    internal static void Check(int status, string operation)
+    {
+        if (status != 0)
+        {
+            throw new GpuDriverException(operation, status);
+        }
+    }
+
+    protected static void RejectOutOfMemory(int status)
+    {
+        // Only payload-allocation entry points classify CUDA_ERROR_OUT_OF_MEMORY / hipErrorOutOfMemory here.
+        // A rejected request releases its reservation; context-restore failure still requires quarantine.
+        if (status == 2)
+        {
+            throw new GpuAllocationRejectedException();
+        }
+    }
+
+    public abstract int GetDeviceCount();
+    public abstract GpuDeviceIdentity GetIdentity(int device);
+    public abstract int CreateContext(int device, out nint context);
+    public abstract void DestroyContext(int device, nint context);
+    public abstract nint Enter(int device, nint context);
+    public abstract void Exit(nint token);
+    public abstract GpuDeviceAddress AllocateDevice(long bytes);
+    public abstract void FreeDevice(GpuDeviceAddress address);
+    public abstract GpuHostAddress AllocateHost(long bytes, bool readback);
+    public abstract void FreeHost(GpuHostAddress address);
+    public abstract nint CreateStream();
+    public abstract nint CreateEvent();
+    public abstract void DestroyStream(nint stream);
+    public abstract void DestroyEvent(nint @event);
+    public abstract void CopyUpload(GpuHostAddress source, GpuDeviceAddress destination, long bytes, nint stream);
+    public abstract void CopyReadback(GpuDeviceAddress source, GpuHostAddress destination, long bytes, nint stream);
+    public abstract void Record(nint @event, nint stream);
+    public abstract int Query(nint @event);
+    public virtual MemoryDetection CanPeer(int source, int destination) => MemoryDetection.Unsupported;
+    public virtual bool EnablePeer(int destination, nint destinationContext) => throw new NotSupportedException();
+    public virtual void DisablePeer(int destination, nint destinationContext) => throw new NotSupportedException();
+    public virtual void CopyPeer(GpuDeviceAddress source, int sourceDevice, nint sourceContext,
+        GpuDeviceAddress destination, int destinationDevice, nint destinationContext, long bytes, nint stream)
+        => throw new NotSupportedException();
+}
+
+/// <summary>Native custody, bounds and DMA tracking; accounting remains with the existing allocation owner.</summary>
+internal sealed class GpuNativeSession : IGpuPeerDriverSession
+{
+    private static long s_nextId;
+    private readonly long _id = Interlocked.Increment(ref s_nextId);
+    private readonly object _gate = new();
+    private readonly GpuNativeApi _api;
+    private readonly int _device;
+    private readonly nint _context;
+    private readonly Dictionary<GpuDeviceAddress, long> _devices = new();
+    private readonly Dictionary<GpuHostAddress, long> _hosts = new();
+    private readonly Dictionary<GpuSubmission, SubmissionState> _submissions = new();
+    private readonly HashSet<SubmissionState> _incoming = new();
+    private readonly Dictionary<GpuNativeSession, PeerLink> _peerLinks = new();
+    private bool _disposed;
+    private bool _faulted;
+
+    public GpuNativeSession(GpuNativeApi api, int device)
+    {
+        _api = api;
+        _device = device;
+        api.Retain();
+        try
+        {
+            Identity = api.GetIdentity(device);
+            GpuNativeApi.Check(api.CreateContext(device, out _context), "create-session-context");
+        }
+        catch
+        {
+            if (_context != 0)
+            {
+                // Failure to release native custody intentionally keeps the library loaded.
+                api.DestroyContext(device, _context);
+            }
+            api.Release();
+            throw;
+        }
+    }
+
+    public GpuDeviceIdentity Identity
+    {
+        get;
+    }
+
+    public GpuDeviceAddress AllocateDevice(long bytes)
+    {
+        ValidateSize(bytes);
+        lock (_gate)
+        {
+            return Invoke(() =>
+            {
+                GpuDeviceAddress address = _api.AllocateDevice(bytes);
+                _devices.Add(address, bytes);
+                return address;
+            });
+        }
+    }
+
+    public void FreeDevice(GpuDeviceAddress address)
+    {
+        lock (_gate)
+        {
+            EnsureAvailable();
+            if (!_devices.ContainsKey(address) || _submissions.Values.Any(value => value.Device == address)
+                || _incoming.Any(value => value.PeerDevice == address))
+            {
+                throw new InvalidOperationException("Device allocation is unknown or held by a submission.");
+            }
+            Invoke(() =>
+            {
+                _api.FreeDevice(address);
+                _devices.Remove(address);
+                return 0;
+            });
+        }
+    }
+
+    public GpuHostAddress AllocateHost(long bytes, bool cpuReadback)
+    {
+        ValidateSize(bytes);
+        lock (_gate)
+        {
+            return Invoke(() =>
+            {
+                GpuHostAddress address = _api.AllocateHost(bytes, cpuReadback);
+                _hosts.Add(address, bytes);
+                return address;
+            });
+        }
+    }
+
+    public void FreeHost(GpuHostAddress address)
+    {
+        lock (_gate)
+        {
+            EnsureAvailable();
+            if (!_hosts.ContainsKey(address) || _submissions.Values.Any(value => value.Host == address))
+            {
+                throw new InvalidOperationException("Host allocation is unknown or held by a submission.");
+            }
+            Invoke(() =>
+            {
+                _api.FreeHost(address);
+                _hosts.Remove(address);
+                return 0;
+            });
+        }
+    }
+
+    public unsafe void WriteHost(GpuHostAddress address, ReadOnlySpan<byte> source)
+    {
+        lock (_gate)
+        {
+            EnsureAvailable();
+            ValidateHost(address, source.Length);
+            EnsureHostIdle(address);
+            source.CopyTo(new Span<byte>((void*)address.Value, source.Length));
+        }
+    }
+
+    public unsafe void ReadHost(GpuHostAddress address, Span<byte> destination)
+    {
+        lock (_gate)
+        {
+            EnsureAvailable();
+            ValidateHost(address, destination.Length);
+            EnsureHostIdle(address);
+            new ReadOnlySpan<byte>((void*)address.Value, destination.Length).CopyTo(destination);
+        }
+    }
+
+    public GpuSubmission SubmitUpload(GpuHostAddress source, GpuDeviceAddress destination, long bytes)
+        => Submit(source, destination, bytes, upload: true);
+
+    public GpuSubmission SubmitReadback(GpuDeviceAddress source, GpuHostAddress destination, long bytes)
+        => Submit(destination, source, bytes, upload: false);
+
+    private GpuSubmission Submit(GpuHostAddress host, GpuDeviceAddress device, long bytes, bool upload)
+    {
+        ValidateSize(bytes);
+        lock (_gate)
+        {
+            ValidateHost(host, bytes);
+            ValidateDevice(device, bytes);
+            EnsureHostIdle(host);
+            return Invoke(() => StartSubmission(new(host, device), stream =>
+            {
+                if (upload)
+                {
+                    _api.CopyUpload(host, device, bytes, stream);
+                }
+                else
+                {
+                    _api.CopyReadback(device, host, bytes, stream);
+                }
+            }));
+        }
+    }
+
+    public MemoryDetection DetectPeerAccess(IGpuPeerDriverSession destination)
+    {
+        if (destination is not GpuNativeSession peer || !Compatible(peer))
+        {
+            return MemoryDetection.Unsupported;
+        }
+        return WithPeer(peer, () => Invoke(() => _api.CanPeer(_device, peer._device)));
+    }
+
+    public GpuSubmission SubmitPeerTransfer(GpuDeviceAddress source, IGpuPeerDriverSession destination,
+        GpuDeviceAddress destinationAddress, long bytes)
+    {
+        ValidateSize(bytes);
+        if (destination is not GpuNativeSession peer || !Compatible(peer))
+        {
+            throw new NotSupportedException("Peer sessions must share the approved native backend and API identity.");
+        }
+        return WithPeer(peer, () =>
+        {
+            EnsureAvailable();
+            peer.EnsureAvailable();
+            ValidateDevice(source, bytes);
+            peer.ValidateDevice(destinationAddress, bytes);
+            return Invoke(() =>
+            {
+                if (_api.CanPeer(_device, peer._device) != MemoryDetection.Present)
+                {
+                    throw new NotSupportedException("Driver does not support this directional peer pair.");
+                }
+                var state = new SubmissionState(default, source) { Peer = peer, PeerDevice = destinationAddress };
+                peer._incoming.Add(state);
+                return StartSubmission(state, stream =>
+                {
+                    if (!_peerLinks.TryGetValue(peer, out PeerLink? link))
+                    {
+                        link = new(_api.EnablePeer(peer._device, peer._context));
+                        _peerLinks.Add(peer, link);
+                    }
+                    link.References++;
+                    state.PeerLinkAssigned = true;
+                    _api.CopyPeer(source, _device, _context, destinationAddress, peer._device,
+                        peer._context, bytes, stream);
+                });
+            });
+        });
+    }
+
+    public GpuCompletion Query(GpuSubmission submission)
+    {
+        lock (_gate)
+        {
+            ObjectDisposedException.ThrowIf(_disposed, this);
+            SubmissionState state = GetSubmission(submission);
+            if (!state.Recorded || state.Uncertain)
+            {
+                return GpuCompletion.Uncertain;
+            }
+            try
+            {
+                int status = Invoke(() => _api.Query(submission.Event), allowFaulted: true);
+                if (status == 0)
+                {
+                    return GpuCompletion.Complete;
+                }
+                if (status == 600)
+                {
+                    return GpuCompletion.Pending;
+                }
+            }
+            catch (GpuDriverException)
+            {
+                // Context failures are equally uncertain; no teardown can imply DMA completion.
+            }
+            state.Uncertain = true;
+            _faulted = true;
+            return GpuCompletion.Uncertain;
+        }
+    }
+
+    public void ReleaseSubmission(GpuSubmission submission)
+    {
+        SubmissionState state;
+        lock (_gate)
+        {
+            state = GetSubmission(submission);
+        }
+        void Release()
+        {
+            if (Query(submission) != GpuCompletion.Complete)
+            {
+                throw new InvalidOperationException("Submission completion is not certain.");
+            }
+            Invoke(() =>
+            {
+                if (state.Peer is { } peer && state.PeerLinkAssigned && !state.PeerLinkReleased)
+                {
+                    PeerLink link = _peerLinks[peer];
+                    if (link.References == 1)
+                    {
+                        if (link.Owned)
+                        {
+                            _api.DisablePeer(peer._device, peer._context);
+                        }
+                        _peerLinks.Remove(peer);
+                    }
+                    else
+                    {
+                        link.References--;
+                    }
+                    state.PeerLinkReleased = true;
+                }
+                if (!state.EventReleased)
+                {
+                    _api.DestroyEvent(submission.Event);
+                    state.EventReleased = true;
+                }
+                _api.DestroyStream(submission.Stream);
+                _submissions.Remove(submission);
+                state.Peer?._incoming.Remove(state);
+                return 0;
+            }, allowFaulted: true);
+        }
+        if (state.Peer is { } peer)
+        {
+            WithPeer(peer, () =>
+            {
+                Release();
+                return 0;
+            });
+        }
+        else
+        {
+            lock (_gate)
+            {
+                Release();
+            }
+        }
+    }
+
+    public void Dispose()
+    {
+        lock (_gate)
+        {
+            if (_disposed)
+            {
+                return;
+            }
+            if (_devices.Count != 0 || _hosts.Count != 0 || _submissions.Count != 0 || _incoming.Count != 0
+                || _peerLinks.Count != 0)
+            {
+                throw new InvalidOperationException("Native allocations or submissions still own the session.");
+            }
+            _api.DestroyContext(_device, _context);
+            _disposed = true;
+            _api.Release();
+        }
+    }
+
+    private GpuSubmission StartSubmission(SubmissionState state, Action<nint> copy)
+    {
+        nint stream;
+        try
+        {
+            stream = _api.CreateStream();
+        }
+        catch
+        {
+            state.Peer?._incoming.Remove(state);
+            throw;
+        }
+        nint @event;
+        try
+        {
+            @event = _api.CreateEvent();
+        }
+        catch
+        {
+            // No copy was called yet; a cleanup failure retains an opaque stream record.
+            try
+            {
+                _api.DestroyStream(stream);
+                state.Peer?._incoming.Remove(state);
+            }
+            catch
+            {
+                _submissions.Add(new(stream, 0), state);
+                _faulted = true;
+            }
+            throw;
+        }
+        var submission = new GpuSubmission(stream, @event);
+        _submissions.Add(submission, state);
+        try
+        {
+            copy(stream);
+            _api.Record(@event, stream);
+            state.Recorded = true;
+            return submission;
+        }
+        catch
+        {
+            // INTEROP: Even failed copy/record calls can report an earlier asynchronous error.
+            state.Uncertain = true;
+            _faulted = true;
+            throw;
+        }
+    }
+
+    private T Invoke<T>(Func<T> action, bool allowFaulted = false)
+    {
+        ObjectDisposedException.ThrowIf(_disposed, this);
+        if (!allowFaulted)
+        {
+            EnsureAvailable();
+        }
+        nint token = _api.Enter(_device, _context);
+        try
+        {
+            return action();
+        }
+        finally
+        {
+            try
+            {
+                _api.Exit(token);
+            }
+            catch
+            {
+                _faulted = true;
+                throw;
+            }
+        }
+    }
+
+    private T WithPeer<T>(GpuNativeSession peer, Func<T> action)
+    {
+        object first = _id < peer._id ? _gate : peer._gate;
+        object second = _id < peer._id ? peer._gate : _gate;
+        lock (first)
+        {
+            lock (second)
+            {
+                return action();
+            }
+        }
+    }
+
+    private bool Compatible(GpuNativeSession peer)
+        => peer != this && _api.Backend == peer._api.Backend && _api.Version == peer._api.Version
+            && _api.LibraryPath == peer._api.LibraryPath;
+
+    private SubmissionState GetSubmission(GpuSubmission submission)
+        => _submissions.TryGetValue(submission, out SubmissionState? state) ? state
+            : throw new InvalidOperationException("Submission belongs to another session or was released.");
+
+    private void EnsureAvailable()
+    {
+        ObjectDisposedException.ThrowIf(_disposed, this);
+        if (_faulted)
+        {
+            throw new InvalidOperationException("Session is quarantined after an uncertain native operation.");
+        }
+    }
+
+    private void ValidateHost(GpuHostAddress address, long bytes)
+    {
+        if (!_hosts.TryGetValue(address, out long length) || bytes > length)
+        {
+            throw new ArgumentOutOfRangeException(nameof(address));
+        }
+    }
+
+    private void ValidateDevice(GpuDeviceAddress address, long bytes)
+    {
+        if (!_devices.TryGetValue(address, out long length) || bytes > length)
+        {
+            throw new ArgumentOutOfRangeException(nameof(address));
+        }
+    }
+
+    private void EnsureHostIdle(GpuHostAddress address)
+    {
+        if (_submissions.Values.Any(value => value.Host == address))
+        {
+            throw new InvalidOperationException("Host allocation is held by a submission.");
+        }
+    }
+
+    private static void ValidateSize(long bytes)
+    {
+        if (bytes <= 0 || (ulong)bytes > nuint.MaxValue)
+        {
+            throw new ArgumentOutOfRangeException(nameof(bytes));
+        }
+    }
+
+    private sealed class SubmissionState(GpuHostAddress host, GpuDeviceAddress device)
+    {
+        public GpuHostAddress Host { get; } = host;
+        public GpuDeviceAddress Device { get; } = device;
+        public GpuNativeSession? Peer
+        {
+            get; init;
+        }
+        public GpuDeviceAddress PeerDevice
+        {
+            get; init;
+        }
+        public bool Recorded
+        {
+            get; set;
+        }
+        public bool Uncertain
+        {
+            get; set;
+        }
+        public bool EventReleased
+        {
+            get; set;
+        }
+        public bool PeerLinkAssigned
+        {
+            get; set;
+        }
+        public bool PeerLinkReleased
+        {
+            get; set;
+        }
+    }
+
+    private sealed class PeerLink(bool owned)
+    {
+        public bool Owned { get; } = owned;
+        public int References
+        {
+            get; set;
+        }
+    }
+}
