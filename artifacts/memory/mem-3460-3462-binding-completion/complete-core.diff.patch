+                    || segment.Footprint.AllocatedFileBytes > bound.Value.MaximumChargeBytes)
+                {
+                    segment.Retired = true;
+                    Cleanup(segment);
+                    return MemoryOperationResult<DiskSegmentPublication>.Reject(MemoryFailure.BudgetRejected);
+                }
