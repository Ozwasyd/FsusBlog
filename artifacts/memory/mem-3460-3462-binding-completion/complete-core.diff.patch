+                }
+                using (OperationResource<FileStream> handle = Track(_root.CreateFile(segment.Name, () => segment.FileExists = true)))
+                {
+                    FileStream file = handle.Resource;
+                    segment.Footprint = _root.ObserveFileFootprint(file);
