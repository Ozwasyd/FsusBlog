+            catch (Exception exception) when (KnownFailure(exception))
+            {
+                segment.Retired = true;
+                Cleanup(segment);
+                return MemoryOperationResult<DiskSegmentPublication>.Reject(Failure(exception));
+            }
+            catch
+            {
+                segment.Retired = true;
+                Cleanup(segment);
+                throw;
+            }
+            finally
+            {
+                segment.Operations--;
+                Cleanup(segment);
+            }
+        }
+        finally
+        {
+            try
+            {
+                EndOperation();
+            }
+            finally
+            {
+                Monitor.Exit(_gate);
+            }
+        }
+    }
