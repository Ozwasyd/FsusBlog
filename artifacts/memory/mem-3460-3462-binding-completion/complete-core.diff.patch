@@ -0,0 +1,87 @@
+using FsusBlog.Server.Infrastructure.Memory.Contracts;
+
+namespace FsusBlog.Server.Infrastructure.Memory.Devices;
+
+/// <summary>One device allocation owner; no direct CPU view is exposed.</summary>
+public sealed class GpuAllocation : IDisposable
+{
+    private readonly GpuMemoryDevice _owner;
+
+    internal GpuAllocation(GpuMemoryDevice owner, MemoryContentIdentity content, MemoryLocationToken location,
+        GpuDeviceAddress address, long length, IMemoryAllocationCharge? charge, IMemoryReservation? unconverted)
+    {
+        _owner = owner;
+        Content = content;
+        Location = location;
+        Address = address;
+        Length = length;
+        Charge = charge;
+        Unconverted = unconverted;
+    }
+
+    public MemoryContentIdentity Content
+    {
+        get;
+    }
+    public MemoryLocationToken Location
+    {
+        get;
+    }
+    public long Length
+    {
+        get;
+    }
+    public bool IsCurrent => _owner.IsCurrent(this);
+    internal GpuDeviceAddress Address
+    {
+        get;
+    }
+    internal IGpuDriverSession Driver => _owner.Driver;
+    internal Accounting.MemoryReservationCoordinator Ledger => _owner.Ledger;
+    internal ResourceDomainId TransferDomain => _owner.TransferDomain;
+    internal void InvalidateOwner() => _owner.InvalidateEpoch();
+    internal IMemoryAllocationCharge? Charge
+    {
+        get;
+    }
+    internal IMemoryReservation? Unconverted
+    {
+        get;
+    }
+    internal int Holds
+    {
+        get; set;
+    }
+    internal bool Retiring
+    {
+        get; set;
+    }
+    internal bool UploadSubmitted
+    {
+        get; set;
+    }
+    internal bool Initialized
+    {
+        get; set;
+    }
+
+    public MemoryOperationResult<IGpuPeerAllocationHold> TryAcquirePeerHold(MemoryLocationToken expected)
+        => _owner.TryRetain(this, expected);
+
+    public void Dispose() => _owner.Retire(this);
+}
+
+internal sealed class GpuAllocationHold(GpuMemoryDevice owner, GpuAllocation allocation, GpuPeerAllocationAccess access) : IGpuPeerAllocationHold
+{
+    private GpuMemoryDevice? _owner = owner;
+    public MemoryLocationToken Location => allocation.Location;
+    public MemoryContentIdentity Content => allocation.Content;
+    public GpuPeerAllocationAccess Access => access;
+    public GpuDeviceAddress Address => allocation.Address;
+    public IGpuDriverSession Session => allocation.Driver;
+    public long Length => allocation.Length;
+    public bool IsCurrent => _owner is not null && allocation.IsCurrent;
+    public bool CanSubmit => _owner is not null && _owner.CanSubmit(allocation);
+
+    public void Dispose() => Interlocked.Exchange(ref _owner, null)?.ReleaseHold(allocation, access == GpuPeerAllocationAccess.Read);
+}
diff --git a/src/backend/Infrastructure/Memory/Devices/GpuDriver.cs b/src/backend/Infrastructure/Memory/Devices/GpuDriver.cs
new file mode 100644
index 000000000..7b63ad1b2
--- /dev/null
+++ b/src/backend/Infrastructure/Memory/Devices/GpuDriver.cs
@@ -0,0 +1,66 @@
+using FsusBlog.Server.Infrastructure.Memory.Contracts;
+
+namespace FsusBlog.Server.Infrastructure.Memory.Devices;
+
+public enum GpuCompletion
+{
+    Pending,
+    Complete,
+    Uncertain
+}
+
+public sealed record GpuDeviceIdentity(string Backend, string NativeIdentity, string Name,
+    int ApiVersion, bool SharesHostCapacity);
+
+// INTEROP: A device address is opaque and never convertible to a CPU view.
+public readonly record struct GpuDeviceAddress(ulong Value);
+public readonly record struct GpuHostAddress(nint Value);
+public readonly record struct GpuSubmission(nint Stream, nint Event);
+
+/// <summary>Driver seam; implementations must not free uncertain submitted resources.</summary>
+public interface IGpuDriverSession : IDisposable
+{
+    GpuDeviceIdentity Identity
+    {
+        get;
+    }
+    GpuDeviceAddress AllocateDevice(long bytes);
+    void FreeDevice(GpuDeviceAddress address);
+    GpuHostAddress AllocateHost(long bytes, bool cpuReadback);
+    void FreeHost(GpuHostAddress address);
+    void WriteHost(GpuHostAddress address, ReadOnlySpan<byte> source);
+    void ReadHost(GpuHostAddress address, Span<byte> destination);
+    // A throw may follow submission. The owner therefore quarantines all holds on a throw.
+    GpuSubmission SubmitUpload(GpuHostAddress source, GpuDeviceAddress destination, long bytes);
+    GpuSubmission SubmitReadback(GpuDeviceAddress source, GpuHostAddress destination, long bytes);
+    GpuCompletion Query(GpuSubmission submission);
+    void ReleaseSubmission(GpuSubmission submission);
+}
+
+/// <summary>Submission and release failures retain charges instead of guessing DMA stopped.</summary>
+public sealed class GpuDriverException : Exception
+{
+    public GpuDriverException(string operation, int nativeCode)
+        : base($"GPU operation {operation} failed with native status {nativeCode}.")
+    {
+        Operation = operation;
+        NativeCode = nativeCode;
+    }
+
+    public string Operation
+    {
+        get;
+    }
+    public int NativeCode
+    {
+        get;
+    }
+}
+
+/// <summary>A driver-confirmed allocation rejection that created no native resource.</summary>
+public sealed class GpuAllocationRejectedException : Exception
+{
+    public GpuAllocationRejectedException() : base("The driver rejected allocation without creating a resource.")
+    {
+    }
+}
diff --git a/src/backend/Infrastructure/Memory/Devices/GpuMemoryDevice.cs b/src/backend/Infrastructure/Memory/Devices/GpuMemoryDevice.cs
new file mode 100644
index 000000000..977057dba
--- /dev/null
+++ b/src/backend/Infrastructure/Memory/Devices/GpuMemoryDevice.cs
@@ -0,0 +1,888 @@
+using FsusBlog.Server.Infrastructure.Memory.Accounting;
+using FsusBlog.Server.Infrastructure.Memory.Capabilities;
+using FsusBlog.Server.Infrastructure.Memory.Contracts;
+using FsusBlog.Server.Infrastructure.Memory.Platform;
+
+namespace FsusBlog.Server.Infrastructure.Memory.Devices;
+
+public sealed record GpuMemoryDomains(ResourceDomainId Device, ResourceDomainId RegisteredHost,
+    ResourceDomainId TransferSlots);
+
+public sealed record GpuMemoryLimits(long MaximumAllocationBytes, long StagingAlignmentBytes,
+    int MaximumAllocations, int MaximumStagingBuffers, int MaximumOperations)
+{
+    /// <summary>Caller-declared physical device bound reserved before allocation when capacity is observed.</summary>
+    public long? MaximumObservedDeviceCapacityBytes
+    {
+        get; init;
+    }
+    /// <summary>Caller-declared physical staging bound reserved with slots before allocation when capacity is observed.</summary>
+    public long? MaximumObservedStagingCapacityBytes
+    {
+        get; init;
+    }
+}
+
+public sealed record GpuMemorySnapshot(DeviceEpoch Epoch, bool Accepting, bool Faulted,
+    int Allocations, int StagingBuffers, int Operations, int QuarantinedOperations, int UncertainReservations, bool RestartRequired);
+
+/// <summary>
+/// Owns admitted device allocations and driver-valid staging. The common governor owns
+/// qualification, scheduling of PollCompletions, recovery policy and content eligibility.
+/// No serving path is activated by constructing these source-level modules.
+/// </summary>
+public sealed class GpuMemoryDevice : IDisposable
+{
+    private readonly object _gate = new();
+    private readonly IGpuDriverSession _driver;
+    private readonly MemoryReservationCoordinator _ledger;
+    private readonly GpuMemoryDomains _domains;
+    private readonly GpuMemoryLimits _limits;
+    private readonly HashSet<GpuAllocation> _allocations = [];
+    private readonly List<GpuStagingBuffer> _staging = [];
+    private readonly HashSet<GpuTransferOperation> _operations = [];
+    private readonly HashSet<GpuPeerDeviceOperation> _peerOperations = [];
+    private readonly List<IMemoryReservation> _uncertainReservations = [];
+    private readonly TaskCompletionSource _drained = new(TaskCreationOptions.RunContinuationsAsynchronously);
+    private DeviceEpoch _epoch;
+    private bool _accepting = true;
+    private bool _faulted;
+    private bool _disposed;
+    private bool _disposeRequested;
+    private Exception? _drainFailure;
+    private int _externalHolds;
+
+    public GpuMemoryDevice(IGpuDriverSession driver, MemoryReservationCoordinator ledger,
+        GpuMemoryDomains domains, GpuMemoryLimits limits, DeviceEpoch epoch, MemoryCapabilityStatus qualification)
+    {
+        ArgumentNullException.ThrowIfNull(driver);
+        ArgumentNullException.ThrowIfNull(ledger);
+        ArgumentNullException.ThrowIfNull(domains);
+        ArgumentNullException.ThrowIfNull(limits);
+        ArgumentNullException.ThrowIfNull(qualification);
+        MemoryCapabilityPolicy.Validate(qualification.Requested);
+        if (qualification.PolicyRevision == 0 || qualification.Detection != MemoryDetection.Present
+            || qualification.Requested == MemoryCapabilityMode.Disabled
+            || qualification.ReleaseQualification != MemoryQualification.Qualified
+            || qualification.RuntimeQualification != MemoryQualification.Qualified
+            || qualification.OnlineState != MemoryOnlineState.Online)
+        {
+            throw new ArgumentException("The common capability owner must qualify and admit the session first.", nameof(qualification));
+        }
+        if (epoch.Value == 0 || limits.MaximumAllocationBytes <= 0 || limits.MaximumAllocations <= 0
+            || limits.MaximumStagingBuffers <= 0 || limits.MaximumOperations <= 0
+            || limits.StagingAlignmentBytes <= 0 || (limits.StagingAlignmentBytes & (limits.StagingAlignmentBytes - 1)) != 0)
+        {
+            throw new ArgumentOutOfRangeException(nameof(limits));
+        }
+        if (driver is IGpuMetalAllocationObservation
+            && (limits.MaximumObservedDeviceCapacityBytes is null || limits.MaximumObservedStagingCapacityBytes is null))
+        {
+            throw new ArgumentException("Capacity-observing drivers require explicit physical admission bounds.", nameof(limits));
+        }
+        if (limits.MaximumObservedDeviceCapacityBytes < limits.MaximumAllocationBytes
+            || limits.MaximumObservedStagingCapacityBytes < limits.MaximumAllocationBytes)
+        {
+            throw new ArgumentOutOfRangeException(nameof(limits), "Physical admission bounds must cover the logical allocation limit.");
+        }
+        // UMA must be represented by the common topology, never treated as extra host capacity.
+        if (driver.Identity.SharesHostCapacity
+            && !ledger.Topology.ConstraintChain(domains.Device).Select(domain => domain.CapacityIdentity)
+                .Intersect(ledger.Topology.ConstraintChain(domains.RegisteredHost).Select(domain => domain.CapacityIdentity), StringComparer.Ordinal).Any())
+        {
+            throw new ArgumentException("Shared device capacity requires shared physical-domain accounting.", nameof(domains));
+        }
+        _driver = driver;
+        _ledger = ledger;
+        _domains = domains;
+        _limits = limits;
+        _epoch = epoch;
+    }
+
+    public GpuDeviceIdentity Identity => _driver.Identity;
+
+    /// <summary>
+    /// Completes after Dispose stops admission, all submitted work and retained consumers drain,
+    /// and native allocations, staging and the driver session are released. PollCompletions still
+    /// requires the common scheduler. Unreleased holds remain pending; unproven faulted teardown
+    /// faults this task without releasing uncertain custody or authorizing a restart/reset.
+    /// Cancelling a caller's wait does not cancel this device-owned task or resource cleanup.
+    /// </summary>
+    public Task Drained => _drained.Task;
+    internal IGpuDriverSession Driver => _driver;
+    internal MemoryReservationCoordinator Ledger => _ledger;
+    internal ResourceDomainId TransferDomain => _domains.TransferSlots;
+
+    public GpuMemorySnapshot Snapshot()
+    {
+        lock (_gate)
+        {
+            int quarantined = _operations.Count(operation => operation.Quarantined)
+                + _peerOperations.Count(operation => operation.Quarantined);
+            return new(_epoch, _accepting, _faulted, _allocations.Count, _staging.Count,
+                _operations.Count + _peerOperations.Count + _externalHolds, quarantined, _uncertainReservations.Count, _faulted);
+        }
+    }
+
+    public MemoryOperationResult<GpuAllocation> TryAllocate(MemoryContentIdentity content, long length,
+        ResidencyRevision revision)
+    {
+        content.Validate();
+        if (length <= 0 || length > _limits.MaximumAllocationBytes || revision.Value == 0)
+        {
+            return MemoryOperationResult<GpuAllocation>.Reject(MemoryFailure.BoundsViolation);
+        }
+        lock (_gate)
+        {
+            if (!_accepting)
+            {
+                return MemoryOperationResult<GpuAllocation>.Reject(_faulted ? MemoryFailure.DeviceLost : MemoryFailure.TierUnavailable);
+            }
+            if (_allocations.Count >= _limits.MaximumAllocations)
+            {
+                return MemoryOperationResult<GpuAllocation>.Reject(MemoryFailure.BudgetRejected);
+            }
+            long admittedCapacity = _driver is IGpuMetalAllocationObservation
+                ? _limits.MaximumObservedDeviceCapacityBytes!.Value : length;
+            MemoryResourceCharge[] vector = [new(_domains.Device, MemoryResourceUnit.Bytes, admittedCapacity)];
+            var admission = _ledger.TryReserve(vector);
+            if (!admission.Succeeded)
+            {
+                return MemoryOperationResult<GpuAllocation>.Reject(admission.Failure!.Value);
+            }
+            var reservation = admission.Value!;
+            GpuDeviceAddress address;
+            try
+            {
+                address = _driver.AllocateDevice(length);
+            }
+            catch (GpuAllocationRejectedException)
+            {
+                reservation.Dispose();
+                return MemoryOperationResult<GpuAllocation>.Reject(MemoryFailure.BudgetRejected);
+            }
+            catch
+            {
+                // A native call can allocate successfully and then fail context restoration.
+                // There is no returned handle proving safe release; retain admission and stop.
+                _uncertainReservations.Add(reservation);
+                FaultLocked();
+                return MemoryOperationResult<GpuAllocation>.Reject(MemoryFailure.DeviceLost);
+            }
+            var location = new MemoryLocationToken(new(Guid.NewGuid()), new(Guid.NewGuid()), revision, _epoch);
+            MemoryOperationResult<MemoryAllocationLayout> layout;
+            try
+            {
+                ulong? observed = _driver is IGpuMetalAllocationObservation observer
+                    ? observer.ObservedDeviceCapacity(address) : (ulong)length;
+                layout = ObservedLayout(length, observed, 1);
+            }
+            catch (Exception exception)
+            {
+                RejectUnpublishedDeviceLocked(content, location, address, length, reservation, exception);
+                return MemoryOperationResult<GpuAllocation>.Reject(MemoryFailure.DeviceLost);
+            }
+            if (!layout.Succeeded)
+            {
+                RejectUnpublishedDeviceLocked(content, location, address, length, reservation);
+                return MemoryOperationResult<GpuAllocation>.Reject(layout.Failure!.Value);
+            }
+            var descriptor = new MemoryAllocationDescriptor(location.Allocation, _domains.Device,
+                layout.Value!);
+            var actual = new MemoryResourceCharge[] { new(_domains.Device, MemoryResourceUnit.Bytes, layout.Value!.CapacityBytes) };
+            var conversion = reservation.CommitPhysical(descriptor, actual);
+            if (!conversion.Succeeded)
+            {
+                RejectUnpublishedDeviceLocked(content, location, address, length, reservation);
+                return MemoryOperationResult<GpuAllocation>.Reject(conversion.Failure!.Value);
+            }
+            var allocation = new GpuAllocation(this, content, location, address, length, conversion.Value, null);
+            _allocations.Add(allocation);
+            return MemoryOperationResult<GpuAllocation>.Success(allocation);
+        }
+    }
+
+    private static MemoryOperationResult<MemoryAllocationLayout> ObservedLayout(long length, ulong? capacity, long alignment)
+        => capacity is null or 0 ? MemoryOperationResult<MemoryAllocationLayout>.Reject(MemoryFailure.UnsupportedCapability)
+            : capacity > long.MaxValue ? MemoryOperationResult<MemoryAllocationLayout>.Reject(MemoryFailure.BoundsViolation)
+            : MemoryAllocationLayout.TryCreate(length, (long)capacity.Value, alignment);
+
+    private void RejectUnpublishedDeviceLocked(MemoryContentIdentity content, MemoryLocationToken location,
+        GpuDeviceAddress address, long length, IMemoryReservation reservation, Exception? cause = null)
+    {
+        try
+        {
+            // This resource has never entered DMA. Only a successful native free proves reservation release safe.
+            _driver.FreeDevice(address);
+            reservation.Dispose();
+        }
+        catch (Exception exception)
+        {
+            _allocations.Add(new GpuAllocation(this, content, location, address, length, null, reservation) { Retiring = true });
+            FaultLocked(cause ?? exception);
+        }
+        if (cause is not null)
+        {
+            FaultLocked(cause);
+        }
+    }
+
+    /// <summary>Success transfers custody of source to the actual operation; rejection leaves it with the caller.</summary>
+    public MemoryOperationResult<GpuTransferOperation> TryUpload(GpuAllocation destination,
+        IMemoryHostReadLease source, MemoryLocationToken expectedDestination)
+    {
+        ArgumentNullException.ThrowIfNull(source);
+        ArgumentNullException.ThrowIfNull(destination);
+        // Content authority/eligibility is still checked by the residency publisher before publication.
+        if (source.Content != destination.Content || source.Memory.Length != destination.Length)
+        {
+            return MemoryOperationResult<GpuTransferOperation>.Reject(MemoryFailure.BoundsViolation);
+        }
+        return Submit(destination, expectedDestination, source, readback: false);
+    }
+
+    /// <summary>Copies one complete immutable representation into an exclusive, unpublished destination.</summary>
+    public MemoryOperationResult<GpuPeerDeviceOperation> TryPeerUpload(GpuAllocation destination,
+        GpuAllocation source, MemoryCapabilityStatus peerStatus, GpuPeerCapabilityFacts facts, MemoryQualification workloadQualification,
+        string workloadReason)
+    {
+        ArgumentNullException.ThrowIfNull(source);
+        ArgumentNullException.ThrowIfNull(destination);
+        ArgumentNullException.ThrowIfNull(peerStatus);
+        var selection = GpuPeerPathSelection.Select(peerStatus, facts, GpuPeerPath.PeerTransfer,
+            workloadQualification, MemoryAdmission.Admitted, workloadReason);
+        if (selection.Path != GpuPeerPath.PeerTransfer)
+        {
+            return MemoryOperationResult<GpuPeerDeviceOperation>.Reject(MemoryFailure.UnsupportedCapability);
+        }
+        if (!ReferenceEquals(_ledger, source.Ledger))
+        {
+            return MemoryOperationResult<GpuPeerDeviceOperation>.Reject(MemoryFailure.OwnershipViolation);
+        }
+        if (destination.Content != source.Content)
+        {
+            return MemoryOperationResult<GpuPeerDeviceOperation>.Reject(MemoryFailure.Corruption);
+        }
+        if (destination.Length != source.Length)
+        {
+            return MemoryOperationResult<GpuPeerDeviceOperation>.Reject(MemoryFailure.BoundsViolation);
+        }
+        if (_driver is not IGpuPeerDriverSession destinationSession
+            || source.Driver is not IGpuPeerDriverSession sourceSession)
+        {
+            return MemoryOperationResult<GpuPeerDeviceOperation>.Reject(MemoryFailure.UnsupportedCapability);
+        }
+        var retainedSource = source.TryAcquirePeerHold(source.Location);
+        if (!retainedSource.Succeeded)
+        {
+            return MemoryOperationResult<GpuPeerDeviceOperation>.Reject(retainedSource.Failure!.Value);
+        }
+        IGpuPeerAllocationHold sourceHold = retainedSource.Value!;
+        GpuAllocationHold destinationHold;
+        MemoryReservation reservation;
+        GpuPeerDeviceOperation operation;
+        bool custodyTransferred = false;
+        try
+        {
+            lock (_gate)
+            {
+                if (!_accepting || !IsCurrentLocked(destination) || destination.Retiring
+                    || destination.UploadSubmitted || destination.Holds != 0)
+                {
+                    return MemoryOperationResult<GpuPeerDeviceOperation>.Reject(MemoryFailure.StaleLocation);
+                }
+                if (_operations.Count + _peerOperations.Count + _externalHolds >= _limits.MaximumOperations)
+                {
+                    return MemoryOperationResult<GpuPeerDeviceOperation>.Reject(MemoryFailure.BudgetRejected);
+                }
+                MemoryResourceCharge[] vector = source.TransferDomain == _domains.TransferSlots
+                    ? [new(_domains.TransferSlots, MemoryResourceUnit.OperationSlots, 1)]
+                    : [new(_domains.TransferSlots, MemoryResourceUnit.OperationSlots, 1), new(source.TransferDomain, MemoryResourceUnit.OperationSlots, 1)];
+                var admission = _ledger.TryReserve(vector);
+                if (!admission.Succeeded)
+                {
+                    return MemoryOperationResult<GpuPeerDeviceOperation>.Reject(admission.Failure!.Value);
+                }
+                reservation = admission.Value!;
+                destination.Holds++;
+                destination.UploadSubmitted = true;
+                destinationHold = new GpuAllocationHold(this, destination, GpuPeerAllocationAccess.ExclusiveWrite);
+                operation = new GpuPeerDeviceOperation(source, destination);
+                _peerOperations.Add(operation);
+            }
+            // Never hold one device gate while checking or invoking the other device owner.
+            try
+            {
+                custodyTransferred = true;
+                GpuPeerTransfer transfer = GpuPeerTransfer.Submit(sourceSession, destinationSession,
+                    sourceHold, destinationHold, destination.Length, reservation);
+                bool quarantined = transfer.IsQuarantined;
+                if (quarantined)
+                {
+                    source.InvalidateOwner();
+                }
+                lock (_gate)
+                {
+                    operation.Transfer = transfer;
+                    operation.Quarantined = quarantined;
+                    if (quarantined)
+                    {
+                        FaultLocked();
+                        operation.Finish(MemoryFailure.DeviceLost);
+                    }
+                }
+                return MemoryOperationResult<GpuPeerDeviceOperation>.Success(operation);
+            }
+            catch
+            {
+                // Pre-submit validation released all supplied holds and the reservation.
+                lock (_gate)
+                {
+                    _peerOperations.Remove(operation);
+                    destination.UploadSubmitted = false;
+                    DrainLocked();
+                }
+                throw;
+            }
+        }
+        finally
+        {
+            if (!custodyTransferred)
+            {
+                sourceHold.Dispose();
+            }
+        }
+    }
+
+    public MemoryOperationResult<GpuTransferOperation> TryReadback(GpuAllocation source, MemoryLocationToken expectedSource)
+    {
+        ArgumentNullException.ThrowIfNull(source);
+        return Submit(source, expectedSource, null, readback: true);
+    }
+
+    private MemoryOperationResult<GpuTransferOperation> Submit(GpuAllocation allocation,
+        MemoryLocationToken expected, IMemoryHostReadLease? source, bool readback)
+    {
+        lock (_gate)
+        {
+            if (!_accepting || !IsCurrentLocked(allocation) || allocation.Location != expected || allocation.Retiring
+                || (readback ? !allocation.Initialized : allocation.UploadSubmitted))
+            {
+                return MemoryOperationResult<GpuTransferOperation>.Reject(MemoryFailure.StaleLocation);
+            }
+            if (_operations.Count + _peerOperations.Count + _externalHolds >= _limits.MaximumOperations)
+            {
+                return MemoryOperationResult<GpuTransferOperation>.Reject(MemoryFailure.BudgetRejected);
+            }
+            var planned = MemoryAllocationLayout.TryPlan(allocation.Length, 1, _limits.StagingAlignmentBytes,
+                _limits.MaximumAllocationBytes);
+            if (!planned.Succeeded || allocation.Length > int.MaxValue)
+            {
+                return MemoryOperationResult<GpuTransferOperation>.Reject(MemoryFailure.BoundsViolation);
+            }
+            long capacity = planned.Value!.CapacityBytes;
+            GpuStagingBuffer? staging = _staging.FirstOrDefault(buffer => !buffer.Busy
+                && buffer.RequestedCapacity == capacity && buffer.Readback == readback);
+            if (staging is null && _staging.Count >= _limits.MaximumStagingBuffers)
+            {
+                return MemoryOperationResult<GpuTransferOperation>.Reject(MemoryFailure.BudgetRejected);
+            }
+            // New staging bytes and transfer slots are one all-or-nothing vector. Existing
+            // staging is already charged; its pool retention never fabricates free headroom.
+            long admittedCapacity = _driver is IGpuMetalAllocationObservation
+                ? _limits.MaximumObservedStagingCapacityBytes!.Value : capacity;
+            MemoryResourceCharge[] vector = staging is null
+                ? [new(_domains.RegisteredHost, MemoryResourceUnit.Bytes, admittedCapacity), new(_domains.TransferSlots, MemoryResourceUnit.OperationSlots, 1)]
+                : [new(_domains.TransferSlots, MemoryResourceUnit.OperationSlots, 1)];
+            var admission = _ledger.TryReserve(vector);
+            if (!admission.Succeeded)
+            {
+                return MemoryOperationResult<GpuTransferOperation>.Reject(admission.Failure!.Value);
+            }
+            var reservation = admission.Value!;
+            bool newlyAllocated = staging is null;
+            if (staging is null)
+            {
+                GpuHostAddress address;
+                try
+                {
+                    address = _driver.AllocateHost(capacity, readback);
+                }
+                catch (GpuAllocationRejectedException)
+                {
+                    reservation.Dispose();
+                    return MemoryOperationResult<GpuTransferOperation>.Reject(MemoryFailure.BudgetRejected);
+                }
+                catch
+                {
+                    _uncertainReservations.Add(reservation);
+                    FaultLocked();
+                    return MemoryOperationResult<GpuTransferOperation>.Reject(MemoryFailure.DeviceLost);
+                }
+                MemoryOperationResult<MemoryAllocationLayout> layout;
+                try
+                {
+                    ulong? observed = _driver is IGpuMetalAllocationObservation observer
+                        ? observer.ObservedHostCapacity(address) : (ulong)capacity;
+                    layout = ObservedLayout(allocation.Length, observed, _limits.StagingAlignmentBytes);
+                }
+                catch (Exception exception)
+                {
+                    RejectUnpublishedHostLocked(new(address, capacity, null, readback), reservation, exception);
+                    return MemoryOperationResult<GpuTransferOperation>.Reject(MemoryFailure.DeviceLost);
+                }
+                staging = new(address, capacity, layout.Value, readback);
+                if (!layout.Succeeded || layout.Value!.CapacityBytes > admittedCapacity)
+                {
+                    RejectUnpublishedHostLocked(staging, reservation);
+                    return MemoryOperationResult<GpuTransferOperation>.Reject(layout.Failure ?? MemoryFailure.BudgetRejected);
+                }
+                _staging.Add(staging);
+            }
+            // This reservation remains an operation owner; on completion its staging
+            // bytes are converted to a retained physical charge before returning to pool.
+            var operation = new GpuTransferOperation(this, allocation, staging, source, reservation, newlyAllocated, readback);
+            staging.Busy = true;
+            allocation.Holds++;
+            _operations.Add(operation);
+            try
+            {
+                if (source is not null)
+                {
+                    _driver.WriteHost(staging.Address, source.Memory.Span);
+                }
+            }
+            catch
+            {
+                // No driver submission was attempted; cleanup is safe only if native free succeeds.
+                operation.Source = null;
+                CompleteLocked(operation, MemoryFailure.OwnershipViolation);
+                FaultLocked();
+                throw;
+            }
+            try
+            {
+                allocation.UploadSubmitted |= !readback;
+                operation.Submission = readback
+                    ? _driver.SubmitReadback(allocation.Address, staging.Address, allocation.Length)
+                    : _driver.SubmitUpload(staging.Address, allocation.Address, allocation.Length);
+                operation.Submitted = true;
+            }
+            catch
+            {
+                // Submission can fail after DMA entered the driver. Keep every owner and
+                // reject new work; no unbounded retries/new epochs are allowed here.
+                operation.Quarantined = true;
+                FaultLocked();
+                operation.Finish(MemoryFailure.DeviceLost);
+            }
+            return MemoryOperationResult<GpuTransferOperation>.Success(operation);
+        }
+    }
+
+    private void RejectUnpublishedHostLocked(GpuStagingBuffer staging, IMemoryReservation reservation, Exception? cause = null)
+    {
+        try
+        {
+            _driver.FreeHost(staging.Address);
+            reservation.Dispose();
+        }
+        catch (Exception exception)
+        {
+            staging.Busy = true;
+            _staging.Add(staging);
+            _uncertainReservations.Add(reservation);
+            FaultLocked(cause ?? exception);
+        }
+        if (cause is not null)
+        {
+            FaultLocked(cause);
+        }
+    }
+
+    /// <summary>Bounded synchronous poll; the common scheduler owns cadence and recovery.</summary>
+    public void PollCompletions()
+    {
+        lock (_gate)
+        {
+            foreach (GpuTransferOperation operation in _operations.ToArray())
+            {
+                if (!operation.Submitted || operation.DriverComplete)
+                {
+                    continue;
+                }
+                GpuCompletion completion;
+                try
+                {
+                    completion = _driver.Query(operation.Submission);
+                }
+                catch
+                {
+                    completion = GpuCompletion.Uncertain;
+                }
+                if (completion == GpuCompletion.Pending)
+                {
+                    continue;
+                }
+                if (completion == GpuCompletion.Uncertain)
+                {
+                    operation.Quarantined = true;
+                    FaultLocked();
+                    operation.Finish(MemoryFailure.DeviceLost);
+                    continue;
+                }
+                operation.DriverComplete = true;
+                try
+                {
+                    _driver.ReleaseSubmission(operation.Submission);
+                }
+                catch
+                {
+                    operation.Quarantined = true;
+                    FaultLocked();
+                    operation.Finish(MemoryFailure.DeviceLost);
+                    continue;
+                }
+                if (!operation.Readback || operation.ReleaseRequested || !IsCurrentLocked(operation.Allocation))
+                {
+                    if (!operation.Readback && IsCurrentLocked(operation.Allocation))
+                    {
+                        operation.Allocation.Initialized = true;
+                    }
+                    CompleteLocked(operation, IsCurrentLocked(operation.Allocation) ? null : MemoryFailure.DeviceLost);
+                }
+                else
+                {
+                    // The readback consumer retains staging and its slot until explicit disposal.
+                    operation.Finish(null);
+                }
+            }
+            DrainLocked();
+        }
+        GpuPeerDeviceOperation[] peers;
+        lock (_gate)
+        {
+            peers = _peerOperations.ToArray();
+        }
+        foreach (GpuPeerDeviceOperation operation in peers)
+        {
+            GpuPeerTransfer? transfer;
+            lock (_gate)
+            {
+                transfer = operation.Transfer;
+            }
+            if (transfer is null)
+            {
+                continue;
+            }
+            var completion = transfer.Poll();
+            if (completion.Failure == MemoryFailure.TierUnavailable)
+            {
+                continue;
+            }
+            bool quarantined = transfer.IsQuarantined;
+            if (quarantined)
+            {
+                operation.Source.InvalidateOwner();
+            }
+            lock (_gate)
+            {
+                if (!_peerOperations.Contains(operation))
+                {
+                    continue;
+                }
+                if (quarantined)
+                {
+                    operation.Quarantined = true;
+                    FaultLocked();
+                    operation.Finish(MemoryFailure.DeviceLost);
+                    continue;
+                }
+                bool current = IsCurrentLocked(operation.Destination);
+                operation.Destination.Initialized = completion.Succeeded && current;
+                _peerOperations.Remove(operation);
+                operation.Finish(completion.Succeeded && !current ? MemoryFailure.StaleLocation : completion.Failure);
+                DrainLocked();
+            }
+        }
+    }
+
+    public void InvalidateEpoch()
+    {
+        lock (_gate)
+        {
+            FaultLocked();
+            foreach (GpuPeerDeviceOperation operation in _peerOperations)
+            {
+                operation.Quarantined = true;
+                operation.Finish(MemoryFailure.DeviceLost);
+            }
+            foreach (GpuTransferOperation operation in _operations)
+            {
+                operation.Quarantined = !operation.DriverComplete;
+                operation.Finish(MemoryFailure.DeviceLost);
+            }
+        }
+    }
+
+    internal bool IsCurrent(GpuAllocation allocation)
+    {
+        lock (_gate)
+        {
+            return IsCurrentLocked(allocation);
+        }
+    }
+
+    internal bool CanSubmit(GpuAllocation allocation)
+    {
+        lock (_gate)
+        {
+            return _accepting && !allocation.Retiring && IsCurrentLocked(allocation);
+        }
+    }
+
+    private bool IsCurrentLocked(GpuAllocation allocation)
+        => !_faulted && !_disposed && allocation.Location.Epoch == _epoch && _allocations.Contains(allocation);
+
+    private void FaultLocked(Exception? cause = null)
+    {
+        if (!_faulted)
+        {
+            // Never wrap an exhausted epoch into a potentially valid old identity.
+            if (_epoch.Value < ulong.MaxValue)
+            {
+                _epoch = new(_epoch.Value + 1);
+            }
+            _faulted = true;
+            _accepting = false;
+            _drainFailure = cause;
+        }
+        FailDrainLocked();
+    }
+
+    private void FailDrainLocked()
+    {
+        if (_disposeRequested && _faulted && !_drained.Task.IsCompleted)
+        {
+            _drained.TrySetException(new InvalidOperationException(
+                "GPU resource drain is unproven after an ownership or driver fault; uncertain custody remains retained.", _drainFailure));
+        }
+    }
+
+    internal void Retire(GpuAllocation allocation)
+    {
+        lock (_gate)
+        {
+            allocation.Retiring = true;
+            DrainLocked();
+        }
+    }
+
+    internal MemoryOperationResult<IGpuPeerAllocationHold> TryRetain(GpuAllocation allocation, MemoryLocationToken expected)
+    {
+        lock (_gate)
+        {
+            if (!_accepting || !IsCurrentLocked(allocation) || allocation.Retiring || !allocation.Initialized || allocation.Location != expected)
+            {
+                return MemoryOperationResult<IGpuPeerAllocationHold>.Reject(MemoryFailure.StaleLocation);
+            }
+            if (allocation.Holds >= _limits.MaximumOperations
+                || _operations.Count + _peerOperations.Count + _externalHolds >= _limits.MaximumOperations)
+            {
+                return MemoryOperationResult<IGpuPeerAllocationHold>.Reject(MemoryFailure.BudgetRejected);
+            }
+            allocation.Holds++;
+            _externalHolds++;
+            return MemoryOperationResult<IGpuPeerAllocationHold>.Success(new GpuAllocationHold(this, allocation, GpuPeerAllocationAccess.Read));
+        }
+    }
+
+    internal void ReleaseHold(GpuAllocation allocation, bool external)
+    {
+        lock (_gate)
+        {
+            allocation.Holds--;
+            if (external)
+            {
+                _externalHolds--;
+            }
+            DrainLocked();
+        }
+    }
+
+    internal void CopyReadback(GpuTransferOperation operation, Span<byte> destination)
+    {
+        lock (_gate)
+        {
+            if (!_operations.Contains(operation) || !operation.Readback || !operation.DriverComplete
+                || operation.Quarantined || operation.ReleaseRequested || !IsCurrentLocked(operation.Allocation))
+            {
+                throw new InvalidOperationException("Readback requires current completed operation custody.");
+            }
+            if (destination.Length != operation.Allocation.Length)
+            {
+                throw new ArgumentException("The complete payload must be delivered to its admitted response owner.", nameof(destination));
+            }
+            try
+            {
+                _driver.ReadHost(operation.Staging.Address, destination);
+            }
+            catch
+            {
+                operation.Quarantined = true;
+                FaultLocked();
+                throw;
+            }
+        }
+    }
+
+    internal void ReleaseOperation(GpuTransferOperation operation)
+    {
+        lock (_gate)
+        {
+            operation.ReleaseRequested = true;
+            if (operation.DriverComplete && !operation.Quarantined && _operations.Contains(operation))
+            {
+                CompleteLocked(operation, IsCurrentLocked(operation.Allocation) ? null : MemoryFailure.DeviceLost);
+                DrainLocked();
+            }
+        }
+    }
+
+    private void CompleteLocked(GpuTransferOperation operation, MemoryFailure? failure)
+    {
+        if (operation.NewStaging)
+        {
+            var vector = new MemoryResourceCharge[] { new(_domains.RegisteredHost, MemoryResourceUnit.Bytes, operation.Staging.Capacity) };
+            var descriptor = new MemoryAllocationDescriptor(new(Guid.NewGuid()), _domains.RegisteredHost,
+                operation.Staging.Layout!);
+            var conversion = operation.Reservation.CommitPhysical(descriptor, vector);
+            if (!conversion.Succeeded)
+            {
+                operation.Quarantined = true;
+                FaultLocked();
+                operation.Finish(conversion.Failure);
+                return;
+            }
+            operation.Staging.Charge = conversion.Value;
+        }
+        else
+        {
+            operation.Reservation.Dispose();
+        }
+        try
+        {
+            operation.Source?.Dispose();
+        }
+        catch (Exception exception)
+        {
+            // Completion proves DMA stopped, but a failed source-owner release does not prove its custody drained.
+            operation.CleanupFailure = exception;
+            operation.Quarantined = true;
+            FaultLocked(exception);
+            operation.Finish(failure ?? MemoryFailure.OwnershipViolation);
+            return;
+        }
+        operation.Staging.Busy = false;
+        operation.Allocation.Holds--;
+        _operations.Remove(operation);
+        operation.Finish(failure);
+    }
+
+    private void DrainLocked()
+    {
+        FailDrainLocked();
+        foreach (GpuAllocation allocation in _allocations.Where(value => value.Retiring && value.Holds == 0).ToArray())
+        {
+            // A faulted context has no proof that driver resources are safe to free.
+            if (_faulted)
+            {
+                break;
+            }
+            try
+            {
+                _driver.FreeDevice(allocation.Address);
+                allocation.Charge?.Dispose();
+                allocation.Unconverted?.Dispose();
+                _allocations.Remove(allocation);
+            }
+            catch
+            {
+                FaultLocked();
+                break;
+            }
+        }
+        if (!_accepting && !_faulted)
+        {
+            foreach (GpuStagingBuffer buffer in _staging.Where(value => !value.Busy).ToArray())
+            {
+                try
+                {
+                    _driver.FreeHost(buffer.Address);
+                    buffer.Charge!.Dispose();
+                    _staging.Remove(buffer);
+                }
+                catch
+                {
+                    FaultLocked();
+                    break;
+                }
+            }
+            if (!_faulted && _operations.Count == 0 && _peerOperations.Count == 0 && _externalHolds == 0
+                && _allocations.Count == 0 && _staging.Count == 0 && _uncertainReservations.Count == 0 && !_disposed)
+            {
+                try
+                {
+                    _driver.Dispose();
+                    _disposed = true;
+                    _drained.TrySetResult();
+                }
+                catch
+                {
+                    // Context teardown may have partly completed; never guess it is retry-safe.
+                    FaultLocked();
+                }
+            }
+        }
+    }
+
+    /// <summary>Stop new use and drain confirmed work; faulted resources require the declared controlled restart owner.</summary>
+    public void Dispose()
+    {
+        lock (_gate)
+        {
+            _disposeRequested = true;
+            _accepting = false;
+            foreach (GpuAllocation allocation in _allocations)
+            {
+                allocation.Retiring = true;
+            }
+            foreach (GpuTransferOperation operation in _operations.ToArray())
+            {
+                operation.ReleaseRequested = true;
+                if (operation.DriverComplete && !operation.Quarantined)
+                {
+                    CompleteLocked(operation, IsCurrentLocked(operation.Allocation) ? null : MemoryFailure.DeviceLost);
+                }
+            }
+            DrainLocked();
+        }
+    }
+}
+
+internal sealed class GpuStagingBuffer(GpuHostAddress address, long requestedCapacity, MemoryAllocationLayout? layout, bool readback)
+{
+    public GpuHostAddress Address { get; } = address;
+    public long RequestedCapacity { get; } = requestedCapacity;
+    public MemoryAllocationLayout? Layout { get; } = layout;
+    public long Capacity => Layout?.CapacityBytes ?? throw new InvalidOperationException("Staging capacity is unverified.");
+    public bool Readback { get; } = readback;
+    public bool Busy
+    {
+        get; set;
+    }
+    public IMemoryAllocationCharge? Charge
+    {
+        get; set;
+    }
+}
diff --git a/src/backend/Infrastructure/Memory/Devices/GpuPeerCapabilities.cs b/src/backend/Infrastructure/Memory/Devices/GpuPeerCapabilities.cs
new file mode 100644
index 000000000..b6973d087
--- /dev/null
+++ b/src/backend/Infrastructure/Memory/Devices/GpuPeerCapabilities.cs
@@ -0,0 +1,78 @@
+using FsusBlog.Server.Infrastructure.Memory.Capabilities;
+
+namespace FsusBlog.Server.Infrastructure.Memory.Devices;
+
+public enum GpuMappingCoherency
+{
+    Unknown,
+    DriverSynchronized,
+    Coherent
+}
+
+/// <summary>Reporting a large aperture never proves that an allocation is CPU mappable.</summary>
+public sealed record GpuPeerCapabilityFacts(
+    MemoryDetection LargeBar,
+    MemoryDetection AllocationCpuMapping,
+    GpuMappingCoherency Coherency,
+    MemoryDetection PeerTransfer,
+    int ApiVersion,
+    string MappingReason)
+{
+    public static GpuPeerCapabilityFacts ClassicDeviceAllocation(int apiVersion, MemoryDetection peerTransfer)
+        => new(MemoryDetection.Unknown, MemoryDetection.Unsupported, GpuMappingCoherency.Unknown,
+            peerTransfer, apiVersion,
+            "The classic device-allocation API provides no supported CPU mapping; use admitted DMA staging.");
+}
+
+public enum GpuPeerPath
+{
+    DmaStaging,
+    MappedDeviceRead,
+    PeerTransfer,
+    RequirementFailed
+}
+
+public sealed record GpuPeerPathDecision(GpuPeerPath Path, string Reason);
+
+/// <summary>Consumes the owning capability authority's qualifications and frozen workload result.</summary>
+public static class GpuPeerPathSelection
+{
+    public static bool ShouldProbe(MemoryCapabilityMode mode)
+        => MemoryCapabilityPolicy.Validate(mode) != MemoryCapabilityMode.Disabled;
+
+    public static GpuPeerPathDecision Select(
+        MemoryCapabilityStatus status,
+        GpuPeerCapabilityFacts facts,
+        GpuPeerPath candidate,
+        MemoryQualification workloadQualification,
+        MemoryAdmission operationAdmission,
+        string workloadReason)
+    {
+        ArgumentNullException.ThrowIfNull(status);
+        ArgumentNullException.ThrowIfNull(facts);
+        MemoryCapabilityPolicy.Validate(status.Requested);
+        if (candidate is not (GpuPeerPath.MappedDeviceRead or GpuPeerPath.PeerTransfer))
+        {
+            throw new ArgumentOutOfRangeException(nameof(candidate));
+        }
+        if (!Enum.IsDefined(workloadQualification) || !Enum.IsDefined(operationAdmission))
+        {
+            throw new ArgumentException("Qualification and admission must be defined contract values.");
+        }
+        string? reason = status.Requested == MemoryCapabilityMode.Disabled ? "Capability disabled."
+            : facts.ApiVersion <= 0 ? "Driver API version is not verified."
+            : candidate == GpuPeerPath.MappedDeviceRead && facts.AllocationCpuMapping != MemoryDetection.Present ? facts.MappingReason
+            : candidate == GpuPeerPath.MappedDeviceRead && facts.Coherency is not (GpuMappingCoherency.DriverSynchronized or GpuMappingCoherency.Coherent) ? "Mapped allocation coherency is not verified."
+            : candidate == GpuPeerPath.PeerTransfer && facts.PeerTransfer != MemoryDetection.Present ? "Peer support is " + facts.PeerTransfer + "."
+            : status.Detection != MemoryDetection.Present ? status.Reason
+            : status.ReleaseQualification != MemoryQualification.Qualified ? "Release qualification is " + status.ReleaseQualification + ". " + status.Reason
+            : status.RuntimeQualification != MemoryQualification.Qualified ? "Runtime qualification is " + status.RuntimeQualification + ". " + status.Reason
+            : status.OnlineState != MemoryOnlineState.Online ? "Capability is " + status.OnlineState + ". " + status.Reason
+            : workloadQualification != MemoryQualification.Qualified ? "Workload qualification is " + workloadQualification + ". " + workloadReason
+            : operationAdmission != MemoryAdmission.Admitted ? "Operation admission is " + operationAdmission + "."
+            : null;
+        return reason is null
+            ? new(candidate, "Qualified workload and admitted operation.")
+            : new(status.Requested == MemoryCapabilityMode.Required ? GpuPeerPath.RequirementFailed : GpuPeerPath.DmaStaging, reason);
+    }
+}
diff --git a/src/backend/Infrastructure/Memory/Devices/GpuPeerDeviceOperation.cs b/src/backend/Infrastructure/Memory/Devices/GpuPeerDeviceOperation.cs
new file mode 100644
index 000000000..8dc7edd21
--- /dev/null
+++ b/src/backend/Infrastructure/Memory/Devices/GpuPeerDeviceOperation.cs
@@ -0,0 +1,40 @@
+using FsusBlog.Server.Infrastructure.Memory.Contracts;
+
+namespace FsusBlog.Server.Infrastructure.Memory.Devices;
+
+/// <summary>The device registry retains this operation even when the caller cancels or drops its wait.</summary>
+public sealed class GpuPeerDeviceOperation : IDisposable
+{
+    private readonly TaskCompletionSource<MemoryOperationResult<GpuPeerDeviceOperation>> _completion = new(TaskCreationOptions.RunContinuationsAsynchronously);
+    internal GpuPeerDeviceOperation(GpuAllocation source, GpuAllocation destination)
+    {
+        Source = source;
+        Destination = destination;
+    }
+    internal GpuAllocation Source
+    {
+        get;
+    }
+    internal GpuAllocation Destination
+    {
+        get;
+    }
+    internal bool Quarantined
+    {
+        get; set;
+    }
+    internal GpuPeerTransfer? Transfer
+    {
+        get; set;
+    }
+    public Task<MemoryOperationResult<GpuPeerDeviceOperation>> WaitAsync(CancellationToken cancellationToken = default)
+        => _completion.Task.WaitAsync(cancellationToken);
+    internal void Finish(MemoryFailure? failure)
+        => _completion.TrySetResult(failure is null
+            ? MemoryOperationResult<GpuPeerDeviceOperation>.Success(this)
+            : MemoryOperationResult<GpuPeerDeviceOperation>.Reject(failure.Value));
+    // Only the owning registry polls and drains the native operation.
+    public void Dispose()
+    {
+    }
+}
diff --git a/src/backend/Infrastructure/Memory/Devices/GpuPeerMapping.cs b/src/backend/Infrastructure/Memory/Devices/GpuPeerMapping.cs
new file mode 100644
index 000000000..b13cc4081
--- /dev/null
+++ b/src/backend/Infrastructure/Memory/Devices/GpuPeerMapping.cs
@@ -0,0 +1,333 @@
+using FsusBlog.Server.Infrastructure.Memory.Contracts;
+
+namespace FsusBlog.Server.Infrastructure.Memory.Devices;
+
+/// <summary>Opaque driver mapping identity. It has no CPU pointer conversion.</summary>
+public readonly record struct GpuDriverMapping(ulong Token);
+
+public enum GpuMappedAccess
+{
+    ReadOnly
+}
+
+public sealed record GpuMappingSynchronization(
+    string DriverApi,
+    int ApiVersion,
+    MemoryLocationToken Location,
+    ulong Sequence,
+    bool Completed);
+
+/// <summary>A version-bound supported driver API; reads must obey its mapped access/coherency rules.</summary>
+public interface IGpuMappedDriverApi
+{
+    IGpuDriverSession Session
+    {
+        get;
+    }
+    string DriverApi
+    {
+        get;
+    }
+    int ApiVersion
+    {
+        get;
+    }
+    GpuMappingCoherency Coherency
+    {
+        get;
+    }
+    GpuDriverMapping Map(IGpuPeerAllocationHold allocation, long offset, long length);
+    GpuMappingSynchronization SynchronizeForRead(GpuDriverMapping mapping, MemoryLocationToken location);
+    void Read(GpuDriverMapping mapping, long relativeOffset, Span<byte> destination);
+    void Unmap(GpuDriverMapping mapping);
+}
+
+/// <summary>Explicit mapped-device reads retain the allocation/epoch until the final consumer drains.</summary>
+public sealed class GpuMappedReadLease : IDisposable
+{
+    private readonly object _gate = new();
+    private readonly IGpuMappedDriverApi _driver;
+    private readonly IGpuPeerAllocationHold _allocation;
+    private GpuDriverMapping _mapping;
+    private int _consumers;
+    private bool _draining;
+    private bool _released;
+    private bool _quarantined;
+    private ulong _lastSynchronization;
+
+    private GpuMappedReadLease(IGpuMappedDriverApi driver, IGpuPeerAllocationHold allocation, long offset, long length,
+        int maximumConsumers)
+    {
+        _driver = driver;
+        _allocation = allocation;
+        Offset = offset;
+        Length = length;
+        MaximumConsumers = maximumConsumers;
+        Location = allocation.Location;
+        DriverApi = driver.DriverApi;
+        ApiVersion = driver.ApiVersion;
+        Coherency = driver.Coherency;
+        DeviceIdentity = allocation.Session.Identity;
+    }
+
+    public MemoryLocationToken Location
+    {
+        get;
+    }
+    public long Offset
+    {
+        get;
+    }
+    public long Length
+    {
+        get;
+    }
+    public int MaximumConsumers
+    {
+        get;
+    }
+    public GpuMappedAccess Access => GpuMappedAccess.ReadOnly;
+    public string DriverApi
+    {
+        get;
+    }
+    public int ApiVersion
+    {
+        get;
+    }
+    public GpuMappingCoherency Coherency
+    {
+        get;
+    }
+    public GpuDeviceIdentity DeviceIdentity
+    {
+        get;
+    }
+    public bool IsQuarantined
+    {
+        get
+        {
+            lock (_gate)
+            {
+                return _quarantined;
+            }
+        }
+    }
+    public Exception? DriverFailure
+    {
+        get; private set;
+    }
+    public GpuMappingSynchronization? Synchronization
+    {
+        get; private set;
+    }
+
+    /// <summary>Transfers the allocation hold. A possibly submitted failed map retains it in quarantine.</summary>
+    public static GpuMappedReadLease Map(IGpuMappedDriverApi driver, IGpuPeerAllocationHold allocation,
+        long offset, long length, int maximumConsumers)
+    {
+        ArgumentNullException.ThrowIfNull(driver);
+        ArgumentNullException.ThrowIfNull(allocation);
+        try
+        {
+            allocation.Location.Validate();
+            allocation.Content.Validate();
+            if (allocation.Access != GpuPeerAllocationAccess.Read)
+            {
+                throw new InvalidOperationException("Mapped reads require a readable allocation hold.");
+            }
+            if (!allocation.IsCurrent)
+            {
+                throw new InvalidOperationException("Mapping allocation epoch/location is stale.");
+            }
+            if (!allocation.CanSubmit)
+            {
+                throw new InvalidOperationException("Mapping allocation owner has stopped new submissions.");
+            }
+            if (!ReferenceEquals(driver.Session, allocation.Session)
+                || driver.ApiVersion <= 0 || driver.ApiVersion != allocation.Session.Identity.ApiVersion
+                || string.IsNullOrWhiteSpace(driver.DriverApi))
+            {
+                throw new InvalidOperationException("Mapping API version does not match the allocation session.");
+            }
+            if (driver.Coherency is not (GpuMappingCoherency.DriverSynchronized or GpuMappingCoherency.Coherent))
+            {
+                throw new InvalidOperationException("Mapping coherency is not known.");
+            }
+            if (offset < 0 || length <= 0 || offset > allocation.Length || length > allocation.Length - offset)
+            {
+                throw new ArgumentOutOfRangeException(nameof(length));
+            }
+            if (maximumConsumers <= 0)
+            {
+                throw new ArgumentOutOfRangeException(nameof(maximumConsumers));
+            }
+        }
+        catch
+        {
+            allocation.Dispose();
+            throw;
+        }
+        var lease = new GpuMappedReadLease(driver, allocation, offset, length, maximumConsumers);
+        try
+        {
+            lease._mapping = driver.Map(allocation, offset, length);
+            if (lease._mapping.Token == 0)
+            {
+                throw new InvalidOperationException("Driver mapping identity is invalid.");
+            }
+        }
+        catch (Exception exception)
+        {
+            lease._quarantined = true;
+            lease.DriverFailure = exception;
+        }
+        return lease;
+    }
+
+    public MemoryOperationResult<GpuMappedReadConsumer> TryAcquireConsumer()
+    {
+        lock (_gate)
+        {
+            if (_quarantined)
+            {
+                return MemoryOperationResult<GpuMappedReadConsumer>.Reject(MemoryFailure.DeviceLost);
+            }
+            if (!IsCurrent())
+            {
+                return MemoryOperationResult<GpuMappedReadConsumer>.Reject(MemoryFailure.StaleLocation);
+            }
+            if (_draining || _released || !_allocation.CanSubmit)
+            {
+                return MemoryOperationResult<GpuMappedReadConsumer>.Reject(MemoryFailure.TierUnavailable);
+            }
+            if (_consumers >= MaximumConsumers)
+            {
+                return MemoryOperationResult<GpuMappedReadConsumer>.Reject(MemoryFailure.BudgetRejected);
+            }
+            checked
+            {
+                _consumers++;
+            }
+            return MemoryOperationResult<GpuMappedReadConsumer>.Success(new(this));
+        }
+    }
+
+    internal MemoryFailure? Read(GpuMappedReadConsumer consumer, long relativeOffset, Span<byte> destination)
+    {
+        lock (_gate)
+        {
+            if (consumer.IsDisposed || _released)
+            {
+                return MemoryFailure.OwnershipViolation;
+            }
+            if (_quarantined)
+            {
+                return MemoryFailure.DeviceLost;
+            }
+            if (!IsCurrent())
+            {
+                return MemoryFailure.StaleLocation;
+            }
+            if (relativeOffset < 0 || relativeOffset > Length || destination.Length > Length - relativeOffset)
+            {
+                return MemoryFailure.BoundsViolation;
+            }
+            try
+            {
+                GpuMappingSynchronization synchronization = _driver.SynchronizeForRead(_mapping, Location);
+                if (synchronization.Location != Location || synchronization.DriverApi != DriverApi
+                    || synchronization.ApiVersion != ApiVersion || !synchronization.Completed
+                    || synchronization.Sequence == 0 || synchronization.Sequence < _lastSynchronization)
+                {
+                    _quarantined = true;
+                    return MemoryFailure.OwnershipViolation;
+                }
+                Synchronization = synchronization;
+                _lastSynchronization = synchronization.Sequence;
+                if (!IsCurrent())
+                {
+                    return MemoryFailure.StaleLocation;
+                }
+                _driver.Read(_mapping, relativeOffset, destination);
+                return IsCurrent() ? null : MemoryFailure.StaleLocation;
+            }
+            catch (Exception exception)
+            {
+                _quarantined = true;
+                DriverFailure = exception;
+                return MemoryFailure.DeviceLost;
+            }
+        }
+    }
+
+    public void Dispose()
+    {
+        lock (_gate)
+        {
+            _draining = true;
+            TryUnmap();
+        }
+    }
+
+    internal void ReleaseConsumer(GpuMappedReadConsumer consumer)
+    {
+        lock (_gate)
+        {
+            if (!consumer.MarkDisposed())
+            {
+                return;
+            }
+            _consumers--;
+            TryUnmap();
+        }
+    }
+
+    private void TryUnmap()
+    {
+        if (!_draining || _consumers != 0 || _released || _quarantined)
+        {
+            return;
+        }
+        try
+        {
+            _driver.Unmap(_mapping);
+        }
+        catch (Exception exception)
+        {
+            _quarantined = true;
+            DriverFailure = exception;
+            return;
+        }
+        _released = true;
+        _allocation.Dispose();
+    }
+
+    private bool IsCurrent()
+        => _allocation.IsCurrent && ReferenceEquals(_driver.Session, _allocation.Session)
+            && _allocation.Session.Identity == DeviceIdentity && _driver.DriverApi == DriverApi
+            && _driver.ApiVersion == ApiVersion && _driver.Coherency == Coherency;
+}
+
+/// <summary>Mapped access remains explicit and exposes neither Memory nor a CPU-dereferenceable address.</summary>
+public sealed class GpuMappedReadConsumer : IDisposable
+{
+    private readonly GpuMappedReadLease _owner;
+    internal bool IsDisposed
+    {
+        get; private set;
+    }
+
+    internal GpuMappedReadConsumer(GpuMappedReadLease owner) => _owner = owner;
+    public MemoryFailure? Read(long relativeOffset, Span<byte> destination) => _owner.Read(this, relativeOffset, destination);
+    public void Dispose() => _owner.ReleaseConsumer(this);
+    internal bool MarkDisposed()
+    {
+        if (IsDisposed)
+        {
+            return false;
+        }
+        IsDisposed = true;
+        return true;
+    }
+}
diff --git a/src/backend/Infrastructure/Memory/Devices/GpuPeerTransfer.cs b/src/backend/Infrastructure/Memory/Devices/GpuPeerTransfer.cs
new file mode 100644
index 000000000..8137f564b
--- /dev/null
+++ b/src/backend/Infrastructure/Memory/Devices/GpuPeerTransfer.cs
@@ -0,0 +1,232 @@
+using FsusBlog.Server.Infrastructure.Memory.Capabilities;
+using FsusBlog.Server.Infrastructure.Memory.Contracts;
+
+namespace FsusBlog.Server.Infrastructure.Memory.Devices;
+
+public enum GpuPeerAllocationAccess
+{
+    Read,
+    ExclusiveWrite
+}
+
+/// <summary>The allocation owner retains the backing, charge and device epoch for this hold.</summary>
+public interface IGpuPeerAllocationHold : IDisposable
+{
+    IGpuDriverSession Session
+    {
+        get;
+    }
+    MemoryContentIdentity Content
+    {
+        get;
+    }
+    GpuPeerAllocationAccess Access
+    {
+        get;
+    }
+    MemoryLocationToken Location
+    {
+        get;
+    }
+    GpuDeviceAddress Address
+    {
+        get;
+    }
+    long Length
+    {
+        get;
+    }
+    bool IsCurrent
+    {
+        get;
+    }
+    /// <summary>The existing owner admits new use separately from retaining valid draining reads.</summary>
+    bool CanSubmit
+    {
+        get;
+    }
+}
+
+/// <summary>Peer copies use the same session and completion owner as ordinary GPU DMA.</summary>
+public interface IGpuPeerDriverSession : IGpuDriverSession
+{
+    MemoryDetection DetectPeerAccess(IGpuPeerDriverSession destination);
+    GpuSubmission SubmitPeerTransfer(GpuDeviceAddress source, IGpuPeerDriverSession destination,
+        GpuDeviceAddress destinationAddress, long bytes);
+}
+
+/// <summary>Transferred owner holds remain retained after cancellation or uncertain native completion.</summary>
+public sealed class GpuPeerTransfer : IDisposable
+{
+    private readonly object _gate = new();
+    private readonly IGpuPeerDriverSession _sourceSession;
+    private readonly IGpuPeerAllocationHold _source;
+    private readonly IGpuPeerAllocationHold _destination;
+    private readonly IDisposable _operationResources;
+    private GpuSubmission _submission;
+    private bool _released;
+    private bool _quarantined;
+    private MemoryFailure? _terminalFailure;
+    public Exception? SubmissionFailure
+    {
+        get; private set;
+    }
+
+    private GpuPeerTransfer(IGpuPeerDriverSession sourceSession, IGpuPeerAllocationHold source,
+        IGpuPeerAllocationHold destination, IDisposable operationResources)
+    {
+        _sourceSession = sourceSession;
+        _source = source;
+        _destination = destination;
+        _operationResources = operationResources;
+    }
+
+    public bool IsQuarantined
+    {
+        get
+        {
+            lock (_gate)
+            {
+                return _quarantined;
+            }
+        }
+    }
+    public bool IsDrained
+    {
+        get
+        {
+            lock (_gate)
+            {
+                return _released;
+            }
+        }
+    }
+
+    /// <summary>Ownership of all holds transfers on invocation, including failed or uncertain submission.</summary>
+    public static GpuPeerTransfer Submit(IGpuPeerDriverSession sourceSession, IGpuPeerDriverSession destinationSession,
+        IGpuPeerAllocationHold source, IGpuPeerAllocationHold destination, long bytes, IDisposable operationResources)
+    {
+        ArgumentNullException.ThrowIfNull(sourceSession);
+        ArgumentNullException.ThrowIfNull(destinationSession);
+        ArgumentNullException.ThrowIfNull(source);
+        ArgumentNullException.ThrowIfNull(destination);
+        ArgumentNullException.ThrowIfNull(operationResources);
+        var transfer = new GpuPeerTransfer(sourceSession, source, destination, operationResources);
+        try
+        {
+            source.Location.Validate();
+            destination.Location.Validate();
+            source.Content.Validate();
+            destination.Content.Validate();
+            if (source.Content != destination.Content || source.Access != GpuPeerAllocationAccess.Read
+                || destination.Access != GpuPeerAllocationAccess.ExclusiveWrite)
+            {
+                throw new InvalidOperationException("Peer transfer requires identical content and a read/exclusive-write owner pair.");
+            }
+            if (!ReferenceEquals(source.Session, sourceSession) || !ReferenceEquals(destination.Session, destinationSession))
+            {
+                throw new InvalidOperationException("Peer allocation belongs to a different driver session.");
+            }
+            if (!source.IsCurrent || !destination.IsCurrent)
+            {
+                throw new InvalidOperationException("Peer allocation epoch/location is stale.");
+            }
+            if (!source.CanSubmit || !destination.CanSubmit)
+            {
+                throw new InvalidOperationException("Peer allocation owner has stopped new submissions.");
+            }
+            if (bytes <= 0 || bytes != source.Length || bytes != destination.Length)
+            {
+                throw new ArgumentOutOfRangeException(nameof(bytes));
+            }
+        }
+        catch
+        {
+            transfer.ReleaseHolds();
+            throw;
+        }
+        try
+        {
+            transfer._submission = sourceSession.SubmitPeerTransfer(source.Address, destinationSession, destination.Address, bytes);
+        }
+        catch (Exception exception)
+        {
+            // A driver may have enqueued a copy before reporting an error. Keep the owner reachable.
+            transfer._quarantined = true;
+            transfer.SubmissionFailure = exception;
+        }
+        return transfer;
+    }
+
+    /// <summary>Polling does not abort DMA. Complete old-epoch results release safely but cannot publish success.</summary>
+    public MemoryOperationResult<GpuPeerTransfer> Poll()
+    {
+        lock (_gate)
+        {
+            if (_quarantined)
+            {
+                return MemoryOperationResult<GpuPeerTransfer>.Reject(MemoryFailure.DeviceLost);
+            }
+            if (_released)
+            {
+                return _terminalFailure is { } failure ? MemoryOperationResult<GpuPeerTransfer>.Reject(failure)
+                    : MemoryOperationResult<GpuPeerTransfer>.Success(this);
+            }
+            GpuCompletion completion;
+            try
+            {
+                completion = _sourceSession.Query(_submission);
+            }
+            catch
+            {
+                _quarantined = true;
+                return MemoryOperationResult<GpuPeerTransfer>.Reject(MemoryFailure.DeviceLost);
+            }
+            if (completion == GpuCompletion.Pending)
+            {
+                return MemoryOperationResult<GpuPeerTransfer>.Reject(MemoryFailure.TierUnavailable);
+            }
+            if (completion != GpuCompletion.Complete)
+            {
+                _quarantined = true;
+                return MemoryOperationResult<GpuPeerTransfer>.Reject(MemoryFailure.DeviceLost);
+            }
+            bool current = _source.IsCurrent && _destination.IsCurrent;
+            try
+            {
+                _sourceSession.ReleaseSubmission(_submission);
+            }
+            catch
+            {
+                _quarantined = true;
+                return MemoryOperationResult<GpuPeerTransfer>.Reject(MemoryFailure.DeviceLost);
+            }
+            _terminalFailure = current ? null : MemoryFailure.StaleLocation;
+            try
+            {
+                ReleaseHolds();
+            }
+            catch (Exception exception)
+            {
+                _quarantined = true;
+                SubmissionFailure = exception;
+                return MemoryOperationResult<GpuPeerTransfer>.Reject(MemoryFailure.DeviceLost);
+            }
+            return _terminalFailure is { } terminalFailure ? MemoryOperationResult<GpuPeerTransfer>.Reject(terminalFailure)
+                : MemoryOperationResult<GpuPeerTransfer>.Success(this);
+        }
+    }
+
+    // Outer cancellation/disposal only asks for a drain check. It never frees submitted resources.
+    public void Dispose() => Poll();
+
+    private void ReleaseHolds()
+    {
+        // Completion or pre-submit rejection proves slot release is safe. Release the vector
+        // before the final allocation holds can finish either device owner's drain task.
+        _operationResources.Dispose();
+        _source.Dispose();
+        _destination.Dispose();
+        _released = true;
+    }
+}
diff --git a/src/backend/Infrastructure/Memory/Devices/GpuTransferOperation.cs b/src/backend/Infrastructure/Memory/Devices/GpuTransferOperation.cs
new file mode 100644
index 000000000..5ec6f6b2c
