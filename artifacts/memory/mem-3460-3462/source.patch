diff --git a/src/backend/Infrastructure/Memory/Platform/GpuMetalDiscovery.cs b/src/backend/Infrastructure/Memory/Platform/GpuMetalDiscovery.cs
new file mode 100644
index 000000000..4e027219c
--- /dev/null
