+                    copyFileSync(path.join(root, input), destination);
+                }
+            }
+            const fixtureOwner = path.join(fixtureRoot, target);
+            mkdirSync(path.dirname(fixtureOwner), { recursive: true });
+            if (variant === 'symlink-owner')
