+            }
+        }
+
+        internal MemoryContentIdentity Content
+        {
+            get;
+        }
+        internal MemoryLocationToken Location
+        {
+            get;
+        }
+        internal int Count
+        {
+            get;
+        }
+
+        internal FlatArtifactIndexEntry[] CopyEntries()
