@@ -0,0 +1,39 @@
+namespace FsusBlog.Server.Infrastructure.Memory.Contracts;
+
+// OWNERSHIP: Content identity survives residency changes; addresses never identify an owner.
+public readonly record struct BlobId(Guid Value);
+public readonly record struct AllocationId(Guid Value);
+public readonly record struct BlockId(Guid Value);
+public readonly record struct ContentGeneration(ulong Value);
+public readonly record struct RepresentationId(Guid Value);
+public readonly record struct ResidencyRevision(ulong Value);
+public readonly record struct DeviceEpoch(ulong Value);
+
+public readonly record struct MemoryContentIdentity(BlobId Blob, ContentGeneration Generation, RepresentationId Representation)
+{
+    public void Validate()
+    {
+        if (Blob.Value == Guid.Empty || Generation.Value == 0 || Representation.Value == Guid.Empty)
+        {
+            throw new ArgumentException("Content identity requires nonempty IDs and a positive generation.");
+        }
+    }
+}
+
+public readonly record struct MemoryLocationToken(AllocationId Allocation, BlockId Block, ResidencyRevision Revision, DeviceEpoch Epoch)
+{
+    public void Validate()
+    {
+        if (Allocation.Value == Guid.Empty || Block.Value == Guid.Empty || Revision.Value == 0 || Epoch.Value == 0)
+        {
+            throw new ArgumentException("Location identity requires nonempty IDs and positive revision/epoch.");
+        }
+    }
+
+    public bool IsCurrent(MemoryLocationToken current)
+    {
+        Validate();
+        current.Validate();
+        return this == current;
+    }
+}
diff --git a/src/backend/Infrastructure/Memory/Contracts/MemoryOperationResult.cs b/src/backend/Infrastructure/Memory/Contracts/MemoryOperationResult.cs
new file mode 100644
index 000000000..a0c4d9c40
--- /dev/null
+++ b/src/backend/Infrastructure/Memory/Contracts/MemoryOperationResult.cs
@@ -0,0 +1,59 @@
+namespace FsusBlog.Server.Infrastructure.Memory.Contracts;
+
+public enum MemoryFailure
+{
+    BudgetRejected,
+    TierUnavailable,
+    UnsupportedCapability,
+    Cancelled,
+    Corruption,
+    DeviceLost,
+    OwnershipViolation,
+    BoundsViolation,
+    StaleLocation
+}
+
+public enum MemoryOwnerDisposition
+{
+    RetainOriginal,
+    RetireFaultedOwner
+}
+
+// CORRECTNESS: Expected admission failures never erase corruption or ownership failures.
+public sealed class MemoryOperationResult<T> where T : class
+{
+    private MemoryOperationResult(T? value, MemoryFailure? failure)
+    {
+        Value = value;
+        Failure = failure;
+    }
+
+    public T? Value
+    {
+        get;
+    }
+    public MemoryFailure? Failure
+    {
+        get;
+    }
+    public bool Succeeded => Failure is null;
+    public bool IsCorrectnessFailure => Failure is MemoryFailure.Corruption or MemoryFailure.OwnershipViolation
+        or MemoryFailure.BoundsViolation or MemoryFailure.StaleLocation;
+    public MemoryOwnerDisposition Disposition => Failure is MemoryFailure.Corruption or MemoryFailure.DeviceLost
+        ? MemoryOwnerDisposition.RetireFaultedOwner : MemoryOwnerDisposition.RetainOriginal;
+
+    public static MemoryOperationResult<T> Success(T value)
+    {
+        ArgumentNullException.ThrowIfNull(value);
+        return new(value, null);
+    }
+
+    public static MemoryOperationResult<T> Reject(MemoryFailure failure)
+    {
+        if (!Enum.IsDefined(failure))
+        {
+            throw new ArgumentOutOfRangeException(nameof(failure));
+        }
+        return new(null, failure);
+    }
+}
diff --git a/src/backend/Infrastructure/Memory/Contracts/MemoryResourceDomain.cs b/src/backend/Infrastructure/Memory/Contracts/MemoryResourceDomain.cs
new file mode 100644
index 000000000..6dd3db5d4
--- /dev/null
+++ b/src/backend/Infrastructure/Memory/Contracts/MemoryResourceDomain.cs
@@ -0,0 +1,136 @@
+namespace FsusBlog.Server.Infrastructure.Memory.Contracts;
+
+public readonly record struct ResourceDomainId(Guid Value);
+public enum MemoryResourceUnit
+{
+    Bytes, OperationSlots, Inodes
+}
+public enum MemoryObservationState
+{
+    Unknown, Available, Denied, Malformed, Stale
+}
+
+public sealed record MemoryResourceDomain(
+    ResourceDomainId Id,
+    string CapacityIdentity,
+    MemoryResourceUnit Unit,
+    ResourceDomainId? ContainingDomain);
+
+// PROVENANCE: Unknown/denied/stale samples carry no fabricated numeric availability.
+public sealed class MemoryResourceObservation
+{
+    public MemoryResourceObservation(ResourceDomainId domain, MemoryResourceUnit unit,
+        MemoryObservationState state, long? value, string source, DateTimeOffset sampledAt)
+    {
+        if (domain.Value == Guid.Empty || !Enum.IsDefined(unit) || !Enum.IsDefined(state)
+            || (state == MemoryObservationState.Available ? value is null or < 0 : value is not null)
+            || string.IsNullOrWhiteSpace(source))
+        {
+            throw new ArgumentException("Invalid resource observation or missing provenance.");
+        }
+        Domain = domain;
+        Unit = unit;
+        State = state;
+        Value = value;
+        Source = source;
+        SampledAt = sampledAt;
+    }
+
+    public ResourceDomainId Domain
+    {
+        get;
+    }
+    public MemoryResourceUnit Unit
+    {
+        get;
+    }
+    public MemoryObservationState State
+    {
+        get;
+    }
+    public long? Value
+    {
+        get;
+    }
+    public string Source
+    {
+        get;
+    }
+    public DateTimeOffset SampledAt
+    {
+        get;
+    }
+}
+
+public sealed class MemoryResourceTopology
+{
+    private readonly Dictionary<ResourceDomainId, MemoryResourceDomain> _domains;
+
+    public MemoryResourceTopology(IEnumerable<MemoryResourceDomain> domains)
+    {
+        ArgumentNullException.ThrowIfNull(domains);
+        _domains = domains.ToDictionary(domain => domain.Id);
+        foreach (MemoryResourceDomain domain in _domains.Values)
+        {
+            if (domain.Id.Value == Guid.Empty || string.IsNullOrWhiteSpace(domain.CapacityIdentity) || !Enum.IsDefined(domain.Unit))
+            {
+                throw new ArgumentException("A domain requires an identity and explicit unit.", nameof(domains));
+            }
+            var visited = new HashSet<ResourceDomainId> { domain.Id };
+            MemoryResourceDomain cursor = domain;
+            while (cursor.ContainingDomain is ResourceDomainId parentId)
+            {
+                if (!_domains.TryGetValue(parentId, out MemoryResourceDomain? parent)
+                    || parent.Unit != domain.Unit || !visited.Add(parentId))
+                {
+                    throw new ArgumentException("Missing, cyclic or unit-incompatible containment.", nameof(domains));
+                }
+                cursor = parent;
+            }
+        }
+        if (_domains.Values.GroupBy(domain => domain.CapacityIdentity, StringComparer.Ordinal)
+            .Any(group => group.Select(domain => domain.Unit).Distinct().Count() != 1))
+        {
+            throw new ArgumentException("Capacity aliases must use the same unit.", nameof(domains));
+        }
+    }
+
+    public int DomainCount => _domains.Count;
+    public MemoryResourceUnit Unit(ResourceDomainId id) => _domains[id].Unit;
+
+    public IEnumerable<MemoryResourceDomain> ConstraintChain(ResourceDomainId id)
+    {
+        MemoryResourceDomain current = _domains[id];
+        while (true)
+        {
+            yield return current;
+            if (current.ContainingDomain is not ResourceDomainId parent)
+            {
+                yield break;
+            }
+            current = _domains[parent];
+        }
+    }
+
+    public string CapacityIdentity(ResourceDomainId id) => _domains[id].CapacityIdentity;
+
+    public bool SharesCapacityOrContainment(ResourceDomainId left, ResourceDomainId right)
+    {
+        MemoryResourceDomain first = _domains[left];
+        MemoryResourceDomain second = _domains[right];
+        return first.CapacityIdentity == second.CapacityIdentity || Contains(first, right) || Contains(second, left);
+    }
+
+    private bool Contains(MemoryResourceDomain child, ResourceDomainId possibleParent)
+    {
+        while (child.ContainingDomain is ResourceDomainId parentId)
+        {
+            if (parentId == possibleParent)
+            {
+                return true;
+            }
+            child = _domains[parentId];
+        }
+        return false;
+    }
+}
diff --git a/src/backend/Infrastructure/Memory/Host/FlatArtifactIndex.cs b/src/backend/Infrastructure/Memory/Host/FlatArtifactIndex.cs
new file mode 100644
index 000000000..b2ea20b5f
--- /dev/null
+++ b/src/backend/Infrastructure/Memory/Host/FlatArtifactIndex.cs
@@ -0,0 +1,549 @@
+using System.Runtime.CompilerServices;
+using System.Runtime.InteropServices;
+using System.Text;
+
+using FsusBlog.Server.Infrastructure.Memory.Accounting;
+using FsusBlog.Server.Infrastructure.Memory.Contracts;
+
+namespace FsusBlog.Server.Infrastructure.Memory.Host;
+
+/// <summary>Process-local public immutable metadata. Payload handles remain owned by their backing.</summary>
+internal readonly record struct FlatArtifactDescriptor(long Id, MemoryContentIdentity Content,
+    MemoryLocationToken PayloadLocation, long PayloadLength)
+{
+    internal bool IsEligible => PayloadLength > 0;
