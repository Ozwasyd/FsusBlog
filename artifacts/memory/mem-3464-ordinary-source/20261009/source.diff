+    {
+        Count = count;
+        Slots = slots;
+        IdOffset = idOffset;
+        RouteOffset = routeOffset;
+        KeyOffset = keyOffset;
+        KeyBytes = keyBytes;
+        Allocation = allocation;
+    }
+
+    internal int Count
