+        for (int probe = 0; probe < _layout.Slots; probe++, slot = (slot + 1) & (_layout.Slots - 1))
+        {
+            FlatArtifactRouteSlot entry = Read<FlatArtifactRouteSlot>(_layout.RouteOffset + slot * FlatArtifactIndexLayout.RouteSlotBytes);
+            if (entry.Record == 0)
