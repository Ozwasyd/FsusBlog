+            }
+        }
+        else if (character === '[')
+        {
+            brackets += 1;
+        }
+        else if (character === ']')
+        {
+            brackets = Math.max(0, brackets - 1);
+        }
+        else if (character === '(')
+        {
+            parentheses += 1;
+        }
+        else if (character === ')')
+        {
+            parentheses = Math.max(0, parentheses - 1);
+        }
+        else if ((character === ';' || character === '{' || character === '}')
+            && angles === 0 && brackets === 0 && parentheses === 0)
+        {
+            return null;
+        }
+    }
+    return null;
+}
