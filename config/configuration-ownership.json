{
    "schema": "fsusblog.configuration-ownership.v1",
    "genericRoot": "config",
    "frameworkRoots": [
        ".config"
    ],
    "rootJsonAllowlist": [
        "global.json"
    ],
    "ownership": [
        {
            "id": "configuration-ownership-registry",
            "owner": "repository-governance",
            "canonicalPath": "config/configuration-ownership.json",
            "pathType": "file"
        },
        {
            "id": "cmake-presets",
            "owner": "native-build-tooling",
            "canonicalPath": "CMakePresets.json",
            "pathType": "file"
        },
        {
            "id": "backend-configuration-contract",
            "owner": "backend-configuration-governance",
            "canonicalPath": "config/application/backend-configuration-contract.json",
            "pathType": "file",
            "exclusiveBasename": true,
            "rejectedPaths": [
                "backend-configuration-contract.json",
                "config/backend-configuration-contract.json"
            ]
        },
        {
            "id": "development-governance",
            "owner": "repository-governance",
            "canonicalPath": "config/development",
            "pathType": "directory",
            "recursive": true
        },
        {
            "id": "public-preview-screenshot-capture",
            "owner": "documentation-visual-evidence",
            "canonicalPath": "config/docs/public-preview-screenshots.json",
            "pathType": "file"
        },
        {
            "id": "observability-slo",
            "owner": "operations-observability",
            "canonicalPath": "config/observability/slo.yml",
            "pathType": "file",
            "rejectedPaths": [
                "config/slo.yml"
            ]
        },
        {
            "id": "app-config-local-tuning-catalog",
            "owner": "backend-performance-governance",
            "canonicalPath": "config/performance/app-config-knob-catalog.v1.json",
            "pathType": "file",
            "exclusiveBasename": true
        },
        {
            "id": "zero-downtime-resource-policy",
            "owner": "operations-deployment",
            "canonicalPath": "config/deployment/zero-downtime-resource-policy.json",
            "pathType": "file",
            "rejectedPaths": [
                "deploy/zero-downtime-resource-policy.json"
            ]
        },
        {
            "id": "moderation-policy-tree",
            "owner": "backend-moderation",
            "canonicalPath": "config/moderation",
            "pathType": "directory",
            "recursive": true,
            "rejectedPaths": [
                "configs/moderation"
            ]
        },
        {
            "id": "mutation-default",
            "owner": "backend-test-governance",
            "canonicalPath": "config/testing/mutation/default.json",
            "pathType": "file",
            "rejectedPaths": [
                "stryker-config.json"
            ]
        },
        {
            "id": "mutation-critical",
            "owner": "backend-test-governance",
            "canonicalPath": "config/testing/mutation/critical.json",
            "pathType": "file",
            "rejectedPaths": [
                "stryker-critical-config.json"
            ]
        },
        {
            "id": "mutation-changed-critical-catalog",
            "owner": "backend-test-governance",
            "canonicalPath": "config/testing/mutation/changed-critical-domains.v1.json",
            "pathType": "file",
            "rejectedPaths": [
                "changed-critical-domains.json",
                "stryker-changed-critical.json"
            ]
        },
        {
            "id": "test-observation-schema",
            "owner": "test-observation-ledger",
            "canonicalPath": "config/schemas/test-observation-artifact.schema.json",
            "pathType": "file"
        },
        {
            "id": "test-matrix-priority-score-schema",
            "owner": "test-matrix-scheduler",
            "canonicalPath": "config/schemas/test-matrix-priority-score.schema.json",
            "pathType": "file"
        },
        {
            "id": "flaky-observation-schema",
            "owner": "flaky-observation-lane",
            "canonicalPath": "config/schemas/flaky-observation-set.schema.json",
            "pathType": "file"
        },
        {
            "id": "flaky-observation-candidates",
            "owner": "flaky-observation-lane",
            "canonicalPath": "config/testing/flaky-observation-candidates.json",
            "pathType": "file"
        },
        {
            "id": "native-test-assets",
            "owner": "native-test-governance",
            "canonicalPath": "config/testing/native-test-assets.json",
            "pathType": "file"
        },
        {
            "id": "test-asset-audit-profile",
            "owner": "test-asset-audit-reconciliation",
            "canonicalPath": "config/testing/test-asset-audit-profile.json",
            "pathType": "file"
        },
        {
            "id": "zk-verification-key-manifests",
            "owner": "backend-zk-security",
            "canonicalPath": "config/zk",
            "pathType": "directory",
            "recursive": true
        },
        {
            "id": "dotnet-local-tools",
            "owner": "dotnet-cli",
            "canonicalPath": ".config/dotnet-tools.json",
            "pathType": "file",
            "exclusiveBasename": true,
            "rejectedPaths": [
                "dotnet-tools.json"
            ]
        },
        {
            "id": "backend-appsettings",
            "owner": "src/backend/FsusBlog.Server.csproj",
            "canonicalPath": "src/backend/appsettings.json",
            "pathType": "file"
        },
        {
            "id": "backend-production-appsettings",
            "owner": "src/backend/FsusBlog.Server.csproj",
            "canonicalPath": "src/backend/appsettings.Production.json",
            "pathType": "file"
        },
        {
            "id": "backend-development-appsettings-example",
            "owner": "src/backend/FsusBlog.Server.csproj",
            "canonicalPath": "src/backend/appsettings.Development.example.json",
            "pathType": "file",
            "exclusiveBasename": true
        },
        {
            "id": "backend-native-launch-profile",
            "owner": "src/backend/FsusBlog.Server.csproj",
            "canonicalPath": "src/backend/Properties/launchSettings.json",
            "pathType": "file",
            "rejectedPaths": [
                "src/backend/FsusBlog.Server/Properties/launchSettings.json"
            ]
        },
        {
            "id": "docker-compose-launch-profile",
            "owner": "ops/docker/docker-compose.dcproj",
            "canonicalPath": "ops/docker/Properties/launchSettings.json",
            "pathType": "file"
        },
        {
            "id": "content-credentials-c2pa",
            "owner": "content-credentials",
            "canonicalPath": "config/content-credentials/c2pa-interop-policy.json",
            "pathType": "file"
        },
        {
            "id": "complexity-baseline",
            "owner": "repository-governance",
            "canonicalPath": "config/governance/complexity-baseline.json",
            "pathType": "file"
        },
        {
            "id": "complexity-exemptions",
            "owner": "repository-governance",
            "canonicalPath": "config/governance/complexity-exemptions.json",
            "pathType": "file"
        },
        {
            "id": "complexity-policy",
            "owner": "repository-governance",
            "canonicalPath": "config/governance/complexity-policy.json",
            "pathType": "file"
        },
        {
            "id": "custom-rule-registry",
            "owner": "repository-governance",
            "canonicalPath": "config/governance/custom-rule-registry.json",
            "pathType": "file"
        },
        {
            "id": "release-document-migrations",
            "owner": "documentation-governance",
            "canonicalPath": "config/governance/release-document-migrations.json",
            "pathType": "file"
        },
        {
            "id": "browser-readiness-migrations",
            "owner": "browser-test-governance",
            "canonicalPath": "config/testing/browser-readiness-migrations.json",
            "pathType": "file"
        },
        {
            "id": "repository-governance-authorities",
            "owner": "repository-governance",
            "canonicalPath": "config/governance/repository-governance-authorities.json",
            "pathType": "file"
        },
        {
            "id": "runtime-scenario-catalog",
            "owner": "runtime-scenario-host",
            "canonicalPath": "config/testing/runtime-scenario-catalog.json",
            "pathType": "file",
            "purpose": "Canonical authority for runtime scenario catalog defining test matrix scenarios and capability assertions",
            "consumers": [
                "tools/test/runtime-scenario-host.mjs",
                "docs/testing/runtime-scenario-host.md"
            ],
            "validationCommand": "node tools/test/runtime-scenario-host.mjs",
            "changePolicy": "manual-update-with-test-matrix-validation",
            "status": "manual"
        },
        {
            "id": "backend-qps-scenario-catalog",
            "owner": "backend-performance-governance",
            "canonicalPath": "config/testing/backend-qps-scenario-catalog.json",
            "pathType": "file",
            "purpose": "Canonical authority for 13 backend QPS scenarios and static invariant definitions",
            "consumers": [
                "tools/test/run-backend-qps-scenarios.mjs",
                "tools/test/lanes/backend-qps.sh",
                "docs/testing/backend-qps-driver-migration-ledger.md"
            ],
            "validationCommand": "node tools/test/run-backend-qps-scenarios.mjs --validate-catalog",
            "changePolicy": "manual-update-with-qps-matrix-validation",
            "status": "manual"
        },
        {
            "id": "content-addressed-build-cache",
            "owner": "test-matrix-scheduler",
            "canonicalPath": "config/testing/content-addressed-build-cache.json",
            "pathType": "file"
        },
        {
            "id": "customization-contracts-ownership",
            "owner": "customization-contracts-governance",
            "canonicalPath": "config/customization-contracts-ownership.json",
            "pathType": "file"
        },
        {
            "id": "customization-dependency-dag",
            "owner": "customization-contracts-governance",
            "canonicalPath": "config/customization-dependency-dag.json",
            "pathType": "file"
        },
        {
            "id": "public-preview-quality-policy",
            "owner": "documentation-visual-evidence",
            "canonicalPath": "config/docs/public-preview-quality-policy.json",
            "pathType": "file"
        },
        {
            "id": "public-preview-quality-scenarios-public",
            "owner": "documentation-visual-evidence",
            "canonicalPath": "config/docs/public-preview-quality-scenarios-public.json",
            "pathType": "file"
        },
        {
            "id": "public-preview-quality-scenarios-task",
            "owner": "documentation-visual-evidence",
            "canonicalPath": "config/docs/public-preview-quality-scenarios-task.json",
            "pathType": "file"
        },
        {
            "id": "public-preview-quality-scenarios-zoom",
            "owner": "documentation-visual-evidence",
            "canonicalPath": "config/docs/public-preview-quality-scenarios-zoom.json",
            "pathType": "file"
        }
    ]
}
