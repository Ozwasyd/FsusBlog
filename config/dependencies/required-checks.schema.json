{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://fsusblog.dev/schemas/dependency-required-checks.schema.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "defaultBranch",
        "updateTypes",
        "requiredSurfaces",
        "requiredGroups",
        "checks",
        "checkSets",
        "branchProtection",
        "groups"
    ],
    "properties": {
        "schema": {
            "const": "fsusblog.dependency-required-checks.v1"
        },
        "defaultBranch": {
            "type": "string",
            "minLength": 1
        },
        "updateTypes": {
            "type": "array",
            "minItems": 5,
            "uniqueItems": true,
            "items": {
                "enum": [
                    "major",
                    "minor",
                    "patch",
                    "digest",
                    "lockFileMaintenance"
                ]
            }
        },
        "requiredSurfaces": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "requiredGroups": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]+$"
            }
        },
        "checks": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
                "$ref": "#/$defs/check"
            }
        },
        "checkSets": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "branchProtection": {
            "$ref": "#/$defs/branchProtection"
        },
        "groups": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/group"
            }
        }
    },
    "$defs": {
        "check": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "workflow",
                "jobName",
                "classes",
                "triggers",
                "lintOnly"
            ],
            "properties": {
                "workflow": {
                    "type": "string",
                    "minLength": 1
                },
                "jobName": {
                    "type": "string",
                    "minLength": 1
                },
                "classes": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "enum": [
                            "lint",
                            "build",
                            "test",
                            "security",
                            "production"
                        ]
                    }
                },
                "triggers": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "enum": [
                            "pull_request",
                            "push"
                        ]
                    }
                },
                "lintOnly": {
                    "type": "boolean"
                }
            }
        },
        "branchProtection": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "strict",
                "contexts"
            ],
            "properties": {
                "strict": {
                    "type": "boolean"
                },
                "contexts": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        },
        "group": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "surfaces",
                "checksByUpdateType"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]+$"
                },
                "surfaces": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "checksByUpdateType": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "major",
                        "minor",
                        "patch",
                        "digest",
                        "lockFileMaintenance"
                    ],
                    "properties": {
                        "major": {
                            "type": "string",
                            "minLength": 1
                        },
                        "minor": {
                            "type": "string",
                            "minLength": 1
                        },
                        "patch": {
                            "type": "string",
                            "minLength": 1
                        },
                        "digest": {
                            "type": "string",
                            "minLength": 1
                        },
                        "lockFileMaintenance": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                }
            }
        }
    }
}
