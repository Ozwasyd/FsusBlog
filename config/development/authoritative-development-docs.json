{
    "schema": "fsusblog.authoritative-development-docs.v1",
    "authority": {
        "codingConventions": "docs/development/coding-conventions.md",
        "codeIntentGovernance": "docs/development/code-intent-governance.md",
        "changeContract": "docs/development/change-contract.md",
        "agentOperations": "AGENTS.md",
        "codeowners": ".github/CODEOWNERS",
        "authorityDocuments": [
            "AGENTS.md",
            "docs/CONTRIBUTING.md",
            ".github/CODEOWNERS",
            ".github/labeler.yml",
            ".github/PULL_REQUEST_TEMPLATE.md",
            "docs/development.md",
            "docs/index.md",
            "docs/development/document-lifecycle.md",
            "docs/development/coding-conventions.md",
            "docs/development/code-intent-governance.md",
            "docs/development/change-contract.md"
        ],
        "linkDocuments": [
            "AGENTS.md",
            "docs/CONTRIBUTING.md",
            ".github/PULL_REQUEST_TEMPLATE.md",
            "docs/development.md",
            "docs/index.md",
            "docs/development/document-lifecycle.md",
            "docs/development/coding-conventions.md",
            "docs/development/code-intent-governance.md",
            "docs/development/change-contract.md"
        ]
    },
    "precedence": [
        "external-contract",
        "language-syntax",
        "fsusblog-csharp-mapping",
        "formatter-linter-default",
        "personal-ide-setting"
    ],
    "formatterBaseline": {
        "indentStyle": "space",
        "indentSize": 4,
        "endOfLine": "lf",
        "charset": "utf-8",
        "insertFinalNewline": true,
        "trimTrailingWhitespace": true
    },
    "requiredStyleOwnerIds": [
        "csharp-dotnet",
        "typescript-javascript-vue",
        "css-web",
        "c",
        "cpp",
        "cmake",
        "shell",
        "python",
        "yaml",
        "json",
        "markdown",
        "sql",
        "lua"
    ],
    "styleOwners": [
        {
            "id": "csharp-dotnet",
            "owner": "CSharpDotNetStyleOwner",
            "extensions": [
                ".cs",
                ".csproj",
                ".props",
                ".targets",
                ".slnx",
                ".slnLaunch",
                ".esproj",
                ".dcproj",
                ".pubxml"
            ],
            "documentationHeading": "## C# and .NET"
        },
        {
            "id": "typescript-javascript-vue",
            "owner": "FrontendLanguageStyleOwner",
            "extensions": [
                ".ts",
                ".mts",
                ".cjs",
                ".js",
                ".mjs",
                ".vue"
            ],
            "documentationHeading": "## TypeScript, JavaScript, and Vue"
        },
        {
            "id": "css-web",
            "owner": "FrontendStyleOwner",
            "extensions": [
                ".css",
                ".html"
            ],
            "documentationHeading": "## CSS"
        },
        {
            "id": "c",
            "owner": "NativeCStyleOwner",
            "extensions": [
                ".c",
                ".h"
            ],
            "documentationHeading": "## C"
        },
        {
            "id": "cpp",
            "owner": "WasmEngineAgent",
            "extensions": [
                ".cpp",
                ".hpp"
            ],
            "specialFiles": [
                ".clang-format",
                ".clang-tidy"
            ],
            "documentationHeading": "## C++"
        },
        {
            "id": "cmake",
            "owner": "WasmBuildStyleOwner",
            "extensions": [
                ".cmake"
            ],
            "specialFiles": [
                "CMakeLists.txt"
            ],
            "documentationHeading": "## CMake"
        },
        {
            "id": "shell",
            "owner": "ToolingStyleOwner",
            "extensions": [
                ".bash",
                ".ps1",
                ".sh"
            ],
            "specialFiles": [
                ".shellcheckrc"
            ],
            "documentationHeading": "## Shell"
        },
        {
            "id": "python",
            "owner": "ToolingStyleOwner",
            "extensions": [
                ".py"
            ],
            "documentationHeading": "## Python"
        },
        {
            "id": "yaml",
            "owner": "ConfigurationStyleOwner",
            "extensions": [
                ".yml",
                ".yaml"
            ],
            "documentationHeading": "## YAML"
        },
        {
            "id": "json",
            "owner": "ContractStyleOwner",
            "extensions": [
                ".json",
                ".json5",
                ".jsonc",
                ".webmanifest"
            ],
            "documentationHeading": "## JSON"
        },
        {
            "id": "markdown",
            "owner": "DocumentationStyleOwner",
            "extensions": [
                ".md"
            ],
            "documentationHeading": "## Markdown"
        },
        {
            "id": "sql",
            "owner": "DatabaseStyleOwner",
            "extensions": [
                ".sql"
            ],
            "documentationHeading": "## SQL"
        },
        {
            "id": "lua",
            "owner": "LuaPluginStyleOwner",
            "extensions": [
                ".lua"
            ],
            "documentationHeading": "## Lua"
        },
        {
            "id": "repository-config",
            "owner": "ConfigurationStyleOwner",
            "extensions": [
                ".conf",
                ".example",
                ".http",
                ".npmrc",
                ".template",
                ".toml",
                ".production-template",
                ".Dockerfile",
                ".editorconfig",
                ".prettierrc",
                ".git-blame-ignore-revs",
                ".gitignore",
                ".gitattributes",
                ".dockerignore",
                ".ignore",
                ".xml"
            ],
            "specialFiles": [
                "CODEOWNERS",
                "Dockerfile"
            ],
            "documentationHeading": "## Repository baseline"
        }
    ],
    "nonSourceExtensions": [
        ".aeds",
        ".diff",
        ".hex",
        ".ico",
        ".png",
        ".proof",
        ".public_inputs",
        ".r1cs",
        ".stderr",
        ".svg",
        ".txt",
        ".vk",
        ".webp"
    ],
    "nonSourceSpecialFiles": [
        "LICENSE"
    ],
    "requiredPathClassificationIds": [
        "generated",
        "vendor",
        "fixture",
        "lock",
        "minified"
    ],
    "pathClassifications": [
        {
            "id": "dependency-migration-archive",
            "owner": "DependencyOwner",
            "patterns": [
                "config/dependencies/fsusui-public-npm-migration.patch.gz"
            ],
            "reason": "the packed migration input is integrity-checked by tools/dependencies/migrate-fsusui-public-npm.mjs; only these compressed bytes are non-source, while applied files retain their normal style owners"
        },
        {
            "id": "generated",
            "owner": "GeneratorOwner",
            "patterns": [
                "artifacts/**",
                "**/generated/**"
            ],
            "reason": "generated outputs are changed through their source or generator"
        },
        {
            "id": "vendor",
            "owner": "DependencyOwner",
            "patterns": [
                "tools/vcpkg-overlays/**",
                "tools/mutation/patches/stryker-net-4.14.2-candidate-validity.patch",
                "tools/mutation/patches/stryker-net-4.14.2-expression-tree.patch",
                "**/vendor/**",
                "**/node_modules/**"
            ],
            "reason": "vendored material preserves upstream format and license"
        },
        {
            "id": "fixture",
            "owner": "TestOwner",
            "patterns": [
                "examples/**",
                "tests/fixtures/**",
                "tests/**/Fixtures/**",
                "tests/**/fixtures/**",
                "src/frontend/public/fixtures/**",
                "src/frontend/tests/**/fixtures/**"
            ],
            "reason": "fixtures may intentionally encode invalid or external formatting"
        },
        {
            "id": "lock",
            "owner": "PackageManager",
            "patterns": [
                "**/package-lock.json",
                "**/pnpm-lock.yaml",
                "**/yarn.lock",
                "tests/migration/packages.lock.json"
            ],
            "reason": "package managers own lock ordering and formatting"
        },
        {
            "id": "minified",
            "owner": "GeneratorOwner",
            "patterns": [
                "**/*.min.*"
            ],
            "reason": "minified output is never a hand-written style precedent"
        }
    ],
    "symbols": [
        {
            "id": "banned-user-middleware",
            "source": "src/backend/Infrastructure/Filters/BannedUserMiddleware.cs",
            "sourceToken": "class BannedUserMiddleware",
            "documents": [
                "docs/architecture.md"
            ],
            "documentToken": "BannedUserMiddleware"
        },
        {
            "id": "binary-frame-result",
            "source": "src/backend/Infrastructure/Results/BinaryFrameResult.cs",
            "sourceToken": "class BinaryFrameResult",
            "documents": [
                "docs/architecture.md"
            ],
            "documentToken": "BinaryFrameResult"
        },
        {
            "id": "binary-preencoded-frame-result",
            "source": "src/backend/Infrastructure/Results/BinaryFrameResult.cs",
            "sourceToken": "class BinaryPreencodedFrameResult",
            "documents": [
                "docs/architecture.md"
            ],
            "documentToken": "BinaryPreencodedFrameResult"
        },
        {
            "id": "pod-binary-codec",
            "source": "src/core/Cache/PodBinaryCodec.Common.cs",
            "sourceToken": "static partial class PodBinaryCodec",
            "documents": [
                "docs/architecture.md"
            ],
            "documentToken": "PodBinaryCodec.WriteArticlePage"
        },
        {
            "id": "aeds-frame-buffer-writer",
            "source": "src/core/Algorithms/AedsFrameBufferWriter.cs",
            "sourceToken": "class AedsFrameBufferWriter",
            "documents": [
                "docs/architecture.md"
            ],
            "documentToken": "AedsFrameBufferWriter"
        },
        {
            "id": "binary-results-frame",
            "source": "src/backend/Infrastructure/Results/BinaryResults.cs",
            "sourceToken": "BinaryFrameResult Frame(",
            "documents": [
                "docs/architecture.md"
            ],
            "documentToken": "BinaryResults.Frame"
        }
    ],
    "retiredTokens": [
        "BannedUserFilter",
        "src/frontend/src/wasm",
        "Results.Stream",
        "AedsBinaryWriter"
    ],
    "commands": [
        {
            "id": "authoritative-development-docs",
            "kind": "node-script",
            "path": "tools/docs/check-authoritative-development-docs.mjs",
            "invocation": "node tools/docs/check-authoritative-development-docs.mjs",
            "documents": [
                "docs/development/coding-conventions.md",
                "docs/development/document-lifecycle.md",
                "docs/development.md"
            ]
        },
        {
            "id": "repository-fast-tests",
            "kind": "shell-script",
            "path": "tools/test.sh",
            "invocation": "./tools/test.sh fast",
            "documents": [
                "docs/CONTRIBUTING.md"
            ]
        },
        {
            "id": "csharp-style",
            "kind": "node-script",
            "path": "tools/dotnet/check-csharp-style.mjs",
            "invocation": "node tools/dotnet/check-csharp-style.mjs --mode changed",
            "documents": [
                "docs/development/csharp-style-enforcement.md"
            ]
        },
        {
            "id": "frontend-style",
            "kind": "node-script",
            "path": "tools/frontend/check-frontend-style.mjs",
            "invocation": "node tools/frontend/check-frontend-style.mjs --mode changed",
            "documents": [
                "docs/development/frontend-style-enforcement.md"
            ]
        },
        {
            "id": "code-intent-governance",
            "kind": "node-script",
            "path": "tools/governance/check-code-intent.mjs",
            "invocation": "node tools/governance/check-code-intent.mjs",
            "documents": [
                "docs/development/code-intent-governance.md",
                "docs/development/coding-conventions.md"
            ]
        },
        {
            "id": "frontend-fast-tests",
            "kind": "npm-script",
            "package": "src/frontend/package.json",
            "script": "test:fast",
            "invocation": "npm --prefix src/frontend run test:fast",
            "documents": [
                "docs/CONTRIBUTING.md"
            ]
        }
    ],
    "requiredExternalContractExceptionIds": [
        "json-api-field",
        "postgres-column-migration",
        "http-header",
        "redis-key",
        "c-abi-wasm-export",
        "environment-variable",
        "css-selector-custom-property",
        "shell-environment-variable",
        "cmake-built-in",
        "third-party-sdk-callback"
    ],
    "externalContractExceptions": [
        {
            "id": "json-api-field",
            "externalPattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "internalPattern": "^[a-z][A-Za-z0-9]*$",
            "adapterRequired": true,
            "positive": {
                "external": "user_id",
                "internal": "userId"
            },
            "negative": {
                "external": "user_id",
                "internal": "user_id"
            }
        },
        {
            "id": "postgres-column-migration",
            "externalPattern": "^[a-z][a-z0-9_]*$",
            "internalPattern": "^[a-z][A-Za-z0-9]*$",
            "adapterRequired": true,
            "positive": {
                "external": "account_subject_hash",
                "internal": "accountSubjectHash"
            },
            "negative": {
                "external": "account_subject_hash",
                "internal": "account_subject_hash"
            }
        },
        {
            "id": "http-header",
            "externalPattern": "^[A-Za-z][A-Za-z0-9-]*$",
            "internalPattern": "^[a-z][A-Za-z0-9]*$",
            "adapterRequired": true,
            "positive": {
                "external": "X-Fsus-Frame-Version",
                "internal": "frameVersion"
            },
            "negative": {
                "external": "X-Fsus-Frame-Version",
                "internal": "X-Fsus-Frame-Version"
            }
        },
        {
            "id": "redis-key",
            "externalPattern": "^[a-z][a-z0-9-]*(?::[a-z0-9{}-]+)+$",
            "internalPattern": "^[a-z][A-Za-z0-9]*$",
            "adapterRequired": true,
            "positive": {
                "external": "article:detail:{id}",
                "internal": "articleDetailKey"
            },
            "negative": {
                "external": "article:detail:{id}",
                "internal": "article:detail:{id}"
            }
        },
        {
            "id": "c-abi-wasm-export",
            "externalPattern": "^[a-z][a-z0-9_]*$",
            "internalPattern": "^[a-z][A-Za-z0-9]*$",
            "adapterRequired": true,
            "positive": {
                "external": "aeds_decode_frame",
                "internal": "decodeFrame"
            },
            "negative": {
                "external": "aeds_decode_frame",
                "internal": "aeds_decode_frame"
            }
        },
        {
            "id": "environment-variable",
            "externalPattern": "^[A-Z][A-Z0-9_]*$",
            "internalPattern": "^[a-z][A-Za-z0-9]*$",
            "adapterRequired": true,
            "positive": {
                "external": "FSUSBLOG_ADMIN_BOOTSTRAP_TOKEN",
                "internal": "adminBootstrapToken"
            },
            "negative": {
                "external": "FSUSBLOG_ADMIN_BOOTSTRAP_TOKEN",
                "internal": "FSUSBLOG_ADMIN_BOOTSTRAP_TOKEN"
            }
        },
        {
            "id": "css-selector-custom-property",
            "externalPattern": "^(?:\\.[a-z][a-z0-9-]*|--[a-z][a-z0-9-]*)$",
            "internalPattern": "^[a-z][A-Za-z0-9]*$",
            "adapterRequired": true,
            "positive": {
                "external": ".article-card",
                "internal": "articleCardClass"
            },
            "negative": {
                "external": ".article-card",
                "internal": "article-card"
            }
        },
        {
            "id": "shell-environment-variable",
            "externalPattern": "^[A-Z][A-Z0-9_]*$",
            "internalPattern": "^[a-z][A-Za-z0-9]*$",
            "adapterRequired": true,
            "positive": {
                "external": "FSUSBLOG_TEST_PROFILE",
                "internal": "testProfile"
            },
            "negative": {
                "external": "FSUSBLOG_TEST_PROFILE",
                "internal": "FSUSBLOG_TEST_PROFILE"
            }
        },
        {
            "id": "cmake-built-in",
            "externalPattern": "^[a-z][a-z0-9_]*$",
            "internalPattern": "^[a-z][A-Za-z0-9]*$",
            "adapterRequired": true,
            "positive": {
                "external": "add_executable",
                "internal": "addExecutableCommand"
            },
            "negative": {
                "external": "add_executable",
                "internal": "add_executable"
            }
        },
        {
            "id": "third-party-sdk-callback",
            "externalPattern": "^[a-z][a-z0-9_]*$",
            "internalPattern": "^[a-z][A-Za-z0-9]*$",
            "adapterRequired": true,
            "positive": {
                "external": "on_passkey_complete",
                "internal": "onPasskeyComplete"
            },
            "negative": {
                "external": "on_passkey_complete",
                "internal": "on_passkey_complete"
            }
        }
    ]
}
