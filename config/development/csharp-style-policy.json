                "declarations": [
                    {
                        "name": "LogCleanupService",
                        "parameters": [
                            "_serviceProvider",
                            "_logger",
                            "workerLease",
                            "timeProvider",
                            "transactionalCommitGuard",
                            "activeReleaseCommitGuard",
