                            "configuration"
                        ]
                    }
                ],
                "reason": "Public primary-constructor parameter names are an existing named-argument source contract."
            },
            {
                "path": "src/backend/Services/StatsService.cs",
                "declarations": [
                    {
                        "name": "StatsService",
                        "parameters": [
                            "_db",
                            "_cacheReader",
                            "_cacheWriter",
                            "_cacheMissCoordinator",
