                "declarations": [
                    {
                        "name": "SystemService",
                        "parameters": [
                            "_db",
                            "_cacheReader",
                            "_cacheWriter",
                            "_stringWriter",
                            "_cacheMissCoordinator",
                            "_dbConcurrencyGate",
