{
    "schema": "fsusblog.csharp-style-policy.v1",
    "editorConfig": ".editorconfig",
    "workspace": "FsusBlog.slnx",
    "baseline": "config/development/csharp-style-baseline.json",
    "minimumDotnetMajor": 10,
    "format": {
        "whitespaceCommand": "dotnet format whitespace --folder --verify-no-changes",
        "styleCommand": "dotnet format style FsusBlog.slnx --verify-no-changes --no-restore --severity info",
        "changedDefaultBase": "HEAD^",
        "fullMode": "baseline-aware",
        "strictFullMode": "dotnet-format"
    },
    "excludedPaths": [
        "**/bin/**",
        "**/obj/**",
        "**/generated/**",
        "**/Generated/**",
        "**/*.g.cs",
        "**/*.generated.cs",
        "**/*.designer.cs",
        "src/core/Algorithms/AedsFrameType.cs",
        "artifacts/**",
        "**/vendor/**",
        "tools/vcpkg-overlays/**",
        "**/node_modules/**",
        "tests/**/Fixtures/**",
        "tests/**/fixtures/**",
        "tools/test-inventory/xunit-roslyn-adapter/fixtures/**"
    ],
    "naming": {
        "interfacePrefix": "I",
        "privateInstanceFieldPrefix": "_",
        "privateStaticFieldPrefix": "s_",
        "threadStaticFieldPrefix": "t_",
        "forbidConsecutiveUnderscores": true,
        "pascalCaseSeparatorScopes": [
            "tests/**/*.cs",
            "benchmarks/**/*.cs"
        ],
        "roslynCompatibilityExceptions": [
            {
                "path": "src/shared/Contracts/Outputs/ServerResponseContracts.cs",
                "declarations": [
                    {
                        "name": "GlobalNoticePayload",
                        "parameters": [
                            "id",
                            "title",
                            "time"
                        ]
                    },
                    {
                        "name": "MessageRevokedPayload",
                        "parameters": [
                            "messageId",
                            "unreadCount",
                            "time"
                        ]
                    },
                    {
                        "name": "AccountStatusPayload",
                        "parameters": [
                            "status",
                            "reason",
                            "time"
                        ]
                    },
                    {
                        "name": "SessionRevokedPayload",
                        "parameters": [
                            "reason",
                            "revokedSessionCount",
                            "time"
                        ]
                    },
                    {
                        "name": "NoticePayload",
                        "parameters": [
                            "title",
                            "unreadCount",
                            "time"
                        ]
                    },
                    {
                        "name": "InboxConversationUpsertPayload",
                        "parameters": [
                            "Conversation",
                            "TotalUnread",
                            "Time"
                        ]
                    },
                    {
                        "name": "InboxMessageAppendPayload",
                        "parameters": [
                            "ConversationId",
                            "Message",
                            "ConversationUnreadCount",
                            "TotalUnread",
                            "Time"
                        ]
                    },
                    {
                        "name": "InboxReadUpdatedPayload",
                        "parameters": [
                            "ConversationId",
                            "LastReadMessageId",
                            "ConversationUnreadCount",
                            "TotalUnread",
                            "Time"
                        ]
                    },
                    {
                        "name": "InboxConversationStatusChangedPayload",
                        "parameters": [
                            "ConversationId",
                            "Status",
                            "Time"
                        ]
                    },
                    {
                        "name": "CommentRemovedPayload",
                        "parameters": [
                            "articleId",
                            "commentId",
                            "rootId",
                            "parentId",
                            "time"
                        ]
                    }
                ],
                "reason": "Legacy notification record parameter casing determines published property and wire contract names."
            },
            {
                "path": "src/backend/Infrastructure/Helpers/Security/ModernAcAutomaton.cs",
                "fields": [
                    "t_ruleRemainingScratch",
                    "t_touchedRuleScratch"
                ],
                "reason": "Roslyn naming symbol groups cannot distinguish ThreadStatic fields; the repository checker enforces t_camelCase."
            },
            {
                "path": "src/backend/Infrastructure/Filters/BannedUserMiddleware.cs",
                "declarations": [
                    {
                        "name": "BannedUserMiddleware",
                        "parameters": [
                            "_next"
                        ]
                    }
                ],
                "reason": "Public primary-constructor parameter names are an existing named-argument source contract."
            },
            {
                "path": "src/backend/Infrastructure/Helpers/Initializer/CacheInitializer.cs",
                "declarations": [
                    {
                        "name": "CacheInitializer",
                        "parameters": [
                            "_db",
                            "_blacklist",
                            "_cache"
                        ]
                    }
                ],
                "reason": "Public primary-constructor parameter names are an existing named-argument source contract."
            },
            {
