        ],
        "externalContractAttributes": [
            "JsonPropertyName",
            "JsonProperty",
            "Column",
            "DataMember"
        ]
    },
    "xmlDocumentation": {
        "scopes": [
            "src/shared/Contracts/**",
            "src/core/Algorithms/**",
            "src/core/Cache/PodBinaryCodec*.cs",
            "tools/architecture/**",
            "src/backend/Infrastructure/Auth/**",
            "src/backend/Infrastructure/Security/**",
            "src/backend/Infrastructure/Privacy/**"
        ],
        "memberScopes": [
            "src/core/Algorithms/**",
            "src/core/Cache/PodBinaryCodec*.cs",
            "tools/architecture/**",
            "src/backend/Infrastructure/Auth/**",
            "src/backend/Infrastructure/Security/**",
            "src/backend/Infrastructure/Privacy/**"
        ],
        "declarationAccessibilities": [
            "public"
        ],
        "excludeModifiers": [
            "override"
        ]
    },
    "enumNaming": {
        "flagsMustBePlural": true,
        "nonFlagsMustBeSingular": true,
        "acceptedSingularSuffixes": [
            "Status",
            "State",
            "Kind",
            "Type",
            "Mode",
            "Policy",
            "Code",
            "Role",
            "Action",
            "Reason",
            "Level",
            "Phase",
            "Class",
            "Miss",
            "Access"
        ],
        "compatibilityExceptions": [
            {
                "path": "src/backend/Infrastructure/PublicReadArtifacts/PublicHotArtifactUpdateQueue.cs",
                "name": "PublicHotArtifactDirtyReason",
                "reason": "Published flags type name is an existing source contract; renaming it would break consumers."
            }
        ]
    }
}
