{
    "schema": "fsusblog.frontend-style-policy.v1",
    "baseline": "config/development/frontend-style-baseline.json",
    "ruleRegistry": "config/development/frontend-style-rule-registry.json",
    "eslintConfig": "eslint.config.mjs",
    "stylelintConfig": "stylelint.config.mjs",
    "configurationSources": [
        ".editorconfig",
        "eslint.config.mjs",
        "stylelint.config.mjs",
        "src/frontend/eslint.config.mjs",
        "src/frontend/stylelint.config.mjs",
        "tools/frontend/check-frontend-style.mjs",
        "tools/frontend/style-toolchain/eslint.config.mjs",
        "tools/frontend/style-toolchain/stylelint.config.mjs"
    ],
    "toolchain": {
        "package": "tools/frontend/style-toolchain/package.json",
        "lock": "tools/frontend/style-toolchain/package-lock.json",
        "eslint": "tools/frontend/style-toolchain/node_modules/.bin/eslint",
        "stylelint": "tools/frontend/style-toolchain/node_modules/.bin/stylelint"
    },
    "modes": {
        "changedDefaultBase": "HEAD^",
        "full": "baseline-aware",
        "strictFull": "all-violations"
    },
    "eslintSourceSets": [
        {
            "root": "src/frontend/src",
            "extensions": [".ts", ".tsx", ".vue", ".js", ".mjs"]
        },
        {
            "root": "src/frontend/wasm/web",
            "extensions": [".ts", ".tsx", ".js", ".mjs"]
        },
        {
            "root": "src/frontend/scripts",
            "extensions": [".js", ".mjs", ".cjs"]
        },
        {
            "root": "src/frontend/public",
            "extensions": [".js", ".mjs"]
        },
        {
            "root": "tools",
            "extensions": [".mjs"]
        },
        {
            "root": "tests",
            "extensions": [".mjs"]
        }
    ],
    "stylelintSourceSets": [
        {
            "root": "src/frontend/src",
            "extensions": [".vue", ".css", ".scss"]
        }
    ],
    "excludedPaths": [
        "artifacts/",
        "src/frontend/coverage/",
        "src/frontend/dist/",
        "src/frontend/node_modules/",
        "src/frontend/public/wasm/",
        "src/frontend/src/generated/",
        "src/frontend/wasm/build/",
        "src/frontend/wasm/dist/",
        "src/frontend/wasm/stage/",
        "tools/frontend/style-toolchain/node_modules/",
        "tests/**/Fixtures/",
        "tests/**/fixtures/"
    ],
    "excludedSuffixes": [".min.js", ".min.css"],
    "authority": {
        "formatter": "eslint-stylelint-ast",
        "forbiddenAuthoritativePackages": ["prettier"],
        "indentSize": 4,
        "braceStyle": "allman",
        "semicolons": "always",
        "cssPropertyOrder": "semantic-preserve"
    },
    "specializedGovernance": {
        "package": "src/frontend/package.json",
        "scriptPrefix": "check:",
        "count": 191,
        "idsSha256": "863eea0dee497ee589244a56eeeefae40fd92eea96bcf862fc83070444ac0c3d",
        "definitionsSha256": "9859f22622d501b07656de9fa0503a6b35c39b7c8b0e2e12e9c04124d751ec5c"
    }
}
