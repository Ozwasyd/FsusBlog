        }
    ],
    "registeredExceptions": [
        {
            "id": "pure-receipt-canonicalizer-import",
            "externalOrEcosystemSurface": "post-runtime pure receipt dependency closure",
            "rule": "only tools/docs/behavior-doc-minimal-contract-build-v3-contract.mjs importing literal ../fact-extractors/lib/canonicalize.mjs",
            "reason": "retain the enumerable canonical dependency required by the pure firewall; all other parent imports remain errors"
        },
        {
            "id": "vue-composable-function",
            "externalOrEcosystemSurface": "Vue composable",
            "rule": "useXxx camelCase",
            "reason": "Vue reactivity discovery and caller contracts use the ecosystem-required use prefix"
        },
        {
            "id": "typescript-structural-interface",
            "externalOrEcosystemSurface": "TypeScript structural type",
            "rule": "PascalCase without mandatory I prefix",
            "reason": "the authoritative #1157 mapping reserves I-prefix enforcement for C# interfaces"
        },
        {
            "id": "javascript-private-field",
            "externalOrEcosystemSurface": "ECMAScript private field",
            "rule": "#camelCase",
            "reason": "language-enforced privacy replaces C# underscore and static prefixes"
        },
        {
            "id": "module-constant",
            "externalOrEcosystemSurface": "JavaScript module binding",
            "rule": "camelCase unless the external contract requires UPPER_CASE",
            "reason": "matches the authoritative #1157 cross-language mapping"
        },
        {
            "id": "json-browser-wasm-contract",
            "externalOrEcosystemSurface": "JSON key, browser event, storage key or Wasm export",
            "rule": "preserve external spelling and adapt to camelCase internally",
            "reason": "formatting cannot change API, AEDS, browser or persistence contracts"
        },
        {
            "id": "html-aria-data-contract",
            "externalOrEcosystemSurface": "HTML, ARIA and data-* attribute",
            "rule": "preserve standards-defined kebab spelling",
            "reason": "template identifiers are browser contracts rather than internal symbols"
        },
        {
            "id": "css-selector-custom-property",
            "externalOrEcosystemSurface": "CSS class, BEM selector and custom property",
            "rule": "kebab-case/BEM spelling",
            "reason": "selectors and tokens are DOM/CSS contracts"
        },
        {
            "id": "vue-custom-event",
            "externalOrEcosystemSurface": "existing public Vue emit name",
            "rule": "preserve caller-facing event spelling",
            "reason": "event renames require a semantic migration and are never formatter fixes"
        }
    ],
    "cssPropertyOrder": {
        "mode": "semantic-preserve",
        "owner": "FrontendStyleOwner",
        "reason": "token dependencies, logical-property fallbacks and component state grouping take precedence over arbitrary alphabetical order"
    },
    "specializedGovernance": {
        "owner": "ExistingGovernanceOwners",
        "sourceScope": "src/frontend/package.json scripts named check:*",
        "fixability": "manual",
        "preservation": "generic AST lint is additive; no existing check:* command may be removed or rewritten by this issue"
    }
}
