{
    "schema": "fsusblog.native-tooling-style-exceptions.v1",
    "precedence": [
        "external-contract",
        "language-syntax",
        "fsusblog-csharp-mapping",
        "formatter-linter-default"
    ],
    "requiredIds": [
        "c-abi-wasm-export",
        "compiler-intrinsic",
        "generated-native",
        "environment-variable",
        "shell-environment-variable",
        "dotnet-configuration-environment",
        "cmake-cache-environment",
        "github-actions-schema",
        "json-wire-key",
        "css-like-contract"
    ],
    "exceptions": [
        {
            "id": "c-abi-wasm-export",
            "authorityExceptionId": "c-abi-wasm-export",
            "paths": [
                "src/frontend/wasm/**/src/*exports.cpp",
                "src/frontend/wasm/aeds/src/exports.cpp",
                "src/frontend/wasm/comment_privacy/src/comment_privacy.cpp",
                "src/frontend/wasm/search/src/search_index.cpp",
                "src/frontend/wasm/pow/src/main.cpp"
            ],
            "externalPattern": "^[a-z][a-z0-9_]*$",
            "internalPattern": "^[A-Z][A-Za-z0-9]*$",
            "adapterRequired": true,
            "positive": {
                "external": "decode_io_buffer",
                "internal": "DecodeIoBuffer"
            },
            "negative": {
                "external": "decode_io_buffer",
                "internal": "decode_io_buffer"
            },
            "reason": "C ABI and Emscripten export spelling is a stable caller-visible contract."
        },
        {
            "id": "compiler-intrinsic",
            "precedenceClass": "language-syntax",
            "paths": [
                "src/frontend/wasm/**/*.cpp",
                "tests/frontend/fixtures/*.cpp"
            ],
            "externalPattern": "^__(?:builtin|attribute|asm)_[A-Za-z0-9_]+$",
            "internalPattern": "^[A-Z][A-Za-z0-9]*$",
            "adapterRequired": false,
            "positive": {
                "external": "__builtin_trap",
                "internal": "FailClosed"
            },
            "negative": {
                "external": "__builtin_trap",
                "internal": "business__builtin_trap"
            },
            "reason": "Compiler-provided intrinsic names cannot be renamed."
        },
        {
            "id": "generated-native",
            "authorityClassificationId": "generated",
            "paths": [
                "src/frontend/wasm/aeds/include/aeds_frame.hpp"
            ],
            "externalPattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "internalPattern": "^[A-Z][A-Za-z0-9]*$",
            "adapterRequired": false,
            "positive": {
                "external": "payload_length",
                "internal": "PayloadLength"
            },
            "negative": {
                "external": "payload_length",
                "internal": "manual_payload_length"
            },
            "reason": "The protocol generator owns this ABI-layout header and its member spelling."
        },
        {
            "id": "environment-variable",
            "authorityExceptionId": "environment-variable",
            "paths": [
                "tools/**/*.mjs",
                "src/**/*.cs"
            ],
            "externalPattern": "^[A-Z][A-Z0-9_]*$",
            "internalPattern": "^[a-z][A-Za-z0-9]*$",
            "adapterRequired": true,
            "positive": {
                "external": "FSUSBLOG_TEST_PROFILE",
                "internal": "testProfile"
            },
            "negative": {
                "external": "FSUSBLOG_TEST_PROFILE",
                "internal": "FSUSBLOG_TEST_PROFILE"
            },
            "reason": "Process environment spelling is external while option variables remain internal."
        },
        {
            "id": "shell-environment-variable",
            "authorityExceptionId": "shell-environment-variable",
            "paths": [
                "tools/**/*.sh"
            ],
            "externalPattern": "^[A-Z][A-Z0-9_]*$",
            "internalPattern": "^[a-z][A-Za-z0-9]*$",
            "adapterRequired": true,
            "positive": {
                "external": "FSUSBLOG_TEST_PROFILE",
                "internal": "testProfile"
            },
            "negative": {
                "external": "FSUSBLOG_TEST_PROFILE",
                "internal": "FSUSBLOG_TEST_PROFILE"
            },
            "reason": "Exported shell variables retain process-level spelling; local aliases use camelCase."
        },
        {
            "id": "release-reliability-runtime-environment",
            "authorityExceptionId": "environment-variable",
            "paths": [
                "tools/test/release-reliability-runtime-environment.mjs",
                "tools/test/run-release-reliability-qualified-local.sh"
            ],
            "externalPattern": "^[A-Z][A-Z0-9_]*$",
            "internalPattern": "^[a-z][A-Za-z0-9]*$",
            "adapterRequired": true,
            "positive": {
                "external": "FSUSBLOG_RELEASE_DERIVED_ROOT",
                "internal": "releaseDerivedRoot"
            },
            "negative": {
                "external": "FSUSBLOG_RELEASE_DERIVED_ROOT",
                "internal": "FSUSBLOG_RELEASE_DERIVED_ROOT"
            },
            "reason": "The canonical final-image projection and its sole shell executor must change atomically for the same caller-visible process environment keys."
        },
        {
            "id": "production-image-verification-contract",
            "authorityExceptionId": "environment-variable",
            "paths": [
                ".github/workflows/production-image-verification.yml",
                "config/deployment/production-compose-environment.json",
                "config/governance/complexity-exemptions.json",
                "config/governance/custom-rule-registry.json",
                "tests/governance/operations-layout.json",
                "tools/deployment/check-production-compose-environment.mjs",
                "tools/deployment/check-production-openresty-config.sh",
                "tools/deployment/verify-container-termination.mjs",
                "tools/test/run-release-reliability-qualified-local.sh"
            ],
            "externalPattern": "^[A-Z][A-Z0-9_]*$",
            "internalPattern": "^[a-z][A-Za-z0-9]*$",
            "adapterRequired": true,
            "positive": {
                "external": "FSUSBLOG_TEST_PROFILE",
                "internal": "testProfile"
            },
            "negative": {
                "external": "FSUSBLOG_TEST_PROFILE",
                "internal": "FSUSBLOG_TEST_PROFILE"
            },
            "reason": "The production-image workflow, deploy contract, runtime probes and their governance registrations must change atomically for the same caller-visible environment and orchestration keys."
        },
        {
            "id": "acceptance-secret-runtime-environment",
            "authorityExceptionId": "environment-variable",
            "paths": [
                "tools/bootstrap-acceptance-env.sh",
                "tools/test/bundles/runtime-environment.mjs"
            ],
            "externalPattern": "^[A-Z][A-Z0-9_]*$",
            "internalPattern": "^[a-z][A-Za-z0-9]*$",
            "adapterRequired": true,
            "positive": {
                "external": "FSUSBLOG_ACCEPTANCE_SECRET",
                "internal": "acceptanceSecret"
            },
            "negative": {
                "external": "FSUSBLOG_ACCEPTANCE_SECRET",
                "internal": "FSUSBLOG_ACCEPTANCE_SECRET"
            },
            "reason": "The acceptance bootstrap secret producer and its sole runtime collector must change atomically for the same run-bound process environment keys."
        },
        {
            "id": "risk-policy-provider-consistency",
            "authorityExceptionId": "environment-variable",
            "paths": [
                "docs/security.md",
                "src/backend/Infrastructure/Operations/ProductionHealth.cs",
                "src/backend/Infrastructure/Security/RiskActionRegistry.cs",
                "src/backend/Infrastructure/Security/SecurityRiskPolicySnapshotV2Adapter.cs",
                "src/backend/Services/Security/SecurityAdminPolicyService.cs"
            ],
            "externalPattern": "^[A-Z][A-Z0-9_]*$",
            "internalPattern": "^[a-z][A-Za-z0-9]*$",
            "adapterRequired": true,
            "positive": {
                "external": "FSUSBLOG_PERCEPTION_CHARACTER_V3_ENABLED",
                "internal": "perceptionCharacterV3Enabled"
            },
            "negative": {
                "external": "FSUSBLOG_PERCEPTION_CHARACTER_V3_ENABLED",
                "internal": "FSUSBLOG_PERCEPTION_CHARACTER_V3_ENABLED"
            },
            "reason": "The current security contract and its four runtime policy/provider owners must change atomically for the same caller-visible configuration mapping."
        },
        {
            "id": "search-index-utf8-scalar-owner",
            "authorityExceptionId": "json-api-field",
            "paths": [
                "docs/testing.generated.md",
                "src/backend/Services/SearchIndexService.Dictionary.cs",
                "tests/backend/Fixtures/backend-test-requirements.json",
                "tests/coverage-registry.json",
                "tools/check-backend-test-governance.mjs"
            ],
            "externalPattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "internalPattern": "^[a-z][A-Za-z0-9]*$",
            "adapterRequired": true,
            "positive": {
                "external": "search_index_utf8_scalar_owner",
                "internal": "searchIndexUtf8ScalarOwner"
            },
            "negative": {
                "external": "search_index_utf8_scalar_owner",
                "internal": "search_index_utf8_scalar_owner"
            },
            "reason": "The search UTF-8 scalar production owner, governance registry and generated test documentation must migrate atomically while preserving their existing external JSON, document and tooling identifiers; internal C# symbols remain governed by the repository mapping."
        },
        {
            "id": "dotnet-configuration-environment",
            "authorityExceptionId": "environment-variable",
            "paths": [
                "tools/**/*.sh"
            ],
            "externalPattern": "^[A-Za-z][A-Za-z0-9]*(?:__[A-Za-z0-9]+)+$",
            "internalPattern": "^[a-z][A-Za-z0-9]*$",
            "adapterRequired": true,
            "positive": {
                "external": "ConnectionStrings__DefaultConnection",
                "internal": "defaultConnection"
            },
            "negative": {
                "external": "ConnectionStrings__DefaultConnection",
                "internal": "ConnectionStrings__DefaultConnection"
            },
            "reason": "ASP.NET Core maps double-underscore process environment keys to caller-visible configuration paths."
        },
        {
            "id": "cmake-cache-environment",
            "authorityExceptionId": "cmake-built-in",
            "paths": [
                "**/CMakeLists.txt",
                "**/*.cmake"
            ],
            "externalPattern": "^(?:CMAKE|CTEST|CPACK|FSUSBLOG)_[A-Z0-9_]+$",
            "internalPattern": "^[a-z][A-Za-z0-9]*$",
            "adapterRequired": true,
            "positive": {
                "external": "FSUSBLOG_WARNINGS_AS_ERRORS",
                "internal": "warningsAsErrors"
            },
            "negative": {
                "external": "FSUSBLOG_WARNINGS_AS_ERRORS",
                "internal": "FSUSBLOG_WARNINGS_AS_ERRORS"
            },
            "reason": "CMake cache and environment keys are public command-line contracts."
        },
        {
            "id": "github-actions-schema",
            "authorityExceptionId": "third-party-sdk-callback",
            "paths": [
                ".github/workflows/*.yml",
                ".github/workflows/*.yaml"
            ],
            "externalPattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "internalPattern": "^[a-z][A-Za-z0-9]*$",
            "adapterRequired": false,
            "positive": {
                "external": "runs-on",
                "internal": "runnerLabel"
            },
            "negative": {
                "external": "runs-on",
                "internal": "runs-on"
            },
            "reason": "Workflow and third-party action keys are defined by an external schema."
        },
        {
            "id": "json-wire-key",
            "authorityExceptionId": "json-api-field",
            "paths": [
                "config/**/*.json",
                "security/**/*.json",
                "tests/**/*.json"
            ],
            "externalPattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "internalPattern": "^[a-z][A-Za-z0-9]*$",
            "adapterRequired": true,
            "positive": {
                "external": "article_id",
                "internal": "articleId"
            },
            "negative": {
                "external": "article_id",
                "internal": "article_id"
            },
            "reason": "Wire and schema keys remain stable while runtime adapters follow internal naming."
        },
        {
            "id": "css-like-contract",
            "authorityExceptionId": "css-selector-custom-property",
            "paths": [
                "docs/**/*.md",
                "config/**/*.json"
            ],
            "externalPattern": "^(?:\\.[a-z][a-z0-9-]*|--[a-z][a-z0-9-]*)$",
            "internalPattern": "^[a-z][A-Za-z0-9]*$",
            "adapterRequired": true,
            "positive": {
                "external": ".article-card",
                "internal": "articleCardClass"
            },
            "negative": {
                "external": ".article-card",
                "internal": "article-card"
            },
            "reason": "DOM and token spelling is preserved only when documented as a caller-visible contract."
        }
    ]
}
