{
    "schema": "fsusblog.public-preview-screenshot-registry.v1",
    "capturePolicy": {
        "animations": "disabled",
        "completeRegistry": true,
        "language": "C.UTF-8",
        "layoutAudit": true,
        "reducedMotion": "reduce",
        "runtimeAudit": true,
        "timezone": "UTC"
    },
    "failClosedRoots": [
        {
            "path": "src/frontend/src",
            "excludedEntries": [
                "vite-env.d.ts"
            ]
        }
    ],
    "screenshots": [
        {
            "id": "admin-dashboard-desktop-light",
            "file": "admin-dashboard.png",
            "route": "ManageDashboard",
            "viewport": "desktop",
            "theme": "light",
            "scope": "admin"
        },
        {
            "id": "article-detail-desktop-light",
            "file": "article-detail-light.png",
            "route": "ArticleDetail",
            "viewport": "desktop",
            "theme": "light",
            "scope": "anonymous"
        },
        {
            "id": "article-detail-mobile-light",
            "file": "article-detail-mobile.png",
            "route": "ArticleDetail",
            "viewport": "mobile",
            "theme": "light",
            "scope": "anonymous"
        },
        {
            "id": "article-editor-desktop-light",
            "file": "article-editor.png",
            "route": "ManageWriteArticle",
            "viewport": "desktop",
            "theme": "light",
            "scope": "admin"
        },
        {
            "id": "comment-moderation-desktop-light",
            "file": "comment-moderation.png",
            "route": "ManageModerationComments",
            "viewport": "desktop",
            "theme": "light",
            "scope": "admin"
        },
        {
            "id": "operations-status-desktop-light",
            "file": "operations-status.png",
            "route": "ManageOpsHealth",
            "viewport": "desktop",
            "theme": "light",
            "scope": "admin"
        },
        {
            "id": "public-home-desktop-dark",
            "file": "public-dark.png",
            "route": "Home",
            "viewport": "desktop",
            "theme": "dark",
            "scope": "anonymous"
        },
        {
            "id": "public-home-desktop-light",
            "file": "public-home-light.png",
            "route": "Home",
            "viewport": "desktop",
            "theme": "light",
            "scope": "anonymous"
        },
        {
            "id": "security-console-desktop-light",
            "file": "security-console.png",
            "route": "ManageSecurityDashboard",
            "viewport": "desktop",
            "theme": "light",
            "scope": "admin"
        }
    ],
    "visualInputs": {
        "capture": [
            "config/docs/public-preview-screenshots.json",
            "src/frontend/playwright.config.ts",
            "tests/browser-contract/public-preview-gallery.mjs",
            "tests/frontend/e2e/manual/manual-layout-screenshots.spec.ts",
            "tests/frontend/support/playwright",
            "config/docs/public-preview-quality-policy.json",
            "tools/docs/public-preview-registry.mjs",
            "tools/docs/public-preview-registry.d.ts",
            "tools/docs/public-preview-quality.mjs",
            "tools/docs/public-preview-quality-contract.mjs",
            "tools/docs/public-preview-quality-dom.mjs",
            "tools/docs/public-preview-quality-runtime.mjs",
            "tools/docs/public-preview-quality.d.ts",
            "tests/frontend/e2e/manual/public-preview-quality-capture.spec.ts",
            "config/docs/public-preview-quality-scenarios-public.json",
            "config/docs/public-preview-quality-scenarios-task.json",
            "config/docs/public-preview-quality-scenarios-zoom.json"
        ],
        "dependencies": [
            {
                "path": "src/frontend/package.json",
                "jsonKeys": [
                    "dependencies",
                    "devDependencies",
                    "overrides"
                ]
            },
            "src/frontend/package-lock.json",
            "src/frontend/vite.config.ts",
            "src/frontend/scripts/fsusui-local.ts"
        ],
        "fixtures": [
            "src/frontend/public/fixtures",
            "tests/frontend/fixtures",
            "tests/frontend/support/playwright/routeAuditFixtures.ts",
            "tools/test-fixtures/producers/public-content-producer.mjs"
        ],
        "localization": [
            "src/frontend/src/locales"
        ],
        "routes": [
            "src/frontend/src/router",
            "src/frontend/src/views"
        ],
        "sharedFrontend": [
            "src/frontend/src/adapters",
            "src/frontend/src/api",
            "src/frontend/src/bootstrap",
            "src/frontend/src/codecs",
            "src/frontend/src/composables",
            "src/frontend/src/composition",
            "src/frontend/src/config",
            "src/frontend/src/contracts",
            "src/frontend/src/generated",
            "src/frontend/src/performance",
            "src/frontend/src/policies",
            "src/frontend/src/privacy",
            "src/frontend/src/public-renderers",
            "src/frontend/src/security",
            "src/frontend/src/services",
            "src/frontend/src/store",
            "src/frontend/src/ui-contracts",
            "src/frontend/src/ui-tokens",
            "src/frontend/src/utils",
            "src/frontend/src/view-contracts",
            "src/frontend/src/workers"
        ],
        "visualSystem": [
            "src/frontend/src/App.vue",
            "src/frontend/src/assets",
            "src/frontend/src/components",
            "src/frontend/src/fsusui",
            "src/frontend/src/layouts",
            "src/frontend/src/main.ts"
        ]
    },
    "qualityPolicyFile": "config/docs/public-preview-quality-policy.json",
    "qualityScenarioFiles": [
        "config/docs/public-preview-quality-scenarios-public.json",
        "config/docs/public-preview-quality-scenarios-task.json",
        "config/docs/public-preview-quality-scenarios-zoom.json"
    ]
}
