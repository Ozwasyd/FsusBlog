# FsusBlog public-preview local development example.
# Copy to .env only for local experiments. Do not use these values in production.

GITHUB_PACKAGES_TOKEN=replace-with-read-packages-token

FSUSBLOG_DEV_POSTGRES_DB=fsusblog
FSUSBLOG_DEV_POSTGRES_USER=fsusblog
FSUSBLOG_DEV_POSTGRES_PASSWORD=fsusblog_dev
FSUSBLOG_DEV_POSTGRES_PORT=5432
FSUSBLOG_DEV_REDIS_PORT=6379

# Production compose examples use different variables and must be replaced with real deployment values.
SITE_BASEURL=http://127.0.0.1:3000
CORS_ALLOWED_HOSTS=http://localhost:3000,http://127.0.0.1:3000
APP_ALLOWED_HOSTS=localhost
FIDO2_SERVER_DOMAIN=localhost
FIDO2_SERVER_NAME=FsusBlog
