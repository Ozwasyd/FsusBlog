# Copy to .env.production and replace every CHANGE_ME value before deployment.
# Never run production with this example directly.

# Blue/Green 主机槽位。release identity/container/project/派生卷由发布链路注入。
# 不要在此固定以下容器运行时变量：
# - FSUSBLOG_RELEASE_ID：来自经校验的 --release-manifest；
# - FSUSBLOG_RELEASE_MANIFEST_PATH=/app/release-manifest.json：Compose 将同一主机 manifest 只读挂载到该路径；
# - FSUSBLOG_RELEASE_DERIVED_ROOT=/app/release-derived：由下方 shared derived volume 提供持久化根。
# FSUSBLOG_IMAGE_REF、FSUSBLOG_CONTAINER_NAME 与临时 FSUSBLOG_RELEASE_MANIFEST_HOST_PATH 同样由发布链路管理。
# release-worker-observer-service 仅由 zero-downtime Test 演练按阶段启动和回收；不要把
# ASPNETCORE_ENVIRONMENT=Test、FSUSBLOG_ROLLOUT_REHEARSAL、FSUSBLOG_WORKER_OBSERVER_* 写入生产 env。
FSUSBLOG_BLUE_PORT=8081
FSUSBLOG_GREEN_PORT=8082
FSUSBLOG_SLOT_STATE_FILE=/var/lib/fsusblog/deployment/slots.json
FSUSBLOG_DEPLOYMENT_LOCK_FILE=/var/lock/fsusblog-deployment.lock
FSUSBLOG_GATEWAY_ACTIVE_UPSTREAM=/etc/openresty/fsusblog/active-upstream.conf
FSUSBLOG_GATEWAY_CONFIG_FILE=/etc/openresty/nginx.conf
FSUSBLOG_GATEWAY_PUBLIC_PROBE_URL=https://CHANGE_ME_PRODUCTION_HOST/health/ready
FSUSBLOG_GATEWAY_EVIDENCE_DIR=/var/lib/fsusblog/deployment/evidence
FSUSBLOG_DRAIN_TIMEOUT_SECONDS=45
FSUSBLOG_DEPLOYMENT_NOTIFICATION_DRILL_ENABLED=false
# Active-release fence availability window. 5000/30 means six failed durable-witness
# refreshes before the production host requests graceful shutdown.
ACTIVE_RELEASE_FENCE_REFRESH_INTERVAL_MS=5000
ACTIVE_RELEASE_FENCE_STALE_THRESHOLD_SECONDS=30
# 必须大于应用 drain timeout；Compose duration 格式。
FSUSBLOG_STOP_GRACE_PERIOD=60s
FSUSBLOG_SHARED_PUBLIC_ASSETS_VOLUME=CHANGE_ME_MIGRATED_PUBLIC_ASSETS_VOLUME_NAME
FSUSBLOG_SHARED_DATA_PROTECTION_VOLUME=fsusblog-data-protection
FSUSBLOG_SHARED_RELEASE_DERIVED_VOLUME=fsusblog-release-derived
FSUSBLOG_RELEASE_ASSET_STORE=/var/lib/fsusblog/release-assets
# 双实例短暂重叠的可用资源下限；只能按实测工作集调整，不能用 0 绕过生产预检。
FSUSBLOG_SLOT_MIN_AVAILABLE_MEMORY_MB=1536
FSUSBLOG_SLOT_MIN_FREE_DISK_MB=2048
FSUSBLOG_SLOT_IMAGE_PULL_RESERVE_MB=2048

# 外部基础设施主机名或 Docker 网络内服务名
EXTERNAL_DB_HOST=global-postgres
EXTERNAL_REDIS_HOST=global-redis

# 数据库凭据
DB_USER=CHANGE_ME_DB_USER
DB_PASSWORD=CHANGE_ME_DB_PASSWORD_MIN_32_CHARS
DB_NAME=fsus_blog

# Redis 凭据。生产启动校验会拒绝空密码。
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_MIN_32_CHARS

# JWT 签名密钥。使用 openssl rand -base64 48 生成，不要复用示例。
Jwt__SecretKey=CHANGE_ME_JWT_SECRET_MIN_32_RANDOM_CHARS
Jwt__KeyVersion=CHANGE_ME_JWT_KEY_VERSION
Jwt__RotationWindowDays=30
# During the one-time migration from pre-kid JWTs, set an explicit UTC deadline no later than RotationWindowDays.
# Jwt__LegacyNoKidAcceptUntilUtc=2026-08-14T00:00:00Z
# For a rotation overlap, add Jwt__PreviousKeys__0__Version, __Key and __AcceptUntilUtc.

# 生产必须启用匿名身份/admin principal 平面，禁止 legacy sys_user.role=admin 授权兜底。
FSUSBLOG_ANONYMOUS_IDENTITY_MODE=1

# 生产默认启用 ZK-Prod 强匿名评论 gate。以下值必须来自真实 trusted setup、
# native/managed verifier VK、RFC 9474 blind issuer key 和 root bootstrap evidence；
# 不得使用仓库内 placeholder manifest/hash。
FSUSBLOG_ZK_COMMENT_POLICY_ENABLED=true
FSUSBLOG_ZK_CONFIG_DIR=/srv/fsusblog/zk/config
FSUSBLOG_ZK_SECRET_DIR=/srv/fsusblog/zk/secrets
FSUSBLOG_ZK_NATIVE_VERIFIER_LIB=managed:mcl
FSUSBLOG_ZK_VERIFYING_KEY_HASH=CHANGE_ME_REAL_64_HEX_VERIFYING_KEY_SHA256
FSUSBLOG_ZK_TRUSTED_SETUP_MANIFEST=/app/config/zk/comment-v5-trusted-setup.manifest.json
FSUSBLOG_ZK_VERIFYING_KEY_MANIFEST=/app/config/zk/anonymous-comment-v5-verifying-key.manifest.json
FSUSBLOG_ZK_GROTH16_VERIFYING_KEY=/app/config/zk/comment.v5.vk
FSUSBLOG_ZK_ISSUER_PUBLIC_KEY_ID=CHANGE_ME_PRODUCTION_ISSUER_KEY_ID
FSUSBLOG_ZK_ISSUER_PRIVATE_KEY=/app/secrets/zk/issuer-private.key
FSUSBLOG_ZK_ISSUER_PUBLIC_KEY_HASH=CHANGE_ME_REAL_64_HEX_ISSUER_PUBLIC_KEY_SHA256
FSUSBLOG_ZK_BLIND_ISSUER_ENABLED=true

# 站点配置。生产必须使用 HTTPS origin。
SITE_BASEURL=https://fsus.blog
CORS_ALLOWED_HOSTS=https://fsus.blog,https://www.fsus.blog
APP_ALLOWED_HOSTS=fsus.blog;www.fsus.blog

# 反向代理信任边界。主机 OpenResty/Nginx 代理到活动槽位 127.0.0.1:8081/8082 时保留默认值；
# 若网关在私有网段或独立容器中，改为精确 IP 或 CIDR，不要使用 0.0.0.0/0。
REVERSE_PROXY_KNOWN_PROXIES=127.0.0.1
REVERSE_PROXY_KNOWN_NETWORKS=

# Passkey / WebAuthn 生产来源。ServerDomain 必须与 SITE_BASEURL host 对齐。
FIDO2_SERVER_DOMAIN=fsus.blog
FIDO2_SERVER_NAME=FsusBlog
