            "baselineQuantile": 0.95,
            "growthAllowancePercent": 10
        },
        "ServiceDomainLogic": {
            "baselineQuantile": 0.95,
            "growthAllowancePercent": 8
        },
        "CodecProtocol": {
            "baselineQuantile": 0.95,
            "growthAllowancePercent": 8
        },
        "GeneratedContract": {
            "baselineQuantile": 1,
            "growthAllowancePercent": 100
        },
        "VueViewComponent": {
            "baselineQuantile": 0.95,
            "growthAllowancePercent": 10
        },
        "BuildTestOrchestrator": {
