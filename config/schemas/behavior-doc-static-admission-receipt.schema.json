{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "fsusblog.behavior-doc-static-admission-receipt.v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "run",
        "source",
        "worktree",
        "toolchain",
        "authorityDigests",
        "implementationOwner",
        "factObservations",
        "minimalContractBuild",
        "generated",
        "prose",
        "mutationFixtures",
        "candidateSpawnCountBeforeReceipt",
        "status",
        "failureReasons",
        "durationMs",
        "contentDigest"
    ],
    "properties": {
        "schema": {
            "const": "fsusblog.behavior-doc-static-admission-receipt.v1"
        },
        "run": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "commit",
                "worktreeFingerprint"
            ],
            "properties": {
                "commit": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                },
                "worktreeFingerprint": {
                    "$ref": "#/$defs/digest"
                }
            }
        },
        "worktree": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "root"
            ],
            "properties": {
                "root": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "toolchain": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "node",
                "dotnet",
                "platform",
                "architecture",
                "directoryBuildPropsDigest"
            ],
            "properties": {
                "node": {
                    "type": "string",
                    "minLength": 1
                },
                "dotnet": {
                    "type": "string",
                    "minLength": 1
                },
                "platform": {
                    "type": "string",
                    "minLength": 1
                },
                "architecture": {
                    "type": "string",
                    "minLength": 1
                },
                "directoryBuildPropsDigest": {
                    "$ref": "#/$defs/digest"
                }
            }
        },
        "authorityDigests": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "catalog": {
                    "$ref": "#/$defs/digest"
                },
                "claim": {
                    "$ref": "#/$defs/digest"
                },
                "extractorRegistry": {
                    "$ref": "#/$defs/digest"
                },
                "generatedSectionCatalog": {
                    "$ref": "#/$defs/digest"
                },
                "generatedRenderer": {
                    "$ref": "#/$defs/digest"
                },
                "proseRenderer": {
                    "$ref": "#/$defs/digest"
                },
                "mutationCatalog": {
                    "$ref": "#/$defs/digest"
                }
            }
        },
        "implementationOwner": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "status",
                "bindingCount",
                "contentDigest"
            ],
            "properties": {
                "status": {
                    "enum": [
                        "ok",
                        "failed"
                    ]
                },
                "bindingCount": {
                    "type": "integer",
                    "minimum": 0
                },
                "contentDigest": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/digest"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            }
        },
        "factObservations": {
            "type": "object",
            "additionalProperties": {
                "$ref": "#/$defs/factObservation"
            }
        },
        "minimalContractBuild": {
            "anyOf": [
                {
                    "$ref": "#/$defs/minimalContractBuild"
                },
                {
                    "type": "null"
                }
            ]
        },
        "generated": {
            "$ref": "#/$defs/generatedResult"
        },
        "prose": {
            "$ref": "#/$defs/proseResult"
        },
        "mutationFixtures": {
            "$ref": "#/$defs/mutationResult"
        },
        "candidateSpawnCountBeforeReceipt": {
            "type": "integer",
            "minimum": 0
        },
        "status": {
            "enum": [
                "ok",
                "failed"
            ]
        },
        "failureReasons": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "durationMs": {
            "type": "integer",
            "minimum": 0
        },
        "contentDigest": {
            "$ref": "#/$defs/digest"
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "status": {
                        "const": "ok"
                    }
                },
                "required": [
                    "status"
                ]
            },
            "then": {
                "properties": {
                    "authorityDigests": {
                        "type": "object",
                        "required": [
                            "catalog",
                            "claim",
                            "extractorRegistry",
                            "generatedSectionCatalog",
                            "generatedRenderer",
                            "proseRenderer",
                            "mutationCatalog"
                        ]
                    },
                    "implementationOwner": {
                        "type": "object",
                        "properties": {
                            "status": {
                                "const": "ok"
                            },
                            "bindingCount": {
                                "type": "integer",
                                "minimum": 1
                            },
                            "contentDigest": {
                                "type": "string",
                                "$ref": "#/$defs/digest"
                            }
                        }
                    },
                    "factObservations": {
                        "type": "object",
                        "minProperties": 1
                    },
                    "minimalContractBuild": {
                        "$ref": "#/$defs/minimalContractBuild"
                    },
                    "generated": {
                        "$ref": "#/$defs/successfulGeneratedResult"
                    },
                    "prose": {
                        "$ref": "#/$defs/successfulProseResult"
                    },
                    "mutationFixtures": {
                        "$ref": "#/$defs/successfulMutationResult"
                    },
                    "candidateSpawnCountBeforeReceipt": {
                        "type": "integer",
                        "const": 0
                    },
                    "failureReasons": {
                        "type": "array",
                        "maxItems": 0
                    }
                }
            },
            "else": {
                "properties": {
                    "failureReasons": {
                        "type": "array",
                        "minItems": 1
                    }
                }
            }
        }
    ],
    "$defs": {
        "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
        },
        "prefixedDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "externalExecutableIdentity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "canonicalPath",
                "digest",
                "version"
            ],
            "properties": {
                "canonicalPath": {
                    "type": "string",
                    "pattern": "^/"
                },
                "digest": {
                    "$ref": "#/$defs/digest"
                },
                "version": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "factObservation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "status",
                "extractorDigest",
                "semanticDigest",
                "contentDigest"
            ],
            "properties": {
                "status": {
                    "const": "ok"
                },
                "extractorDigest": {
                    "$ref": "#/$defs/digest"
                },
                "semanticDigest": {
                    "$ref": "#/$defs/digest"
                },
                "contentDigest": {
                    "$ref": "#/$defs/digest"
                }
            }
        },
        "minimalContractBuild": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema",
                "runId",
                "sourceCommit",
                "worktreeFingerprint",
                "toolchain",
                "buildKey",
                "buildRoot",
                "sourceClosureDigests",
                "artifacts",
                "status",
                "failureReasons",
                "contentDigest"
            ],
            "properties": {
                "schema": {
                    "const": "fsusblog.behavior-doc-minimal-contract-build-receipt.v1"
                },
                "runId": {
                    "type": "string",
                    "minLength": 1
                },
                "sourceCommit": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                },
                "worktreeFingerprint": {
                    "$ref": "#/$defs/digest"
                },
                "toolchain": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "dotnet",
                        "configuration",
                        "targetFramework"
                    ],
                    "properties": {
                        "dotnet": {
                            "type": "string",
                            "minLength": 1
                        },
                        "configuration": {
                            "const": "Release"
                        },
                        "targetFramework": {
                            "const": "net10.0"
                        }
                    }
                },
                "buildKey": {
                    "$ref": "#/$defs/digest"
                },
                "buildRoot": {
                    "type": "string",
                    "pattern": "^\\.tmp/behavior-doc-contract-builds/[a-f0-9]{64}$"
                },
                "sourceClosureDigests": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "path",
                            "digest"
                        ],
                        "properties": {
                            "path": {
                                "type": "string",
                                "minLength": 1
                            },
                            "digest": {
                                "$ref": "#/$defs/digest"
                            }
                        }
                    }
                },
                "sourceDigest": {
                    "$ref": "#/$defs/digest"
                },
                "artifacts": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "runtime-role-observation",
                        "openapi-aeds-observation",
                        "auth-session-permission-observation",
                        "config-error-security-policy-observation",
                        "content-lifecycle-observation"
                    ],
                    "properties": {
                        "runtime-role-observation": {
                            "$ref": "#/$defs/runtimeRoleMinimalArtifact"
                        },
                        "openapi-aeds-observation": {
                            "$ref": "#/$defs/openApiMinimalArtifact"
                        },
                        "auth-session-permission-observation": {
                            "$ref": "#/$defs/genericMinimalArtifact"
                        },
                        "config-error-security-policy-observation": {
                            "$ref": "#/$defs/genericMinimalArtifact"
                        },
                        "content-lifecycle-observation": {
                            "$ref": "#/$defs/genericMinimalArtifact"
                        }
                    }
                },
                "status": {
                    "const": "ok"
                },
                "failureReasons": {
                    "type": "array",
                    "maxItems": 0
                },
                "contentDigest": {
                    "$ref": "#/$defs/digest"
                }
            }
        },
        "genericMinimalArtifact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "project",
                "projectDigest",
                "path",
                "artifactPath",
                "artifactDigest",
                "buildReceipt"
            ],
            "properties": {
                "project": {
                    "type": "string",
                    "minLength": 1
                },
                "projectDigest": {
                    "$ref": "#/$defs/digest"
                },
                "path": {
                    "type": "string",
                    "minLength": 1
                },
                "artifactPath": {
                    "type": "string",
                    "minLength": 1
                },
                "artifactDigest": {
                    "$ref": "#/$defs/digest"
                },
                "buildReceipt": {
                    "$ref": "#/$defs/genericMinimalBuildReceipt"
                }
            }
        },
        "openApiMinimalArtifact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "project",
                "projectDigest",
                "path",
                "artifactPath",
                "artifactDigest",
                "buildReceipt"
            ],
            "properties": {
                "project": {
                    "const": "tools/contracts/FsusBlog.OpenApiObservation/FsusBlog.OpenApiObservation.csproj"
                },
                "projectDigest": {
                    "$ref": "#/$defs/digest"
                },
                "path": {
                    "type": "string",
                    "pattern": "^\\.tmp/behavior-doc-contract-builds/[a-f0-9]{64}/observations/openapi-aeds-observation\\.json$"
                },
                "artifactPath": {
                    "const": ".tmp/contracts/openapi/api-aeds-observation.json"
                },
                "artifactDigest": {
                    "$ref": "#/$defs/digest"
                },
                "buildReceipt": {
                    "$ref": "#/$defs/openApiMinimalBuildReceipt"
                }
            }
        },
        "runtimeRoleMinimalArtifact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "project",
                "projectDigest",
                "path",
                "artifactPath",
                "artifactDigest",
                "assemblyPath",
                "assemblyDigest",
                "deploymentArtifactPath",
                "deploymentArtifactDigest",
                "buildReceipt"
            ],
            "properties": {
                "project": {
                    "const": "tools/contracts/FsusBlog.RuntimeRoleObservation/FsusBlog.RuntimeRoleObservation.csproj"
                },
                "projectDigest": {
                    "$ref": "#/$defs/digest"
                },
                "path": {
                    "type": "string",
                    "pattern": "^\\.tmp/behavior-doc-contract-builds/[a-f0-9]{64}/observations/runtime-role-observation\\.json$"
                },
                "artifactPath": {
                    "const": ".tmp/contracts/runtime-role/runtime-role-observation.json"
                },
                "artifactDigest": {
                    "$ref": "#/$defs/digest"
                },
                "assemblyPath": {
                    "type": "string",
                    "pattern": "^\\.tmp/runtime-role-reproducible-builds/[a-f0-9]{64}/bin/FsusBlog\\.RuntimeRoleObservation/release/FsusBlog\\.RuntimeRoleObservation\\.dll$"
                },
                "assemblyDigest": {
                    "$ref": "#/$defs/digest"
                },
                "deploymentArtifactPath": {
                    "type": "string",
                    "pattern": "^\\.tmp/behavior-doc-contract-builds/[a-f0-9]{64}/observations/runtime-role-deployment-observation\\.json$"
                },
                "deploymentArtifactDigest": {
                    "$ref": "#/$defs/digest"
                },
                "buildReceipt": {
                    "$ref": "#/$defs/runtimeRoleMinimalBuildReceipt"
                }
            }
        },
        "genericMinimalBuildReceipt": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema",
                "artifactId",
                "artifactPath",
                "artifactDigest",
                "configuration"
            ],
            "properties": {
                "schema": {
                    "type": "string",
                    "pattern": "^fsusblog\\.[a-z0-9-]+-build-receipt\\.v1$"
                },
                "artifactId": {
                    "type": "string",
                    "minLength": 1
                },
                "artifactPath": {
                    "type": "string",
                    "minLength": 1
                },
                "artifactDigest": {
                    "$ref": "#/$defs/digest"
                },
                "configuration": {
                    "const": "Release"
                }
            }
        },
        "openApiMinimalBuildReceipt": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema",
                "artifactId",
                "artifactPath",
                "artifactDigest",
                "configuration",
                "openapiPath",
                "openapiArtifactPath",
                "openapiDigest"
            ],
            "properties": {
                "schema": {
                    "const": "fsusblog.openapi-aeds-observation-build-receipt.v1"
                },
                "artifactId": {
                    "const": "openapi-aeds-observation"
                },
                "artifactPath": {
                    "const": ".tmp/contracts/openapi/api-aeds-observation.json"
                },
                "artifactDigest": {
                    "$ref": "#/$defs/digest"
                },
                "configuration": {
                    "const": "Release"
                },
                "openapiPath": {
                    "type": "string",
                    "pattern": "^\\.tmp/behavior-doc-contract-builds/[a-f0-9]{64}/observations/fsusblog\\.openapi\\.observed\\.json$"
                },
                "openapiArtifactPath": {
                    "const": ".tmp/contracts/openapi/fsusblog.openapi.observed.json"
                },
                "openapiDigest": {
                    "$ref": "#/$defs/digest"
                }
            }
        },
        "runtimeRoleMinimalBuildReceipt": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema",
                "artifactId",
                "artifactPath",
                "artifactDigest",
                "configuration",
                "sourceCommit",
                "worktreeFingerprint",
                "projectDigest",
                "assemblyPath",
                "assemblyDigest",
                "reproducibleBuild",
                "deploymentArtifactPath",
                "deploymentArtifactDigest",
                "producer",
                "externalOracle",
                "externalOracleVersion",
                "dockerExecutable",
                "composeImplementation",
                "effectiveComposeModelDigest",
                "deploymentAuthoritySchema",
                "deploymentAuthorityContentDigest",
                "deploymentObservationDigest",
                "observationSchema",
                "evidenceStage",
                "evidenceClass"
            ],
            "properties": {
                "schema": {
                    "const": "fsusblog.runtime-role-observation-build-receipt.v4"
                },
                "artifactId": {
                    "const": "runtime-role-observation"
                },
                "artifactPath": {
                    "const": ".tmp/contracts/runtime-role/runtime-role-observation.json"
                },
                "artifactDigest": {
                    "$ref": "#/$defs/digest"
                },
                "configuration": {
                    "const": "Release"
                },
                "sourceCommit": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                },
                "worktreeFingerprint": {
                    "$ref": "#/$defs/digest"
                },
                "projectDigest": {
                    "$ref": "#/$defs/digest"
                },
                "assemblyPath": {
                    "type": "string",
                    "pattern": "^\\.tmp/runtime-role-reproducible-builds/[a-f0-9]{64}/bin/FsusBlog\\.RuntimeRoleObservation/release/FsusBlog\\.RuntimeRoleObservation\\.dll$"
                },
                "assemblyDigest": {
                    "$ref": "#/$defs/digest"
                },
                "reproducibleBuild": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "schema",
                        "project",
                        "command",
                        "outputRoot",
                        "assemblyPath",
                        "assemblyDigest",
                        "sourceClosureDigest"
                    ],
                    "properties": {
                        "schema": {
                            "const": "fsusblog.runtime-role-reproducible-build-attestation.v1"
                        },
                        "project": {
                            "const": "tools/contracts/FsusBlog.RuntimeRoleObservation/FsusBlog.RuntimeRoleObservation.csproj"
                        },
                        "command": {
                            "type": "array",
                            "minItems": 14,
                            "maxItems": 14,
                            "prefixItems": [
                                {
                                    "const": "dotnet"
                                },
                                {
                                    "const": "build"
                                },
                                {
                                    "const": "tools/contracts/FsusBlog.RuntimeRoleObservation/FsusBlog.RuntimeRoleObservation.csproj"
                                },
                                {
                                    "const": "--configuration"
                                },
                                {
                                    "const": "Release"
                                },
                                {
                                    "const": "--no-incremental"
                                },
                                {
                                    "const": "--disable-build-servers"
                                },
                                {
                                    "const": "--artifacts-path"
                                },
                                {
                                    "type": "string",
                                    "pattern": "^\\.tmp/runtime-role-reproducible-builds/[a-f0-9]{64}$"
                                },
                                {
                                    "const": "/p:Deterministic=true"
                                },
                                {
                                    "const": "/p:ContinuousIntegrationBuild=true"
                                },
                                {
                                    "const": "/p:PathMap={OUTPUT_ROOT}=/_/artifacts%2C{REPOSITORY_ROOT}=/_/src"
                                },
                                {
                                    "const": "/p:NuGetAudit=false"
                                },
                                {
                                    "const": "/m:1"
                                }
                            ],
                            "items": false
                        },
                        "outputRoot": {
                            "type": "string",
                            "pattern": "^\\.tmp/runtime-role-reproducible-builds/[a-f0-9]{64}$"
                        },
                        "assemblyPath": {
                            "type": "string",
                            "pattern": "^\\.tmp/runtime-role-reproducible-builds/[a-f0-9]{64}/bin/FsusBlog\\.RuntimeRoleObservation/release/FsusBlog\\.RuntimeRoleObservation\\.dll$"
                        },
                        "assemblyDigest": {
                            "$ref": "#/$defs/digest"
                        },
                        "sourceClosureDigest": {
                            "$ref": "#/$defs/digest"
                        }
                    }
                },
                "deploymentArtifactPath": {
                    "type": "string",
                    "pattern": "^\\.tmp/behavior-doc-contract-builds/[a-f0-9]{64}/observations/runtime-role-deployment-observation\\.json$"
                },
                "deploymentArtifactDigest": {
                    "$ref": "#/$defs/digest"
                },
                "producer": {
                    "const": "dotnet-run-content-addressed-minimal-contract-host"
                },
                "externalOracle": {
                    "const": "docker-compose-config-json-no-interpolate"
                },
                "externalOracleVersion": {
                    "type": "string",
                    "minLength": 1
                },
                "dockerExecutable": {
                    "$ref": "#/$defs/externalExecutableIdentity"
                },
                "composeImplementation": {
                    "$ref": "#/$defs/externalExecutableIdentity"
                },
                "effectiveComposeModelDigest": {
                    "$ref": "#/$defs/prefixedDigest"
                },
                "deploymentAuthoritySchema": {
                    "const": "fsusblog.monolithic-distributed-architecture.v2"
                },
                "deploymentAuthorityContentDigest": {
                    "$ref": "#/$defs/prefixedDigest"
                },
                "deploymentObservationDigest": {
                    "$ref": "#/$defs/prefixedDigest"
                },
                "observationSchema": {
                    "const": "fsusblog.runtime-role-observation.v3"
                },
                "evidenceStage": {
                    "const": "pre-runtime"
                },
                "evidenceClass": {
                    "const": "compiled-production-code-model"
                }
            }
        },
        "generatedResult": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "status",
                "contentDigest"
            ],
            "properties": {
                "status": {
                    "enum": [
                        "ok",
                        "failed"
                    ]
                },
                "documentCount": {
                    "type": "integer",
                    "minimum": 0
                },
                "contentDigest": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/digest"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            }
        },
        "successfulGeneratedResult": {
            "allOf": [
                {
                    "$ref": "#/$defs/generatedResult"
                },
                {
                    "type": "object",
                    "required": [
                        "documentCount"
                    ],
                    "properties": {
                        "status": {
                            "const": "ok"
                        },
                        "documentCount": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "contentDigest": {
                            "type": "string",
                            "$ref": "#/$defs/digest"
                        }
                    }
                }
            ]
        },
        "proseResult": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "status",
                "contentDigest"
            ],
            "properties": {
                "status": {
                    "enum": [
                        "ok",
                        "failed"
                    ]
                },
                "verifiedClaimCount": {
                    "type": "integer",
                    "minimum": 0
                },
                "contentDigest": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/digest"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            }
        },
        "successfulProseResult": {
            "allOf": [
                {
                    "$ref": "#/$defs/proseResult"
                },
                {
                    "type": "object",
                    "required": [
                        "verifiedClaimCount"
                    ],
                    "properties": {
                        "status": {
                            "const": "ok"
                        },
                        "verifiedClaimCount": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "contentDigest": {
                            "type": "string",
