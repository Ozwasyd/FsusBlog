{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fsusblog.behavior-document-consistency-final-report.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sourceIdentity", "worktreeIdentity", "buildIdentity", "toolchainIdentity", "runtimeIdentity", "authorityDigests", "receiptDigests", "behaviorNodes", "edges", "migrationLedger", "singleMutationCoverage", "zeroLegacyScan", "dagAudit", "spawnBeforeReceipt", "status", "failureReasons", "contentDigest"],
  "properties": {
    "schema": { "const": "fsusblog.behavior-document-consistency-final-report.v1" },
    "sourceIdentity": { "type": "object" },
    "worktreeIdentity": { "type": "object" },
    "buildIdentity": { "type": "object" },
    "toolchainIdentity": { "type": "object" },
    "runtimeIdentity": { "type": "object" },
    "authorityDigests": { "type": "object", "additionalProperties": { "$ref": "#/$defs/digest" } },
    "receiptDigests": { "type": "object" },
    "behaviorNodes": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "edges": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "migrationLedger": { "type": "object" },
    "singleMutationCoverage": { "type": "object" },
    "zeroLegacyScan": { "type": "object" },
    "dagAudit": { "type": "object" },
    "spawnBeforeReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["staticCandidate", "runtimeCandidate", "releaseFinal"],
      "properties": {
        "staticCandidate": { "const": 0 },
        "runtimeCandidate": { "const": 0 },
        "releaseFinal": { "const": 0 }
      }
    },
    "status": { "enum": ["ok", "failed"] },
    "failureReasons": { "type": "array", "items": { "type": "string" } },
    "contentDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
