{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fsusblog.behavior-evidence-post-runtime-receipt.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scope", "runIdentity", "sourceIdentity", "candidateIdentity", "preRuntimeReceiptDigest", "catalogDigest", "behaviorIds", "requiredRuntimeProducers", "observedBehaviorResults", "documentClaimDigests", "missing", "orphans", "conflicts", "releaseFinalSpawnCountBeforeReceipt", "status", "failureReasons", "contentDigest"],
  "properties": {
    "schema": { "const": "fsusblog.behavior-evidence-post-runtime-receipt.v1" },
    "scope": { "const": "post-runtime" },
    "runIdentity": { "type": "string", "minLength": 1 },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "worktreeFingerprint"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "worktreeFingerprint": { "$ref": "#/$defs/digest" }
      }
    },
    "candidateIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buildReceiptDigest", "runtimeEvidenceDigest", "browserContractDigest"],
      "properties": {
        "buildReceiptDigest": { "$ref": "#/$defs/nullableDigest" },
        "runtimeEvidenceDigest": { "$ref": "#/$defs/nullableDigest" },
        "browserContractDigest": { "$ref": "#/$defs/nullableDigest" }
      }
    },
    "preRuntimeReceiptDigest": { "$ref": "#/$defs/digest" },
    "catalogDigest": { "$ref": "#/$defs/digest" },
    "behaviorIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "requiredRuntimeProducers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "observedBehaviorResults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["behaviorId", "producerTierId", "observationSchema", "status", "evidenceDigest"],
        "properties": {
          "behaviorId": { "type": "string" },
          "producerTierId": { "type": "string" },
          "observationSchema": { "type": "string" },
          "status": { "enum": ["ok", "failed"] },
          "evidenceDigest": { "$ref": "#/$defs/nullableDigest" }
        }
      }
    },
    "documentClaimDigests": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/digest" }
    },
    "missing": { "$ref": "#/$defs/findings" },
    "orphans": { "$ref": "#/$defs/findings" },
    "conflicts": { "$ref": "#/$defs/findings" },
    "releaseFinalSpawnCountBeforeReceipt": { "const": 0 },
    "status": { "enum": ["ok", "failed"] },
    "failureReasons": { "type": "array", "items": { "type": "string" } },
    "contentDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "nullableDigest": {
      "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "behaviorId", "anchor", "reason"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "behaviorId": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
          "anchor": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
