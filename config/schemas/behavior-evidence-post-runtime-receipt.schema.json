{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "fsusblog.behavior-evidence-post-runtime-receipt.v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "scope",
        "runIdentity",
        "sourceIdentity",
        "candidateIdentity",
        "preRuntimeReceiptDigest",
        "catalogDigest",
        "behaviorIds",
        "requiredRuntimeProducers",
        "observedBehaviorResults",
        "observationArtifactDigests",
        "documentClaimDigests",
        "missing",
        "orphans",
        "conflicts",
        "releaseFinalSpawnCountBeforeReceipt",
        "status",
        "failureReasons",
        "contentDigest",
        "executionIdentity",
        "executionContext",
        "schedulerEvidence",
        "observationRefs",
        "acceptedClaimRefs",
        "registryDigest",
        "documentClaimTerminals",
        "requiredProducerClasses",
        "observedProducerClasses",
        "stale",
        "diagnostics",
        "findingCounts"
    ],
    "properties": {
        "schema": {
            "const": "fsusblog.behavior-evidence-post-runtime-receipt.v1"
        },
        "scope": {
            "const": "post-runtime"
        },
        "runIdentity": {
            "type": "string",
            "minLength": 1
        },
        "sourceIdentity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "commit",
                "worktreeFingerprint"
            ],
            "properties": {
                "commit": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                },
                "worktreeFingerprint": {
                    "$ref": "#/$defs/digest"
                }
            }
        },
        "candidateIdentity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "sourceCommit",
                "worktreeFingerprint",
                "buildIdentity",
                "candidateId",
                "runtimeId",
                "browserIdentity",
                "releaseId",
                "rolloutId",
                "runId",
                "attemptId",
                "fixtureId",
                "profileId"
            ],
            "properties": {
                "sourceCommit": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                },
                "worktreeFingerprint": {
                    "$ref": "#/$defs/digest"
                },
                "buildIdentity": {
                    "$ref": "#/$defs/digest"
                },
                "candidateId": {
                    "type": "string",
                    "minLength": 1
                },
                "runtimeId": {
                    "type": "string",
                    "minLength": 1
                },
                "browserIdentity": {
                    "type": "string",
                    "minLength": 1
                },
                "releaseId": {
                    "type": "string",
                    "minLength": 1
                },
                "rolloutId": {
                    "type": "string",
                    "minLength": 1
                },
                "runId": {
                    "type": "string",
                    "minLength": 1
                },
                "attemptId": {
                    "type": "string",
                    "pattern": "^attempt-[0-9]{4}$"
                },
                "fixtureId": {
                    "type": "string",
                    "minLength": 1
                },
                "profileId": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "preRuntimeReceiptDigest": {
            "$ref": "#/$defs/digest"
        },
        "catalogDigest": {
            "$ref": "#/$defs/digest"
        },
        "behaviorIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string"
            }
        },
        "requiredRuntimeProducers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string"
            }
        },
        "observedBehaviorResults": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "behaviorId",
                    "extractorId",
                    "producerId",
                    "classId",
                    "contentDigest",
                    "artifactDigest",
                    "status"
                ],
                "properties": {
                    "behaviorId": {
                        "type": "string",
                        "minLength": 1
                    },
                    "extractorId": {
                        "type": "string",
                        "minLength": 1
                    },
                    "producerId": {
                        "type": "string",
                        "minLength": 1
                    },
                    "classId": {
                        "type": "string",
                        "minLength": 1
                    },
                    "contentDigest": {
                        "$ref": "#/$defs/digest"
                    },
                    "artifactDigest": {
                        "$ref": "#/$defs/digest"
                    },
                    "status": {
                        "const": "ok"
                    }
                }
            }
        },
        "documentClaimDigests": {
            "type": "object",
            "additionalProperties": {
                "$ref": "#/$defs/digest"
            },
            "minProperties": 1
        },
        "missing": {
            "$ref": "#/$defs/findings"
        },
        "orphans": {
            "$ref": "#/$defs/findings"
        },
        "conflicts": {
            "$ref": "#/$defs/findings"
        },
        "releaseFinalSpawnCountBeforeReceipt": {
            "const": 0
        },
        "status": {
            "enum": [
                "ok",
                "failed"
            ]
        },
        "failureReasons": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "contentDigest": {
            "$ref": "#/$defs/digest"
        },
        "executionIdentity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "commit",
                "worktreeFingerprint",
                "schedulerRunId",
                "attemptId",
                "candidateIdentityDigest",
                "buildIdentityDigest"
            ],
            "properties": {
                "commit": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                },
                "worktreeFingerprint": {
                    "$ref": "#/$defs/digest"
                },
                "schedulerRunId": {
                    "type": "string",
                    "minLength": 1
                },
                "attemptId": {
                    "type": "string",
                    "pattern": "^attempt-[0-9]{4}$"
                },
                "candidateIdentityDigest": {
                    "$ref": "#/$defs/digest"
                },
                "buildIdentityDigest": {
                    "$ref": "#/$defs/digest"
                }
            }
        },
        "executionContext": {
            "$ref": "#/$defs/reference"
        },
        "schedulerEvidence": {
            "$ref": "#/$defs/reference"
        },
        "observationRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/reference"
            }
        },
        "acceptedClaimRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/reference"
            }
        },
        "registryDigest": {
            "$ref": "#/$defs/digest"
        },
        "documentClaimTerminals": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
                "$ref": "#/$defs/digest"
            }
        },
        "observationArtifactDigests": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
                "$ref": "#/$defs/digest"
            }
        },
        "requiredProducerClasses": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "observedProducerClasses": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "stale": {
            "$ref": "#/$defs/findings"
        },
        "diagnostics": {
            "$ref": "#/$defs/findings"
        },
        "findingCounts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "missing",
                "orphans",
                "conflicts",
                "stale",
                "diagnostics"
            ],
            "properties": {
                "missing": {
                    "type": "integer",
                    "minimum": 0
                },
                "orphans": {
                    "type": "integer",
                    "minimum": 0
                },
                "conflicts": {
                    "type": "integer",
                    "minimum": 0
                },
                "stale": {
                    "type": "integer",
                    "minimum": 0
                },
                "diagnostics": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        }
    },
    "$defs": {
        "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "findings": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "kind",
                    "behaviorId",
                    "anchor",
                    "reason"
                ],
                "properties": {
                    "kind": {
                        "type": "string",
                        "minLength": 1
                    },
                    "behaviorId": {
                        "oneOf": [
                            {
                                "type": "string",
                                "minLength": 1
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "anchor": {
                        "type": "string",
                        "minLength": 1
                    },
                    "reason": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        },
        "reference": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "ref",
                "fileDigest",
                "contentDigest"
            ],
            "properties": {
                "ref": {
                    "type": "string",
                    "minLength": 1
                },
                "fileDigest": {
                    "$ref": "#/$defs/digest"
                },
                "contentDigest": {
                    "$ref": "#/$defs/digest"
                }
            }
        }
    }
}
