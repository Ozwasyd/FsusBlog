{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "fsusblog.behavior-evidence-post-runtime-receipt.v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "scope",
        "runIdentity",
        "sourceIdentity",
        "candidateIdentity",
        "executionIdentity",
        "preRuntimeReceiptDigest",
        "staticClaimVerificationDigest",
        "catalogDigest",
        "registryDigest",
        "behaviorIds",
        "requiredRuntimeProducers",
        "requiredObservationScopes",
        "requiredProducerClasses",
        "observedProducerClasses",
        "observedBehaviorResults",
        "observationRefs",
        "acceptedClaimsRef",
        "documentClaimDigests",
        "documentClaimTerminalDigest",
        "schedulerEvidence",
        "missing",
        "orphans",
        "conflicts",
        "stale",
        "diagnostics",
        "findingCounts",
        "releaseFinalSpawnCountBeforeReceipt",
        "status",
        "failureReasons",
        "contentDigest"
    ],
    "properties": {
        "schema": {
            "const": "fsusblog.behavior-evidence-post-runtime-receipt.v1"
        },
        "scope": {
            "const": "post-runtime"
        },
        "runIdentity": {
            "type": "string",
            "minLength": 1
        },
        "sourceIdentity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "commit",
                "worktreeFingerprint"
            ],
            "properties": {
                "commit": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                },
                "worktreeFingerprint": {
                    "$ref": "#/$defs/digest"
                }
            }
        },
        "candidateIdentity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "sourceCommit",
                "worktreeFingerprint",
                "buildIdentity",
                "candidateId",
                "runId",
                "attemptId",
                "fixtureId",
                "profileId",
                "runtimeId",
                "browserId",
                "releaseId",
                "rolloutId"
            ],
            "properties": {
                "sourceCommit": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                },
                "worktreeFingerprint": {
                    "$ref": "#/$defs/digest"
                },
                "buildIdentity": {
                    "$ref": "#/$defs/digest"
                },
                "candidateId": {
                    "$ref": "#/$defs/nonEmptyString"
                },
                "runId": {
                    "$ref": "#/$defs/nonEmptyString"
                },
                "attemptId": {
                    "type": "string",
                    "pattern": "^attempt-[0-9]{4}$"
                },
                "fixtureId": {
                    "$ref": "#/$defs/nonEmptyString"
                },
                "profileId": {
                    "$ref": "#/$defs/nonEmptyString"
                },
                "runtimeId": {
                    "$ref": "#/$defs/nonEmptyString"
                },
                "browserId": {
                    "$ref": "#/$defs/nonEmptyString"
                },
                "releaseId": {
                    "$ref": "#/$defs/nonEmptyString"
                },
                "rolloutId": {
                    "$ref": "#/$defs/nonEmptyString"
                }
            }
        },
        "executionIdentity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "commit",
                "worktreeFingerprint",
                "schedulerRunId",
                "attemptId",
                "candidateIdentityDigest",
                "buildIdentityDigest"
            ],
            "properties": {
                "commit": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                },
                "worktreeFingerprint": {
                    "$ref": "#/$defs/digest"
                },
                "schedulerRunId": {
                    "$ref": "#/$defs/nonEmptyString"
                },
                "attemptId": {
                    "type": "string",
                    "pattern": "^attempt-[0-9]{4}$"
                },
                "candidateIdentityDigest": {
                    "$ref": "#/$defs/digest"
                },
                "buildIdentityDigest": {
                    "$ref": "#/$defs/digest"
                }
            }
        },
        "preRuntimeReceiptDigest": {
            "$ref": "#/$defs/digest"
        },
        "staticClaimVerificationDigest": {
            "oneOf": [
                {
                    "$ref": "#/$defs/digest"
                },
                {
                    "type": "null"
                }
            ]
        },
        "catalogDigest": {
            "$ref": "#/$defs/digest"
        },
        "registryDigest": {
            "$ref": "#/$defs/digest"
        },
        "behaviorIds": {
            "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "requiredRuntimeProducers": {
            "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "requiredObservationScopes": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
                "enum": [
                    "application",
                    "release-deployment"
                ]
            }
        },
        "requiredProducerClasses": {
            "$ref": "#/$defs/stringSetMap"
        },
        "observedProducerClasses": {
            "$ref": "#/$defs/stringSetMap"
        },
        "observedBehaviorResults": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "behaviorId",
                    "extractorId",
                    "producerId",
                    "scope",
                    "classId",
                    "classReceiptPath",
                    "classReceiptDigest",
                    "rawReceiptPath",
                    "rawReceiptDigest",
                    "semanticFactsDigest",
                    "status"
                ],
                "properties": {
                    "behaviorId": {
                        "$ref": "#/$defs/nonEmptyString"
                    },
                    "extractorId": {
                        "$ref": "#/$defs/nonEmptyString"
                    },
                    "producerId": {
                        "$ref": "#/$defs/nonEmptyString"
                    },
                    "scope": {
                        "enum": [
                            "application",
                            "release-deployment"
                        ]
                    },
                    "classId": {
                        "$ref": "#/$defs/nonEmptyString"
                    },
                    "classReceiptPath": {
                        "$ref": "#/$defs/nonEmptyString"
                    },
                    "classReceiptDigest": {
                        "$ref": "#/$defs/digest"
                    },
                    "rawReceiptPath": {
                        "$ref": "#/$defs/nonEmptyString"
                    },
                    "rawReceiptDigest": {
                        "$ref": "#/$defs/digest"
                    },
                    "semanticFactsDigest": {
                        "$ref": "#/$defs/digest"
                    },
                    "status": {
                        "const": "ok"
                    }
                }
            }
        },
        "observationRefs": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
                "$ref": "#/$defs/scopedReference"
            }
        },
        "acceptedClaimsRef": {
            "$ref": "#/$defs/reference"
        },
        "documentClaimDigests": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
                "$ref": "#/$defs/digest"
            }
        },
        "documentClaimTerminalDigest": {
            "$ref": "#/$defs/digest"
        },
        "schedulerEvidence": {
            "$ref": "#/$defs/reference"
        },
        "missing": {
            "$ref": "#/$defs/findings"
        },
        "orphans": {
            "$ref": "#/$defs/findings"
        },
        "conflicts": {
            "$ref": "#/$defs/findings"
        },
        "stale": {
            "$ref": "#/$defs/findings"
        },
        "diagnostics": {
            "$ref": "#/$defs/findings"
        },
        "findingCounts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "missing",
                "orphans",
                "conflicts",
                "stale",
                "diagnostics"
            ],
            "properties": {
                "missing": {
                    "type": "integer",
                    "minimum": 0
                },
                "orphans": {
                    "type": "integer",
                    "minimum": 0
                },
                "conflicts": {
                    "type": "integer",
                    "minimum": 0
                },
                "stale": {
                    "type": "integer",
                    "minimum": 0
                },
                "diagnostics": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        },
        "releaseFinalSpawnCountBeforeReceipt": {
            "const": 0
        },
        "status": {
            "const": "ok"
        },
        "failureReasons": {
            "type": "array",
            "maxItems": 0
        },
        "contentDigest": {
            "$ref": "#/$defs/digest"
        }
    },
    "$defs": {
        "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "nonEmptyString": {
            "type": "string",
            "minLength": 1
        },
        "nonEmptyUniqueStrings": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "$ref": "#/$defs/nonEmptyString"
            }
        },
        "stringSetMap": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
                "$ref": "#/$defs/nonEmptyUniqueStrings"
            }
        },
        "reference": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "path",
                "fileDigest",
                "contentDigest"
            ],
            "properties": {
                "path": {
                    "$ref": "#/$defs/nonEmptyString"
                },
                "fileDigest": {
                    "$ref": "#/$defs/digest"
                },
                "contentDigest": {
                    "$ref": "#/$defs/digest"
                }
            }
        },
        "scopedReference": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "scope",
                "path",
                "fileDigest",
                "contentDigest"
            ],
            "properties": {
                "scope": {
                    "enum": [
                        "application",
                        "release-deployment"
                    ]
                },
                "path": {
                    "$ref": "#/$defs/nonEmptyString"
                },
                "fileDigest": {
                    "$ref": "#/$defs/digest"
                },
                "contentDigest": {
                    "$ref": "#/$defs/digest"
                }
            }
        },
        "findings": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "kind",
                    "behaviorId",
                    "anchor",
                    "reason"
                ],
                "properties": {
                    "kind": {
                        "$ref": "#/$defs/nonEmptyString"
                    },
                    "behaviorId": {
                        "oneOf": [
                            {
                                "$ref": "#/$defs/nonEmptyString"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "anchor": {
                        "$ref": "#/$defs/nonEmptyString"
                    },
                    "reason": {
                        "$ref": "#/$defs/nonEmptyString"
                    }
                }
            }
        }
    }
}
