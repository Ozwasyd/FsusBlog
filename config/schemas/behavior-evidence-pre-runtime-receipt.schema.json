{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "fsusblog.behavior-evidence-pre-runtime-receipt.v1",
    "title": "FsusBlog pre-runtime BehaviorGraph evidence receipt",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "scope",
        "runIdentity",
        "sourceIdentity",
        "buildIdentity",
        "catalogDigest",
        "staticAdmissionDigest",
        "behaviorGraphDigest",
        "testEvidenceDigests",
        "rawResultDigests",
        "mutationEvidenceDigest",
        "behaviorIds",
        "requiredTestKinds",
        "observedTestKinds",
        "mutationStatus",
        "staticClaimVerificationDigest",
        "missing",
        "orphans",
        "conflicts",
        "runtimeCandidateSpawnCountBeforeReceipt",
        "status",
        "failureReasons",
        "contentDigest"
    ],
    "properties": {
        "schema": {
            "const": "fsusblog.behavior-evidence-pre-runtime-receipt.v1"
        },
        "scope": {
            "const": "pre-runtime"
        },
        "runIdentity": {
            "anyOf": [
                {
                    "type": "string",
                    "minLength": 1
                },
                {
                    "type": "null"
                }
            ]
        },
        "sourceIdentity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "commit",
                "worktreeFingerprint"
            ],
            "properties": {
                "commit": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                },
                "worktreeFingerprint": {
                    "$ref": "#/$defs/prefixedDigest"
                }
            }
        },
        "buildIdentity": {
            "anyOf": [
                {
                    "$ref": "#/$defs/buildIdentity"
                },
                {
                    "type": "null"
                }
            ]
        },
        "catalogDigest": {
            "$ref": "#/$defs/prefixedDigest"
        },
        "staticAdmissionDigest": {
            "$ref": "#/$defs/prefixedDigest"
        },
        "behaviorGraphDigest": {
            "$ref": "#/$defs/prefixedDigest"
        },
        "testEvidenceDigests": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "$ref": "#/$defs/prefixedDigest"
            }
        },
        "rawResultDigests": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "testEvidence"
            ],
            "properties": {
                "testEvidence": {
                    "$ref": "#/$defs/prefixedDigest"
                },
                "mutation": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}/[a-f0-9]{64}$"
                }
            }
        },
        "mutationEvidenceDigest": {
            "anyOf": [
                {
                    "$ref": "#/$defs/prefixedDigest"
                },
                {
                    "type": "null"
                }
            ]
        },
        "behaviorIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
            }
        },
        "requiredTestKinds": {
            "type": "object",
            "additionalProperties": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                    "$ref": "#/$defs/testKind"
                }
            }
        },
        "observedTestKinds": {
            "type": "object",
            "additionalProperties": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                    "$ref": "#/$defs/testKind"
                }
            }
        },
        "mutationStatus": {
            "type": "object",
            "additionalProperties": {
                "$ref": "#/$defs/mutationStatus"
            }
        },
        "staticClaimVerificationDigest": {
            "anyOf": [
                {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                },
                {
                    "type": "null"
                }
            ]
        },
        "missing": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/locator"
            }
        },
        "orphans": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/locator"
            }
        },
        "conflicts": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/locator"
            }
        },
        "runtimeCandidateSpawnCountBeforeReceipt": {
            "type": "integer",
            "const": 0
        },
        "status": {
            "enum": [
                "ok",
                "failed"
            ]
        },
        "failureReasons": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "contentDigest": {
            "$ref": "#/$defs/prefixedDigest"
        }
    },
    "$defs": {
        "prefixedDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "testKind": {
            "enum": [
                "positive",
                "boundary",
                "negative",
                "concurrency",
                "migration",
                "mutation"
            ]
        },
        "buildIdentity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "artifactId",
                "receiptDigest",
                "artifactDigest"
            ],
            "properties": {
                "artifactId": {
                    "type": "string",
                    "minLength": 1
                },
                "receiptDigest": {
                    "type": "string",
                    "minLength": 1
                },
                "artifactDigest": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "mutationStatus": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "behaviorId",
                "mutationRequired",
                "mutationStatus",
                "qualified",
                "failures"
            ],
            "properties": {
                "behaviorId": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                },
                "mutationRequired": {
                    "type": "boolean"
                },
                "mutationStatus": {
                    "type": "string",
                    "minLength": 1
                },
                "qualified": {
                    "type": "boolean"
                },
                "failures": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "locator": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "kind",
                "behaviorId",
                "anchor",
                "reason"
            ],
            "properties": {
                "kind": {
                    "type": "string",
                    "minLength": 1
                },
                "behaviorId": {
                    "anyOf": [
                        {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9-]*$"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "anchor": {
                    "type": "string",
                    "minLength": 1
                },
                "reason": {
                    "type": "string",
                    "minLength": 1
                }
            }
        }
    }
}
