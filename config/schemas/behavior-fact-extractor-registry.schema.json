{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "fsusblog.behavior-fact-extractor-registry.v1",
    "title": "FsusBlog behavior fact ExtractorRegistry",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "digestAlgorithm",
        "canonicalSerialization",
        "extractors"
    ],
    "properties": {
        "schema": {
            "const": "fsusblog.behavior-fact-extractor-registry.v1"
        },
        "digestAlgorithm": {
            "const": "sha256"
        },
        "canonicalSerialization": {
            "const": "json-utf8-v1"
        },
        "extractors": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/extractor"
            }
        }
    },
    "$defs": {
        "extractor": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "kind",
                "entrypoint",
                "consumedInputs",
                "outputSchema",
                "requiredBuildArtifact",
                "hermeticPolicy",
                "evidenceStage",
                "ownedBehaviorIds"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                },
                "kind": {
                    "enum": [
                        "source-ast",
                        "compiled-assembly",
                        "canonical-catalog",
                        "generated-contract",
                        "matrix-projection",
                        "runtime-receipt-adapter"
                    ]
                },
                "entrypoint": {
                    "type": "string",
                    "pattern": "^tools/fact-extractors/"
                },
                "consumedInputs": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "outputSchema": {
                    "const": "fsusblog.fact-observation-receipt.v1"
                },
                "requiredBuildArtifact": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "hermeticPolicy": {
                    "enum": [
                        "source-worktree",
                        "exact-build-receipt",
                        "declared-inputs",
                        "current-run-receipts"
                    ]
                },
                "evidenceStage": {
                    "enum": [
                        "pre-runtime",
                        "post-runtime"
                    ]
                },
                "ownedBehaviorIds": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]*$"
                    }
                },
                "runtimeContract": {
                    "$ref": "#/$defs/runtimeContract"
                }
            }
        },
        "runtimeContract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "producerOwner",
                "observationSchema",
                "executionClass",
                "evidenceClass",
                "observationClasses",
                "requiredIdentities",
                "requiredOutcomes",
                "diagnosticEligibility",
                "timeoutSemantics",
                "cancelSemantics",
                "recoverySemantics",
                "acceptedClaimIds"
            ],
            "properties": {
                "producerOwner": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                },
                "observationSchema": {
                    "const": "fsusblog.fact-observation-receipt.v1"
                },
                "executionClass": {
                    "enum": [
                        "runtime",
                        "browser-runtime",
                        "release-deployment"
                    ]
                },
                "evidenceClass": {
                    "const": "correctness"
                },
                "observationClasses": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]*$"
                    }
                },
                "requiredIdentities": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]*$"
                    }
                },
                "requiredOutcomes": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "enum": [
                            "positive",
                            "negative",
                            "boundary",
                            "failure"
                        ]
                    }
                },
                "diagnosticEligibility": {
                    "const": "forbidden-for-qualification"
                },
                "timeoutSemantics": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                },
                "cancelSemantics": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                },
                "recoverySemantics": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                },
                "acceptedClaimIds": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9.-]*$"
                    }
                }
            }
        },
        "forbiddenKinds": {
            "description": "Kinds that are never admitted as static extractors.",
            "enum": [
                "shell-command",
                "http-endpoint",
                "database-query",
                "browser"
            ]
        }
    }
}
