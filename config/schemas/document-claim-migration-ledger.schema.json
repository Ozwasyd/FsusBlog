{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fsusblog.document-claim-migration-ledger.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scopes"],
  "properties": {
    "schema": { "const": "fsusblog.document-claim-migration-ledger.v1" },
    "scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scopeId", "behaviorIds", "entries"],
        "properties": {
          "scopeId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "behaviorIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "entries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["behaviorId", "documentPath", "claimIds", "generatedSectionIds"],
              "properties": {
                "behaviorId": { "type": "string" },
                "documentPath": { "type": "string", "pattern": "^docs/.+\\.md$" },
                "claimIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
                "generatedSectionIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  }
}
