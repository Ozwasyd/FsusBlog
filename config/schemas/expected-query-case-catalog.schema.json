{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "fsusblog.expected-query-case-catalog.v1",
    "title": "FsusBlog ExpectedQueryCaseCatalog",
    "description": "Closed test/evidence-only inventory bindings to the original query authority and canonical graph/distribution roles. This contract does not create case data, generate expected results, or run queries.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "version",
        "productionReadable",
        "consumers",
        "queryRegistry",
        "authorities",
        "cases",
        "schemaDigest",
        "contentDigest"
    ],
    "properties": {
        "schema": {
            "const": "fsusblog.expected-query-case-catalog.v1"
        },
        "version": {
            "const": 1
        },
        "productionReadable": {
            "const": false
        },
        "consumers": {
            "type": "array",
            "items": {
                "enum": [
                    "test",
                    "evidence"
                ]
            },
            "minItems": 1,
            "uniqueItems": true
        },
        "queryRegistry": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "path",
                "contentDigest"
            ],
            "properties": {
                "path": {
                    "const": "tools/data-scale/query-case-registry.mjs"
                },
                "contentDigest": {
                    "$ref": "#/$defs/digest"
                }
            }
        },
        "authorities": {
            "$ref": "#/$defs/authorities"
        },
        "cases": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/case"
            },
            "minItems": 1
        },
        "schemaDigest": {
            "$ref": "#/$defs/digest",
            "description": "SHA-256 of the exact JSON schema file bytes; schema changes invalidate catalog artifacts."
        },
        "contentDigest": {
            "$ref": "#/$defs/digest"
        }
    },
    "$defs": {
        "stableId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "semanticId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[:.-][a-z0-9]+)*$",
            "description": "Canonical plan identity, never a database ID or a display field."
        },
        "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "repositoryPath": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*$",
            "description": "Repository-relative regular-file path. The consumer must also reject symlinks and verify file identity and digest."
        },
        "authorityRef": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "path",
                "contentDigest"
            ],
            "properties": {
                "path": {
                    "$ref": "#/$defs/repositoryPath"
                },
                "contentDigest": {
                    "$ref": "#/$defs/digest"
                }
            }
        },
        "authorities": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "articleGraph",
                "commentGraph",
                "distributionCatalog",
                "assignments",
                "statistics"
            ],
            "properties": {
                "articleGraph": {
                    "$ref": "#/$defs/authorityRef"
                },
                "commentGraph": {
                    "$ref": "#/$defs/authorityRef"
                },
                "distributionCatalog": {
                    "$ref": "#/$defs/authorityRef"
                },
                "assignments": {
                    "$ref": "#/$defs/authorityRef"
                },
                "statistics": {
                    "$ref": "#/$defs/authorityRef"
                }
            }
        },
        "queryOwner": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "path",
                "contentDigest",
                "entrypoint",
                "version"
            ],
            "properties": {
                "path": {
                    "$ref": "#/$defs/repositoryPath"
                },
                "contentDigest": {
                    "$ref": "#/$defs/digest"
                },
                "entrypoint": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"
                },
                "version": {
                    "$ref": "#/$defs/stableId"
                }
            }
        },
        "input": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "parameter",
                "roleId",
                "authority",
                "valueType"
            ],
            "properties": {
                "parameter": {
                    "$ref": "#/$defs/stableId"
                },
                "roleId": {
                    "$ref": "#/$defs/stableId"
                },
                "authority": {
                    "enum": [
                        "articleGraph",
                        "commentGraph",
                        "distributionCatalog",
                        "assignments",
                        "statistics"
                    ]
                },
                "valueType": {
                    "enum": [
                        "semantic-id",
                        "temporal-ref",
                        "search-ref",
                        "page-size",
                        "cursor-ref"
                    ]
                }
            }
        },
        "scenario": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "scenarioDigest",
                "assignmentDigest",
                "statisticsDigest",
                "releaseEvidenceEligible"
            ],
            "properties": {
                "id": {
                    "$ref": "#/$defs/stableId"
                },
                "scenarioDigest": {
                    "$ref": "#/$defs/digest"
                },
                "assignmentDigest": {
                    "$ref": "#/$defs/digest"
                },
                "statisticsDigest": {
                    "$ref": "#/$defs/digest"
                },
                "releaseEvidenceEligible": {
                    "type": "boolean"
                }
            }
        },
        "semantics": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "order",
                "tieBreakerRoleId",
                "pagination",
                "visibilityPolicyRef",
                "permissionPolicyRef"
            ],
            "properties": {
                "order": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/orderRole"
                    },
                    "minItems": 1
                },
                "tieBreakerRoleId": {
                    "$ref": "#/$defs/stableId"
                },
                "pagination": {
                    "enum": [
                        "cursor",
                        "page",
                        "none"
                    ]
                },
                "visibilityPolicyRef": {
                    "$ref": "#/$defs/stableId"
                },
                "permissionPolicyRef": {
                    "$ref": "#/$defs/stableId"
                }
            }
        },
        "orderRole": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "roleId",
                "direction",
                "nulls"
            ],
            "properties": {
                "roleId": {
                    "$ref": "#/$defs/stableId"
                },
                "direction": {
                    "enum": [
                        "asc",
                        "desc"
                    ]
                },
                "nulls": {
                    "enum": [
                        "first",
                        "last",
                        "forbidden"
                    ]
                }
            }
        },
        "case": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "domain",
                "kind",
                "queryOwner",
                "inputs",
                "actorClass",
                "scenarios",
                "expectedSchema",
                "semantics",
                "contentDigest"
            ],
            "properties": {
                "id": {
                    "$ref": "#/$defs/stableId"
                },
                "domain": {
                    "enum": [
                        "article",
                        "comment"
                    ]
                },
                "kind": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/articleKind"
                        },
                        {
                            "$ref": "#/$defs/commentKind"
                        }
                    ]
                },
                "queryOwner": {
                    "$ref": "#/$defs/queryOwner"
                },
                "inputs": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/input"
                    },
                    "minItems": 1
                },
                "actorClass": {
                    "$ref": "#/$defs/stableId"
                },
                "scenarios": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/scenario"
                    },
                    "minItems": 1
                },
                "expectedSchema": {
                    "enum": [
                        "fsusblog.expected-query.article.v1",
                        "fsusblog.expected-query.comment.v1"
                    ]
                },
                "semantics": {
                    "$ref": "#/$defs/semantics"
                },
                "contentDigest": {
                    "$ref": "#/$defs/digest"
                }
            },
            "description": "Bindings for IDs imported from the original query-case registry; kind is a semantic vocabulary, not a second query ID inventory.",
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "domain": {
                                "const": "article"
                            }
                        },
                        "required": [
                            "domain"
                        ]
                    },
                    "then": {
                        "properties": {
                            "kind": {
                                "$ref": "#/$defs/articleKind"
                            },
                            "expectedSchema": {
                                "const": "fsusblog.expected-query.article.v1"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "domain": {
                                "const": "comment"
                            }
                        },
                        "required": [
                            "domain"
                        ]
                    },
                    "then": {
                        "properties": {
                            "kind": {
                                "$ref": "#/$defs/commentKind"
                            },
                            "expectedSchema": {
                                "const": "fsusblog.expected-query.comment.v1"
                            }
                        }
                    }
                }
            ]
        },
        "expectedBinding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "caseId",
                "scenarioId",
                "scenarioDigest",
                "assignmentDigest",
                "statisticsDigest",
                "actorClass",
                "catalogDigest",
                "caseDigest",
                "schemaDigest"
            ],
            "properties": {
                "caseId": {
                    "$ref": "#/$defs/stableId"
                },
                "scenarioId": {
                    "$ref": "#/$defs/stableId"
                },
                "scenarioDigest": {
                    "$ref": "#/$defs/digest"
                },
                "assignmentDigest": {
                    "$ref": "#/$defs/digest"
                },
                "statisticsDigest": {
                    "$ref": "#/$defs/digest"
                },
                "actorClass": {
                    "$ref": "#/$defs/stableId"
                },
                "catalogDigest": {
                    "$ref": "#/$defs/digest"
                },
                "caseDigest": {
                    "$ref": "#/$defs/digest"
                },
                "schemaDigest": {
                    "$ref": "#/$defs/digest"
                }
            },
            "description": "Exact catalog, case and schema identities bind query owners, registry semantics and source references transitively. Equality admission belongs to the future existing runner/verifier; this schema alone does not validate runtime equality."
        },
        "counts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "matched",
                "total"
            ],
            "properties": {
                "matched": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                },
                "total": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                }
            }
        },
        "paginationFacts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "mode",
                "pageSize",
                "pageIndex",
                "offset",
                "currentCursorRef",
                "nextCursorRef",
                "previousCursorRef",
                "hasNext",
                "hasPrevious"
            ],
            "properties": {
                "mode": {
                    "enum": [
                        "cursor",
                        "page",
                        "none"
                    ]
                },
                "pageSize": {
                    "oneOf": [
                        {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "pageIndex": {
                    "oneOf": [
                        {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "offset": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                },
                "currentCursorRef": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/semanticId"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "nextCursorRef": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/semanticId"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "previousCursorRef": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/semanticId"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "hasNext": {
                    "type": "boolean"
                },
                "hasPrevious": {
                    "type": "boolean"
                }
            }
        },
        "permissionFacts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "policyRef",
                "actorClass",
                "outcome"
            ],
            "properties": {
                "policyRef": {
                    "$ref": "#/$defs/stableId"
                },
                "actorClass": {
                    "$ref": "#/$defs/stableId"
                },
                "outcome": {
                    "enum": [
                        "allowed",
                        "denied"
                    ]
                }
            }
        },
        "visibilityFacts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "policyRef",
                "outcome"
            ],
            "properties": {
                "policyRef": {
                    "$ref": "#/$defs/stableId"
                },
                "outcome": {
                    "enum": [
                        "visible",
                        "hidden",
                        "excluded"
                    ]
                }
            }
        },
        "coordinates": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "sourceRef",
                "publicationRef",
                "revisionRef",
                "edgeRefs"
            ],
            "properties": {
                "sourceRef": {
                    "$ref": "#/$defs/semanticId"
                },
                "publicationRef": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/semanticId"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "revisionRef": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/semanticId"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "edgeRefs": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/semanticId"
                    },
                    "uniqueItems": true
                }
            }
        },
        "articleItem": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "semanticId",
                "status",
                "coordinates",
                "permission",
                "visibility",
                "semanticDigest"
            ],
            "properties": {
                "semanticId": {
                    "$ref": "#/$defs/semanticId"
                },
                "status": {
                    "$ref": "#/$defs/stableId"
                },
                "coordinates": {
                    "$ref": "#/$defs/coordinates"
                },
                "permission": {
                    "$ref": "#/$defs/permissionFacts"
                },
                "visibility": {
                    "$ref": "#/$defs/visibilityFacts"
                },
                "semanticDigest": {
                    "$ref": "#/$defs/digest"
                }
            }
        },
        "commentItem": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "semanticId",
                "articleRef",
                "status",
                "coordinates",
                "thread",
                "permission",
                "visibility",
                "semanticDigest"
            ],
            "properties": {
                "semanticId": {
                    "$ref": "#/$defs/semanticId"
                },
                "articleRef": {
                    "$ref": "#/$defs/semanticId"
                },
                "status": {
                    "$ref": "#/$defs/stableId"
                },
                "coordinates": {
                    "$ref": "#/$defs/coordinates"
                },
                "thread": {
                    "$ref": "#/$defs/threadFacts"
                },
                "permission": {
                    "$ref": "#/$defs/permissionFacts"
                },
                "visibility": {
                    "$ref": "#/$defs/visibilityFacts"
                },
                "semanticDigest": {
                    "$ref": "#/$defs/digest"
                }
            }
        },
        "threadFacts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "parentRef",
                "rootRef",
                "depth",
                "deletedPlaceholder"
            ],
            "properties": {
                "parentRef": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/semanticId"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "rootRef": {
                    "$ref": "#/$defs/semanticId"
                },
                "depth": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                },
                "deletedPlaceholder": {
                    "type": "boolean"
                }
            }
        },
        "articleExpected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema",
                "version",
                "productionReadable",
                "binding",
                "authorities",
                "orderedSemanticIds",
                "items",
                "counts",
                "pagination",
                "status",
                "permission",
                "visibility",
                "semanticDigest",
                "contentDigest"
            ],
            "properties": {
                "schema": {
                    "const": "fsusblog.expected-query.article.v1"
                },
                "version": {
                    "const": 1
                },
                "productionReadable": {
                    "const": false
                },
                "binding": {
                    "$ref": "#/$defs/expectedBinding"
                },
                "authorities": {
                    "$ref": "#/$defs/authorities"
                },
                "orderedSemanticIds": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/semanticId"
                    },
                    "uniqueItems": true
                },
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/articleItem"
                    }
                },
                "counts": {
                    "$ref": "#/$defs/counts"
                },
                "pagination": {
                    "$ref": "#/$defs/paginationFacts"
                },
                "status": {
                    "$ref": "#/$defs/stableId"
                },
                "permission": {
                    "$ref": "#/$defs/permissionFacts"
                },
                "visibility": {
                    "$ref": "#/$defs/visibilityFacts"
                },
                "semanticDigest": {
                    "$ref": "#/$defs/digest"
                },
                "contentDigest": {
                    "$ref": "#/$defs/digest"
                }
            },
            "description": "Future test/evidence-only plan-derived article expected document. No runtime identifiers, serialized production cursors, titles, SQL, or actual outputs are admitted. Cross-field ordering/count/digest equality is enforced by the canonical consumer."
        },
        "commentExpected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema",
                "version",
                "productionReadable",
                "binding",
                "authorities",
                "orderedSemanticIds",
                "items",
                "counts",
                "pagination",
                "status",
                "permission",
                "visibility",
                "semanticDigest",
                "contentDigest"
            ],
            "properties": {
                "schema": {
                    "const": "fsusblog.expected-query.comment.v1"
                },
                "version": {
                    "const": 1
                },
                "productionReadable": {
                    "const": false
                },
                "binding": {
                    "$ref": "#/$defs/expectedBinding"
                },
                "authorities": {
                    "$ref": "#/$defs/authorities"
                },
                "orderedSemanticIds": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/semanticId"
                    },
                    "uniqueItems": true
                },
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/commentItem"
                    }
                },
                "counts": {
                    "$ref": "#/$defs/counts"
                },
                "pagination": {
                    "$ref": "#/$defs/paginationFacts"
                },
                "status": {
                    "$ref": "#/$defs/stableId"
                },
                "permission": {
                    "$ref": "#/$defs/permissionFacts"
                },
                "visibility": {
                    "$ref": "#/$defs/visibilityFacts"
                },
                "semanticDigest": {
                    "$ref": "#/$defs/digest"
                },
                "contentDigest": {
                    "$ref": "#/$defs/digest"
                }
            },
            "description": "Future test/evidence-only plan-derived comment expected document. No runtime identifiers, serialized production cursors, titles, SQL, or actual outputs are admitted. Cross-field ordering/count/digest equality is enforced by the canonical consumer."
        },
        "articleKind": {
            "enum": [
                "latest-list",
                "top-list",
                "category-filter",
                "tag-filter",
                "detail",
                "prev-next",
                "search-hit",
                "search-no-hit",
                "cache-consistency",
                "aot-consistency",
                "hot-read-consistency"
            ]
        },
        "commentKind": {
            "enum": [
                "public-list",
                "public-thread",
                "moderation-queue",
                "approved-visibility",
                "pending-visibility",
                "rejected-visibility",
                "hidden-visibility",
                "region-filter",
                "actor-filter",
                "permission-filter",
                "deleted-root",
                "deleted-reply",
                "pagination-order"
            ]
        },
        "currentInputs": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "authorityRefs",
                "queryOwners",
                "inputRoles",
                "scenarios"
            ],
            "properties": {
                "authorityRefs": {
                    "$ref": "#/$defs/authorities"
                },
                "queryOwners": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "id",
                            "domain",
                            "kind",
                            "queryOwner",
                            "actorClass",
                            "semantics",
                            "inputs",
                            "scenarioIds",
                            "expectedSchema"
                        ],
                        "properties": {
                            "id": {
                                "$ref": "#/$defs/stableId"
                            },
                            "domain": {
                                "enum": [
                                    "article",
                                    "comment"
                                ]
                            },
                            "kind": {
                                "oneOf": [
                                    {
                                        "$ref": "#/$defs/articleKind"
                                    },
                                    {
                                        "$ref": "#/$defs/commentKind"
                                    }
                                ]
                            },
                            "queryOwner": {
                                "$ref": "#/$defs/queryOwner"
                            },
                            "actorClass": {
                                "$ref": "#/$defs/stableId"
                            },
                            "semantics": {
                                "$ref": "#/$defs/semantics"
                            },
                            "inputs": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/$defs/input"
                                },
                                "minItems": 1
                            },
                            "scenarioIds": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/$defs/stableId"
                                },
                                "minItems": 1,
                                "uniqueItems": true
                            },
                            "expectedSchema": {
                                "enum": [
                                    "fsusblog.expected-query.article.v1",
                                    "fsusblog.expected-query.comment.v1"
                                ]
                            }
                        },
                        "allOf": [
                            {
                                "if": {
                                    "properties": {
                                        "domain": {
                                            "const": "article"
                                        }
                                    },
                                    "required": [
                                        "domain"
                                    ]
                                },
                                "then": {
                                    "properties": {
