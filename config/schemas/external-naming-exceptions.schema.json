{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://fsusblog.local/schemas/external-naming-exceptions.v1.json",
    "title": "External naming exception declaration",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "exceptions"
    ],
    "properties": {
        "schema": {
            "const": "fsusblog.external-naming-exceptions.v1"
        },
        "exceptions": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "paths",
                    "reason"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "minLength": 1
                    },
                    "paths": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                            "type": "string",
                            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\s]+$"
                        }
                    },
                    "reason": {
                        "type": "string",
                        "minLength": 12
                    }
                }
            }
        }
    }
}
