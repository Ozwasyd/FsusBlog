{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "fsusblog.fact-observation-receipt.v1",
    "title": "FsusBlog source-bound fact observation receipt",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "extractorId",
        "behaviorIds",
        "sourceCommit",
        "worktreeFingerprint",
        "buildIdentity",
        "extractorDigest",
        "registryDigest",
        "consumedInputDigests",
        "observations",
        "status",
        "failureReasons",
        "contentDigest"
    ],
    "properties": {
        "schema": {
            "const": "fsusblog.fact-observation-receipt.v1"
        },
        "extractorId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
        },
        "behaviorIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
            }
        },
        "sourceCommit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
        },
        "worktreeFingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
        },
        "buildIdentity": {
            "anyOf": [
                { "type": "null" },
                { "$ref": "#/$defs/legacyBuildIdentity" },
                { "$ref": "#/$defs/canonicalBuildIdentity" }
            ]
        },
        "extractorDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
        },
        "registryDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
        },
        "consumedInputDigests": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "path",
                    "digest"
                ],
                "properties": {
                    "path": {
                        "type": "string",
                        "minLength": 1
                    },
                    "digest": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                    }
                }
            }
        },
        "observations": {
            "type": "object",
            "description": "Non-empty required when status=ok; may be empty on hard failure.",
            "additionalProperties": {
                "$ref": "#/$defs/observationValue"
            }
        },
        "status": {
            "enum": [
                "ok",
                "failed"
            ]
        },
        "failureReasons": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "contentDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
        }
    },
    "$defs": {
        "legacyBuildIdentity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifactId", "receiptDigest", "artifactDigest"],
            "properties": {
                "artifactId": { "type": "string", "minLength": 1 },
                "receiptDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "artifactDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
        },
        "canonicalBuildIdentity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schema", "artifactId", "receiptDigest", "artifactDigest", "sourceDigests", "sourceDigest"],
            "properties": {
                "schema": { "const": "fsusblog.build-identity.v1" },
                "artifactId": { "type": "string", "minLength": 1 },
                "receiptDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "artifactDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "sourceDigests": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["path", "digest"],
                        "properties": {
                            "path": { "type": "string", "minLength": 1 },
                            "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                        }
                    }
                },
                "sourceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
        },
        "observationValue": {
            "description": "Stable typed observation values only. No free-form source, logs, or Markdown.",
            "oneOf": [
                {
                    "type": "string"
                },
                {
                    "type": "number"
                },
                {
                    "type": "boolean"
                },
                {
                    "type": "array",
                    "items": {
                        "type": [
                            "string",
                            "number",
                            "boolean"
                        ]
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/observationValue"
                    }
                }
            ]
        },
        "forbiddenReceiptFields": {
            "description": "Fields that must never appear on a fact observation receipt.",
            "enum": [
                "observedAt",
                "timestamp",
                "warning",
                "warnings",
                "partial",
                "expected",
                "baseline",
                "approved",
                "lastVerifiedCommit",
                "shellCommand",
                "rawSource",
                "markdown"
            ]
        }
    }
}
