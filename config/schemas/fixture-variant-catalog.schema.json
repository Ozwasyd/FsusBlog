{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fsusblog.fixture-variant-catalog.v1",
  "title": "FsusBlog FixtureVariantCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "validityClasses", "writerContracts", "contentShapes", "temporalShapes", "mediaShapes", "distributionShapes", "derivedStates", "sentinels", "variants"],
  "properties": {
    "schema": { "const": "fsusblog.fixture-variant-catalog.v1" },
    "validityClasses": { "$ref": "#/definitions/registry" },
    "writerContracts": { "$ref": "#/definitions/registry" },
    "contentShapes": { "$ref": "#/definitions/registry" },
    "temporalShapes": { "$ref": "#/definitions/registry" },
    "mediaShapes": { "$ref": "#/definitions/registry" },
    "distributionShapes": { "$ref": "#/definitions/registry" },
    "derivedStates": { "$ref": "#/definitions/registry" },
    "sentinels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "value", "allowedValidityClasses", "allowedProfiles", "profileScope", "forbiddenInCanonicalPositive", "retirementOwner"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "value": { "type": "string", "minLength": 1 },
          "allowedValidityClasses": { "type": "array", "minItems": 1, "items": { "enum": ["canonical-positive", "migration-legacy", "negative-invalid", "diagnostic-only", "scale-synthetic"] } },
          "allowedProfiles": { "type": "array", "items": { "type": "string" } },
          "profileScope": { "enum": ["registered-profiles", "unbound-retired"] },
          "forbiddenInCanonicalPositive": { "type": "boolean" },
          "retirementOwner": { "$ref": "#/definitions/id" }
        }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "capabilityId", "validityClass", "ownerProducerId", "writerContractId", "contentShapeIds", "temporalShapeId", "mediaShapeIds", "distributionShapeId", "requiredDerivedStateIds", "forbiddenSentinelIds", "expectedBoundary", "allowedExecutionClasses", "defaultExecutionClasses"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "capabilityId": { "$ref": "#/definitions/id" },
          "validityClass": { "enum": ["canonical-positive", "migration-legacy", "negative-invalid", "diagnostic-only", "scale-synthetic"] },
          "ownerProducerId": { "$ref": "#/definitions/id" },
          "writerContractId": { "$ref": "#/definitions/id" },
          "contentShapeIds": { "$ref": "#/definitions/idList" },
          "temporalShapeId": { "$ref": "#/definitions/id" },
          "mediaShapeIds": { "type": "array", "items": { "$ref": "#/definitions/id" }, "uniqueItems": true },
          "distributionShapeId": { "anyOf": [{ "$ref": "#/definitions/id" }, { "type": "null" }] },
          "requiredDerivedStateIds": { "type": "array", "items": { "$ref": "#/definitions/id" }, "uniqueItems": true },
          "forbiddenSentinelIds": { "type": "array", "items": { "$ref": "#/definitions/id" }, "uniqueItems": true },
          "expectedBoundary": { "type": "string", "minLength": 1 },
          "expectedInvariantId": { "anyOf": [{ "$ref": "#/definitions/id" }, { "type": "null" }] },
          "injectedSentinelId": { "anyOf": [{ "$ref": "#/definitions/id" }, { "type": "null" }] },
          "allowedExecutionClasses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["acceptance", "browser", "development", "diagnostic", "load", "runtime", "security"] } },
          "defaultExecutionClasses": { "type": "array", "uniqueItems": true, "items": { "enum": ["acceptance", "browser", "development", "diagnostic", "load", "runtime", "security"] } }
        }
      }
    }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
    "idList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/id" } },
    "registry": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "$ref": "#/definitions/id" }, "semantics": { "type": "string", "minLength": 1 }, "allowedExecutionClasses": { "type": "array", "uniqueItems": true, "items": { "enum": ["acceptance", "browser", "development", "diagnostic", "load", "runtime", "security"] } } } } }
  }
}
