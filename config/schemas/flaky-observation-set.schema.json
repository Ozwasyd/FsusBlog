{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsus.dev/schemas/flaky-observation-set.v1.json",
  "title": "FsusBlog isolated flaky observation evidence",
  "type": "object",
  "required": [
    "schema",
    "generatedAt",
    "lane",
    "candidateSelection",
    "affectsCanonicalCorrectness",
    "satisfiesReleaseCorrectness",
    "candidates",
    "contentDigest"
  ],
  "properties": {
    "schema": { "const": "fsusblog.flaky-observation-set.v1" },
    "lane": { "const": "observation-only" },
    "candidateSelection": {
      "enum": ["explicit-test-id", "explicit-manifest"]
    },
    "affectsCanonicalCorrectness": { "const": false },
    "satisfiesReleaseCorrectness": { "const": false },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "testId",
          "requestedAttempts",
          "minimumSamples",
          "classification",
          "bindings",
          "attempts"
        ],
        "properties": {
          "classification": {
            "enum": [
              "stable-pass",
              "stable-fail",
              "outcome-inconsistent",
              "signature-inconsistent",
              "environment-failure",
              "insufficient-samples"
            ]
          },
          "attempts": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
