{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://fsus.blog/schemas/frontend-style-baseline-corrections.schema.json",
    "title": "Reviewed frontend style baseline corrections",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "reviewIssue",
        "corrections"
    ],
    "properties": {
        "schema": {
            "const": "fsusblog.frontend-style-baseline-corrections.v1"
        },
        "reviewIssue": {
            "type": "integer",
            "minimum": 1
        },
        "corrections": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "path",
                    "sourceSha256",
                    "previousViolationCount",
                    "previousViolationDigest",
                    "previousRules",
                    "correctedViolationCount",
                    "correctedViolationDigest",
                    "correctedRules",
                    "reason",
                    "terminalCondition"
                ],
                "properties": {
                    "path": {
                        "type": "string",
                        "minLength": 1
                    },
                    "sourceSha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                    },
                    "previousViolationCount": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "previousViolationDigest": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                    },
                    "previousRules": {
                        "$ref": "#/$defs/rules"
                    },
                    "correctedViolationCount": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "correctedViolationDigest": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                    },
                    "correctedRules": {
                        "$ref": "#/$defs/rules"
                    },
                    "reason": {
                        "type": "string",
                        "minLength": 24
                    },
                    "terminalCondition": {
                        "const": "baseline-entry-replaced-once"
                    }
                }
            }
        }
    },
    "$defs": {
        "rules": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
                "type": "integer",
                "minimum": 1
            }
        }
    }
}
