{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://fsus.blog/schemas/generated-output-repair-binding.schema.json",
    "title": "Post-merge generated output repair binding",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "sourceRevision",
        "sourcePullRequest",
        "sourceMergeRevision",
        "sources",
        "generator",
        "outputs"
    ],
    "properties": {
        "schema": {
            "const": "fsusblog.generated-output-repair-binding.v1"
        },
        "sourceRevision": {
            "$ref": "#/$defs/revision"
        },
        "sourcePullRequest": {
            "type": "integer",
            "minimum": 1
        },
        "sourceMergeRevision": {
            "$ref": "#/$defs/revision"
        },
        "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "path",
                    "currentSha256"
                ],
                "properties": {
                    "path": {
                        "$ref": "#/$defs/path"
                    },
                    "currentSha256": {
                        "$ref": "#/$defs/digest"
                    }
                }
            }
        },
        "generator": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "identity",
                "path",
                "currentSha256",
                "command"
            ],
            "properties": {
                "identity": {
                    "type": "string",
                    "minLength": 1
                },
                "path": {
                    "$ref": "#/$defs/path"
                },
                "currentSha256": {
                    "$ref": "#/$defs/digest"
                },
                "command": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "outputs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "path",
                    "baseSha256",
                    "expectedSha256",
                    "currentSha256"
                ],
                "properties": {
                    "path": {
                        "$ref": "#/$defs/path"
                    },
                    "baseSha256": {
                        "$ref": "#/$defs/digest"
                    },
                    "expectedSha256": {
                        "$ref": "#/$defs/digest"
                    },
                    "currentSha256": {
                        "$ref": "#/$defs/digest"
                    }
                }
            }
        }
    },
    "$defs": {
        "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
        },
        "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "path": {
            "type": "string",
            "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[A-Za-z0-9._/\\-]+$"
        }
    }
}
