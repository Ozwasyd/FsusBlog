{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://fsusblog.local/schemas/outcome-adapter-catalog.v1.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "schemaVersion",
        "candidateSchema",
        "fieldDispositionSchema",
        "membershipSchema",
        "entries"
    ],
    "properties": {
        "schema": {
            "const": "fsusblog.outcome-adapter-catalog.v1"
        },
        "schemaVersion": {
            "const": "1"
        },
        "candidateSchema": {
            "const": "fsusblog.producer-semantic-outcome-candidate.v1"
        },
        "fieldDispositionSchema": {
            "const": "fsusblog.outcome-field-dispositions.v2"
        },
        "membershipSchema": {
            "const": "config/schemas/outcome-adapter-membership.schema.json"
        },
        "entries": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "family",
                    "producerIds",
                    "authorityId",
                    "adapterExport",
                    "verifierExport",
                    "sourceCommit",
                    "sourceDigest",
                    "membershipSchema",
                    "normalizationStatus",
                    "owner",
                    "proofTestId"
                ],
                "properties": {
                    "family": {
                        "type": "string",
                        "minLength": 1
                    },
                    "producerIds": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "minLength": 1
                        },
                        "uniqueItems": true
                    },
                    "authorityId": {
                        "type": "string",
                        "minLength": 1
                    },
                    "adapterExport": {
                        "type": "string",
                        "minLength": 1
                    },
                    "verifierExport": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "sourceCommit": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{40}$"
                    },
                    "sourceDigest": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}$"
                    },
                    "membershipSchema": {
                        "type": "string",
                        "pattern": "^#/[a-zA-Z$]+/[a-zA-Z0-9-]+$"
                    },
                    "normalizationStatus": {
                        "enum": [
                            "existing-v2",
                            "data-only-schema"
                        ]
                    },
                    "owner": {
                        "type": "string",
                        "minLength": 1
                    },
                    "proofTestId": {
                        "type": "string",
                        "minLength": 1
                    },
                    "producerSources": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "$ref": "#/$defs/producerSource"
                        }
                    }
                }
            }
        }
    },
    "$defs": {
        "producerSource": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "role",
                "path",
                "sourceCommit",
                "sourceDigest",
                "exports",
                "methods",
                "documentSchemas",
                "contractPath",
                "admissionStatus",
                "grantsQualification"
            ],
            "properties": {
                "role": {
                    "enum": [
                        "assertion-report",
                        "runner-binding",
                        "held-native-bridge",
                        "native-reporter",
                        "native-runner",
                        "native-execution-events",
                        "replay-parent"
                    ]
                },
                "path": {
                    "type": "string",
                    "pattern": "^tools/(?:[A-Za-z0-9_-]+/)+[A-Za-z0-9_-]+\\.mjs$"
                },
                "sourceCommit": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                },
                "sourceDigest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "exports": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    },
                    "uniqueItems": true,
                    "minItems": 1
                },
                "methods": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    },
                    "uniqueItems": true
                },
                "documentSchemas": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "pattern": "^fsusblog\\.[a-z0-9.-]+\\.v[1-9][0-9]*$"
                    },
                    "uniqueItems": true
                },
                "contractPath": {
                    "type": "string",
                    "pattern": "^tools/(?:[A-Za-z0-9_-]+/)+[A-Za-z0-9_.-]+\\.md$"
                },
                "admissionStatus": {
                    "const": "ordinary-source-only"
                },
                "grantsQualification": {
                    "const": false
                }
            }
        }
    }
}
