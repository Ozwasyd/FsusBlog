{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://fsusblog.local/schemas/post-merge-generated-output-repair.v3.json",
    "title": "Sealed backend evidence history digest repair",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "producerId",
        "repairClass",
        "qualification",
        "baseCommit",
        "command",
        "closure",
        "output"
    ],
    "properties": {
        "schema": {
            "const": "fsusblog.post-merge-generated-output-repair.v3"
        },
        "producerId": {
            "const": "backend-evidence-path-authority"
        },
        "repairClass": {
            "const": "sealed-history-digest-refresh"
        },
        "qualification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "kind",
                "anchor",
                "frontier",
                "sourceEvents",
                "historySha256"
            ],
            "properties": {
                "kind": {
                    "const": "reviewed-mainline-history"
                },
                "anchor": {
                    "$ref": "#/$defs/revision"
                },
                "frontier": {
                    "$ref": "#/$defs/revision"
                },
                "sourceEvents": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 64,
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/revision"
                    }
                },
                "historySha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                }
            }
        },
        "baseCommit": {
            "$ref": "#/$defs/revision"
        },
        "command": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "executable",
                "arguments"
            ],
            "properties": {
                "executable": {
                    "const": "node"
                },
                "arguments": {
                    "const": [
                        "tools/test/generate-backend-evidence-path-authority.mjs",
                        "--write"
                    ]
                }
            }
        },
        "closure": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "path",
                    "anchor",
                    "frontier",
                    "base"
                ],
                "properties": {
                    "path": {
                        "enum": [
                            "tests/backend/Fixtures/backend-test-requirements.json",
                            "tests/matrix.yml",
                            "tools/test-matrix/parse-matrix.mjs",
                            "tools/test/backend-evidence-path-authority.mjs",
                            "tools/test/generate-backend-evidence-path-authority.mjs",
                            "tools/yaml/parse-document.mjs"
                        ]
                    },
                    "anchor": {
                        "$ref": "#/$defs/identity"
                    },
                    "frontier": {
                        "$ref": "#/$defs/identity"
                    },
                    "base": {
                        "$ref": "#/$defs/identity"
                    }
                }
            }
        },
        "output": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "path",
                "anchor",
                "base",
                "candidate"
            ],
            "properties": {
                "path": {
                    "const": "tests/backend/Fixtures/backend-evidence-path-authority.generated.json"
                },
                "anchor": {
                    "$ref": "#/$defs/identity"
                },
                "base": {
                    "$ref": "#/$defs/identity"
                },
                "candidate": {
                    "$ref": "#/$defs/identity"
                }
            }
        }
    },
    "$defs": {
        "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
        },
        "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "mode",
                "object",
                "sha256"
            ],
            "properties": {
                "mode": {
                    "enum": [
                        "100644",
                        "100755"
                    ]
                },
                "object": {
                    "$ref": "#/$defs/revision"
                },
                "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                }
            }
        }
    }
}
