{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "fsusblog.post-runtime-accepted-claims.v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "sourceState",
        "producerId",
        "toolVersion",
        "registryDigest",
        "claimsSchemaDigest",
        "terminalReceiptRef",
        "migrationLedgerDigest",
        "claims",
        "status",
        "contentDigest"
    ],
    "properties": {
        "schema": {
            "const": "fsusblog.post-runtime-accepted-claims.v1"
        },
        "sourceState": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "commit",
                "worktreeFingerprint",
                "schedulerRunId",
                "attemptId",
                "candidateIdentityDigest",
                "buildIdentityDigest"
            ],
            "properties": {
                "commit": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                },
                "worktreeFingerprint": {
                    "$ref": "#/$defs/digest"
                },
                "schedulerRunId": {
                    "type": "string",
                    "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_](?:[A-Za-z0-9_.-]{0,126}[A-Za-z0-9_])?$"
                },
                "attemptId": {
                    "type": "string",
                    "pattern": "^attempt-[0-9]{4}$"
                },
                "candidateIdentityDigest": {
                    "$ref": "#/$defs/digest"
                },
                "buildIdentityDigest": {
                    "$ref": "#/$defs/digest"
                }
            }
        },
        "producerId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
        },
        "toolVersion": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*@[1-9][0-9]*$"
        },
        "registryDigest": {
            "$ref": "#/$defs/digest"
        },
        "claimsSchemaDigest": {
            "$ref": "#/$defs/digest"
        },
        "terminalReceiptRef": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "path",
                "fileDigest",
                "contentDigest",
                "schema",
                "authorityId",
                "producerId",
                "toolVersion",
                "producerCommand",
                "payloadPath",
                "payloadFileDigest",
                "payloadContentDigest",
                "payloadSchema"
            ],
            "properties": {
                "path": {
                    "type": "string",
                    "minLength": 1
                },
                "fileDigest": {
                    "$ref": "#/$defs/digest"
                },
                "contentDigest": {
                    "$ref": "#/$defs/digest"
                },
                "schema": {
                    "const": "fsusblog.current-run-evidence-reference.v1"
                },
                "authorityId": {
                    "const": "evidence-consumer.docs.global-claim-exactness-final.current-run"
                },
                "producerId": {
                    "const": "evidence-consumer.docs.global-claim-exactness-final.producer"
                },
                "toolVersion": {
                    "const": "global-claim-exactness-final@1"
                },
                "producerCommand": {
                    "type": "string",
                    "minLength": 1
                },
                "payloadPath": {
                    "type": "string",
                    "minLength": 1
                },
                "payloadFileDigest": {
                    "$ref": "#/$defs/digest"
                },
                "payloadContentDigest": {
                    "$ref": "#/$defs/digest"
                },
                "payloadSchema": {
                    "const": "fsusblog.global-claim-exactness-terminal-receipt.v1"
                }
            }
        },
        "migrationLedgerDigest": {
            "$ref": "#/$defs/digest"
        },
        "claims": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "claimId",
                    "behaviorId",
                    "scopeId"
                ],
                "properties": {
                    "claimId": {
                        "type": "string",
                        "minLength": 1
                    },
                    "behaviorId": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "scopeId": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        },
        "status": {
            "const": "accepted"
        },
        "contentDigest": {
            "$ref": "#/$defs/digest"
        }
    },
    "$defs": {
        "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
        }
    }
}
