{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "fsusblog.post-runtime-accepted-claims.v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "sourceState",
        "producerId",
        "toolVersion",
        "terminalReceiptRef",
        "migrationLedgerDigest",
        "claims",
        "status",
        "contentDigest"
    ],
    "properties": {
        "schema": {
            "const": "fsusblog.post-runtime-accepted-claims.v1"
        },
        "sourceState": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "commit",
                "worktreeFingerprint"
            ],
            "properties": {
                "commit": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                },
                "worktreeFingerprint": {
                    "$ref": "#/$defs/digest"
                }
            }
        },
        "producerId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
        },
        "toolVersion": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*@[1-9][0-9]*$"
        },
        "terminalReceiptRef": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "path",
                "fileDigest",
                "contentDigest",
                "schema"
            ],
            "properties": {
                "path": {
                    "type": "string",
                    "minLength": 1
                },
                "fileDigest": {
                    "$ref": "#/$defs/digest"
                },
                "contentDigest": {
                    "$ref": "#/$defs/digest"
                },
                "schema": {
                    "const": "fsusblog.global-claim-exactness-terminal-receipt.v1"
                }
            }
        },
        "migrationLedgerDigest": {
            "$ref": "#/$defs/digest"
        },
        "claims": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "claimId",
                    "behaviorId",
                    "scopeId"
                ],
                "properties": {
                    "claimId": {
                        "type": "string",
                        "minLength": 1
                    },
                    "behaviorId": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "scopeId": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        },
        "status": {
            "const": "accepted"
        },
        "contentDigest": {
            "$ref": "#/$defs/digest"
        }
    },
    "$defs": {
        "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
        }
    }
}
