{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "fsusblog.release-deployment-prose-classification-authority.v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "scopeId",
        "documents"
    ],
    "properties": {
        "schema": {
            "const": "fsusblog.release-deployment-prose-classification-authority.v1"
        },
        "scopeId": {
            "const": "protocol-release-deployment-ownership"
        },
        "documents": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "documentPath",
                    "behaviorIds",
                    "classification",
                    "nodeCount",
                    "inventoryDigest"
                ],
                "properties": {
                    "documentPath": {
                        "type": "string",
                        "pattern": "^docs/.+\\.md$"
                    },
                    "behaviorIds": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9-]+$"
                        }
                    },
                    "classification": {
                        "enum": [
                            "diagnostic",
                            "example",
                            "history",
                            "non-authority"
                        ]
                    },
                    "nodeCount": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "inventoryDigest": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                    }
                }
            }
        }
    }
}
