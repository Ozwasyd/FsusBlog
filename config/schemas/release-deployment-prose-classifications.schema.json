{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "fsusblog.release-deployment-prose-classifications.v2",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "producerId",
        "scopeId",
        "source",
        "entries",
        "contentDigest"
    ],
    "properties": {
        "schema": {
            "const": "fsusblog.release-deployment-prose-classifications.v2"
        },
        "producerId": {
            "const": "release-deployment-prose-classification-index"
        },
        "scopeId": {
            "const": "protocol-release-deployment-ownership"
        },
        "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "path",
                "producerId",
                "commit",
                "digest"
            ],
            "properties": {
                "path": {
                    "const": "config/contracts/release-deployment-prose-classification-authority.json"
                },
                "producerId": {
                    "const": "release-deployment-prose-classification-policy"
                },
                "commit": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                },
                "digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                }
            }
        },
        "entries": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "release-deployment-prose-classification-authority.schema.json#/$defs/entry"
            }
        },
        "contentDigest": {
            "type": [
                "string",
                "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
        }
    }
}
