{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "fsusblog.release-deployment-prose-classifications.v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "scopeId",
        "entries"
    ],
    "properties": {
        "schema": {
            "const": "fsusblog.release-deployment-prose-classifications.v1"
        },
        "scopeId": {
            "const": "protocol-release-deployment-ownership"
        },
        "entries": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "documentPath",
                    "startLine",
                    "endLine",
                    "nodeType",
                    "classification",
                    "contentDigest"
                ],
                "properties": {
                    "documentPath": {
                        "type": "string",
                        "pattern": "^docs/.+\\.md$"
                    },
                    "startLine": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "endLine": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "nodeType": {
                        "enum": [
                            "heading",
                            "paragraph",
                            "list",
                            "table",
                            "callout"
                        ]
                    },
                    "classification": {
                        "enum": [
                            "diagnostic",
                            "example",
                            "history",
                            "non-authority"
                        ]
                    },
                    "contentDigest": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                    }
                }
            }
        }
    }
}
