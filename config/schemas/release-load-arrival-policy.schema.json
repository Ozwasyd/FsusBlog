{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "fsusblog.release-load-arrival-policy.v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "profileId",
        "durationMs",
        "arrivalModel",
        "plannedRequestsPerSecond",
        "burstWindows",
        "maximumInFlight",
        "requestTimeoutMs",
        "routeMix",
        "scheduleSeed",
        "qualificationWindowMs",
        "offeredRateTolerance"
    ],
    "properties": {
        "schema": {
            "const": "fsusblog.release-load-arrival-policy.v1"
        },
        "profileId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
        },
        "durationMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400000
        },
        "arrivalModel": {
            "enum": [
                "constant",
                "step",
                "burst"
            ]
        },
        "plannedRequestsPerSecond": {
            "type": "number",
            "exclusiveMinimum": 0
        },
        "burstWindows": {
            "type": "array",
            "maxItems": 256,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "startMs",
                    "endMs",
                    "requestsPerSecond"
                ],
                "properties": {
                    "startMs": {
                        "type": "integer",
                        "minimum": 0
                    },
                    "endMs": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "requestsPerSecond": {
                        "type": "number",
                        "exclusiveMinimum": 0
                    },
                    "recoveryEndMs": {
                        "type": "integer",
                        "minimum": 1
                    }
                }
            }
        },
        "maximumInFlight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
        },
        "requestTimeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300000
        },
        "routeMix": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
                "oneOf": [
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "routeId",
                            "weight"
                        ],
                        "properties": {
                            "routeId": {
                                "type": "string",
                                "pattern": "^[a-z][a-z0-9-]*$"
                            },
                            "weight": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 1000000
                            }
                        }
                    },
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "routeId",
                            "count"
                        ],
                        "properties": {
                            "routeId": {
                                "type": "string",
                                "pattern": "^[a-z][a-z0-9-]*$"
                            },
                            "count": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 1000000
                            }
                        }
                    }
                ]
            }
        },
        "scheduleSeed": {
            "oneOf": [
                {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                }
            ]
        },
        "qualificationWindowMs": {
            "type": "integer",
            "minimum": 1
        },
        "offeredRateTolerance": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 1
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "arrivalModel": {
                        "const": "constant"
                    }
                }
            },
            "then": {
                "properties": {
                    "burstWindows": {
                        "maxItems": 0,
                        "type": "array"
                    }
                }
            },
            "else": {
                "properties": {
                    "burstWindows": {
                        "minItems": 1,
                        "type": "array"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "arrivalModel": {
                        "const": "burst"
                    }
                }
            },
            "then": {
                "properties": {
                    "burstWindows": {
                        "items": {
                            "required": [
                                "recoveryEndMs"
                            ],
                            "type": "object"
                        },
                        "type": "array"
                    }
                }
            },
            "else": {
                "properties": {
                    "burstWindows": {
                        "items": {
                            "not": {
                                "required": [
                                    "recoveryEndMs"
                                ],
                                "type": "object"
                            },
                            "type": "object"
                        },
                        "type": "array"
                    }
                }
            }
        }
    ]
}
