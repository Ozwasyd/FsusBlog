{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "fsusblog.release-reliability-lifecycle-action-registry.v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "scenarioCatalog",
        "stateDomainRegistry",
        "receiptSchema",
        "actions"
    ],
    "properties": {
        "schema": {
            "const": "fsusblog.release-reliability-lifecycle-action-registry.v1"
        },
        "scenarioCatalog": {
            "const": "config/testing/release-reliability-scenario-catalog.json"
        },
        "stateDomainRegistry": {
            "const": "config/testing/runtime-state-domain-registry.json"
        },
        "receiptSchema": {
            "const": "fsusblog.release-reliability-lifecycle-action-receipt.v2"
        },
        "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/action"
            }
        }
    },
    "$defs": {
        "stringArray": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            },
            "uniqueItems": true
        },
        "action": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "actionId",
                "scenarioId",
                "phase",
                "operation",
                "executable",
                "args",
                "env",
                "cwd",
                "expectedReceiptPath",
                "expectedReceiptSchema",
                "requiredFields",
                "passStatusValues",
                "timeoutPolicy",
                "stateDomains",
                "safeAfterFailure"
            ],
            "properties": {
                "actionId": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"
                },
                "scenarioId": {
                    "type": "string",
                    "pattern": "^release-[a-z0-9]+(?:-[a-z0-9]+)+$"
                },
                "phase": {
                    "enum": [
                        "precondition",
                        "reset-before",
                        "measurement",
                        "postcondition",
                        "reset-after"
                    ]
                },
                "operation": {
                    "enum": [
                        "cleanup-mutation-output",
                        "observe-runtime",
                        "observe-mutation",
                        "observe-data-scale-runtime",
                        "provision-data-scale-runtime",
                        "prepare-evidence-files",
                        "reset-runtime-state",
                        "run-measurement",
                        "teardown-data-scale-runtime"
                    ]
                },
                "executable": {
                    "type": "string",
                    "minLength": 1
                },
                "args": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "env": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "cwd": {
                    "type": "string",
                    "minLength": 1
                },
                "expectedReceiptPath": {
                    "type": "string",
                    "minLength": 1
                },
                "expectedReceiptSchema": {
                    "type": "string",
                    "minLength": 1
                },
                "requiredFields": {
                    "$ref": "#/$defs/stringArray"
                },
                "passStatusValues": {
                    "$ref": "#/$defs/stringArray"
                },
                "timeoutPolicy": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "timeoutMs",
                        "terminateGraceMs"
                    ],
                    "properties": {
                        "timeoutMs": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 1800000
                        },
                        "terminateGraceMs": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 30000
                        }
                    }
                },
                "stateDomains": {
                    "$ref": "#/$defs/stringArray"
                },
                "safeAfterFailure": {
                    "type": "boolean"
                },
                "targets": {
                    "$ref": "#/$defs/stringArray"
                },
                "ownerReceipt": {
                    "type": "string",
                    "enum": [
                        "data-scale-runtime",
                        "data-scale-teardown"
                    ]
                }
            }
        }
    }
}
