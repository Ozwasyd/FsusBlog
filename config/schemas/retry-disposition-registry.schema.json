{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://fsusblog.local/schemas/retry-disposition-registry.v1.json",
    "title": "FsusBlog hidden retry dispositions",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema", "scannerVersion", "sourceDigestAlgorithm", "entries", "contentDigest"],
    "properties": {
        "schema": { "const": "fsusblog.retry-disposition-registry.v1" },
        "scannerVersion": { "type": "string", "minLength": 1 },
        "sourceDigestAlgorithm": { "const": "sha256" },
        "entries": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "producerId",
                    "location",
                    "ruleId",
                    "classification",
                    "policyId",
                    "action",
                    "owner",
                    "sourceDigest"
                ],
                "properties": {
                    "producerId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                    "location": { "type": "string", "pattern": "^[^:*?]+:[1-9][0-9]*$" },
                    "ruleId": { "type": "string", "pattern": "^retry\\.[a-z0-9.-]+$" },
                    "classification": { "enum": ["correctness", "diagnostic", "restore-transfer", "non-retry"] },
                    "policyId": { "type": ["string", "null"] },
                    "action": { "enum": ["diagnostic-only", "instrument", "remove", "restore-only"] },
                    "owner": { "type": "string", "minLength": 1 },
                    "sourceDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
                }
            }
        },
        "contentDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
    }
}
