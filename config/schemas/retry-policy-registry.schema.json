{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://fsusblog.local/schemas/retry-policy-registry.v1.json",
    "title": "FsusBlog retry policy registry",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "policyVersion",
        "statuses",
        "classifications",
        "actions",
        "defaultDisposition",
        "policies",
        "producerBindingSources"
    ],
    "properties": {
        "schema": { "const": "fsusblog.retry-policy-registry.v1" },
        "policyVersion": { "type": "string", "minLength": 1 },
        "statuses": {
            "type": "array",
            "minItems": 7,
            "maxItems": 7,
            "uniqueItems": true,
            "items": {
                "enum": [
                    "cancelled",
                    "clean-success",
                    "diagnostic-failed-after-retry",
                    "diagnostic-recovered-after-allowed-infra-retry",
                    "failed-no-retry",
                    "recovered-infra-success",
                    "unstable-attempt-topology"
                ]
            }
        },
        "classifications": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "uniqueItems": true,
            "items": { "enum": ["correctness", "diagnostic", "restore-transfer"] }
        },
        "actions": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "uniqueItems": true,
            "items": { "enum": ["diagnostic-only", "instrument", "remove", "restore-only"] }
        },
        "defaultDisposition": {
            "type": "object",
            "additionalProperties": false,
            "required": ["allowedRetries", "qualificationEligible", "retryOn"],
            "properties": {
                "allowedRetries": { "const": 0 },
                "qualificationEligible": { "const": false },
                "retryOn": { "type": "array", "maxItems": 0 }
            }
        },
        "policies": {
            "type": "array",
            "minItems": 3,
            "items": { "$ref": "#/$defs/policy" }
        },
        "producerBindingSources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
        }
    },
    "$defs": {
        "policy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "classification",
                "allowedRetries",
                "retryOn",
                "firstFailureBlocksQualification",
                "successClassification",
                "recoveredClassification",
                "qualificationSemantics",
                "owner"
            ],
            "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                "classification": { "enum": ["correctness", "diagnostic", "restore-transfer"] },
                "allowedRetries": { "type": "integer", "minimum": 0, "maximum": 1 },
                "retryOn": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
                },
                "firstFailureBlocksQualification": { "const": true },
                "successClassification": { "const": "clean-success" },
                "recoveredClassification": {
                    "type": ["string", "null"]
                },
                "qualificationSemantics": { "type": "string", "minLength": 1 },
                "owner": { "type": "string", "minLength": 1 }
            }
        }
    }
}
