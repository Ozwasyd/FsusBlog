{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "fsusblog.runtime-http-route-contracts.v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "producers",
        "routes"
    ],
    "properties": {
        "schema": {
            "const": "fsusblog.runtime-http-route-contracts.v1"
        },
        "producers": {
            "type": "object",
            "additionalProperties": {
                "type": "array",
                "items": {
                    "type": "string"
                },
                "minItems": 1
            }
        },
        "routes": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/route"
            }
        }
    },
    "$defs": {
        "route": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "routeId",
                "method",
                "pathTemplate",
                "expectedStatus",
                "redirectPolicy",
                "expectedContentType",
                "expectedAedsFrameType",
                "minimumBodyBytes",
                "maximumBodyBytes",
                "semanticValidatorId",
                "cacheHeaderPolicy",
                "authPolicy"
            ],
            "properties": {
                "routeId": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                },
                "method": {
                    "type": "string",
                    "pattern": "^[A-Z]+$"
                },
                "pathTemplate": {
                    "type": "string",
                    "pattern": "^/"
                },
                "expectedStatus": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 599
                },
                "redirectPolicy": {
                    "const": "forbid"
                },
                "expectedContentType": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string"
                    }
                },
                "expectedAedsFrameType": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "minimum": 0,
                    "maximum": 255
                },
                "minimumBodyBytes": {
                    "type": "integer",
                    "minimum": 0
                },
                "maximumBodyBytes": {
                    "type": "integer",
                    "minimum": 0
                },
                "semanticValidatorId": {
                    "enum": [
                        "non-error-frame",
                        "search-manifest",
                        "html-document"
                    ]
                },
                "cacheHeaderPolicy": {
                    "enum": [
                        "any",
                        "no-store"
                    ]
                },
                "authPolicy": {
                    "const": "anonymous"
                }
            }
        }
    }
}
