{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "fsusblog.runtime-role-observation.v3",
    "title": "FsusBlog compiled runtime-role observation",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "modes",
        "staticRoleCapabilities",
        "unsupportedCombinations",
        "ownership",
        "deploymentAuthority",
        "currentSchemaContract",
        "observationDigest"
    ],
    "properties": {
        "schema": {
            "const": "fsusblog.runtime-role-observation.v3"
        },
        "modes": {
            "type": "array",
            "minItems": 3,
            "uniqueItems": true,
            "items": {
                "$ref": "#/$defs/runtimeMode"
            }
        },
        "staticRoleCapabilities": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "propertyNames": {
                "pattern": "^[a-z][a-z0-9.-]*$"
            }
        },
        "unsupportedCombinations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "$ref": "#/$defs/unsupportedCombination"
            }
        },
        "ownership": {
            "$ref": "#/$defs/ownership"
        },
        "deploymentAuthority": {
            "$ref": "#/$defs/deploymentAuthority"
        },
        "observationDigest": {
            "$ref": "#/$defs/digest"
        },
        "currentSchemaContract": {
            "$ref": "#/$defs/currentSchemaContract"
        }
    },
    "$defs": {
        "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
        },
        "prefixedDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "runtimeMode": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "staticRoles",
                "clusterMembershipEnabled",
                "adaptiveSchedulerEnabled",
                "distributedInvalidationEnabled",
                "localInvocationOnly",
                "roleCombinationState"
            ],
            "properties": {
                "id": {
                    "enum": [
                        "single",
                        "static-role",
                        "adaptive"
                    ]
                },
                "staticRoles": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "clusterMembershipEnabled": {
                    "type": "boolean"
                },
                "adaptiveSchedulerEnabled": {
                    "type": "boolean"
                },
                "distributedInvalidationEnabled": {
                    "type": "boolean"
                },
                "localInvocationOnly": {
                    "type": "boolean"
                },
                "roleCombinationState": {
                    "enum": [
                        "optional-ignored",
                        "explicit-required"
                    ]
                }
            }
        },
        "unsupportedCombination": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "errorCode"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                },
                "errorCode": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "ownership": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "process",
                "container",
                "service",
                "coResidency",
                "separation",
                "authorityState",
                "claimEligible",
                "failureReasons"
            ],
            "properties": {
                "process": {
                    "type": "string",
                    "minLength": 1
                },
                "container": {
                    "type": "string",
                    "minLength": 1
                },
                "service": {
                    "type": "string",
                    "minLength": 1
                },
                "coResidency": {
                    "type": "string",
                    "minLength": 1
                },
                "separation": {
                    "type": "string",
                    "minLength": 1
                },
                "authorityState": {
                    "type": "string",
                    "minLength": 1
                },
                "claimEligible": {
                    "type": "boolean"
                },
                "failureReasons": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        },
        "sourceDigest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "path",
                "digest"
            ],
            "properties": {
                "path": {
                    "type": "string",
                    "minLength": 1
                },
                "digest": {
                    "$ref": "#/$defs/digest"
                }
            }
        },
        "composeExecutable": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "canonicalPath",
                "digest",
                "version"
            ],
            "properties": {
                "canonicalPath": {
                    "type": "string",
                    "pattern": "^/[^\\u0000]*$"
                },
                "digest": {
                    "$ref": "#/$defs/digest"
                },
                "version": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "composeService": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "image",
                "build",
                "pullPolicy",
                "profiles",
                "entrypoint",
                "command"
            ],
            "properties": {
                "image": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "build": {
                    "anyOf": [
                        {
                            "type": "object"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "pullPolicy": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "profiles": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "entrypoint": {
                    "anyOf": [
                        {
                            "type": "array"
                        },
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "command": {
                    "anyOf": [
                        {
                            "type": "array"
                        },
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            }
        },
        "effectiveCompose": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "oracle",
                "oracleVersion",
                "dockerExecutable",
                "composeImplementation",
                "sourcePath",
                "defaultServices",
                "allProfileServices",
                "modelDigest"
            ],
            "properties": {
                "oracle": {
                    "const": "docker-compose-config-json-no-interpolate"
                },
                "oracleVersion": {
                    "type": "string",
                    "minLength": 1
                },
                "dockerExecutable": {
                    "$ref": "#/$defs/composeExecutable"
                },
                "composeImplementation": {
                    "$ref": "#/$defs/composeExecutable"
                },
                "sourcePath": {
                    "const": "ops/docker/docker-compose.production.yml"
                },
                "defaultServices": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                        "$ref": "#/$defs/composeService"
                    }
                },
                "allProfileServices": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                        "$ref": "#/$defs/composeService"
                    }
                },
                "modelDigest": {
                    "$ref": "#/$defs/prefixedDigest"
                }
            }
        },
        "application": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "project",
                "dockerTarget",
                "processEntrypoint",
                "composeService",
                "image",
                "serviceRoster",
                "applicationServiceCount",
                "composeEntrypointOverride",
                "composeCommandOverride",
                "effectivePid1",
                "pid1Source"
            ],
            "properties": {
                "project": {
                    "const": "src/backend/FsusBlog.Server.csproj"
                },
                "dockerTarget": {
                    "type": "string",
                    "minLength": 1
                },
                "processEntrypoint": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "composeService": {
                    "type": "string",
                    "minLength": 1
                },
                "image": {
                    "type": "string",
                    "minLength": 1
                },
                "serviceRoster": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "applicationServiceCount": {
                    "type": "integer",
                    "minimum": 1
                },
                "composeEntrypointOverride": {
                    "type": "string",
                    "minLength": 1
                },
                "composeCommandOverride": {
                    "type": "string",
                    "minLength": 1
                },
                "effectivePid1": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "pid1Source": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "volume": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "source",
                "volumeName",
                "access",
                "scope",
                "protection"
            ],
            "properties": {
                "source": {
                    "type": "string",
                    "minLength": 1
                },
                "volumeName": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "access": {
                    "enum": [
                        "read-only",
                        "read-write"
                    ]
                },
                "scope": {
                    "type": "string",
                    "minLength": 1
                },
                "protection": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "deploymentAuthority": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema",
                "authoritySchema",
                "authorityContentDigest",
                "sourceDigests",
                "effectiveCompose",
                "application",
                "volumeTopology",
                "observationDigest"
            ],
            "properties": {
                "schema": {
                    "const": "fsusblog.runtime-role-deployment-observation.v1"
                },
                "authoritySchema": {
                    "const": "fsusblog.monolithic-distributed-architecture.v2"
                },
                "authorityContentDigest": {
                    "$ref": "#/$defs/prefixedDigest"
                },
                "sourceDigests": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "policy",
                        "project",
                        "dockerfile",
                        "productionCompose"
                    ],
                    "properties": {
                        "policy": {
                            "$ref": "#/$defs/sourceDigest"
                        },
                        "project": {
                            "$ref": "#/$defs/sourceDigest"
                        },
                        "dockerfile": {
                            "$ref": "#/$defs/sourceDigest"
                        },
                        "productionCompose": {
                            "$ref": "#/$defs/sourceDigest"
                        }
                    }
                },
                "effectiveCompose": {
                    "$ref": "#/$defs/effectiveCompose"
                },
                "application": {
                    "$ref": "#/$defs/application"
                },
                "volumeTopology": {
                    "type": "object",
                    "minProperties": 1,
                    "propertyNames": {
                        "pattern": "^/[^\\u0000]*$"
                    },
                    "additionalProperties": {
                        "$ref": "#/$defs/volume"
                    }
                },
                "observationDigest": {
                    "$ref": "#/$defs/prefixedDigest"
                }
            }
        },
        "currentSchemaContract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema",
                "evidenceStage",
                "evidenceClass",
                "receiptFormat",
                "maximumEncodedBytes",
                "fixtureOnly",
                "nativeQualification",
                "codecType",
                "admissionType",
                "contractValidated",
                "fixtureArtifactSha256",
                "fixtureContentDigest",
                "positiveControls",
                "refusalControls",
                "observationDigest"
            ],
            "properties": {
                "schema": {
                    "const": "fsusblog.current-schema-code-contract-observation.v1"
                },
                "evidenceStage": {
                    "const": "pre-runtime"
                },
                "evidenceClass": {
                    "const": "compiled-production-code-model"
                },
                "receiptFormat": {
                    "const": "fsusblog.current-schema-receipt.v1"
                },
                "maximumEncodedBytes": {
                    "const": 1048576
                },
                "fixtureOnly": {
                    "const": true
                },
                "nativeQualification": {
                    "const": false
                },
                "codecType": {
                    "const": "FsusBlog.Contracts.SchemaMigration.CurrentSchemaReceiptCodec"
                },
                "admissionType": {
                    "const": "FsusBlog.Server.Infrastructure.SchemaMigration.CurrentSchemaReceiptAdmission"
                },
                "contractValidated": {
                    "const": true
                },
                "fixtureArtifactSha256": {
                    "$ref": "#/$defs/digest"
                },
                "fixtureContentDigest": {
                    "$ref": "#/$defs/digest"
                },
                "positiveControls": {
                    "const": [
                        "canonical-codec-roundtrip",
                        "whole-artifact-admission-contract",
                        "artifact-sha-distinct-from-content-seal"
                    ]
                },
                "refusalControls": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "content-seal-as-file-sha",
                        "content-seal-drift",
                        "database-swap",
                        "duplicate-checkpoint",
                        "duplicate-member",
                        "empty-bytes",
                        "latest-reference",
                        "missing-plan",
                        "missing-status",
                        "old-format",
                        "oversized-bytes",
                        "physical-schema-swap",
                        "provider-swap",
                        "rejected-status",
                        "semantic-mismatch",
                        "target-swap",
                        "unknown-member",
                        "unknown-provider",
                        "unknown-status",
                        "whole-file-drift"
                    ],
                    "properties": {
                        "content-seal-as-file-sha": {
                            "const": "current_receipt_artifact_digest_mismatch"
                        },
                        "content-seal-drift": {
                            "const": "current_receipt_digest_mismatch"
                        },
                        "database-swap": {
                            "const": "current_receipt_live_admission_mismatch"
                        },
                        "duplicate-checkpoint": {
                            "const": "current_receipt_reference_duplicate"
                        },
                        "duplicate-member": {
                            "const": "current_receipt_json_invalid"
                        },
                        "empty-bytes": {
                            "const": "current_receipt_size_invalid"
                        },
                        "latest-reference": {
                            "const": "current_receipt_latest_reference_forbidden"
                        },
                        "missing-plan": {
                            "const": "current_receipt_reference_missing"
                        },
                        "missing-status": {
                            "const": "current_receipt_json_invalid"
                        },
                        "old-format": {
                            "const": "current_receipt_shape_invalid"
                        },
                        "oversized-bytes": {
                            "const": "current_receipt_size_invalid"
                        },
                        "physical-schema-swap": {
                            "const": "current_receipt_live_admission_mismatch"
                        },
                        "provider-swap": {
                            "const": "current_receipt_live_admission_mismatch"
                        },
                        "rejected-status": {
                            "const": "current_receipt_live_admission_mismatch"
                        },
                        "semantic-mismatch": {
                            "const": "current_receipt_postcondition_failed"
                        },
                        "target-swap": {
                            "const": "current_receipt_live_admission_mismatch"
                        },
                        "unknown-member": {
                            "const": "current_receipt_json_invalid"
                        },
                        "unknown-provider": {
                            "const": "current_receipt_provider_unknown"
                        },
                        "unknown-status": {
                            "const": "current_receipt_json_invalid"
                        },
                        "whole-file-drift": {
                            "const": "current_receipt_artifact_digest_mismatch"
                        }
                    }
                },
                "observationDigest": {
                    "$ref": "#/$defs/digest"
                }
            }
        }
    }
}
