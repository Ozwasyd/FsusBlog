{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "fsusblog.runtime-role-observation.v3",
    "title": "FsusBlog compiled runtime-role observation",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "modes",
        "staticRoleCapabilities",
        "unsupportedCombinations",
        "ownership",
        "deploymentAuthority",
        "currentSchemaContract",
        "observationDigest"
    ],
    "properties": {
        "schema": {
            "const": "fsusblog.runtime-role-observation.v3"
        },
        "modes": {
            "type": "array",
            "minItems": 3,
            "uniqueItems": true,
            "items": {
                "$ref": "#/$defs/runtimeMode"
            }
        },
        "staticRoleCapabilities": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "propertyNames": {
                "pattern": "^[a-z][a-z0-9.-]*$"
            }
        },
        "unsupportedCombinations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "$ref": "#/$defs/unsupportedCombination"
            }
        },
        "ownership": {
            "$ref": "#/$defs/ownership"
        },
        "deploymentAuthority": {
            "$ref": "#/$defs/deploymentAuthority"
        },
        "observationDigest": {
            "$ref": "#/$defs/digest"
        },
        "currentSchemaContract": {
            "$ref": "#/$defs/currentSchemaContract"
        }
    },
    "$defs": {
        "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
        },
        "prefixedDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "runtimeMode": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "staticRoles",
                "clusterMembershipEnabled",
                "adaptiveSchedulerEnabled",
                "distributedInvalidationEnabled",
                "localInvocationOnly",
                "roleCombinationState"
            ],
            "properties": {
                "id": {
                    "enum": [
                        "single",
                        "static-role",
                        "adaptive"
                    ]
                },
                "staticRoles": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "clusterMembershipEnabled": {
                    "type": "boolean"
                },
                "adaptiveSchedulerEnabled": {
                    "type": "boolean"
                },
                "distributedInvalidationEnabled": {
                    "type": "boolean"
                },
                "localInvocationOnly": {
                    "type": "boolean"
                },
                "roleCombinationState": {
                    "enum": [
                        "optional-ignored",
                        "explicit-required"
                    ]
                }
            }
        },
        "unsupportedCombination": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "errorCode"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                },
                "errorCode": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "ownership": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "process",
                "container",
                "service",
                "coResidency",
                "separation",
                "authorityState",
                "claimEligible",
                "failureReasons"
            ],
            "properties": {
                "process": {
                    "type": "string",
                    "minLength": 1
                },
                "container": {
                    "type": "string",
                    "minLength": 1
                },
                "service": {
                    "type": "string",
                    "minLength": 1
                },
                "coResidency": {
                    "type": "string",
                    "minLength": 1
                },
                "separation": {
                    "type": "string",
                    "minLength": 1
                },
                "authorityState": {
                    "type": "string",
                    "minLength": 1
                },
                "claimEligible": {
                    "type": "boolean"
                },
                "failureReasons": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        },
        "sourceDigest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "path",
                "digest"
            ],
            "properties": {
                "path": {
                    "type": "string",
                    "minLength": 1
                },
                "digest": {
                    "$ref": "#/$defs/digest"
                }
            }
        },
        "composeExecutable": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "canonicalPath",
                "digest",
                "version"
            ],
            "properties": {
                "canonicalPath": {
                    "type": "string",
                    "pattern": "^/[^\\u0000]*$"
                },
                "digest": {
                    "$ref": "#/$defs/digest"
                },
                "version": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "composeService": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "image",
                "build",
                "pullPolicy",
                "profiles",
                "entrypoint",
                "command"
            ],
            "properties": {
                "image": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "build": {
                    "anyOf": [
                        {
                            "type": "object"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "pullPolicy": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "profiles": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "entrypoint": {
                    "anyOf": [
                        {
                            "type": "array"
                        },
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "command": {
                    "anyOf": [
                        {
                            "type": "array"
                        },
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            }
        },
        "effectiveCompose": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "oracle",
                "oracleVersion",
                "dockerExecutable",
                "composeImplementation",
                "sourcePath",
                "defaultServices",
                "allProfileServices",
                "modelDigest"
            ],
            "properties": {
                "oracle": {
                    "const": "docker-compose-config-json-no-interpolate"
                },
                "oracleVersion": {
                    "type": "string",
                    "minLength": 1
                },
                "dockerExecutable": {
                    "$ref": "#/$defs/composeExecutable"
                },
                "composeImplementation": {
                    "$ref": "#/$defs/composeExecutable"
                },
                "sourcePath": {
                    "const": "ops/docker/docker-compose.production.yml"
                },
                "defaultServices": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                        "$ref": "#/$defs/composeService"
                    }
                },
                "allProfileServices": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                        "$ref": "#/$defs/composeService"
                    }
                },
                "modelDigest": {
                    "$ref": "#/$defs/prefixedDigest"
                }
            }
        },
        "application": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "project",
                "dockerTarget",
                "processEntrypoint",
                "composeService",
                "image",
                "serviceRoster",
                "applicationServiceCount",
                "composeEntrypointOverride",
                "composeCommandOverride",
                "effectivePid1",
                "pid1Source"
            ],
            "properties": {
                "project": {
                    "const": "src/backend/FsusBlog.Server.csproj"
                },
                "dockerTarget": {
                    "type": "string",
                    "minLength": 1
                },
                "processEntrypoint": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "composeService": {
                    "type": "string",
                    "minLength": 1
                },
                "image": {
                    "type": "string",
                    "minLength": 1
                },
                "serviceRoster": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "applicationServiceCount": {
                    "type": "integer",
                    "minimum": 1
                },
                "composeEntrypointOverride": {
                    "type": "string",
                    "minLength": 1
                },
                "composeCommandOverride": {
                    "type": "string",
                    "minLength": 1
                },
                "effectivePid1": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "pid1Source": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "volume": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "source",
                "volumeName",
                "access",
                "scope",
                "protection"
            ],
            "properties": {
                "source": {
                    "type": "string",
                    "minLength": 1
                },
                "volumeName": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "access": {
                    "enum": [
                        "read-only",
                        "read-write"
                    ]
                },
                "scope": {
                    "type": "string",
                    "minLength": 1
                },
                "protection": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "deploymentAuthority": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema",
                "authoritySchema",
                "authorityContentDigest",
                "sourceDigests",
                "effectiveCompose",
                "application",
                "volumeTopology",
                "observationDigest"
            ],
            "properties": {
                "schema": {
                    "const": "fsusblog.runtime-role-deployment-observation.v1"
                },
                "authoritySchema": {
                    "const": "fsusblog.monolithic-distributed-architecture.v2"
                },
                "authorityContentDigest": {
                    "$ref": "#/$defs/prefixedDigest"
                },
                "sourceDigests": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "policy",
                        "project",
                        "dockerfile",
                        "productionCompose"
                    ],
                    "properties": {
                        "policy": {
                            "$ref": "#/$defs/sourceDigest"
                        },
                        "project": {
                            "$ref": "#/$defs/sourceDigest"
                        },
                        "dockerfile": {
                            "$ref": "#/$defs/sourceDigest"
                        },
                        "productionCompose": {
                            "$ref": "#/$defs/sourceDigest"
                        }
                    }
                },
                "effectiveCompose": {
                    "$ref": "#/$defs/effectiveCompose"
                },
                "application": {
                    "$ref": "#/$defs/application"
                },
                "volumeTopology": {
                    "type": "object",
                    "minProperties": 1,
                    "propertyNames": {
                        "pattern": "^/[^\\u0000]*$"
                    },
                    "additionalProperties": {
                        "$ref": "#/$defs/volume"
                    }
                },
                "observationDigest": {
                    "$ref": "#/$defs/prefixedDigest"
                }
            }
        },
        "currentSchemaContract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema",
                "stage",
                "evidenceClass",
                "receiptFormat",
                "target",
                "producer",
                "entityTableCount",
                "requiredRecipeCount",
                "inputDigest",
                "nativeVerifier",
                "nativeStage",
                "actualDatabaseObserved",
                "nativeClaimEligible"
            ],
            "properties": {
                "schema": {
                    "const": "fsusblog.runtime-role-current-schema-contract.v1"
                },
                "stage": {
                    "const": "compiled-contract"
                },
                "evidenceClass": {
                    "const": "original-production-current-model-and-receipt-validation-contract"
                },
                "receiptFormat": {
                    "const": "fsusblog.current-schema-receipt.v1"
                },
                "target": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "modelVersion",
                        "extractorVersion",
                        "generatorVersion",
                        "sourceDigest",
                        "contentDigest"
                    ],
                    "properties": {
                        "modelVersion": {
                            "type": "string",
                            "minLength": 1
                        },
                        "extractorVersion": {
                            "type": "string",
                            "minLength": 1
                        },
                        "generatorVersion": {
                            "type": "string",
                            "minLength": 1
                        },
                        "sourceDigest": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                        },
                        "contentDigest": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                        }
                    }
                },
                "producer": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "sourceCommit",
                        "producerId",
                        "producerAssemblySha256",
                        "contractAssemblySha256"
                    ],
                    "properties": {
                        "sourceCommit": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{40}$"
                        },
                        "producerId": {
                            "const": "fsusblog.current-schema-owned-projection.v1"
                        },
                        "producerAssemblySha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                        },
                        "contractAssemblySha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                        }
                    }
                },
                "entityTableCount": {
                    "type": "integer",
                    "minimum": 1
                },
                "requiredRecipeCount": {
                    "type": "integer",
                    "minimum": 1
                },
                "inputDigest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                },
                "nativeVerifier": {
                    "const": "FsusBlog.Server.Infrastructure.SchemaMigration.CurrentSchemaReceiptAdmission.VerifyAsync"
                },
                "nativeStage": {
                    "const": "post-static-admission"
                },
                "actualDatabaseObserved": {
                    "const": false
                },
                "nativeClaimEligible": {
                    "const": false
                }
            }
        }
    }
}
