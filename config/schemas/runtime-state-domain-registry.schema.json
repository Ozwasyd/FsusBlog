{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fsusblog.runtime-state-domain-registry.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "domains"],
  "properties": {
    "schema": {"const": "fsusblog.runtime-state-domain-registry.v1"},
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"}
    }
  }
}
