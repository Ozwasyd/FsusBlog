{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "fsusblog.runtime-state-domain-registry.v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "domains",
        "observerBindings",
        "quiescence"
    ],
    "properties": {
        "schema": {
            "const": "fsusblog.runtime-state-domain-registry.v1"
        },
        "domains": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
            }
        },
        "observerBindings": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "domain",
                    "observerId",
                    "observerVersion",
                    "semanticClass"
                ],
                "properties": {
                    "domain": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
                    },
                    "observerId": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
                    },
                    "observerVersion": {
                        "type": "string",
                        "pattern": "^v[1-9][0-9]*$"
                    },
                    "semanticClass": {
                        "enum": [
                            "aot-generation",
                            "auth-state",
                            "file-tree",
                            "object-storage",
                            "postgresql",
                            "redis",
                            "runtime-config",
                            "runtime-topology"
                        ]
                    }
                }
            }
        },
        "quiescence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema",
                "boundedQueueCatalog",
                "contracts",
                "managedWorkerSources"
            ],
            "properties": {
                "schema": {
                    "const": "fsusblog.quiescence-contract-registration.v1"
                },
                "boundedQueueCatalog": {
                    "const": "config/testing/bounded-channel-delivery-contracts.json"
                },
                "contracts": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "domainId",
                            "owner",
                            "stateDomains",
                            "observerApi",
                            "namespaceScope",
                            "highWatermarkSource",
                            "generationSource",
                            "freezeAdmissionHook",
                            "commitPostcondition",
                            "qualificationImpact",
                            "proofTests"
                        ],
                        "properties": {
                            "domainId": {
                                "type": "string",
                                "minLength": 1
                            },
                            "owner": {
                                "type": "string",
                                "minLength": 1
                            },
                            "stateDomains": {
                                "type": "array",
                                "minItems": 1,
                                "uniqueItems": true,
                                "items": {
                                    "type": "string",
                                    "minLength": 1
                                }
                            },
                            "observerApi": {
                                "type": "string",
                                "minLength": 1
                            },
                            "namespaceScope": {
                                "type": "string",
                                "minLength": 1
                            },
                            "highWatermarkSource": {
                                "type": "string",
                                "minLength": 1
                            },
                            "generationSource": {
                                "type": "string",
                                "minLength": 1
                            },
                            "freezeAdmissionHook": {
                                "type": "string",
                                "minLength": 1
                            },
                            "commitPostcondition": {
                                "type": "string",
                                "minLength": 1
                            },
                            "qualificationImpact": {
                                "type": "string",
                                "minLength": 1
                            },
                            "proofTests": {
                                "type": "array",
                                "minItems": 1,
                                "uniqueItems": true,
                                "items": {
                                    "type": "string",
                                    "minLength": 1
                                }
                            }
                        }
                    }
                },
                "managedWorkerSources": {
                    "type": "array",
                    "uniqueItems": true,
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "pattern": "^src/backend/.*[.]cs#[A-Za-z][A-Za-z0-9_]*$"
                    }
                }
            }
        }
    }
}
