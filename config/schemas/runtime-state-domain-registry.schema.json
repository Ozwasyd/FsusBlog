{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "fsusblog.runtime-state-domain-registry.v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "domains",
        "observerBindings"
    ],
    "properties": {
        "schema": {
            "const": "fsusblog.runtime-state-domain-registry.v1"
        },
        "domains": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
            }
        },
        "observerBindings": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "domain",
                    "observerId",
                    "observerVersion",
                    "semanticClass"
                ],
                "properties": {
                    "domain": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
                    },
                    "observerId": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
                    },
                    "observerVersion": {
                        "type": "string",
                        "pattern": "^v[1-9][0-9]*$"
                    },
                    "semanticClass": {
                        "enum": [
                            "aot-generation",
                            "auth-state",
                            "file-tree",
                            "object-storage",
                            "postgresql",
                            "redis",
                            "runtime-config",
                            "runtime-topology"
                        ]
                    }
                }
            }
        }
    }
}
