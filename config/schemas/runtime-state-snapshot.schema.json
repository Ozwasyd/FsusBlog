{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "fsusblog.runtime-state-snapshot.v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "status",
        "identity",
        "boundary",
        "stepId",
        "domains",
        "fragments",
        "semanticDigest",
        "snapshotDigest"
    ],
    "properties": {
        "schema": {
            "const": "fsusblog.runtime-state-snapshot.v1"
        },
        "status": {
            "const": "complete"
        },
        "identity": {
            "$ref": "#/$defs/identity"
        },
        "boundary": {
            "enum": [
                "before-runtime",
                "before-mutating-step",
                "after-mutating-step",
                "after-runtime"
            ]
        },
        "stepId": {
            "type": [
                "string",
                "null"
            ]
        },
        "domains": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string"
            }
        },
        "fragments": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "domain",
                    "observerId",
                    "observerVersion",
                    "fragmentDigest",
                    "semanticDigest"
                ],
                "properties": {
                    "domain": {
                        "type": "string"
                    },
                    "observerId": {
                        "type": "string"
                    },
                    "observerVersion": {
                        "type": "string"
                    },
                    "fragmentDigest": {
                        "$ref": "#/$defs/digest"
                    },
                    "semanticDigest": {
                        "$ref": "#/$defs/digest"
                    }
                }
            }
        },
        "semanticDigest": {
            "$ref": "#/$defs/digest"
        },
        "snapshotDigest": {
            "$ref": "#/$defs/digest"
        }
    },
    "$defs": {
        "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "runId",
                "attemptId",
                "sourceCommit",
                "sourceFingerprint",
                "buildReceiptDigest",
                "fixtureDigest",
                "envelopeDigest",
                "clockDigest",
                "replayDigest",
                "catalogDigest",
                "sessionId"
            ],
            "properties": {
                "runId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                },
                "attemptId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                },
                "sessionId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                },
                "sourceCommit": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                },
                "sourceFingerprint": {
                    "$ref": "#/$defs/digest"
                },
                "buildReceiptDigest": {
                    "$ref": "#/$defs/digest"
                },
                "fixtureDigest": {
                    "$ref": "#/$defs/digest"
                },
                "envelopeDigest": {
                    "$ref": "#/$defs/digest"
                },
                "clockDigest": {
                    "$ref": "#/$defs/digest"
                },
                "replayDigest": {
                    "$ref": "#/$defs/digest"
                },
                "catalogDigest": {
                    "$ref": "#/$defs/digest"
                }
            }
        }
    }
}
