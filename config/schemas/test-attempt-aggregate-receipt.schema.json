{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://fsusblog.local/schemas/test-attempt-aggregate-receipt.v1.json",
    "title": "FsusBlog aggregate attempt receipt",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "producerId",
        "schedulerRunId",
        "sourceCommit",
        "worktreeFingerprint",
        "retryPolicyId",
        "attempts",
        "firstAttemptStatus",
        "finalAttemptStatus",
        "finalClassification",
        "cleanFirstAttempt",
        "qualificationEligible",
        "contentDigest"
    ],
    "properties": {
        "schema": { "const": "fsusblog.test-attempt-aggregate-receipt.v1" },
        "producerId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "schedulerRunId": { "type": "string", "minLength": 1 },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "worktreeFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "retryPolicyId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "attempts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["attemptNumber", "path", "digest"],
                "properties": {
                    "attemptNumber": { "type": "integer", "minimum": 1, "maximum": 2 },
                    "path": { "type": "string", "minLength": 1 },
                    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
                }
            }
        },
        "firstAttemptStatus": { "enum": ["cancelled", "clean-success", "failed-no-retry"] },
        "finalAttemptStatus": { "enum": ["cancelled", "clean-success", "failed-no-retry"] },
        "finalClassification": {
            "enum": [
                "cancelled",
                "clean-success",
                "diagnostic-failed-after-retry",
                "diagnostic-recovered-after-allowed-infra-retry",
                "failed-no-retry",
                "recovered-infra-success",
                "unstable-attempt-topology"
            ]
        },
        "cleanFirstAttempt": { "type": "boolean" },
        "qualificationEligible": { "type": "boolean" },
        "contentDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
    }
}
