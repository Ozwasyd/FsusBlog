{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://fsusblog.local/schemas/test-attempt-receipt.v1.json",
    "title": "FsusBlog producer attempt receipt",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "producerId",
        "attemptNumber",
        "maxAttempts",
        "sourceCommit",
        "worktreeFingerprint",
        "schedulerRunId",
        "command",
        "commandDigest",
        "executionEnvelopeDigest",
        "replayPlanDigest",
        "temporalContextDigest",
        "authorityReferences",
        "startedAt",
        "finishedAt",
        "durationMs",
        "exitCode",
        "signal",
        "failureClass",
        "failureKind",
        "failedTestIds",
        "executedTestIds",
        "stdoutPath",
        "stderrPath",
        "artifactPaths",
        "artifactDigests",
        "firstFailure",
        "retryDecision",
        "retryPolicyId",
        "status",
        "contentDigest"
    ],
    "properties": {
        "schema": { "const": "fsusblog.test-attempt-receipt.v1" },
        "producerId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "attemptNumber": { "type": "integer", "minimum": 1 },
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 2 },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "worktreeFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "schedulerRunId": { "type": "string", "minLength": 1 },
        "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "commandDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "executionEnvelopeDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "replayPlanDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "temporalContextDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "authorityReferences": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "$ref": "#/$defs/authorityReference" }
        },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "exitCode": { "type": ["integer", "null"] },
        "signal": { "type": ["string", "null"] },
        "failureClass": { "type": ["string", "null"] },
        "failureKind": { "type": ["string", "null"] },
        "failedTestIds": { "$ref": "#/$defs/sortedStrings" },
        "executedTestIds": { "$ref": "#/$defs/sortedStrings" },
        "stdoutPath": { "type": "string", "minLength": 1 },
        "stderrPath": { "type": "string", "minLength": 1 },
        "artifactPaths": { "$ref": "#/$defs/sortedStrings" },
        "artifactDigests": {
            "type": "object",
            "additionalProperties": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "firstFailure": { "type": "boolean" },
        "retryDecision": { "enum": ["not-applicable", "policy-authorized", "policy-denied", "policy-exhausted"] },
        "retryPolicyId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "status": {
            "enum": [
                "cancelled",
                "clean-success",
                "failed-no-retry"
            ]
        },
        "contentDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
    },
    "$defs": {
        "sortedStrings": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
        },
        "authorityReference": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "artifactPath", "artifactDigest", "verificationReceiptPath", "verificationReceiptDigest"],
            "properties": {
                "kind": { "enum": ["execution-envelope", "replay-plan", "temporal-context"] },
                "artifactPath": { "type": "string", "minLength": 1 },
                "artifactDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                "verificationReceiptPath": { "type": "string", "minLength": 1 },
                "verificationReceiptDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            }
        }
    }
}
