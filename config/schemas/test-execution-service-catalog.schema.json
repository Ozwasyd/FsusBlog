{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://fsusblog.local/schemas/test-execution-service-catalog.schema.json",
    "title": "FsusBlog Test Execution Service Catalog",
    "type": "object",
    "required": [
        "schema",
        "version",
        "correctnessPhase",
        "containerRuntime",
        "services"
    ],
    "properties": {
        "schema": {
            "const": "fsusblog.test-execution-service-catalog.v2"
        },
        "version": {
            "const": 2
        },
        "correctnessPhase": {
            "type": "object",
            "required": [
                "imagePull",
                "hostFallback",
                "admission"
            ],
            "properties": {
                "imagePull": {
                    "const": "denied"
                },
                "hostFallback": {
                    "const": "denied"
                },
                "admission": {
                    "const": "planned-actual-exact"
                }
            },
            "additionalProperties": false
        },
        "containerRuntime": {
            "type": "object",
            "required": [
                "kind",
                "identityFields",
                "plannedVersionSource"
            ],
            "properties": {
                "kind": {
                    "const": "docker"
                },
                "identityFields": {
                    "const": [
                        "serverVersion",
                        "serverId",
                        "operatingSystem",
                        "architecture",
                        "cgroupDriver"
                    ]
                },
                "plannedVersionSource": {
                    "const": "observed-preflight-exact"
                }
            },
            "additionalProperties": false
        },
        "services": {
            "type": "object",
            "required": [
                "backend",
                "frontend",
                "postgres",
                "preview",
                "redis"
            ],
            "properties": {
                "backend": {
                    "$ref": "#/$defs/processService"
                },
                "frontend": {
                    "$ref": "#/$defs/processService"
                },
                "postgres": {
                    "$ref": "#/$defs/postgresService"
                },
                "preview": {
                    "$ref": "#/$defs/processService"
                },
                "redis": {
                    "$ref": "#/$defs/containerService"
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false,
    "$defs": {
        "processService": {
            "type": "object",
            "required": [
                "kind",
                "identityAuthority",
                "image",
                "imageNotApplicableReason"
            ],
            "properties": {
                "kind": {
                    "const": "run-owned-process"
                },
                "identityAuthority": {
                    "const": "resident-resource-lease"
                },
                "image": {
                    "type": "null"
                },
                "imageNotApplicableReason": {
                    "const": "repository-build-artifact-process"
                }
            },
            "additionalProperties": false
        },
        "containerService": {
            "type": "object",
            "required": [
                "kind",
                "imageReference",
                "version",
                "versionCommand",
                "hostNativeAllowed",
                "requiredIdentityFields"
            ],
            "properties": {
                "kind": {
                    "const": "container"
                },
                "imageReference": {
                    "type": "string",
                    "pattern": "^[a-z0-9./_-]+@sha256:[a-f0-9]{64}$"
                },
                "version": {
                    "type": "string",
                    "minLength": 1
                },
                "versionCommand": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string"
                    }
                },
                "hostNativeAllowed": {
                    "const": false
                },
                "requiredIdentityFields": {
                    "const": [
                        "containerId",
                        "imageReference",
                        "imageId",
                        "repositoryDigest",
                        "serviceVersion",
                        "networkMode",
                        "ports",
                        "resourceLimits"
                    ]
                }
            },
            "additionalProperties": false
        },
        "postgresService": {
            "type": "object",
            "required": [
                "kind",
                "imageReference",
                "version",
                "databaseIdentityAuthority",
                "database",
                "username",
                "serverVersionNumber",
                "versionCommand",
                "hostNativeAllowed",
                "requiredIdentityFields"
            ],
            "properties": {
                "kind": {
                    "const": "container"
                },
                "imageReference": {
                    "type": "string",
                    "pattern": "^[a-z0-9./_-]+@sha256:[a-f0-9]{64}$"
                },
                "version": {
                    "const": "16.15"
                },
                "databaseIdentityAuthority": {
                    "const": "postgres-control-system-exact"
                },
                "database": {
                    "const": "fsusblog"
                },
                "username": {
                    "const": "fsusblog"
                },
                "serverVersionNumber": {
                    "const": "160015"
                },
                "versionCommand": {
                    "const": [
                        "postgres",
                        "--version"
                    ]
                },
                "hostNativeAllowed": {
                    "const": false
                },
                "requiredIdentityFields": {
                    "const": [
                        "containerId",
                        "imageReference",
                        "imageId",
                        "repositoryDigest",
                        "serviceVersion",
                        "networkMode",
                        "ports",
                        "resourceLimits",
                        "databaseIdentity"
                    ]
                }
            },
            "additionalProperties": false
        }
    }
}
