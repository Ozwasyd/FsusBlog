{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsus.dev/schemas/test-matrix-priority-score.v1.json",
  "title": "FsusBlog test matrix ready-set priority score",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "modelVersion", "sourceBinding", "signals"],
  "properties": {
    "schema": { "const": "fsusblog.test-matrix.priority-score.v1" },
    "modelVersion": { "const": 1 },
    "sourceBinding": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceClosureDigest", "testIds", "samples"],
          "properties": {
            "sourceClosureDigest": { "$ref": "#/$defs/digest" },
            "testIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "samples": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "fallbackReason": { "type": "string", "minLength": 1 },
    "signals": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": { "$ref": "#/$defs/signal" }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawValue", "normalizedValue", "weight", "contribution"],
      "properties": {
        "rawValue": {},
        "normalizedValue": { "type": "number" },
        "weight": { "type": "number" },
        "contribution": { "type": "number" }
      }
    }
  }
}
