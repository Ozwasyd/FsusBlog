            "stateFields": [
                "classification",
                "commentId",
                "confidence",
                "evidenceRef",
                "provider",
                "signalRef",
                "version"
            ],
            "postconditions": [
                "admin.signal-exact",
                "database.evidence-exact",
                "database.signal-exact"
            ],
            "proofTests": [
                "signal-private-payload-absent",
                "signal-provider-version-bound"
            ]
        },
        {
            "id": "comment.thread.depth-boundary",
            "portId": "comment-thread-lifecycle",
            "requiredRefs": [
                "article.published",
                "auth.user.active"
            ],
            "stateFields": [
                "commentId",
                "depth",
                "parentId",
                "rootId"
            ],
            "postconditions": [
                "admin.relation-exact",
                "database.depth-policy-exact",
                "public.relation-exact"
            ],
            "proofTests": [
