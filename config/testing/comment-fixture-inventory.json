                "depth-overrun-rejected"
            ]
        },
        {
            "id": "comment.thread.nested",
            "portId": "comment-thread-lifecycle",
            "requiredRefs": [
                "article.published",
                "auth.user.active"
            ],
            "stateFields": [
                "commentId",
                "depth",
                "parentId",
                "replyToCommentId",
                "rootId"
            ],
            "postconditions": [
                "admin.relation-exact",
                "database.relation-exact",
                "public.relation-exact"
            ],
            "proofTests": [
                "nested-public-order",
                "nested-relation"
            ]
        },
        {
            "id": "comment.thread.reply",
            "portId": "comment-thread-lifecycle",
            "requiredRefs": [
                "article.published",
                "auth.user.active"
            ],
            "stateFields": [
                "commentId",
                "depth",
                "parentId",
                "replyToCommentId",
                "rootId"
            ],
            "postconditions": [
                "admin.relation-exact",
                "database.relation-exact",
                "public.relation-exact"
            ],
            "proofTests": [
                "reply-parent-root",
                "reply-target-exact"
            ]
        },
        {
            "id": "comment.thread.root",
            "portId": "comment-thread-lifecycle",
            "requiredRefs": [
                "article.published",
                "auth.user.active"
            ],
            "stateFields": [
                "articleId",
                "commentId",
                "depth",
                "parentId",
                "replyToCommentId",
                "rootId"
            ],
            "postconditions": [
