            "positive",
            "negative",
            "boundary",
            "failure"
        ],
        "qualifyingEnvelope": {
            "executionClass": "correctness",
            "evidenceClass": "correctness",
            "qualificationEligible": true,
            "planned": true,
            "executed": true,
            "outcome": "passed",
            "recovered": false
        },
        "terminalOutcomes": {
            "passed": {
                "timeout": false,
                "cancelled": false,
                "processTreeTerminated": false
            },
            "failed": {
                "timeout": false,
                "cancelled": false,
                "processTreeTerminated": false
            },
            "timed-out": {
                "timeout": true,
                "cancelled": false,
                "processTreeTerminated": true
            },
            "cancelled": {
                "timeout": false,
                "cancelled": true,
                "processTreeTerminated": true
            }
        }
    },
