    "producers": [
        {
            "producerId": "production-correctness-scheduler",
            "toolVersion": "production-correctness-scheduler@1",
            "owner": "tools/run-test-matrix.mjs",
            "behaviorId": "browserless-production-correctness",
            "behaviorDomain": "testing",
            "producerTierId": "production-correctness",
            "observationSchema": "fsusblog.browserless-correctness-receipt.v1",
            "executionClass": "correctness",
            "evidenceClass": "correctness",
            "requiredIdentities": [
                "sourceCommit",
                "worktreeFingerprint",
                "buildIdentity",
                "schedulerRunId",
                "producerId"
            ],
            "requiredObservations": {
                "positive": [
                    "browser-behavior-contract",
                    "release-identity-readiness",
                    "route-response-error",
                    "cache-search-outbox-convergence"
                ],
                "negative": [
                    "route-response-error",
                    "session-cookie-runtime",
                    "browser-behavior-contract"
                ],
                "boundary": [
                    "aot-spa-hydration",
                    "blue-green-containment"
                ],
                "failure": [
                    "blue-green-containment",
                    "session-cookie-runtime"
                ]
            },
            "diagnosticEligible": false,
            "timeoutPolicy": "per-producer budget from config/testing/correctness-budget-policy.json with physical process-tree termination",
            "cancelPolicy": "cancel terminates the whole process tree and leaves no partial receipt",
            "recoveryPolicy": "resume appends a new attempt only; previous attempts stay sealed read-only",
            "acceptedClaimRefs": [
                "browserless-production-correctness.tiers",
                "browserless-production-correctness.final-inputs",
                "browserless-production-correctness.bundle-order",
                "browserless-production-correctness.execution-classes",
                "browserless-production-correctness.predecessors",
