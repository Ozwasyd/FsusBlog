{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://fsusblog.local/schemas/temporal-shape-catalog.v1.json",
    "title": "FsusBlog temporal shape catalog",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "baseEpochAuthority",
        "precisionPolicy",
        "roleOwners",
        "roleRegistry",
        "timezoneCases",
        "cultureCases",
        "tieBreakers",
        "invariants",
        "requiredBoundaryTags",
        "shapes"
    ],
    "properties": {
        "schema": {
            "const": "fsusblog.temporal-shape-catalog.v1"
        },
        "baseEpochAuthority": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "source",
                "representation"
            ],
            "properties": {
                "source": {
                    "const": "temporalContext.businessEpochUtc"
                },
                "representation": {
                    "const": "relative-offsets-only"
                }
            }
        },
        "precisionPolicy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "unit",
                "rounding",
                "loss"
            ],
            "properties": {
                "unit": {
                    "const": "millisecond"
                },
                "rounding": {
                    "const": "none"
                },
                "loss": {
                    "const": "reject"
                }
            }
        },
        "roleOwners": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/idSource"
            }
        },
        "roleRegistry": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "domain",
                    "owner",
                    "clockKind",
                    "semanticEffect"
                ],
                "properties": {
                    "id": {
                        "$ref": "#/$defs/id"
                    },
                    "domain": {
                        "$ref": "#/$defs/id"
                    },
                    "owner": {
                        "$ref": "#/$defs/id"
                    },
                    "clockKind": {
                        "enum": [
                            "business-wall",
                            "artifact-metadata"
                        ]
                    },
                    "semanticEffect": {
                        "enum": [
                            "included",
                            "excluded"
                        ]
                    }
                }
            }
        },
        "timezoneCases": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "timezone"
                ],
                "properties": {
                    "id": {
                        "$ref": "#/$defs/id"
                    },
                    "timezone": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        },
        "cultureCases": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "locale",
                    "backendCulture",
                    "calendar"
                ],
                "properties": {
                    "id": {
                        "$ref": "#/$defs/id"
                    },
                    "locale": {
                        "type": "string",
                        "minLength": 1
                    },
                    "backendCulture": {
                        "type": "string",
                        "minLength": 1
                    },
                    "calendar": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        },
        "tieBreakers": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "identity",
                    "source"
                ],
                "properties": {
                    "id": {
                        "$ref": "#/$defs/id"
                    },
                    "identity": {
                        "type": "string",
                        "minLength": 1
                    },
                    "source": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        },
        "invariants": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "kind",
                    "roles"
                ],
                "properties": {
                    "id": {
                        "$ref": "#/$defs/id"
                    },
                    "kind": {
                        "enum": [
                            "ordered-chain",
                            "same-instant",
                            "occurred-arrival",
                            "metadata-exclusion"
                        ]
                    },
                    "roles": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "$ref": "#/$defs/id"
                        }
                    },
                    "operators": {
                        "type": "array",
                        "items": {
                            "enum": [
                                "<",
                                "<="
                            ]
                        }
                    },
                    "tieBreakerId": {
                        "$ref": "#/$defs/id"
                    }
                }
            }
        },
        "requiredBoundaryTags": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/id"
            }
        },
        "shapes": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/shape"
            }
        },
        "entityShapes": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/entityShape"
            }
        }
    },
    "$defs": {
        "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "idSource": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "source"
            ],
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "source": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "roleBinding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "roleId",
                "offsetMilliseconds",
                "expectedBusinessState"
            ],
            "properties": {
                "roleId": {
                    "$ref": "#/$defs/id"
                },
                "offsetMilliseconds": {
                    "type": "integer"
                },
                "expectedBusinessState": {
                    "$ref": "#/$defs/id"
                }
            }
        },
        "orderingGroup": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "roleIds",
                "direction"
            ],
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "roleIds": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                        "$ref": "#/$defs/id"
                    }
                },
                "direction": {
                    "enum": [
                        "ascending",
                        "descending",
                        "same-instant"
                    ]
                },
                "tieBreakerId": {
                    "$ref": "#/$defs/id"
                }
            }
        },
        "expiryBoundary": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "subjectRoleId",
                "referenceRoleId",
                "relation"
            ],
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "subjectRoleId": {
                    "$ref": "#/$defs/id"
                },
                "referenceRoleId": {
                    "$ref": "#/$defs/id"
                },
                "relation": {
                    "enum": [
                        "before",
                        "at",
                        "after"
                    ]
                }
            }
        },
        "shape": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "schema",
                "baseEpochReference",
                "timezoneCaseId",
                "cultureCaseId",
                "timestampRoles",
                "orderingGroups",
                "expiryBoundaries",
                "expectedBusinessStates",
                "invariantIds",
                "boundaryTags",
                "contentDigest"
            ],
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "schema": {
                    "const": "fsusblog.temporal-shape.v1"
                },
                "baseEpochReference": {
                    "const": "temporalContext.businessEpochUtc"
                },
                "timezoneCaseId": {
                    "$ref": "#/$defs/id"
                },
                "cultureCaseId": {
                    "$ref": "#/$defs/id"
                },
                "timestampRoles": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/roleBinding"
                    }
                },
                "orderingGroups": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/orderingGroup"
                    }
                },
                "expiryBoundaries": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/expiryBoundary"
                    }
                },
                "expectedBusinessStates": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "invariantIds": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/id"
                    }
                },
                "boundaryTags": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/id"
                    }
                },
                "contentDigest": {
                    "$ref": "#/$defs/digest"
                }
            }
        },
        "entityShape": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "schema",
                "entityKinds",
                "contentDigest",
                "parentChronology"
            ],
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "schema": {
                    "const": "fsusblog.temporal-entity-shape.v1"
                },
                "entityKinds": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "kind",
                            "states",
                            "revisionRequired",
                            "publicationAllowed",
                            "stateFacts",
                            "roles",
                            "invariantIds"
                        ],
                        "properties": {
                            "kind": {
                                "$ref": "#/$defs/id"
                            },
                            "states": {
                                "type": "array",
                                "minItems": 1,
                                "uniqueItems": true,
                                "items": {
                                    "$ref": "#/$defs/id"
                                }
                            },
                            "revisionRequired": {
                                "type": "boolean"
                            },
                            "publicationAllowed": {
                                "type": "boolean"
                            },
                            "stateFacts": {
                                "type": "array",
                                "uniqueItems": true,
                                "items": {
                                    "type": "string",
                                    "minLength": 1
                                }
                            },
                            "roles": {
                                "type": "array",
                                "minItems": 1,
                                "items": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "required": [
                                        "roleId",
                                        "presence",
                                        "absent"
                                    ],
                                    "properties": {
                                        "roleId": {
                                            "$ref": "#/$defs/id"
                                        },
                                        "presence": {
                                            "type": "string",
                                            "minLength": 1
                                        },
                                        "absent": {
                                            "enum": [
                                                "null",
                                                "not-generated"
                                            ]
                                        }
                                    }
                                }
                            },
                            "invariantIds": {
                                "type": "array",
                                "uniqueItems": true,
                                "items": {
                                    "$ref": "#/$defs/id"
                                }
                            }
                        }
                    }
                },
                "contentDigest": {
                    "$ref": "#/$defs/digest"
                },
                "parentChronology": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "roleId",
                        "operator"
                    ],
                    "properties": {
                        "roleId": {
                            "const": "comment.created"
                        },
                        "operator": {
                            "const": "<="
                        }
                    }
                }
            }
        }
    }
}
