{
	admin off
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

(fsusblog_upstream) {
	reverse_proxy 127.0.0.1:{$FSUSBLOG_UPSTREAM_PORT} {
		header_up -Forwarded
		header_up -X-Original-For
		header_up -X-Original-Proto
		header_up -X-Original-Host
		header_up -X-Original-Prefix
		transport http {
			versions 1.1
			keepalive 60s
			keepalive_idle_conns_per_host 64
			max_conns_per_host 64
			compression off
		}
	}
}

{$FSUSBLOG_PUBLIC_ADDRESS} {
	bind {$FSUSBLOG_PROXY_BIND:0.0.0.0}
	tls {$FSUSBLOG_TLS_CERTIFICATE} {$FSUSBLOG_TLS_KEY}
	@private_preview path /api/v2/media/draft-preview /api/v2/media/draft-preview/*
	log_skip @private_preview
	import fsusblog_upstream
}
