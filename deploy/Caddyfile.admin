import Caddyfile

{$FSUSBLOG_ADMIN_ADDRESS} {
	bind {$FSUSBLOG_PROXY_BIND:0.0.0.0}
	tls {$FSUSBLOG_ADMIN_TLS_CERTIFICATE} {$FSUSBLOG_ADMIN_TLS_KEY}

	@wrong_tls_host expression `{http.request.tls.server_name}.lowerAscii() != {http.request.host}.lowerAscii()`
	@admin_routes path /admin /admin/ /admin/articles /admin/articles/ /admin/interaction /admin/interaction/ /admin/site /admin/site/ /admin/system /admin/system/ /admin/identity /admin/identity/ /admin/articles/write /admin/articles/workspace /admin/articles/edit/* /admin/canvas /admin/canvas/* /admin/assets /api/v2/admin/identity/* /api/v2/authoring/* /api/v2/media/* /assets/* /dist/*
	@admin_legacy_read {
		method GET
		path_regexp admin_legacy_read (?i)^/api/binary/(system/admin/page/[^/]+|author/comments/[0-9]+/(revisions|moderation-timeline))/?$
	}
	@admin_page_write {
		method PUT
		path_regexp admin_page_write (?i)^/api/binary/system/page/?$
	}
	route {
		respond @wrong_tls_host 421
		handle @admin_routes {
			import fsusblog_upstream
		}
		handle @admin_legacy_read {
			import fsusblog_upstream
		}
		handle @admin_page_write {
			import fsusblog_upstream
		}
		respond 404
	}
}
