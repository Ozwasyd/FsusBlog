[Unit]
Description=Seal the previous UTC day of the FsusBlog publication ledger
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=fsusblog-checkpoint
EnvironmentFile=/etc/fsusblog/checkpoint.env
StateDirectory=fsusblog-checkpoints
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=2min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ExecStart=/usr/bin/dotnet /opt/fsusblog/cli/FsusBlog.V2.Cli.dll publication-transparency checkpoint-daily-auto "${FSUSBLOG_PUBLIC_ORIGIN}" "${FSUSBLOG_CHECKPOINT_KEYS}" "${FSUSBLOG_CHECKPOINT_ANCHOR_SEQUENCE}" "${FSUSBLOG_CHECKPOINT_ANCHOR_SHA256}" /var/lib/fsusblog-checkpoints
