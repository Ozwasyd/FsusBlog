<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" Sdk="Microsoft.Docker.Sdk">
  <PropertyGroup Label="Globals">
    <ProjectVersion>2.1</ProjectVersion>
    <DockerTargetOS>Linux</DockerTargetOS>
    <ProjectGuid>81dded9d-158b-e303-5f62-77a2896d2a5a</ProjectGuid>
    <DockerComposeProjectPath>docker-compose.yml</DockerComposeProjectPath>
  </PropertyGroup>

  <!-- 核心修复(2026-02-21)：根据 VS 顶部的配置自动适配 Compose 文件组合 -->
  <PropertyGroup>
    <DockerComposeBaseConfiguration>docker-compose.yml</DockerComposeBaseConfiguration>
    
    <!-- 调试模式：加载基础配置 + 开发覆盖配置 (支持热更新和挂载) -->
    <DockerComposeBaseConfiguration Condition="'$(Configuration)' == 'Debug'">$(DockerComposeBaseConfiguration);docker-compose.dev.yml</DockerComposeBaseConfiguration>
    
    <!-- 发布模式：仅加载基础配置 (执行纯净的 Dockerfile 多阶段构建) -->
    <DockerComposeBaseConfiguration Condition="'$(Configuration)' == 'Release'">$(DockerComposeBaseConfiguration)</DockerComposeBaseConfiguration>
  </PropertyGroup>

  <ItemGroup>
    <None Include=".env" />
    <!-- 逻辑自洽：这里的 DependentUpon 保持 UI 上的树形结构 -->
    <None Include="docker-compose.dev.yml">
      <DependentUpon>docker-compose.yml</DependentUpon>
    </None>
    <None Include="docker-compose.yml" />
    <None Include=".dockerignore" />
  </ItemGroup>
</Project>