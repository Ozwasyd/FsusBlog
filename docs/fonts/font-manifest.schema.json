{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://fsusblog.local/schemas/font-manifest.schema.json",
    "title": "FsusBlog FontManifest",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "id",
        "name",
        "version",
        "fsusblog",
        "type",
        "family",
        "category",
        "scripts",
        "locales",
        "faces",
        "license",
        "budgets",
        "loading"
    ],
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^fsusblog\\.font\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
            "type": "string",
            "minLength": 1
        },
        "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "fsusblog": {
            "type": "string",
            "minLength": 1
        },
        "type": {
            "const": "font"
        },
        "family": {
            "type": "string",
            "minLength": 1
        },
        "category": {
            "enum": [
                "ui-sans",
                "prose-sans",
                "code-mono",
                "cjk-sans",
                "emoji"
            ]
        },
        "scripts": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            },
            "uniqueItems": true
        },
        "locales": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            },
            "uniqueItems": true
        },
        "faces": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
                "$ref": "#/$defs/face"
            }
        },
        "license": {
            "$ref": "#/$defs/license"
        },
        "budgets": {
            "$ref": "#/$defs/budgets"
        },
        "loading": {
            "$ref": "#/$defs/loading"
        }
    },
    "$defs": {
        "packagePath": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^\\u0000]+$"
        },
        "face": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "weight",
                "style",
                "file",
                "critical"
            ],
            "properties": {
                "weight": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                },
                "style": {
                    "enum": [
                        "normal",
                        "italic",
                        "oblique"
                    ]
                },
                "file": {
                    "allOf": [
                        {
                            "$ref": "#/$defs/packagePath"
                        },
                        {
                            "pattern": "^fonts/.+\\.woff2$"
                        }
                    ]
                },
                "unicodeRange": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "critical": {
                    "type": "boolean"
                }
            }
        },
        "license": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "file",
                "source"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "file": {
                    "allOf": [
                        {
                            "$ref": "#/$defs/packagePath"
                        },
                        {
                            "pattern": "^license/.+"
                        }
                    ]
                },
                "source": {
                    "allOf": [
                        {
                            "$ref": "#/$defs/packagePath"
                        },
                        {
                            "pattern": "^license/.+\\.json$"
                        }
                    ]
                }
            }
        },
        "budgets": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "criticalBytes",
                "totalBytes",
                "maxFaces"
            ],
            "properties": {
                "criticalBytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 16777216
                },
                "totalBytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 67108864
                },
                "maxFaces": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 32
                }
            }
        },
        "loading": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "display",
                "preload",
                "defer"
            ],
            "properties": {
                "display": {
                    "enum": [
                        "auto",
                        "block",
                        "swap",
                        "fallback",
                        "optional"
                    ]
                },
                "preload": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "uniqueItems": true
                },
                "defer": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "uniqueItems": true
                }
            }
        }
    }
}
