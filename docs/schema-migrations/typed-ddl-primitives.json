{
    "schema": "fsusblog.schema-migration-primitives.v1",
    "issue": 1134,
    "defaultDialect": "PostgreSql",
    "supportedDialects": [
        "PostgreSql",
        "MySql",
        "Sqlite"
    ],
    "identifier": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
        "qualifiedNamesAllowed": false,
        "rawInterpolationAllowed": false
    },
    "columnDefinition": {
        "types": [
            "smallint",
            "integer",
            "bigint",
            "boolean",
            "bytea",
            "text",
            "timestamp",
            "varchar(n)"
        ],
        "nullability": [
            "NULL",
            "NOT NULL"
        ],
        "defaults": [
            "integer",
            "boolean",
            "now()",
            "string-literal"
        ],
        "multipleStatementsAllowed": false
    },
    "ddlStepKinds": [
        "EnsureTable",
        "EnsureColumn",
        "RenameTable",
        "RenameColumn",
        "DropColumn",
        "DropTable",
        "DropIndex",
        "CreateIndex"
    ],
    "execution": {
        "construction": "SchemaMigrationStep.BuildCommand(ISchemaDdlProvider)",
        "singleExecutionBoundary": "SchemaMigrationStep.ExecuteAsync",
        "preview": "SchemaMigrationPreviewer.PreviewAsync",
        "transactionBoundary": "SchemaMigrationDescriptor.Transactional via SchemaMigrationTransactionExecutor.ExecuteAsync",
        "crossDialectSnapshot": "tests/migration/schema-ddl-provider-snapshots.json",
        "mysql": {
            "realEngineTests": "tests/migration/MySqlDdlExecutionTests.cs",
            "testedEngine": "MySQL 8.4",
            "selectedDatabaseRequired": true,
            "ensureColumn": "Leave an existing column unchanged; otherwise execute admitted ADD COLUMN without MariaDB-only IF NOT EXISTS.",
            "createIndex": "Resolve existence on the exact selected database and target table; preserve unique/non-unique intent without changing an existing index.",
            "dropIndex": "Resolve one owning table, quote schema/table metadata, and no-op only for an absent index. Binary identity deduplication preserves case-only ambiguity; multiple owners fail before a write.",
            "stringDefaults": "Decode shared doubled quotes and emit an explicit UTF-8 constant expression independent of backslash SQL mode.",
            "ddlRollbackGuaranteed": false,
            "transactionLimitation": "DDL may implicitly commit; descriptor transaction wrappers are not a promise of transactional DDL rollback.",
            "historyAcceptance": "Primitive execution and snapshots do not certify every historical SQL template."
        },
        "legacyEnsureTableBatch": {
            "firstStatement": "CREATE TABLE",
            "allowedTrailingStatements": [
                "CREATE TABLE",
                "CREATE INDEX",
                "CREATE UNIQUE INDEX",
                "same-table INSERT INTO"
            ],
            "commentsAllowed": false
        },
        "standaloneDdlTemplates": {
            "singleStatementOnly": true,
            "commentsAllowed": false,
            "validatedKinds": [
                "CREATE INDEX",
                "CREATE UNIQUE INDEX"
            ]
        }
    },
    "negativeCases": [
        "empty_identifier",
        "qualified_identifier",
        "quoted_identifier",
        "statement_terminator_in_identifier",
        "unsupported_column_type",
        "ddl_in_column_definition",
        "wrong_ddl_template_kind",
        "multiple_unapproved_ddl_template_statements",
        "commented_ddl_template"
    ]
}
