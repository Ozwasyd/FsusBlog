{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsusblog.local/schemas/moderation/model-provider-error.schema.json",
  "title": "FsusBlog Moderation Provider Error",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "provider_id",
    "status",
    "error"
  ],
  "not": {
    "anyOf": [
      { "required": ["allow"] },
      { "required": ["reject_submit"] },
      { "required": ["geo_block"] },
      { "required": ["publish"] },
      { "required": ["hide"] },
      { "required": ["legal_in_region"] },
      { "required": ["illegal_in_region"] },
      { "required": ["blocked_regions"] },
      { "required": ["submit_action"] },
      { "required": ["display_action"] },
      { "required": ["action"] }
    ]
  },
  "properties": {
    "contract_version": {
      "const": "fsusblog-moderation-provider-v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "provider_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "status": {
      "type": "string",
      "enum": [
        "provider_error",
        "model_unavailable",
        "contract_mismatch",
        "too_long",
        "empty",
        "unsupported_language"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Z0-9_]+$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "retryable": {
          "type": "boolean"
        }
      }
    }
  }
}
