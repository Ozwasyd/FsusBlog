{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsusblog.local/schemas/moderation/model-provider-request.schema.json",
  "title": "FsusBlog Moderation Provider Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "content_type",
    "text"
  ],
  "not": {
    "anyOf": [
      { "required": ["userId"] },
      { "required": ["user_id"] },
      { "required": ["userid"] },
      { "required": ["username"] },
      { "required": ["userName"] },
      { "required": ["user_name"] },
      { "required": ["email"] },
      { "required": ["ip"] },
      { "required": ["lastIp"] },
      { "required": ["last_ip"] },
      { "required": ["authorId"] },
      { "required": ["author_id"] },
      { "required": ["replyToUserId"] },
      { "required": ["reply_to_user_id"] },
      { "required": ["accountId"] },
      { "required": ["account_id"] },
      { "required": ["publicHandle"] },
      { "required": ["public_handle"] }
    ]
  },
  "properties": {
    "contract_version": {
      "const": "fsusblog-moderation-provider-v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "comment",
        "article",
        "profile",
        "message"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 0,
      "maxLength": 20000
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
    },
    "region_hint": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[A-Z0-9][A-Z0-9-]*$"
    },
    "threshold_profile": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "max_evidence_items": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32
    },
    "metadata": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "enum": [
          "source",
          "comment_id",
          "article_id",
          "comment_depth",
          "region_policy_version",
          "author_mode",
          "anonymous_display_language",
          "moderation_subject_hash",
          "credential_level",
          "reputation_bucket",
          "account_age_bucket",
          "anonymous_comments_enabled",
          "zk_anonymous_enabled",
          "anonymous_proof_level",
          "anonymous_credential_level",
          "anonymous_nullifier_hash",
          "anonymous_scope",
          "submitted_time_bucket"
        ]
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    }
  }
}
