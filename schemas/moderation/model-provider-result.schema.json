{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsusblog.local/schemas/moderation/model-provider-result.schema.json",
  "title": "FsusBlog Moderation Provider Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "provider_id",
    "model_profile",
    "status",
    "label",
    "confidence",
    "severity",
    "categories"
  ],
  "not": {
    "anyOf": [
      { "required": ["allow"] },
      { "required": ["reject_submit"] },
      { "required": ["geo_block"] },
      { "required": ["publish"] },
      { "required": ["hide"] },
      { "required": ["legal_in_region"] },
      { "required": ["illegal_in_region"] },
      { "required": ["blocked_regions"] },
      { "required": ["submit_action"] },
      { "required": ["display_action"] },
      { "required": ["action"] }
    ]
  },
  "properties": {
    "contract_version": {
      "const": "fsusblog-moderation-provider-v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "provider_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "model_profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "threshold_profile": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "status": {
      "type": "string",
      "enum": [
        "scored",
        "unsupported_language",
        "too_long",
        "empty",
        "provider_error",
        "model_unavailable",
        "contract_mismatch"
      ]
    },
    "label": {
      "type": "string",
      "enum": [
        "clean",
        "suspicious",
        "risky",
        "blocked_candidate"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "severity": {
      "$ref": "#/$defs/severity"
    },
    "primary_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "categories": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/categorySignal"
      }
    },
    "needs_second_round": {
      "type": "boolean",
      "default": false
    },
    "evidence": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/evidenceItem"
      }
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 600000
    },
    "metadata": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.:-]{1,64}$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    }
  },
  "$defs": {
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "categoryId": {
      "type": "string",
      "enum": [
        "advertising",
        "contact_lead",
        "scam",
        "spam_repeat",
        "malicious_link",
        "html_risk",
        "pornographic",
        "sexual_explicit",
        "sexual_suggestion",
        "political_sensitive",
        "public_order_risk",
        "national_security_risk",
        "hate_speech",
        "terrorism_extremism",
        "gambling",
        "violence_extreme",
        "child_safety",
        "harassment"
      ]
    },
    "evidencePolicy": {
      "type": "string",
      "enum": [
        "show_full",
        "show_category_only",
        "redact"
      ]
    },
    "categorySignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "confidence",
        "severity",
        "evidence_policy"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/categoryId"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "evidence_policy": {
          "$ref": "#/$defs/evidencePolicy"
        }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "policy",
        "value"
      ],
      "properties": {
        "category": {
          "$ref": "#/$defs/categoryId"
        },
        "policy": {
          "$ref": "#/$defs/evidencePolicy"
        },
        "value": {
          "type": "string",
          "maxLength": 512
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        }
      }
    }
  }
}
