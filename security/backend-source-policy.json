{
  "schema": "fsusblog.backend-security-source-policy.v1",
  "rules": [
    {
      "id": "FSUSBLOGSEC001",
      "kind": "forbid-random-shared",
      "include": [
        "src/backend/Services/Security/**/*.cs",
        "src/backend/Infrastructure/Security/**/*.cs"
      ]
    },
    {
      "id": "FSUSBLOGSEC002",
      "kind": "forbid-random-constructor",
      "include": [
        "src/backend/Services/Security/**/*.cs",
        "src/backend/Infrastructure/Security/**/*.cs"
      ]
    },
    {
      "id": "FSUSBLOGSEC003",
      "kind": "require-fixed-time-sensitive-comparison",
      "include": [
        "src/backend/Services/Security/AnonymousCredentialRevocationAccumulator.cs",
        "src/backend/Services/Security/AnonymousCommentTicketService.cs"
      ]
    },
    {
      "id": "FSUSBLOGSEC004",
      "kind": "forbid-raw-sensitive-log-template",
      "include": [
        "src/backend/Services/Security/**/*.cs",
        "src/backend/Services/HumanReadProofService.cs",
        "src/backend/Services/FileService.cs"
      ]
    },
    {
      "id": "FSUSBLOGSEC005",
      "kind": "forbid-raw-exception-output",
      "include": [
        "src/backend/Infrastructure/Middlewares/GlobalExceptionMiddleware.cs",
        "src/backend/Infrastructure/Operations/ProductionHealth.cs",
        "src/backend/Infrastructure/Operations/ProductionStartupValidator.cs",
        "src/backend/Modules/Endpoints/LocalAuthFixtureEndpoints.cs"
      ]
    },
    {
      "id": "FSUSBLOGSEC006",
      "kind": "minimum-constant",
      "include": [
        "src/backend/Services/Security/Argon2idPoSpaceV1ChallengeProvider.cs"
      ],
      "constantName": "MinMemoryKib",
      "minimum": 19456
    },
    {
      "id": "FSUSBLOGSEC007",
      "kind": "minimum-constant",
      "include": [
        "src/backend/Services/Security/Argon2idPoSpaceV1ChallengeProvider.cs"
      ],
      "constantName": "MinIterations",
      "minimum": 2
    },
    {
      "id": "FSUSBLOGSEC008",
      "kind": "minimum-constant",
      "include": [
        "src/backend/Services/Security/RecoveryKeyService.cs"
      ],
      "constantName": "RecoveryKeyPbkdf2Iterations",
      "minimum": 600000
    }
  ]
}

