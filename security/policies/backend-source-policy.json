{
    "schema": "fsusblog.backend-security-source-policy.v2",
    "policyId": "backend-security-source",
    "version": "2.0.0",
    "owner": "ServerContractAgent",
    "analyzer": {
        "project": "tools/security/FsusBlog.SecuritySourceAnalyzer/FsusBlog.SecuritySourceAnalyzer.csproj",
        "failClosed": true
    },
    "documentation": [
        "docs/security.md",
        "docs/testing/security-hardening-source-policy.md"
    ],
    "rules": [
        {
            "id": "FSUSBLOGSEC001",
            "kind": "forbid-random-shared",
            "severity": "error",
            "rationale": "Shared non-cryptographic randomness must never protect security state.",
            "pathScope": "repository-relative-include-globs",
            "include": [
                "src/backend/Services/Security/**/*.cs",
                "src/backend/Infrastructure/Security/**/*.cs"
            ]
        },
        {
            "id": "FSUSBLOGSEC002",
            "kind": "forbid-random-constructor",
            "severity": "error",
            "rationale": "Security code must use an injected cryptographic random source.",
            "pathScope": "repository-relative-include-globs",
            "include": [
                "src/backend/Services/Security/**/*.cs",
                "src/backend/Infrastructure/Security/**/*.cs"
            ]
        },
        {
            "id": "FSUSBLOGSEC003",
            "kind": "require-fixed-time-sensitive-comparison",
            "severity": "error",
            "rationale": "Secret and proof material must not be compared with data-dependent string helpers.",
            "pathScope": "repository-relative-include-globs",
            "include": [
                "src/backend/Services/Security/AnonymousCredentialRevocationAccumulator.cs",
                "src/backend/Services/Security/AnonymousCommentTicketService.cs"
            ]
        },
        {
            "id": "FSUSBLOGSEC004",
            "kind": "forbid-raw-sensitive-log-template",
            "severity": "error",
            "rationale": "Security logs must expose only redacted or derived identifiers.",
            "pathScope": "repository-relative-include-globs",
            "include": [
                "src/backend/Services/Security/**/*.cs",
                "src/backend/Services/HumanReadProofService.cs",
                "src/backend/Services/FileService.cs"
            ]
        },
        {
            "id": "FSUSBLOGSEC005",
            "kind": "forbid-raw-exception-output",
            "severity": "error",
            "rationale": "Client and health responses must not reveal runtime exception details.",
            "pathScope": "repository-relative-include-globs",
            "include": [
                "src/backend/Infrastructure/Middlewares/GlobalExceptionMiddleware.cs",
                "src/backend/Infrastructure/Operations/ProductionHealth.cs",
                "src/backend/Infrastructure/Operations/ProductionStartupValidator.cs",
                "src/backend/Modules/Endpoints/LocalAuthFixtureEndpoints.cs"
            ]
        },
        {
            "id": "FSUSBLOGSEC006",
            "kind": "minimum-constant",
            "severity": "error",
            "rationale": "Argon2 memory cost must remain above the repository security floor.",
            "pathScope": "repository-relative-include-globs",
            "include": [
                "src/backend/Services/Security/Argon2idPoSpaceV1ChallengeProvider.cs"
            ],
            "constantName": "MinMemoryKib",
            "minimum": 19456
        },
        {
            "id": "FSUSBLOGSEC007",
            "kind": "minimum-constant",
            "severity": "error",
            "rationale": "Argon2 iteration cost must remain above the repository security floor.",
            "pathScope": "repository-relative-include-globs",
            "include": [
                "src/backend/Services/Security/Argon2idPoSpaceV1ChallengeProvider.cs"
            ],
            "constantName": "MinIterations",
            "minimum": 2
        },
        {
            "id": "FSUSBLOGSEC008",
            "kind": "minimum-constant",
            "severity": "error",
            "rationale": "Recovery-key derivation must retain its brute-force resistance floor.",
            "pathScope": "repository-relative-include-globs",
            "include": [
                "src/backend/Services/Security/RecoveryKeyService.cs"
            ],
            "constantName": "RecoveryKeyPbkdf2Iterations",
            "minimum": 600000
        },
        {
            "id": "FSUSBLOGDATA001",
            "kind": "forbid-literal-data-reader-ordinal",
            "severity": "error",
            "rationale": "Named projection columns prevent silent authorization and data-shape drift.",
            "pathScope": "repository-relative-include-globs",
            "include": [
                "src/backend/Services/**/*.cs"
            ]
        }
    ]
}
