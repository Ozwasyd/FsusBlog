      "type": "domain-separated-field",
      "constraint": "equals comment.create"
    },
    {
      "name": "scope",
      "type": "field-hash",
      "constraint": "bound into nullifier PRF and policy hash"
    },
    {
      "name": "nullifier_hash",
      "type": "field",
      "constraint": "Poseidon credential_secret/action_context/scope output"
    },
    {
      "name": "credential_root",
      "type": "field",
      "constraint": "membership root for credential_epoch"
    },
    {
      "name": "revocation_root",
      "type": "field",
      "constraint": "non-membership accumulator root"
    },
    {
      "name": "credential_epoch",
