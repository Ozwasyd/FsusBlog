      "constraint": "signed credential epoch and accepted root epoch"
    },
    {
      "name": "credential_level",
      "type": "u16",
      "constraint": "signed credential attribute in allowed catalog"
    },
    {
      "name": "reputation_bucket",
      "type": "u16",
      "constraint": "signed credential attribute in allowed catalog"
    },
    {
      "name": "issuer_public_key_hash",
      "type": "field",
      "constraint": "accepted issuer key bound by root metadata"
    },
    {
      "name": "policy_hash",
      "type": "field",
      "constraint": "anonymous comment policy context"
    },
    {
      "name": "verifying_key_hash",
      "type": "sha256-hex",
      "constraint": "SHA256 of canonical verifying key bytes"
    }
  ],
  "private_witness": [
    {
      "name": "credential_secret",
      "type": "field",
      "purpose": "secret seed for nullifier PRF"
    },
    {
      "name": "circuit_native_issuer_signature",
      "type": "poseidon-schnorr-signature",
      "purpose": "prove accepted issuer signed credential attributes on the circuit-native curve"
    },
    {
      "name": "issuer_signature_public_key",
      "type": "jubjub-public-key",
      "purpose": "verify the circuit-native issuer signature inside the circuit"
    },
    {
      "name": "credential_opening",
      "type": "commitment-opening",
      "purpose": "open blinded credential commitment inside the circuit"
    },
    {
      "name": "credential_membership_proof",
      "type": "merkle-or-accumulator-witness",
      "purpose": "prove credential is in credential_root"
    },
    {
      "name": "revocation_non_membership_witness",
      "type": "accumulator-non-membership-witness",
      "purpose": "prove credential is not in revocation_root"
    },
    {
      "name": "signed_credential_level",
      "type": "attribute-field",
      "purpose": "prove public credential_level is a signed attribute"
    },
    {
      "name": "signed_reputation_bucket",
      "type": "attribute-field",
      "purpose": "prove public reputation_bucket is a signed attribute"
    },
    {
      "name": "policy_comparison_witness",
      "type": "range-and-set-membership-witness",
      "purpose": "prove disclosed attributes satisfy policy"
    }
  ],
  "nullifier_prf": {
    "algorithm": "poseidon",
    "formula": "Poseidon(domain_separator, credential_secret, action_context, scope)",
    "binds": [
      "credential_secret",
      "action_context",
      "scope"
    ],
    "stable_for_same_secret_and_scope": true,
    "unlinkable_across_scope": true
  },
  "security_assertions": [
    {
      "id": "valid_circuit_native_credential",
      "statement": "holder has a circuit-native credential signed by an accepted issuer key"
    },
    {
      "id": "current_credential_root",
      "statement": "credential belongs to credential_root for credential_epoch"
    },
    {
      "id": "revocation_non_membership",
      "statement": "credential is not present in revocation_root"
    },
    {
      "id": "qualification_policy",
      "statement": "credential_level and reputation_bucket satisfy comment eligibility policy"
    },
    {
      "id": "nullifier_prf_binding",
      "statement": "nullifier_hash is derived from credential_secret, action_context and scope"
    },
    {
      "id": "credential_bucket_legality",
      "statement": "credential_level and reputation_bucket are signed attributes in allowed catalogs"
    },
    {
      "id": "identity_non_disclosure",
      "statement": "account identity fields are absent from public inputs and private witness"
    },
    {
      "id": "presentation_unlinkability",
      "statement": "public inputs contain no credential-specific stable identifier other than the scope-bound nullifier"
    }
  ],
