<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/FsusBlog.V2.Core.csproj" />
    <ProjectReference Include="../Platform/FsusBlog.V2.Platform.csproj" />
    <ProjectReference Include="../Contracts/FsusBlog.V2.Contracts.csproj" />
    <ProjectReference Include="../Storage/FsusBlog.V2.Storage.csproj" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Jint" Version="[4.13.0]" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <EmbeddedResource Include="Schema/*.sql" LogicalName="FsusBlog.V2.Cli.Schema.%(Filename)%(Extension)" />
    <EmbeddedResource Include="OptionalSchema/private-media-import-origin.sql"
                      LogicalName="FsusBlog.V2.Cli.OptionalSchema.private-media-import-origin.sql" />
    <EmbeddedResource Include="OptionalSchema/legacy-release-origin.sql"
                      LogicalName="FsusBlog.V2.Cli.OptionalSchema.legacy-release-origin.sql" />
  </ItemGroup>
</Project>
