<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/FsusBlog.V2.Core.csproj" />
    <ProjectReference Include="../Contracts/FsusBlog.V2.Contracts.csproj" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Jint" Version="[4.13.0]" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Compile Include="../Storage/*.cs" Link="Storage/%(Filename)%(Extension)" />
    <EmbeddedResource Include="*.sql" LogicalName="FsusBlogV2.Schema.%(Filename)%(Extension)" />
    <EmbeddedResource Include="OptionalSchema/private-media-import-origin.sql"
                      LogicalName="FsusBlogV2.OptionalSchema.private-media-import-origin.sql" />
    <EmbeddedResource Include="OptionalSchema/legacy-release-origin.sql"
                      LogicalName="FsusBlogV2.OptionalSchema.legacy-release-origin.sql" />
  </ItemGroup>
</Project>
