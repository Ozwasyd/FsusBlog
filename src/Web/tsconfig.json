{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "types": ["vite/client", "node", "@ozwasyd/element-plus/global"],
    "paths": {
      "vue": ["./node_modules/vue"],
      "@vue/*": ["./node_modules/@vue/*"]
    }
  },
  "vueCompilerOptions": { "strictTemplates": true },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "../Contracts/**/*.ts",
    "vite.config.ts"
  ]
}
