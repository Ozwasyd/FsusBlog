<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../../shared/FsusBlog.Shared.csproj" />
        <InternalsVisibleTo Include="FsusBlog.ArticleVault.MacOS.Tests" />
        <None Include="$(IntermediateOutputPath)libFsusBlog.ArticleVault.MacOS.dylib"
              Link="libFsusBlog.ArticleVault.MacOS.dylib"
              CopyToOutputDirectory="PreserveNewest"
              Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    </ItemGroup>
    <Target Name="BuildMacVaultNative" BeforeTargets="BeforeBuild"
            Condition="$([MSBuild]::IsOSPlatform('OSX'))">
        <MakeDir Directories="$(IntermediateOutputPath)" />
        <Exec Command="xcrun clang -std=c11 -Wall -Wextra -Werror -Wno-deprecated-declarations -fvisibility=hidden -dynamiclib -framework CoreServices -framework CoreFoundation &quot;$(MSBuildProjectDirectory)/native/MacVaultFSEvents.c&quot; -o &quot;$(IntermediateOutputPath)libFsusBlog.ArticleVault.MacOS.dylib&quot;" />
    </Target>
</Project>
