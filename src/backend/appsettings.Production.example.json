{
  "AllowedHosts": "example.com",
  "ConnectionStrings": {
    "_Comment": "PostgreSQL Username=/Password= are Npgsql connection string keyword aliases for database credentials, not application admin identity fields.",
    "_LibpqUrlExample": "postgresql://replace-with-db-user:replace-with-db-password@replace-with-private-db-host:5432/fsusblog",
    "DefaultConnection": "Host=replace-with-private-db-host;Port=5432;Database=fsusblog;Username=replace-with-db-user;Password=replace-with-db-password",
    "Redis": "replace-with-private-redis-host:6379,password=replace-with-redis-password,abortConnect=false,connectTimeout=10000"
  },
  "Database": {
    "PublicArticleProjection": {
      "Enabled": true
    }
  },
  "RedisOptions": {
    "Configuration": "replace-with-private-redis-host:6379,password=replace-with-redis-password,abortConnect=false,connectTimeout=10000",
    "InstanceName": "FsusBlog_"
  },
  "ActiveReleaseFence": {
    "RefreshIntervalMs": 5000,
    "StaleThresholdSeconds": 30,
    "MutationEnabled": true,
    "AllowSyntheticLocalFence": false
  },
  "Jwt": {
    "KeyVersion": "v2-2026-07",
    "SecretKey": "replace-with-strong-production-secret",
    "Issuer": "FsusBlogServer",
    "Audience": "FsusBlogClient",
    "AccessTokenExpiresMinutes": 15,
    "RotationWindowDays": 30,
    "LegacyNoKidAcceptUntilUtc": null,
    "PreviousKeys": []
  },
  "Security": {
    "Pow": {
      "SigningKey": "replace-with-independent-production-pow-signing-secret"
    },
    "CaptchaV1": {
      "SigningKey": "replace-with-independent-production-captcha-signing-secret"
    },
    "PerceptionSealedToken": {
      "CurrentKeyVersion": "k1",
      "Keys": {
        "k1": "replace-with-64-hex-32-byte-perception-aead-key"
      }
    },
    "RiskPseudonymization": {
      "CurrentEpoch": 1,
      "CurrentKey": "replace-with-independent-base64-32-byte-risk-pseudonym-key",
      "PreviousEpoch": null,
      "PreviousKey": "",
      "PreviousAcceptUntilUtc": null
    },
    "RecoveryKeyPepper": "replace-with-independent-production-recovery-key-pepper"
  },
  "MfaChallenge": {
    "TicketSigningKey": "replace-with-independent-production-mfa-challenge-ticket-signing-key"
  },
  "VisitLog": {
    "IpPseudonymization": {
      "CurrentEpoch": 1,
      "CurrentKey": "replace-with-independent-base64-32-byte-visit-log-key",
      "PreviousEpoch": null,
      "PreviousKey": "",
      "PreviousAcceptUntilUtc": null
    }
  },
  "Moderation": {
    "Pepper": "replace-with-stable-random-moderation-pepper",
    "RegionPolicy": {
      "IpHashKey": "replace-with-independent-production-region-ip-hash-key"
    },
    "AntiSpamModel": {
      "Enabled": false,
      "RuntimePath": "/opt/fsusblog/models/fsus-antispammodel/stable",
      "RuntimeChannel": "stable",
      "RequireSignature": true,
      "TrustedSigningKey": "replace-with-runtime-signing-key"
    }
  },
  "Subscription": {
    "EmailHashPepper": "replace-with-stable-random-subscription-email-hash-pepper"
  },
  "AuthCookies": {
    "AllowInsecureTransportCookies": false
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "https://example.com"
    ]
  },
  "Seo": {
    "BaseUrl": "https://example.com"
  },
  "AnonymousCredentialIssuer": {
    "AllowBannedAccountIssuance": false,
    "MaxCredentialRequestBytes": 8192,
    "MaxClientNonceBytes": 128,
    "EpochDurationMinutes": 1440,
    "CredentialTtlMinutes": 1440,
    "IssuerPublicKeyId": "CHANGE_ME_ISSUER_PUBLIC_KEY_ID",
    "SubjectHashPepper": "replace-with-stable-random-subject-hash-pepper",
    "CircuitNative": {
      "Enabled": true,
      "Backend": "managed_circuit_native_v2",
      "IssuerPrivateKeyPath": "/app/secrets/zk/issuer-private.key",
      "IssuerPublicKeyPath": "/app/config/zk/issuer-public.key",
      "IssuerPublicKeyHash": "CHANGE_ME_REAL_64_HEX_ISSUER_PUBLIC_KEY_SHA256",
      "MaxConcurrentSignatures": 2,
      "TimeoutMs": 2000
    }
  },
  "AnonymousCredentialRoot": {
    "AttestationKey": "replace-with-stable-random-anonymous-root-attestation-key",
    "AttestationKeyId": "prod-root-attestation"
  },
  "AnonymousIdentity": {
    "NullifierPepper": "replace-with-stable-random-anonymous-nullifier-pepper",
    "ZkProd": {
      "Enabled": true,
      "RequireNativeVerifier": true,
      "RequireCredential": true,
      "RequireTrustedSetupVerified": true,
      "AllowDevVerifier": false,
      "FallbackToLegacyAnonymous": false,
      "VerifierBackend": "native_groth16",
      "TrustedSetupVerified": true,
      "CredentialReady": true,
      "VerifyingKeyHash": "CHANGE_ME_REAL_64_HEX_VERIFYING_KEY_SHA256",
      "CircuitManifestPath": "security/zk/comment-v2-circuit.manifest.json",
      "TrustedSetupManifestPath": "/app/config/zk/comment-v2-trusted-setup.manifest.json",
      "VerifyingKeyManifestPath": "/app/config/zk/anonymous-comment-v2-verifying-key.manifest.json"
    },
    "ZkVerifier": {
      "Enabled": true,
      "CircuitId": "fsus.anonymous.comment.v2",
      "VerifyingKeyHash": "CHANGE_ME_REAL_64_HEX_VERIFYING_KEY_SHA256",
      "PublicInputLayoutVersion": 3,
      "MaxProofBytes": 4096,
      "Backend": "native_groth16",
      "BackendTimeoutMs": 2000,
      "MaxConcurrentVerifications": 2,
      "VerifyingKeyManifestPath": "/app/config/zk/anonymous-comment-v2-verifying-key.manifest.json",
      "NativeGroth16": {
        "LibraryPath": "managed:mcl",
        "VerifyingKeyPath": "/app/config/zk/comment.v2.vk",
        "VerifyingKeySha256": "CHANGE_ME_REAL_64_HEX_VERIFYING_KEY_SHA256",
        "EntryPoint": "fsus_zk_groth16_verify"
      }
    }
  },
  "Fido2": {
    "ServerDomain": "example.com",
    "ServerName": "FsusBlog",
    "Origins": [
      "https://example.com"
    ]
  },
  "ReverseProxy": {
    "KnownProxies": "127.0.0.1",
    "KnownNetworks": ""
  }
}
