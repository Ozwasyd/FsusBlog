{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error",
      "FsusBlog": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Error",
        "System": "Error",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Error"
      }
    }
  },
  "Observability": {
    "Enabled": true,
    "ExporterEnabled": false,
    "ServiceName": "FsusBlog",
    "ServiceVersion": "2.0.0",
    "OtlpEndpoint": "",
    "HttpMetricsSampleRate": 16,
    "SlowRequestThresholdMilliseconds": 500
  },
  "PublicHotRead": {
    "CounterMode": "Sampled",
    "CounterSampleRate": 64
  },
  "AnonymousCredentialIssuer": {
    "AllowBannedAccountIssuance": false,
    "MaxBlindedRequestBytes": 8192,
    "MaxClientNonceBytes": 128,
    "EpochDurationMinutes": 1440,
    "CredentialTtlMinutes": 1440
  },
  "AnonymousIdentity": {
    "ZkProd": {
      "Enabled": false,
      "RequireNativeVerifier": true,
      "RequireBbsCredential": true,
      "RequireTrustedSetupVerified": true,
      "AllowDevVerifier": false,
      "FallbackToLegacyAnonymous": false,
      "VerifierBackend": "native_groth16",
      "TrustedSetupVerified": false,
      "BbsCredentialReady": false,
      "VerifyingKeyHash": ""
    }
  },
  "Jwt": {
    // 逻辑自洽：这里的 SecretKey 留空或设为无效值
    // 生产环境中，我们将通过 docker-compose 传递环境变量强行覆盖它！
    "SecretKey": "MUST_BE_OVERRIDDEN_BY_ENV_VARIABLES",
    "AccessTokenExpiresMinutes": 15
  }
}
