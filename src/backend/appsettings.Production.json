{
    "Articles": {
        "MutationIdempotencyEnabled": true
    },
    "ArticleDetailViewProjection": {
        "MaxEntries": 100000,
        "MaxLogicalBytes": 3200000,
        "MaxCapacityBytes": 6400000,
        "EntryTtl": "00:30:00"
    },
    "AllowedHosts": "fsus.blog;www.fsus.blog",
    "Database": {
        "PublicArticleProjection": {
            "Enabled": true
        }
    },
    "Logging": {
        "LogLevel": {
            "Default": "Warning",
            "Microsoft.AspNetCore": "Error",
            "FsusBlog": "Information"
        }
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Warning",
            "Override": {
                "Microsoft": "Error",
                "System": "Error",
                "Microsoft.AspNetCore.Hosting.Diagnostics": "Error"
            }
        }
    },
    "Observability": {
        "Enabled": true,
        "ExporterEnabled": false,
        "ServiceName": "FsusBlog",
        "ServiceVersion": "2.0.0",
        "OtlpEndpoint": "",
        "HttpMetricsSampleRate": 16,
        "SlowRequestThresholdMilliseconds": 500
    },
    "PublicHotRead": {
        "CounterMode": "Sampled",
        "CounterSampleRate": 64,
        "MaxResidentBytes": 0,
        "MaxRawBytes": 0,
        "MaxCompressedBytes": 0,
        "MaxHtmlBytes": 0,
        "MaxSnapshotOverlapBytes": 0,
        "MaxSnapshotAge": "00:05:00",
        "MaxArticleResidentBytes": 0,
        "MaxArtifactObjects": 0,
        "ArticleAdmissionRecentPercent": 40,
        "MinCompressionSavingsPercent": 8,
        "ExpectedBrotliClientSharePercent": 80,
        "ExpectedGzipClientSharePercent": 15,
        "MinResidentVariantClientSharePercent": 5
    },
    "PublicArtifactRevocation": {
        "CdnPurgeEnabled": false,
        "CdnProvider": "Generic",
        "CdnPurgeEndpoint": "",
        "CdnPurgeBearerToken": "",
        "CloudflareZoneId": "",
        "PurgeAllOnArticleRevocation": true,
        "MutationFenceRecoveryIntervalSeconds": 5
    },
    "AnonymousCredentialIssuer": {
        "AllowBannedAccountIssuance": false,
        "EpochDurationMinutes": 1440,
        "CredentialTtlMinutes": 1440,
        "IssuerPublicKeyId": "",
        "SubjectHashPepper": "",
        "BlindRsa": {
            "Enabled": false,
            "Profile": "rfc9474-rsabssa-sha384-pss-randomized-3072",
            "KeyId": "",
            "PublicKeyHash": "",
            "PrivateKeyPath": "",
            "CredentialLevel": "basic",
            "MaxConcurrentSignatures": 2,
            "TimeoutMs": 2000,
            "MinimumResponseMilliseconds": 2500
        }
    },
    "AnonymousCredentialRoot": {
        "AttestationKey": "",
        "AttestationKeyId": "prod-root-attestation"
    },
    "AnonymousIdentity": {
        "NullifierPepper": "",
        "ZkCommentPolicy": {
            "Enabled": false,
            "RequireCredential": true,
            "RequireTrustedSetupVerified": true
        },
        "ZkVerifier": {
            "Enabled": false,
            "CircuitId": "fsus.anonymous.comment.v5",
            "VerifyingKeyHash": "",
            "PublicInputLayoutVersion": 6,
            "MaxProofBytes": 4096,
            "Backend": "native_groth16",
            "BackendTimeoutMs": 2000,
            "MaxConcurrentVerifications": 2,
            "TrustedSetupManifestPath": "security/zk/provenance/comment-v5-trusted-setup.manifest.json",
      "VerifyingKeyManifestPath": "config/zk/anonymous-comment-v5-verifying-key.manifest.json",
            "NativeGroth16": {
                "LibraryPath": "managed:mcl",
                "VerifyingKeyPath": "",
                        "EntryPoint": "fsus_zk_groth16_verify"
            }
        }
    },
    "Audit": {
        "DetachedCheckpoint": {
            "Enabled": true,
            "DirectoryName": "audit-checkpoints",
            "IntervalSeconds": 300,
            "MaxRecords": 1000,
            "CurrentKeyId": "CHANGE_ME_AUDIT_CHECKPOINT_KEY_ID",
            "Keys": [
                {
                    "KeyId": "CHANGE_ME_AUDIT_CHECKPOINT_KEY_ID",
                    "Version": 1,
                    "PublicKeyPath": "/run/secrets/fsusblog-audit-checkpoint-public.der",
                    "PrivateKeyPath": "/run/secrets/fsusblog-audit-checkpoint-private.der",
                    "NotBeforeUtc": "2026-07-01T00:00:00Z"
                }
            ]
        }
    },
    "Jwt": {
        // 逻辑自洽：这里的 SecretKey 留空或设为无效值
        // 生产环境中，我们将通过 docker-compose 传递环境变量强行覆盖它！
        "KeyVersion": "",
        "SecretKey": "",
        "AccessTokenExpiresMinutes": 15,
        "RotationWindowDays": 30,
        "LegacyNoKidAcceptUntilUtc": null,
        "PreviousKeys": []
    },
    "Security": {
        "RiskControl": {
            "GlobalMode": "enforce",
            "MaxRiskScore": 200
        },
        "AdminSessionProjection": {
            "MaxSessionEntries": 16384,
            "MaxPrincipalEntries": 4096,
            "MaxResidentBytes": 8388608,
            "ColdStartBatchSize": 256,
            "TouchQueueCapacity": 4096,
            "MaxTouchTrackingEntries": 16384,
            "RecoveryRetryMilliseconds": 1000,
            "ShutdownFlushMilliseconds": 5000
        },
        "Pow": {
            "SigningKey": ""
        },
        "PublicHotReadRiskProjection": {
            "MaxEntries": 100000,
            "MaxBytes": 16777216,
            "MaxEntryTtlSeconds": 3600,
            "ReplayIntervalSeconds": 5,
            "SubscriberCapacity": 10000
        },
        "PerceptionSealedToken": {
            "CurrentKeyVersion": "k1",
            "Keys": {
                "k1": ""
            }
        },
        "PerceptionCharacterV3": {
            "Enabled": "disabled",
            "TokenKeyCurrent": "",
            "AnswerKeyCurrent": "",
            "TokenKeys": {},
            "AnswerKeys": {},
            "AllowTestVectors": false,
            "Pool": {
                "RootPath": "var/security/perception-v3-pools",
                "ActiveGeneration": "",
                "KeyCurrent": "",
                "Keys": {}
            },
            "Resources": {
                "AllocationsEnabled": true,
                "Watermarks": {
                    "High": 100,
                    "Low": 30,
                    "Critical": 10,
                    "TotalHigh": 200,
                    "TotalLow": 60,
                    "TotalCritical": 20
                },
                "Budgets": {
                    "LeasePerMinute": 120,
                    "LeaseRollingHour": 2000,
                    "EgressBytesPerMinute": 4194304,
                    "EgressBytesRollingHour": 67108864
                },
                "Quotas": {
                    "IpPrefixPerMinute": 12,
                    "DevicePerMinute": 10,
                    "SubjectPerMinute": 8,
                    "ActionPerMinute": 30
                },
                "Replenishment": {
                    "MaxEntries": 64,
                    "MaxBytes": 2097152
                },
                "CriticalActions": [
                    "account.recovery",
                    "auth.recovery",
                    "admin.security"
                ],
                "Dispositions": {
                    "Comment": "QueueForModeration",
                    "Enrollment": "Block",
                    "AccountRecovery": "Block",
                    "AdminSensitive": "Block",
                    "PublicRead": "RequireCheaperProof",
                    "Other": "Unavailable"
                }
            }
        },
        "UserSessions": {
            "MaxActiveSessions": 10,
            "MetadataRetentionDays": 30,
            "MetadataRiskSignalsEnabled": true
        },
        "UserSessionValidation": {
            "DistributedCacheEnabled": true,
            "DbFallback": {
                "MaxConcurrent": 32,
                "FailureThreshold": 5,
                "BreakSeconds": 5
            }
        },
        "StepUp": {
            "FreshnessMinutes": 5
        },
        "RiskPseudonymization": {
            "CurrentEpoch": 1,
            "CurrentKey": "",
            "PreviousEpoch": null,
            "PreviousKey": "",
            "PreviousAcceptUntilUtc": null
        },
        "RecoveryKeyPepper": ""
    },
    "MfaChallenge": {
        "TicketSigningKey": ""
    },
    "AuthEnrollment": {
        "ProvisionalTtlMinutes": 20,
        "CleanupIntervalMinutes": 5
    },
    "HumanReadProof": {
        "Mode": "enforce",
        "SigningKey": "",
        "Dedup": {
            "CurrentKeyEpoch": 1,
            "CurrentKey": ""
        }
    },
    "ReadAnalyticsPrivacy": {
        "KThreshold": 10,
        "EpsilonPerRelease": 0.5,
        "DailyEpsilonLimit": 1.0,
        "NoiseKey": ""
    },
    "VisitLog": {
        "IpPseudonymization": {
            "CurrentEpoch": 1,
            "CurrentKey": "",
            "PreviousEpoch": null,
            "PreviousKey": "",
            "PreviousAcceptUntilUtc": null
        }
    },
    "Moderation": {
        "Pepper": "",
        "RegionPolicy": {
            "IpHashKey": ""
        },
        "AntiSpamModel": {
            "Enabled": false,
            "RuntimePath": "",
            "RuntimeChannel": "stable",
            "Mode": "score-only",
            "FailOpen": false,
            "RequireSignature": true,
            "TrustedSigningKey": ""
        }
    },
    "Subscription": {
        "EmailHashPepper": ""
    },
    "Messages": {
        "AdminSessionAuditReferenceKey": "",
        "RetentionCleanupEnabled": true
    }
}
