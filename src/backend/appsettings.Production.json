{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error",
      "FsusBlog": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Error",
        "System": "Error",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Error"
      }
    }
  },
  "Observability": {
    "Enabled": true,
    "ExporterEnabled": false,
    "ServiceName": "FsusBlog",
    "ServiceVersion": "2.0.0",
    "OtlpEndpoint": "",
    "HttpMetricsSampleRate": 16,
    "SlowRequestThresholdMilliseconds": 500
  },
  "PublicHotRead": {
    "CounterMode": "Sampled",
    "CounterSampleRate": 64
  },
  "AnonymousCredentialIssuer": {
    "AllowBannedAccountIssuance": false,
    "MaxCredentialRequestBytes": 8192,
    "MaxClientNonceBytes": 128,
    "EpochDurationMinutes": 1440,
    "CredentialTtlMinutes": 1440,
    "IssuerPublicKeyId": "issuer-key:local",
    "SubjectHashPepper": "MUST_BE_OVERRIDDEN_BY_ENV_VARIABLES",
    "CircuitNative": {
      "Enabled": false,
      "Backend": "managed_circuit_native_v2",
      "IssuerPrivateKeyPath": "",
      "IssuerPublicKeyPath": "",
      "IssuerPublicKeyHash": "",
      "MaxConcurrentSignatures": 2,
      "TimeoutMs": 2000
    }
  },
  "AnonymousCredentialRoot": {
    "AttestationKey": "MUST_BE_OVERRIDDEN_BY_ENV_VARIABLES",
    "AttestationKeyId": "prod-root-attestation"
  },
  "AnonymousIdentity": {
    "NullifierPepper": "MUST_BE_OVERRIDDEN_BY_ENV_VARIABLES",
    "ZkProd": {
      "Enabled": false,
      "RequireNativeVerifier": true,
      "RequireCredential": true,
      "RequireTrustedSetupVerified": true,
      "AllowDevVerifier": false,
      "FallbackToLegacyAnonymous": false,
      "VerifierBackend": "native_groth16",
      "TrustedSetupVerified": false,
      "CredentialReady": false,
      "VerifyingKeyHash": "",
      "CircuitManifestPath": "security/zk/comment-v2-circuit.manifest.json",
      "TrustedSetupManifestPath": "security/zk/comment-v2-trusted-setup.manifest.json",
      "VerifyingKeyManifestPath": "config/zk/anonymous-comment-v2-verifying-key.manifest.json"
    },
    "ZkVerifier": {
      "Enabled": false,
      "CircuitId": "fsus.anonymous.comment.v2",
      "VerifyingKeyHash": "",
      "PublicInputLayoutVersion": 3,
      "MaxProofBytes": 4096,
      "Backend": "native_groth16",
      "BackendTimeoutMs": 2000,
      "MaxConcurrentVerifications": 2,
      "VerifyingKeyManifestPath": "config/zk/anonymous-comment-v2-verifying-key.manifest.json",
      "NativeGroth16": {
        "LibraryPath": "",
        "VerifyingKeyPath": "",
        "VerifyingKeySha256": "",
        "EntryPoint": "fsus_zk_groth16_verify"
      }
    }
  },
  "Jwt": {
    // 逻辑自洽：这里的 SecretKey 留空或设为无效值
    // 生产环境中，我们将通过 docker-compose 传递环境变量强行覆盖它！
    "SecretKey": "MUST_BE_OVERRIDDEN_BY_ENV_VARIABLES",
    "AccessTokenExpiresMinutes": 15
  },
  "Security": {
    "Pow": {
      "SigningKey": "MUST_BE_OVERRIDDEN_BY_ENV_VARIABLES"
    },
    "CaptchaV1": {
      "SigningKey": "MUST_BE_OVERRIDDEN_BY_ENV_VARIABLES"
    },
    "PerceptionSealedToken": {
      "CurrentKeyVersion": "k1",
      "Keys": {
        "k1": "MUST_BE_OVERRIDDEN_WITH_64_HEX_32_BYTE_KEY"
      }
    },
    "RecoveryKeyPepper": "MUST_BE_OVERRIDDEN_BY_ENV_VARIABLES"
  },
  "MfaChallenge": {
    "TicketSigningKey": "MUST_BE_OVERRIDDEN_BY_ENV_VARIABLES"
  },
  "VisitLog": {
    "IpHashPepper": "MUST_BE_OVERRIDDEN_BY_ENV_VARIABLES"
  },
  "Moderation": {
    "Pepper": "MUST_BE_OVERRIDDEN_BY_ENV_VARIABLES",
    "RegionPolicy": {
      "IpHashKey": "MUST_BE_OVERRIDDEN_BY_ENV_VARIABLES"
    },
    "AntiSpamModel": {
      "Providers": {
        "http-json": {
          "AllowedHosts": ""
        }
      }
    }
  },
  "Subscription": {
    "EmailHashPepper": "MUST_BE_OVERRIDDEN_BY_ENV_VARIABLES"
  }
}
