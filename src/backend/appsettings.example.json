{
  "AllowedHosts": "localhost;127.0.0.1",
  "ConnectionStrings": {
    "DefaultConnection": "Host=127.0.0.1;Port=5432;Database=fsusblog;Username=fsusblog;Password=replace-for-local-or-production"
  },
  "Database": {
    "PublicArticleProjection": {
      "Enabled": true
    }
  },
  "RedisOptions": {
    "Configuration": "127.0.0.1:6379,abortConnect=false,connectTimeout=10000",
    "InstanceName": "FsusBlog_"
  },
  "ActiveReleaseFence": {
    "RefreshIntervalMs": 5000,
    "StaleThresholdSeconds": 30,
    "MutationEnabled": true,
    "AllowSyntheticLocalFence": false
  },
  "Jwt": {
    "KeyVersion": "dev-v1",
    "SecretKey": "replace-with-at-least-32-random-bytes-before-any-shared-environment",
    "Issuer": "FsusBlogServer",
    "Audience": "FsusBlogClient",
    "AccessTokenExpiresMinutes": 15,
    "RotationWindowDays": 30,
    "LegacyNoKidAcceptUntilUtc": null,
    "PreviousKeys": []
  },
  "DataProtection": {
    "ApplicationName": "FsusBlog",
    "KeyRingPath": "/var/lib/fsusblog/shared/data-protection/keyring",
    "KeyProtection": {
      "Mode": "Certificate",
      "CurrentCertificate": {
        "Path": "/run/secrets/fsusblog-data-protection-current.pfx",
        "Password": ""
      },
      "PreviousCertificates": [
        {
          "Path": "/run/secrets/fsusblog-data-protection-previous.pfx",
          "Password": ""
        }
      ]
    }
  },
  "Security": {
    "Pow": {
      "SigningKey": "replace-with-independent-pow-signing-secret"
    },
    "CaptchaV1": {
      "SigningKey": "replace-with-independent-captcha-signing-secret"
    },
    "PerceptionSealedToken": {
      "CurrentKeyVersion": "dev",
      "Keys": {
        "dev": "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
      }
    },
    "RiskPseudonymization": {
      "CurrentEpoch": 1,
      "CurrentKey": "replace-with-independent-base64-32-byte-risk-pseudonym-key",
      "PreviousEpoch": null,
      "PreviousKey": "",
      "PreviousAcceptUntilUtc": null
    },
    "RecoveryKeyPepper": "replace-with-independent-recovery-key-pepper"
  },
  "MfaChallenge": {
    "TicketSigningKey": "replace-with-independent-mfa-challenge-ticket-signing-key"
  },
  "VisitLog": {
    "IpPseudonymization": {
      "CurrentEpoch": 1,
      "CurrentKey": "replace-with-independent-base64-32-byte-visit-log-key",
      "PreviousEpoch": null,
      "PreviousKey": "",
      "PreviousAcceptUntilUtc": null
    }
  },
  "Moderation": {
    "RegionPolicy": {
      "IpHashKey": "replace-with-independent-region-ip-hash-key"
    },
    "AntiSpamModel": {
      "Enabled": false,
      "RuntimePath": "",
      "RuntimeChannel": "stable",
      "RequireSignature": false,
      "TrustedSigningKey": ""
    }
  },
  "Subscription": {
    "EmailHashPepper": "replace-with-stable-random-subscription-email-hash-pepper"
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000"
    ]
  },
  "AnonymousCredentialIssuer": {
    "AllowBannedAccountIssuance": false,
    "MaxCredentialRequestBytes": 8192,
    "MaxClientNonceBytes": 128,
    "EpochDurationMinutes": 1440,
    "CredentialTtlMinutes": 1440,
    "IssuerPublicKeyId": "CHANGE_ME_ISSUER_PUBLIC_KEY_ID",
    "SubjectHashPepper": "replace-with-stable-random-subject-hash-pepper",
    "CircuitNative": {
      "Enabled": false,
      "Backend": "managed_circuit_native_v2",
      "IssuerPrivateKeyPath": "",
      "IssuerPublicKeyPath": "",
      "IssuerPublicKeyHash": "",
      "MaxConcurrentSignatures": 2,
      "TimeoutMs": 2000
    }
  },
  "AnonymousCredentialRoot": {
    "AttestationKey": "development-anonymous-root-attestation-key-change-before-shared-use",
    "AttestationKeyId": "local-dev-root-attestation"
  },
  "AnonymousIdentity": {
    "NullifierPepper": "replace-with-stable-random-anonymous-nullifier-pepper",
    "ZkProd": {
      "Enabled": false,
      "RequireNativeVerifier": true,
      "RequireCredential": true,
      "RequireTrustedSetupVerified": true,
      "AllowDevVerifier": false,
      "FallbackToLegacyAnonymous": false,
      "VerifierBackend": "native_groth16",
      "TrustedSetupVerified": false,
      "CredentialReady": false,
      "VerifyingKeyHash": "",
      "CircuitManifestPath": "security/zk/comment-v2-circuit.manifest.json",
      "TrustedSetupManifestPath": "security/zk/comment-v2-trusted-setup.manifest.json",
      "VerifyingKeyManifestPath": "config/zk/anonymous-comment-v2-verifying-key.manifest.json"
    },
    "ZkVerifier": {
      "Enabled": false,
      "CircuitId": "fsus.anonymous.comment.v2",
      "VerifyingKeyHash": "",
      "PublicInputLayoutVersion": 3,
      "MaxProofBytes": 4096,
      "Backend": "native_groth16",
      "BackendTimeoutMs": 2000,
      "MaxConcurrentVerifications": 2,
      "VerifyingKeyManifestPath": "config/zk/anonymous-comment-v2-verifying-key.manifest.json",
      "NativeGroth16": {
        "LibraryPath": "",
        "VerifyingKeyPath": "",
        "VerifyingKeySha256": "",
        "EntryPoint": "fsus_zk_groth16_verify"
      }
    }
  },
  "Fido2": {
    "ServerDomain": "localhost",
    "ServerName": "FsusBlog",
    "Origins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000"
    ]
  }
}
