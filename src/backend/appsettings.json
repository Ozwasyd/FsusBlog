{
    "AllowedHosts": "*",
    "CorsSettings": {
        "AllowedOrigins": []
    },
    "Articles": {
        "MutationIdempotencyEnabled": true
    },
    "ArticleDetailViewProjection": {
        "MaxEntries": 100000,
        "MaxLogicalBytes": 3200000,
        "MaxCapacityBytes": 6400000,
        "EntryTtl": "00:30:00"
    },
    "RedisOptions": {
        /* 逻辑自洽补丁：添加 Configuration 占位符。
        注意：如果 Docker 变量是 Redis__Configuration，此处应改为 "Redis": { "Configuration": "..." }
        如果是 RedisOptions__Configuration，则保留在此处。 */
        "Configuration": "localhost:6379",
        "InstanceName": "MyBlog_"
    },
    "ConnectionStrings": {
        /* 安全性保障：此处仅作为开发期占位，生产环境会被 Docker 环境变量覆盖 */
        "DefaultConnection": ""
    },
    "Jwt": {
        "KeyVersion": "dev-v1",
        "SecretKey": "",
        "Issuer": "FsusBlogServer",
        "Audience": "FsusBlogClient",
        "AccessTokenExpiresMinutes": 15,
        "RotationWindowDays": 30,
        "LegacyNoKidAcceptUntilUtc": null,
        "PreviousKeys": []
    },
    "DataProtection": {
        "ApplicationName": "FsusBlog",
        "KeyRingPath": "",
        "KeyProtection": {
            "Mode": "",
            "CurrentCertificate": {
                "Path": "",
                "Password": ""
            },
            "PreviousCertificates": []
        }
    },
    "Security": {
        "RiskControl": {
            "GlobalMode": "enforce",
            "MaxRiskScore": 200
        },
        "AdminSessionProjection": {
            "MaxSessionEntries": 16384,
            "MaxPrincipalEntries": 4096,
            "MaxResidentBytes": 8388608,
            "ColdStartBatchSize": 256,
            "TouchQueueCapacity": 4096,
            "MaxTouchTrackingEntries": 16384,
            "RecoveryRetryMilliseconds": 1000,
            "ShutdownFlushMilliseconds": 5000
        },
        "Pow": {
            "SigningKey": ""
        },
        "PublicHotReadRiskProjection": {
            "MaxEntries": 100000,
            "MaxBytes": 16777216,
            "MaxEntryTtlSeconds": 3600,
            "ReplayIntervalSeconds": 5,
            "SubscriberCapacity": 10000
        },
        "PerceptionSealedToken": {
            "CurrentKeyVersion": "dev",
            "Keys": {
                "dev": ""
            }
        },
        "PerceptionCharacterV3": {
            "Enabled": "disabled",
            "TokenKeyCurrent": "",
            "AnswerKeyCurrent": "",
            "TokenKeys": {},
            "AnswerKeys": {},
            "AllowTestVectors": false,
            "Pool": {
                "RootPath": "var/security/perception-v3-pools",
                "ActiveGeneration": "",
                "KeyCurrent": "",
                "Keys": {}
            },
            "Resources": {
                "AllocationsEnabled": true,
                "Watermarks": {
                    "High": 100,
                    "Low": 30,
                    "Critical": 10,
                    "TotalHigh": 200,
                    "TotalLow": 60,
                    "TotalCritical": 20
                },
                "Budgets": {
                    "LeasePerMinute": 120,
                    "LeaseRollingHour": 2000,
                    "EgressBytesPerMinute": 4194304,
                    "EgressBytesRollingHour": 67108864
                },
                "Quotas": {
                    "IpPrefixPerMinute": 12,
                    "DevicePerMinute": 10,
                    "SubjectPerMinute": 8,
                    "ActionPerMinute": 30
                },
                "Replenishment": {
                    "MaxEntries": 64,
                    "MaxBytes": 2097152
                },
                "CriticalActions": [
                    "account.recovery",
                    "auth.recovery",
                    "admin.security"
                ],
                "Dispositions": {
                    "Comment": "QueueForModeration",
                    "Enrollment": "Block",
                    "AccountRecovery": "Block",
                    "AdminSensitive": "Block",
                    "PublicRead": "RequireCheaperProof",
                    "Other": "Unavailable"
                }
            }
        },
        "UserSessions": {
            "MaxActiveSessions": 10,
            "MetadataRetentionDays": 30,
            "MetadataRiskSignalsEnabled": true
        },
        "UserSessionValidation": {
            "DistributedCacheEnabled": true,
            "DbFallback": {
                "MaxConcurrent": 32,
                "FailureThreshold": 5,
                "BreakSeconds": 5
            }
        },
        "StepUp": {
            "FreshnessMinutes": 5
        },
        "RecoveryKeyPepper": ""
    },
    "MfaChallenge": {
        "TicketSigningKey": ""
    },
    "HumanReadProof": {
        "Mode": "enforce",
        "SigningKey": "YGFiY2RlZmdoaWprbG1ub3BxcnN0dXZ3eHl6e3x9fn8=",
        "Dedup": {
            "CurrentKeyEpoch": 1,
            "CurrentKey": "gIGCg4SFhoeIiYqLjI2Oj5CRkpOUlZaXmJmam5ydnp8="
        }
    },
    "ReadAnalyticsPrivacy": {
        "KThreshold": 10,
        "EpsilonPerRelease": 0.5,
        "DailyEpsilonLimit": 1.0,
        "NoiseKey": "oKGio6SlpqeoqaqrrK2ur7CxsrO0tba3uLm6u7y9vr8="
    },
    "VisitLog": {
        "IpPseudonymization": {
            "CurrentEpoch": 1,
            "CurrentKey": "",
            "PreviousEpoch": null,
            "PreviousKey": "",
            "PreviousAcceptUntilUtc": null
        }
    },
    "Moderation": {
        "Pepper": "",
        "RegionPolicy": {
            "IpHashKey": ""
        }
    },
    "Subscription": {
        "EmailHashPepper": ""
    },
    "Messages": {
        "AdminSessionAuditReferenceKey": "",
        "RetentionCleanupEnabled": true
    },
    "AuthCookies": {
        "AllowInsecureTransportCookies": false
    },
    "AuthEnrollment": {
        "ProvisionalTtlMinutes": 20,
        "CleanupIntervalMinutes": 5
    },
    "PrivateAssets": {
        "TimeToLive": "00:05:00"
    },
    "Observability": {
        "Enabled": true,
        "ExporterEnabled": false,
        "ServiceName": "FsusBlog",
        "ServiceVersion": "2.0.0",
        "OtlpEndpoint": ""
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.File",
            "Serilog.Sinks.Async"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning",
                "Microsoft.AspNetCore.Hosting.Diagnostics": "Error" // 屏蔽烦人的健康检查日志
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{AuditSource}] [{AuditType}] {Message:lj}{NewLine}{Exception}"
                }
            },
            {
                "Name": "Async", // 使用异步包装器，提升吞吐量
                "Args": {
                    "configure": [
                        {
                            "Name": "File",
                            "Args": {
                                "path": "Logs/log-.txt", // 日志路径
                                "rollingInterval": "Day", // 按天滚动
                                "retainedFileCountLimit": 30, // 保留最近30天
                                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{AuditSource}] [{AuditType}] {Message:lj}{NewLine}{Exception}"
                            }
                        }
                    ]
                }
            }
        ]
    },
    "SqlSugar": {
        "DbType": "PostgreSQL",
        "IsAutoCloseConnection": true
    },
    "AnonymousCredentialIssuer": {
        "AllowBannedAccountIssuance": false,
        "EpochDurationMinutes": 1440,
        "CredentialTtlMinutes": 1440,
        "IssuerPublicKeyId": "",
        "SubjectHashPepper": "",
        "BlindRsa": {
            "Enabled": false,
            "Profile": "rfc9474-rsabssa-sha384-pss-randomized-3072",
            "KeyId": "",
            "PublicKeyHash": "",
            "PrivateKeyPath": "",
            "CredentialLevel": "basic",
            "MaxConcurrentSignatures": 2,
            "TimeoutMs": 2000,
            "MinimumResponseMilliseconds": 2500
        }
    },
    "AnonymousCredentialRoot": {
        "AttestationKey": "",
        "AttestationKeyId": "local-dev-root-attestation"
    },
    "AnonymousIdentity": {
        "NullifierPepper": "",
        "ZkCommentPolicy": {
            "Enabled": false,
            "RequireCredential": true,
            "RequireTrustedSetupVerified": true
        },
        "ZkVerifier": {
            "Enabled": false,
            "CircuitId": "fsus.anonymous.comment.v5",
            "VerifyingKeyHash": "",
            "PublicInputLayoutVersion": 6,
            "MaxProofBytes": 4096,
            "Backend": "native_groth16",
            "BackendTimeoutMs": 2000,
            "MaxConcurrentVerifications": 2,
            "TrustedSetupManifestPath": "security/zk/provenance/comment-v5-trusted-setup.manifest.json",
      "VerifyingKeyManifestPath": "config/zk/anonymous-comment-v5-verifying-key.manifest.json",
            "NativeGroth16": {
                "LibraryPath": "",
                "VerifyingKeyPath": "",
                        "EntryPoint": "fsus_zk_groth16_verify"
            }
        }
    },
    "Audit": {
        "DetachedCheckpoint": {
            "Enabled": false,
            "DirectoryName": "audit-checkpoints",
            "IntervalSeconds": 300,
            "MaxRecords": 1000,
            "CurrentKeyId": "",
            "Keys": []
        }
    },
    "Fido2": {
        "ServerDomain": "localhost",
        "ServerName": "FsusBlog",
        "Origins": [ "http://localhost:3000", "http://localhost:5173", "http://localhost:7291", "http://localhost:8080", "http://127.0.0.1:8080", "http://localhost:55710", "http://127.0.0.1:55710" ]
    }
}
