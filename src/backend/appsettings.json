{
  "AllowedHosts": "*",
  "CorsSettings": {
    "AllowedOrigins": []
  },
  "RedisOptions": {
    /* 逻辑自洽补丁：添加 Configuration 占位符。
       注意：如果 Docker 变量是 Redis__Configuration，此处应改为 "Redis": { "Configuration": "..." }
       如果是 RedisOptions__Configuration，则保留在此处。 */
    "Configuration": "localhost:6379",
    "InstanceName": "MyBlog_"
  },
  "ConnectionStrings": {
    /* 安全性保障：此处仅作为开发期占位，生产环境会被 Docker 环境变量覆盖 */
    "DefaultConnection": ""
  },
  "Jwt": {
    "SecretKey": "MUST_BE_OVERRIDDEN_BY_ENV_VARIABLES",
    "Issuer": "FsusBlogServer",
    "Audience": "FsusBlogClient",
    "AccessTokenExpiresMinutes": 15
  },
  "AuthCookies": {
    "AllowInsecureTransportCookies": false
  },
  "Observability": {
    "Enabled": true,
    "ExporterEnabled": false,
    "ServiceName": "FsusBlog",
    "ServiceVersion": "2.0.0",
    "OtlpEndpoint": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Async"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Error" // 屏蔽烦人的健康检查日志
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{AuditSource}] [{AuditType}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Async", // 使用异步包装器，提升吞吐量
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/log-.txt", // 日志路径
                "rollingInterval": "Day", // 按天滚动
                "retainedFileCountLimit": 30, // 保留最近30天
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{AuditSource}] [{AuditType}] {Message:lj}{NewLine}{Exception}"
              }
            }
          ]
        }
      }
    ]
  },
  "SqlSugar": {
    "DbType": "PostgreSQL",
    "IsAutoCloseConnection": true
  },
  "AnonymousCredentialIssuer": {
    "AllowBannedAccountIssuance": false,
    "MaxCredentialRequestBytes": 8192,
    "MaxClientNonceBytes": 128,
    "EpochDurationMinutes": 1440,
    "CredentialTtlMinutes": 1440,
    "IssuerPublicKeyId": "issuer-key:local",
    "CircuitNative": {
      "Enabled": false,
      "Backend": "managed_circuit_native_v2",
      "IssuerPrivateKeyPath": "",
      "IssuerPublicKeyPath": "",
      "IssuerPublicKeyHash": "",
      "MaxConcurrentSignatures": 2,
      "TimeoutMs": 2000
    }
  },
  "AnonymousIdentity": {
    "ZkProd": {
      "Enabled": false,
      "RequireNativeVerifier": true,
      "RequireCredential": true,
      "RequireTrustedSetupVerified": true,
      "AllowDevVerifier": false,
      "FallbackToLegacyAnonymous": false,
      "VerifierBackend": "native_groth16",
      "TrustedSetupVerified": false,
      "CredentialReady": false,
      "VerifyingKeyHash": "",
      "CircuitManifestPath": "security/zk/comment-v2-circuit.manifest.json",
      "TrustedSetupManifestPath": "security/zk/comment-v2-trusted-setup.manifest.json",
      "VerifyingKeyManifestPath": "config/zk/anonymous-comment-v2-verifying-key.manifest.json"
    },
    "ZkVerifier": {
      "Enabled": false,
      "CircuitId": "fsus.anonymous.comment.v2",
      "VerifyingKeyHash": "",
      "PublicInputLayoutVersion": 3,
      "MaxProofBytes": 4096,
      "Backend": "native_groth16",
      "BackendTimeoutMs": 2000,
      "MaxConcurrentVerifications": 2,
      "VerifyingKeyManifestPath": "config/zk/anonymous-comment-v2-verifying-key.manifest.json",
      "NativeGroth16": {
        "LibraryPath": "",
        "VerifyingKeyPath": "",
        "VerifyingKeySha256": "",
        "EntryPoint": "fsus_zk_groth16_verify"
      }
    }
  },
  "Fido2": {
    "ServerDomain": "localhost",
    "ServerName": "FsusBlog",
    "Origins": [ "http://localhost:3000", "http://localhost:5173", "http://localhost:7291", "http://localhost:8080", "http://127.0.0.1:8080", "http://localhost:55710", "http://127.0.0.1:55710" ]
  }
}
