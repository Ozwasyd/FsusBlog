{
  "name": "fsusblog-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate:public-page-manifest": "node ../../tools/frontend/generate-public-page-manifest.mjs",
    "check:public-page-manifest-sync": "node ../../tools/frontend/generate-public-page-manifest.mjs --check",
    "generate:aeds-protocol": "node ../../tools/frontend/generate-aeds-protocol.mjs",
    "check:aeds-protocol": "node ../../tools/frontend/generate-aeds-protocol.mjs --check",
    "dev": "npm run generate:public-page-manifest && vite",
    "dev:debug": "npm run generate:public-page-manifest && npm run ensure:wasm && vite --host 0.0.0.0 --port 3000",
    "test:fast": "bash ../../tools/test.sh fast",
    "test:integration": "bash ../../tools/test.sh integration",
    "test:ci": "bash ../../tools/test.sh ci",
    "test:release": "bash ../../tools/test.sh release",
    "test:acceptance": "bash ../../tools/test.sh acceptance",
    "test:visual": "bash ../../tools/test.sh visual",
    "test:production": "bash ../../tools/test.sh production",
    "test:unit:fast": "npm run generate:public-page-manifest && vitest run --config vitest.config.ts",
    "test:unit:coverage": "npm run generate:public-page-manifest && vitest run --config vitest.config.ts --coverage",
    "deps:wasm-codec": "bash ../../tools/frontend/install-wasm-codec-deps.sh",
    "ensure:wasm": "node ../../tools/frontend/ensure-wasm.mjs ensure",
    "build:wasm": "bash ./wasm/build.sh",
    "bench:pow-wasm": "node ../../tools/frontend/bench-pow-wasm.mjs",
    "build:release": "node ../../tools/frontend/build.mjs",
    "check:image-codec-wasm": "node ../../tests/frontend/checks/wasm/check-image-codec-wasm.mjs",
    "check:image-codec-wasm-runtime": "node ../../tests/frontend/checks/wasm/check-image-codec-wasm-runtime.mjs",
    "check:modern-standards": "node ../../tests/frontend/checks/static/check-modern-standards.mjs",
    "check:result-boundaries": "node ../../tests/frontend/checks/static/check-result-boundaries.mjs",
    "check:error-code-alignment": "node ../../tests/frontend/checks/static/check-error-code-alignment.mjs",
    "check:no-runtime-message-branching": "node ../../tests/frontend/checks/static/check-no-runtime-message-branching.mjs",
    "check:security-consistency": "node ../../tests/frontend/checks/static/check-security-consistency.mjs",
    "check:server-try-catch": "node ../../tests/frontend/checks/static/check-server-try-catch.mjs",
    "check:telemetry-privacy": "node ../../tests/frontend/checks/static/check-telemetry-privacy.mjs",
    "check:subscription-privacy": "node ../../tests/frontend/checks/static/check-subscription-privacy.mjs",
    "check:author-ai-assist": "node ../../tests/frontend/checks/static/check-author-ai-assist.mjs",
    "check:asset-size-budget": "node ../../tests/frontend/checks/static/check-asset-size-budget.mjs",
    "check:public-private-data-leakage": "node ../../tests/frontend/checks/static/check-public-private-data-leakage.mjs",
    "check:sse-runtime": "node ../../tests/frontend/checks/runtime/check-sse-runtime.mjs",
    "check:sse-live": "node ../../tests/frontend/checks/runtime/sse-live-smoke.mjs",
    "check:api-contracts": "node ../../tests/frontend/checks/runtime/api-contract-matrix.mjs",
    "check:binary-contract-smoke": "node ../../tests/frontend/checks/runtime/binary-contract-smoke.mjs",
    "check:distribution-version-coherence": "node ../../tests/frontend/checks/runtime/distribution-version-coherence-smoke.mjs",
    "check:sw-search-runtime": "node ../../tests/frontend/checks/public/check-sw-search-runtime.mjs",
    "check:pwa-offline-policy": "node ../../tests/frontend/checks/public/check-pwa-offline-policy.mjs",
    "check:pwa-offline-smoke": "node ../../tests/frontend/checks/public/check-pwa-offline-smoke.mjs",
    "check:subscription-smoke": "node ../../tests/frontend/checks/public/check-subscription-smoke.mjs",
    "check:public-distribution-contract": "node ../../tests/frontend/checks/public/check-public-distribution-contract.mjs",
    "check:search-runtime": "node ../../tests/frontend/checks/public/check-search-runtime.mjs",
    "check:views-constraints": "node ../../tests/frontend/checks/static/check-views-constraints.mjs",
    "check:aot": "npm run check:image-codec-wasm && npm run check:image-codec-wasm-runtime && node ../../tests/frontend/checks/public/aot-regression.mjs",
    "rebuild:public-hydration": "node ../../tools/frontend/rebuild-public-hydration-bundle.mjs",
    "check:public-hydration": "node ../../tests/frontend/checks/public/check-public-hydration-identity.mjs && node ../../tests/frontend/checks/public/public-hydration-smoke.mjs && node ../../tests/frontend/checks/public/check-public-refresh-hydration.mjs",
    "check:public-refresh-hydration": "node ../../tests/frontend/checks/public/check-public-refresh-hydration.mjs",
    "check:public-hydration-rebuild": "npm run check:public-page-manifest-sync && node ../../tests/frontend/checks/public/check-public-hydration-rebuild.mjs && node ../../tests/frontend/checks/public/check-public-renderer-version-sync.mjs && node ../../tests/frontend/checks/public/check-public-pageid-coverage.mjs",
    "check:public-seo-smoke": "node ../../tests/frontend/checks/public/public-seo-smoke.mjs",
    "warm:public-aot": "node ../../tools/frontend/warm-public-aot-cache.mjs",
    "check:binary-smoke": "node ../../tests/frontend/checks/runtime/binary-smoke.mjs",
    "check:binary-smoke:auth": "node ../../tests/frontend/checks/runtime/binary-smoke-auth.mjs",
    "check:auth-session-smoke": "node ../../tests/frontend/checks/runtime/auth-session-smoke.mjs",
    "check:auth-register-smoke": "node ../../tests/frontend/checks/runtime/auth-register-smoke.mjs",
    "check:runtime-regression": "npm run check:auth-session-smoke && npm run check:sse-runtime && npm run check:sse-live && npm run check:api-contracts && npm run check:binary-smoke && npm run check:binary-contract-smoke && npm run check:public-hydration-rebuild",
    "prepare:binary-smoke:auth-users": "node ../../tests/frontend/fixtures/prepare-auth-smoke-users.mjs",
    "prepare:playwright:fixtures": "node ../../tests/frontend/fixtures/discover-playwright-fixtures.mjs",
    "prepare:playwright:sessions": "node ../../tests/frontend/fixtures/prepare-playwright-sessions.mjs",
    "check:spa:routes": "npm run ensure:wasm && env -u NO_COLOR NODE_PATH=./node_modules npx playwright test --workers=${FSUSBLOG_SPA_ROUTES_WORKERS:-1} acceptance/spa-routes.spec.ts",
    "check:acceptance:auth": "npm run ensure:wasm && env -u NO_COLOR NODE_PATH=./node_modules npx playwright test acceptance/auth-flows.spec.ts",
    "check:acceptance:public": "npm run ensure:wasm && env -u NO_COLOR NODE_PATH=./node_modules npx playwright test acceptance/public-routes.spec.ts",
    "check:acceptance:console": "npm run ensure:wasm && env -u NO_COLOR NODE_PATH=./node_modules npx playwright test acceptance/user-console.spec.ts acceptance/admin-console.spec.ts",
    "check:acceptance:e2e": "npm run check:spa:routes && npm run check:acceptance:auth && npm run check:acceptance:public && npm run check:acceptance:console",
    "check:cross-browser:smoke": "npm run ensure:wasm && env -u NO_COLOR NODE_PATH=./node_modules FSUSBLOG_PLAYWRIGHT_BROWSERS=${FSUSBLOG_PLAYWRIGHT_BROWSERS:-chromium,firefox,webkit} npx playwright test --workers=1 acceptance/cross-browser-smoke.spec.ts",
    "check:visual:public": "npm run ensure:wasm && env -u NO_COLOR NODE_PATH=./node_modules npx playwright test visual/public-visual.spec.ts",
    "check:visual:console": "npm run ensure:wasm && bash ../../tools/frontend/check-console-visual.sh",
    "check:visual:theme": "npm run check:visual:public && npm run check:visual:console",
    "check:visual:mobile": "npm run check:visual:public && npm run check:visual:console",
    "check:acceptance:visual": "npm run check:visual:public && npm run check:visual:console",
    "capture:manual-layout-screenshots": "npm run ensure:wasm && env -u NO_COLOR NODE_PATH=./node_modules npx playwright test --workers=1 manual/manual-layout-screenshots.spec.ts",
    "check:security:auth-mfa": "node ../../tests/frontend/checks/security/check-auth-mfa-smoke.mjs",
    "check:security:auth-passkey": "node ../../tests/frontend/checks/security/check-auth-passkey-smoke.mjs",
    "check:security:permissions": "node ../../tests/frontend/checks/security/check-permission-matrix.mjs",
    "check:security:headers-cors": "node ../../tests/frontend/checks/security/check-security-headers-cors.mjs",
    "check:security:attack-matrix": "node ../../tests/frontend/checks/security/check-security-attack-matrix.mjs",
    "check:security:sse-binary": "node ../../tests/frontend/checks/security/check-security-sse-binary.mjs",
    "check:security:matrices": "node ../../tools/security/check-security-matrices.mjs",
    "generate:sbom": "bash ../../tools/security/generate-sbom.sh",
    "check:supply-chain": "bash ../../tools/security/check-supply-chain-audit.sh",
    "check:security:dast": "bash ../../tools/security/run-zap-baseline.sh",
    "check:security": "npm run check:api-contracts && npm run check:auth-session-smoke && npm run check:security:auth-mfa && npm run check:security:auth-passkey && npm run check:security:permissions && npm run check:security:headers-cors && npm run check:security:attack-matrix && npm run check:security:sse-binary && npm run check:security:matrices && npm run check:supply-chain && npm run check:a11y:smoke && npm run check:security:dast",
    "check:resilience:runtime": "node ../../tests/frontend/checks/resilience/check-runtime-resilience.mjs",
    "check:resilience:upload": "node ../../tests/frontend/checks/resilience/check-upload-resilience.mjs",
    "check:resilience": "npm run check:resilience:runtime && npm run check:resilience:upload && npm run check:sse-runtime && npm run check:search-runtime && npm run check:binary-smoke && npm run check:binary-contract-smoke",
    "check:load:public-api": "node ../../tests/frontend/checks/load/check-load-public-api.mjs",
    "check:load:sse-pressure": "node ../../tests/frontend/checks/load/check-sse-pressure.mjs",
    "check:load": "npm run check:load:public-api && npm run check:load:sse-pressure",
    "check:a11y:smoke": "node ../../tests/frontend/checks/runtime/check-a11y-smoke.mjs",
    "check:acceptance": "echo '[deprecated] use npm run test:release' >&2 && npm run test:release",
    "check:full-regression": "bash ../../tools/frontend/full-regression.sh",
    "build": "npm run build:release",
    "preview": "vite preview --host 0.0.0.0 --port 8080"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@fontsource-variable/noto-sans-jp": "^5.2.10",
    "@fontsource/google-sans": "^5.2.1",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@fontsource/noto-sans-tc": "^5.2.9",
    "@ozwasyd/element-plus": "1.4.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.4",
    "@unhead/vue": "^3.1.0",
    "@vue/server-renderer": "^3.5.33",
    "dayjs": "^1.11.3",
    "echarts": "^6.1.0",
    "katex": "^0.16.45",
    "mermaid": "^11.15.0",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qrcode.vue": "^3.9.0",
    "shiki": "^4.0.2",
    "tailwindcss": "^4.2.4",
    "vue": "^3.5.33",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@pinia/testing": "^0.1.7",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.5",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^20.9.0",
    "sass-embedded": "^1.99.0",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.7"
  }
}
