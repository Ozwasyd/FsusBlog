{
  "extends": "./tsconfig.fsusui-published.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.fsusui-local.tsbuildinfo",
    "erasableSyntaxOnly": false,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@wasm/*": ["./wasm/web/*"],
      "vue": ["./node_modules/vue"],
      "@vue/*": ["./node_modules/@vue/*"],
      "@ozwasyd/element-plus": ["../../../FsusUI/vue/packages/element-plus/index.ts"],
      "element-plus": ["../../../FsusUI/vue/packages/element-plus/index.ts"],
      "@ozwasyd/element-plus/icons-vue": ["../../../FsusUI/vue/packages/element-plus/icons-vue.ts"],
      "@ozwasyd/element-plus/markdown-runtime": ["../../../FsusUI/vue/packages/element-plus/markdown-runtime.ts"],
      "@ozwasyd/element-plus/motion": ["../../../FsusUI/vue/packages/element-plus/motion.ts"],
      "@ozwasyd/element-plus/perception-challenge": ["../../../FsusUI/vue/packages/element-plus/perception-challenge.ts"],
      "@ozwasyd/element-plus/render-pipeline": ["../../../FsusUI/vue/packages/element-plus/render-pipeline.ts"],
      "@ozwasyd/element-plus/result": ["../../../FsusUI/vue/packages/element-plus/result.ts"],
      "@ozwasyd/element-plus/theme": ["../../../FsusUI/vue/packages/element-plus/theme.ts"],
      "@ozwasyd/element-plus/wasm": ["../../../FsusUI/vue/packages/element-plus/wasm.ts"],
      "@element-plus/icons-vue": ["../../../FsusUI/vue/packages/icons-vue/src/index.ts"],
      "@element-plus/icons-vue/*": ["../../../FsusUI/vue/packages/icons-vue/src/*"],
      "@element-plus/theme-chalk/src": ["../../../FsusUI/vue/packages/theme-chalk/src"],
      "@element-plus/theme-chalk/src/*": ["../../../FsusUI/vue/packages/theme-chalk/src/*"],
      "@element-plus/wasm": ["../../../FsusUI/vue/packages/wasm/index.ts"],
      "@element-plus/wasm/*": ["../../../FsusUI/vue/packages/wasm/*"],
      "@element-plus/*": ["../../../FsusUI/vue/packages/*"]
    }
  },
  "include": [
    "../../tests/frontend/typecheck/fsusui-export-contract.ts",
    "../../tests/frontend/typecheck/fsusui-local-export-contract.ts",
    "src/vite-env.d.ts",
    "../../../FsusUI/vue/global.d.ts",
    "../../../FsusUI/vue/typings/components.d.ts",
    "../../../FsusUI/vue/typings/env.d.ts"
  ]
}
