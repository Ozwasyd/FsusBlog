{
    "extends": "./tsconfig.app.json",
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.fsusui-published.tsbuildinfo",
        "composite": false,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@wasm/*": [
                "./wasm/web/*"
            ],
            "vue": [
                "./node_modules/vue"
            ],
            "@vue/*": [
                "./node_modules/@vue/*"
            ],
            "@ozwasyd/element-plus": [
                "./node_modules/@ozwasyd/element-plus"
            ],
            "@ozwasyd/element-plus/theme": [
                "./node_modules/@ozwasyd/element-plus/es/theme.d.ts"
            ]
        }
    },
    "include": [
        "../../tests/frontend/typecheck/fsusui-export-contract.ts",
        "../../tests/frontend/typecheck/admin-segmented-control-consumer-contract.ts",
        "src/vite-env.d.ts"
    ]
}
