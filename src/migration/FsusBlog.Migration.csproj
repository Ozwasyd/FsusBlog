<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FsusBlog.Migration</RootNamespace>
    <AssemblyName>FsusBlog.Migration</AssemblyName>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
    <PackageReference Include="SqlSugarCoreNoDrive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\shared\FsusBlog.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="FsusBlog.SourceCommit" Value="$(FsusBlogCommitSha)" />
    <EmbeddedResource Include="../../tools/ci/migration-retained-inputs.mjs" LogicalName="FsusBlog.Migration.RetainedReader.tools.ci.migration-retained-inputs.mjs" />
    <EmbeddedResource Include="../../tools/ci/production-build-artifacts.mjs" LogicalName="FsusBlog.Migration.RetainedReader.tools.ci.production-build-artifacts.mjs" />
    <EmbeddedResource Include="../../tools/fact-extractors/identity.mjs" LogicalName="FsusBlog.Migration.RetainedReader.tools.fact-extractors.identity.mjs" />
    <EmbeddedResource Include="../../tools/fact-extractors/lib/canonicalize.mjs" LogicalName="FsusBlog.Migration.RetainedReader.tools.fact-extractors.lib.canonicalize.mjs" />
  </ItemGroup>
</Project>
