{
  "stryker-config": {
    "solution": "FsusBlog.slnx",
    "project": "tests/backend/FsusBlog.Server.Tests.csproj",
    "test-case-filter": "Category!=Integration",
    "mutation-level": "Complete",
    "threshold-high": 85,
    "threshold-low": 70,
    "threshold-break": 70,
    "reporters": [
      "progress",
      "html",
      "json"
    ],
    "report-file-name": "backend-mutation",
    "output": ".tmp/mutation/backend",
    "mutate": [
      "src/core/Algorithms/**/*.cs",
      "src/core/Cache/**/*.cs",
      "src/core/Mapping/**/*.cs",
      "src/backend/Infrastructure/Auth/**/*.cs",
      "src/backend/Infrastructure/Binary/**/*.cs",
      "src/backend/Infrastructure/Cache/**/*.cs",
      "src/backend/Infrastructure/Filters/**/*.cs",
      "src/backend/Infrastructure/Middlewares/**/*.cs",
      "src/backend/Infrastructure/NotificationStream/**/*.cs",
      "src/backend/Services/**/*.cs"
    ],
    "ignore-methods": [
      "ToString",
      "GetHashCode"
    ]
  }
}
