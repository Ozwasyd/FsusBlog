<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DefineConstants Condition="'$(DiagnosticRosterReview)' == 'true'">$(DefineConstants);DIAGNOSTIC_ROSTER_V1</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="FsusBlog.Server" HintPath="$(DiagnosticAssemblyPath)" />
  </ItemGroup>
  <Target Name="RequireDiagnosticAssembly" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(DiagnosticAssemblyPath)')" Text="Pass DiagnosticAssemblyPath for the independently built exact-head server assembly." />
  </Target>
</Project>
