          "assertions": [{"pointer": "/body/finalEffectCount", "equals": 1}, {"pointer": "/body/actualAuditCount", "equals": 1}],
          "timeoutMs": 180000,
          "pollMs": 500
        }
      ],
      "ledger": {
        "observedLogicalEventId": {"probe": "final", "pointer": "/body/logicalEventId", "type": "string"},
        "observedKind": {"probe": "final", "pointer": "/body/kind", "type": "string"},
        "attemptCount": {"probe": "final", "pointer": "/body/attemptCount", "type": "integer"},
        "finalEffectCount": {"probe": "final", "pointer": "/body/finalEffectCount", "type": "integer"},
        "finalEffectKey": {"probe": "final", "pointer": "/body/finalEffectKey", "type": "string"},
        "finalReleaseId": {"probe": "final", "pointer": "/body/finalReleaseId", "type": "string"},
        "finalGeneration": {"probe": "final", "pointer": "/body/finalGeneration", "type": "integer"},
        "staleGenerationCommitCount": {"probe": "final", "pointer": "/body/staleGenerationCommitCount", "type": "integer"},
        "pendingLogicalEventId": {"probe": "pending", "pointer": "/body/logicalEventId", "type": "string"},
        "pendingCountAtDrain": {"probe": "pending", "pointer": "/body/pendingCountAtDrain", "type": "integer"},
        "durableReplaySource": {"probe": "pending", "pointer": "/body/durableReplaySource", "type": "string"},
        "expectedAuditCount": {"probe": "final", "pointer": "/body/expectedAuditCount", "type": "integer"},
        "actualAuditCount": {"probe": "final", "pointer": "/body/actualAuditCount", "type": "integer"}
      }
    },
    {
      "kind": "visit-view-projection",
      "identity": {"mode": "generated", "template": "worker-drill-{{runId}}-visit-view"},
      "prepare": [
        {
          "id": "insert-durable-visit",
          "type": "sql-exec",
          "sql": "INSERT INTO sys_visit_log (ip_hash, region, createtime, event_type, route_key, article_id, viewer_key_hash, proof_id, dwell_ms) VALUES ('worker-drill', 'ZZ', (now() AT TIME ZONE 'utc'), 'article_read', '/worker-drill', {{input.articleId}}, 'worker-drill', {{logicalEventId}}, 1000) RETURNING json_build_object('logicalEventId', proof_id, 'visitLogId', id, 'articleId', article_id)",
          "assertions": [{"pointer": "/logicalEventId", "equalsVariable": "logicalEventId"}]
        }
      ],
      "trigger": [],
      "beforeTermination": [
        {
          "id": "pending",
          "type": "http-json",
          "url": "http://127.0.0.1:19031/observations/visit-view-projection/pending?logicalEventId={{logicalEventId}}&rolloutId={{rolloutId}}",
