        "durableReplaySource": {"probe": "pending", "pointer": "/body/durableReplaySource", "type": "string"},
        "expectedProjectionCount": {"probe": "final", "pointer": "/body/expectedProjectionCount", "type": "integer"},
        "actualProjectionCount": {"probe": "final", "pointer": "/body/actualProjectionCount", "type": "integer"}
      }
    },
