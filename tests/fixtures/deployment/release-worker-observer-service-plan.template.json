      "auditCount": "audit_count",
      "projectionCount": "projection_count",
      "ownerCount": "owner_count",
      "consumerCount": "consumer_count",
      "sourceClaimObserved": "source_claim_observed",
      "sourceFinalCommitObserved": "source_final_commit_observed",
      "recoveredByTarget": "recovered_by_target"
    }
  },
