    "source": {
      "origin": "http://127.0.0.1:18081",
      "container": {
        "name": "REPLACE_SOURCE_CONTAINER",
        "identityLabels": {
          "releaseId": "com.fsusblog.release-id",
          "slot": "com.fsusblog.release-slot",
          "generation": "com.fsusblog.runtime-generation"
        }
      }
    },
    "target": {
      "origin": "http://127.0.0.1:18082",
      "container": {
        "name": "REPLACE_TARGET_CONTAINER",
        "identityLabels": {
          "releaseId": "com.fsusblog.release-id",
          "slot": "com.fsusblog.release-slot",
          "generation": "com.fsusblog.runtime-generation"
        }
      }
    },
    "adminStatusPath": "/api/ops/deployment/status",
    "redisFenceKeyTemplate": "fsusblog:test:release:{rolloutId}:slot:{slot}:fence"
  },
  "observation": {
    "schemaName": "public",
