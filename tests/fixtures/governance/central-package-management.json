        {
            "id": "valid-central-authority",
            "snapshot": {
                "centralXml": "<Project><PropertyGroup><ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally></PropertyGroup><ItemGroup><PackageVersion Include=\"Example.Package\" Version=\"1.2.3\" /></ItemGroup></Project>",
                "projects": [
                    {
                        "path": "src/example/Example.csproj",
                        "xml": "<Project><ItemGroup><PackageReference Include=\"Example.Package\" /></ItemGroup></Project>",
                        "lockPath": "src/example/packages.lock.json",
                        "lock": {
                            "version": 2,
                            "dependencies": {
                                "net10.0": {
                                    "Example.Package": {
                                        "type": "Direct",
                                        "requested": "[1.2.3, )",
                                        "resolved": "1.2.3"
                                    }
                                }
                            }
                        }
                    }
                ]
            },
            "expectedCodes": []
        },
