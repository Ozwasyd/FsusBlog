{
    "schema": "fsusblog-ops-health-state-contract.v1",
    "issue": 1896,
    "surface": {
        "owner": "FsusBlog",
        "profile": "task",
        "uiDecisionClass": "bounded-composition",
        "verificationClass": "ux-path",
        "restoresConformance": true
    },
    "componentChoice": {
        "stateComponent": "FsusUiEmptyState",
        "size": "compact",
        "illustration": false,
        "actionComponent": "ElButton",
        "reason": "OpsHealth is a task route whose workbench data is temporarily unavailable; compact EmptyState is the flat low-noise feedback primitive for a dashboard content region, while Result is reserved for completed operations or exceptional access."
    },
    "states": [
        {
            "id": "initial-loading",
            "annunciation": "polite",
            "hasRetry": false,
            "hasWorkbench": false
        },
        {
            "id": "failure",
            "annunciation": "assertive",
            "hasRetry": true,
            "hasWorkbench": false
        },
        {
            "id": "retry-loading",
            "annunciation": "polite",
            "hasRetry": true,
            "retryDisabled": true,
            "retryLoading": true,
            "hasWorkbench": false
        },
        {
            "id": "success",
            "hasRetry": false,
            "hasWorkbench": true
        }
    ],
    "behaviorCases": [
        "success",
        "initial-loading",
        "failure",
        "retry-success",
        "repeated-retry",
        "unmount-stale-response"
    ],
    "renderMatrix": {
        "viewports": [375, 768, 1440],
        "themes": ["light", "dark"],
        "modes": ["default", "zoom-200", "forced-colors"],
        "states": ["initial-loading", "failure", "retry-loading", "success"],
        "requirements": [
            "no-horizontal-overflow",
            "visible-keyboard-focus",
            "screen-reader-reason-and-retry",
            "minimum-44px-retry-hit-target"
        ]
    },
    "forbiddenMutations": [
        "native-retry-moved-to-child",
        "second-native-retry-inside-result",
        "initial-loading-shows-failure",
        "double-click-starts-concurrent-loads",
        "toast-only-without-recovery-action",
        "private-el-selector-css",
        "published-mode-falls-back-to-legacy-dom"
    ],
    "outOfScope": [
        "getOpsHealth-response",
        "getOpsHealth-cache",
        "automatic-polling",
        "service-health-semantics",
        "OpsHealthWorkbench",
        "navigation",
        "new-wrapper",
        "hero-or-illustration-or-marketing-cta"
    ]
}
