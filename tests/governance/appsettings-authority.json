{
    "schema": "fsusblog.appsettings-authority.v1",
    "authorities": {
        "base": "src/backend/appsettings.json",
        "productionOverlay": "src/backend/appsettings.Production.json",
        "developmentExample": "src/backend/appsettings.Development.example.json",
        "productionEnvironmentExample": ".env.production.example"
    },
    "retiredFiles": [
        "src/backend/appsettings.example.json",
        "src/backend/appsettings.Production.example.json",
        ".env.production-template"
    ],
    "precedence": [
        "src/backend/appsettings.json",
        "src/backend/appsettings.Production.json",
        "environment variables loaded from .env.production / Compose",
        "explicit command-line overrides"
    ],
    "developmentOverlay": {
        "allowedLeafPaths": [
            "fsus:allowLocalAuthFixture",
            "ConnectionStrings:DefaultConnection",
            "RedisOptions:Configuration",
            "RedisOptions:InstanceName",
            "AuthCookies:AllowInsecureTransportCookies",
            "ActiveReleaseFence:AllowSyntheticLocalFence",
            "ActiveReleaseFence:MutationEnabled",
            "ActiveReleaseFence:RefreshIntervalMs",
            "ActiveReleaseFence:StaleThresholdSeconds",
            "CorsSettings:AllowedOrigins",
            "Fido2:Origins"
        ]
    },
    "productionOverlay": {
        "allowedTopLevelSections": [
            "AllowedHosts",
            "Database",
            "Logging",
            "Serilog",
            "Observability",
            "PublicHotRead",
            "PublicArtifactRevocation",
            "AnonymousCredentialIssuer",
            "AnonymousCredentialRoot",
            "AnonymousIdentity",
            "Audit",
            "Jwt",
            "Security",
            "MfaChallenge",
            "HumanReadProof",
            "ReadAnalyticsPrivacy",
            "VisitLog",
            "Moderation",
            "Subscription"
        ],
        "requiredEmptyLeafPaths": [
            "Observability:OtlpEndpoint",
            "PublicArtifactRevocation:CdnPurgeEndpoint",
            "PublicArtifactRevocation:CdnPurgeBearerToken",
            "PublicArtifactRevocation:CloudflareZoneId",
            "AnonymousCredentialIssuer:IssuerPublicKeyId",
            "AnonymousCredentialIssuer:SubjectHashPepper",
            "AnonymousCredentialIssuer:CircuitNative:IssuerPrivateKeyPath",
            "AnonymousCredentialIssuer:CircuitNative:IssuerPublicKeyPath",
            "AnonymousCredentialIssuer:CircuitNative:IssuerPublicKeyHash",
            "AnonymousCredentialIssuer:BlindRsa:KeyId",
            "AnonymousCredentialIssuer:BlindRsa:PublicKeyHash",
            "AnonymousCredentialIssuer:BlindRsa:PrivateKeyPath",
            "AnonymousCredentialRoot:AttestationKey",
            "AnonymousIdentity:NullifierPepper",
            "AnonymousIdentity:ZkProd:VerifyingKeyHash",
            "AnonymousIdentity:ZkVerifier:VerifyingKeyHash",
            "AnonymousIdentity:ZkVerifier:NativeGroth16:VerifyingKeyPath",
            "AnonymousIdentity:ZkVerifier:NativeGroth16:VerifyingKeySha256",
            "Jwt:KeyVersion",
            "Jwt:SecretKey",
            "Security:Pow:SigningKey",
            "Security:PerceptionSealedToken:Keys:k1",
            "Security:RiskPseudonymization:CurrentKey",
            "Security:RiskPseudonymization:PreviousKey",
            "Security:RecoveryKeyPepper",
            "MfaChallenge:TicketSigningKey",
            "HumanReadProof:SigningKey",
            "HumanReadProof:Dedup:CurrentKey",
            "ReadAnalyticsPrivacy:NoiseKey",
            "VisitLog:IpPseudonymization:CurrentKey",
            "VisitLog:IpPseudonymization:PreviousKey",
            "Moderation:Pepper",
            "Moderation:RegionPolicy:IpHashKey",
            "Moderation:AntiSpamModel:RuntimePath",
            "Moderation:AntiSpamModel:TrustedSigningKey",
            "Subscription:EmailHashPepper"
        ]
    },
    "productionEnvironmentExample": {
        "requiredKeys": [
            "FSUSBLOG_BLUE_PORT",
            "FSUSBLOG_GREEN_PORT",
            "FSUSBLOG_GATEWAY_PUBLIC_PROBE_URL",
            "FSUSBLOG_SHARED_UPLOADS_VOLUME",
            "EXTERNAL_DB_HOST",
            "EXTERNAL_REDIS_HOST",
            "DB_USER",
            "DB_PASSWORD",
            "DB_NAME",
            "REDIS_PASSWORD",
            "Jwt__SecretKey",
            "Jwt__KeyVersion",
            "FSUSBLOG_ZK_VERIFYING_KEY_HASH",
            "FSUSBLOG_ZK_ISSUER_PUBLIC_KEY_ID",
            "FSUSBLOG_ZK_ISSUER_PUBLIC_KEY_HASH",
            "SITE_BASEURL",
            "CORS_ALLOWED_HOSTS",
            "APP_ALLOWED_HOSTS",
            "FIDO2_SERVER_DOMAIN",
            "FIDO2_SERVER_NAME"
        ],
        "placeholderKeys": [
            "FSUSBLOG_GATEWAY_PUBLIC_PROBE_URL",
            "FSUSBLOG_SHARED_UPLOADS_VOLUME",
            "DB_USER",
            "DB_PASSWORD",
            "REDIS_PASSWORD",
            "Jwt__SecretKey",
            "Jwt__KeyVersion",
            "FSUSBLOG_ZK_VERIFYING_KEY_HASH",
            "FSUSBLOG_ZK_ISSUER_PUBLIC_KEY_ID",
            "FSUSBLOG_ZK_ISSUER_PUBLIC_KEY_HASH"
        ]
    },
    "canonicalTemplateConsumers": [
        ".dockerignore",
        ".gitignore",
        "tools/deploy-production.sh",
        "tools/security/collect-production-hosts.sh",
        "tools/security/check-production-network-baseline.sh",
        "tools/security/check-production-exposure-live.sh",
        "tests/frontend/checks/static/check-infra-security-governance.mjs",
        "tools/docs/check-dev-onboarding.mjs",
        "README.md",
        "docs/development.md",
        "docs/configuration/appsettings-authority.md",
        "docs/open-source-readiness.md",
        "docs/production.md",
        "docs/releases/v1.1.0-public-preview.md",
        "docs/reports/open-source-readiness/v1.1.0-public-preview/readiness-checklist.md"
    ]
}
