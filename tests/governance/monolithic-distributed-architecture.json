{
    "schema": "fsusblog.monolithic-distributed-architecture.v2",
    "contentDigest": "sha256:8a366f76e65d059c4810caf777c7edea4b0a29acd8ff382e04d78f9c5a60a311",
    "mainApplication": {
        "project": "src/backend/FsusBlog.Server.csproj",
        "dockerfile": "ops/docker/FsusBlog.Server.Dockerfile",
        "productionTarget": "final",
        "productionEntrypoint": [
            "./FsusBlog.Server"
        ],
        "productionImage": "${FSUSBLOG_IMAGE_REF:?Set immutable repository@sha256 digest from release-manifest.json}",
        "composeService": "fsusblog.server",
        "frontendIntegrationTokens": [
            "<SpaRoot>..\\frontend</SpaRoot>",
            "<ClientWwwRootPublishDir>",
            "<Copy SourceFiles=\"@(ClientDistFiles)\""
        ]
    },
    "executableProjectClassifications": {
        "src/backend/FsusBlog.Server.csproj": "business-application",
        "src/migration/FsusBlog.Migration.csproj": "non-business-tool"
    },
    "runtimeModes": [
        "single",
        "static-role",
        "adaptive"
    ],
    "runtimeRoleOwnership": {
        "process": "one-fsusblog-server-process-per-application-container",
        "container": "one-application-container-per-release-slot",
        "service": "fsusblog.server",
        "coResidency": "selected-runtime-roles-share-process-container-and-service",
        "separation": "blue-green-release-slots-not-runtime-role-services",
        "supportedModes": [
            "single",
            "static-role",
            "adaptive"
        ],
        "unsupportedDeployments": [
            "fixed-role-business-sidecar",
            "multiple-application-services-per-slot",
            "per-role-container-split",
            "per-role-process-split"
        ],
        "authorityState": "closed-current"
    },
    "blueGreenMounts": {
        "/app/Logs": {
            "source": "fsus-logs",
            "volumeName": "${FSUSBLOG_SLOT_LOGS_VOLUME:?Set slot-specific logs volume}",
            "access": "read-write",
            "scope": "slot-private",
            "protection": "retained-with-slot"
        },
        "/app/config/zk": {
            "source": "${FSUSBLOG_ZK_CONFIG_DIR:?Set FSUSBLOG_ZK_CONFIG_DIR to the host ZK config directory}",
            "volumeName": null,
            "access": "read-only",
            "scope": "operator-shared",
            "protection": "outside-release-cleanup"
        },
        "/app/data": {
            "source": "fsus-slot-data",
            "volumeName": "${FSUSBLOG_SLOT_DATA_VOLUME:?Set slot-specific data volume}",
            "access": "read-write",
            "scope": "slot-private",
            "protection": "retained-with-slot"
        },
        "/app/data-protection": {
            "source": "fsus-data-protection",
            "volumeName": "${FSUSBLOG_SHARED_DATA_PROTECTION_VOLUME:?Set the shared DataProtection volume explicitly}",
            "access": "read-write",
            "scope": "shared-between-slots",
            "protection": "outside-release-cleanup"
        },
        "/app/release-assets": {
            "source": "${FSUSBLOG_RELEASE_ASSET_STORE:?Set the host append-only release asset store}/releases",
            "volumeName": null,
            "access": "read-only",
            "scope": "release-artifact-store",
            "protection": "exact-active-release-gc-authority"
        },
        "/app/release-derived": {
            "source": "fsus-release-derived",
            "volumeName": "${FSUSBLOG_SHARED_RELEASE_DERIVED_VOLUME:-fsusblog-release-derived}",
            "access": "read-write",
            "scope": "shared-between-slots",
            "protection": "outside-release-cleanup"
        },
        "/app/release-manifest.json": {
            "source": "${FSUSBLOG_RELEASE_MANIFEST_HOST_PATH:?Set the validated host release manifest path}",
            "volumeName": null,
            "access": "read-only",
            "scope": "release-identity",
            "protection": "identity-bound-read-only"
        },
        "/app/secrets/zk": {
            "source": "${FSUSBLOG_ZK_SECRET_DIR:?Set FSUSBLOG_ZK_SECRET_DIR to the host ZK secret directory}",
            "volumeName": null,
            "access": "read-only",
            "scope": "operator-shared",
            "protection": "outside-release-cleanup"
        },
        "/app/storage": {
            "source": "fsus-storage",
            "volumeName": "${FSUSBLOG_SHARED_PUBLIC_ASSETS_VOLUME:?Set the migrated shared public-assets volume explicitly}",
            "access": "read-write",
            "scope": "shared-between-slots",
            "protection": "outside-release-cleanup"
        },
        "/app/wwwroot/aot-cache": {
            "source": "fsus-aot-cache",
            "volumeName": "${FSUSBLOG_SLOT_AOT_CACHE_VOLUME:?Set slot-specific AOT cache volume}",
            "access": "read-write",
            "scope": "slot-private",
            "protection": "retained-with-slot"
        }
    },
    "composeServices": {
        "ops/development/dependencies.compose.yml": {
            "postgres": "infrastructure",
            "redis": "infrastructure"
        },
        "ops/docker/docker-compose.development-backend.yml": {
            "fsusblog.server": "application"
        },
        "ops/docker/docker-compose.production.yml": {
            "fsusblog.server": "application"
        },
        "ops/docker/docker-compose.zero-downtime.yml": {
            "openresty": "gateway",
            "postgres": "infrastructure",
            "redis": "infrastructure"
        }
    },
    "domainRoots": [
        "src/backend/Entities",
        "src/core"
    ],
    "domainForbiddenPatterns": [
        {
            "label": "remote or infrastructure namespace",
            "pattern": "using\\s+(?:System\\.Net\\.Http|Grpc|StackExchange\\.Redis|System\\.Net\\.Sockets)"
        },
        {
            "label": "node-location or transport implementation",
            "pattern": "\\b(?:HttpClient|GrpcChannel|ConnectionMultiplexer|IDistributedInvalidationTransport|RuntimeModeOptions|NodeLocation)\\b"
        }
    ],
    "remoteInvocation": {
        "patterns": [
            "\\b(?:IRemoteModuleInvoker|RemoteModuleInvoker|RemoteInvocationTransport|NodeLocationResolver|GrpcChannel)\\b"
        ],
        "allowedRoots": [
            "src/backend/Infrastructure/Bootstrap",
            "src/backend/Infrastructure/Distributed",
            "src/backend/Interfaces",
            "src/shared/Contracts"
        ]
    },
    "singleModeGuard": {
        "runtimeOptions": "src/backend/Infrastructure/Distributed/RuntimeModeOptions.cs",
        "runtimeRequiredTokens": [
            "public string Mode { get; set; } = RuntimeModeNames.Single;",
            "public bool ClusterComponentsEnabled => ResolveMode() != RuntimeModeKind.Single;"
        ],
        "bootstrap": "src/backend/Infrastructure/Bootstrap/DistributedInvalidationServiceCollectionExtensions.cs",
        "bootstrapOrderedTokens": [
            "if (!options.Enabled)",
            "SingleNodeDistributedInvalidationPublisher",
            "services.AddSingleton<IDistributedInvalidationTransport>("
        ]
    },
    "documentation": {
        "boundary": "docs/architecture/monolithic-distributed-boundary.md",
        "linkedFrom": [
            "docs/architecture.md",
            "docs/architecture/overview.md"
        ],
        "requiredPhrases": [
            "单体分布式",
            "Homogeneous Binary, Heterogeneous Runtime",
            "同一套 FsusBlog 程序",
            "唯一业务入口",
            "`single`",
            "`static-role`",
            "`adaptive`",
            "remote invocation",
            "port / adapter"
        ],
        "requiredIssueTitles": [
            "#110 单体分布式支持：同构全能力节点与动态职责调度",
            "#111 节点能力注册与集群成员治理",
            "#112 动态职责调度与自适应负载均衡",
            "#113 分布式状态控制",
            "#114 本地 / 远程调用透明切换与模块边界约束",
            "#115 多节点部署、观测与故障治理"
        ],
        "forbiddenAssertions": [
            "FsusBlog 是微服务架构",
            "默认拆分为固定业务服务",
            "前端与后端作为独立生产发布物",
            "single mode 必须经过 remote invocation"
        ]
    }
}
