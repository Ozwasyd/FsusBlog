{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FsusBlog Test Matrix",
  "type": "object",
  "required": ["version", "tiers"],
  "properties": {
    "version": { "type": "string", "pattern": "^fsusblog-test-matrix-v[0-9]+$" },
    "namespaceTemplate": { "type": "string" },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "owner",
          "command",
          "dependsOn",
          "services",
          "parallelizable",
          "exclusiveResources",
          "phase",
          "cost",
          "resourceClass",
          "maxParallel",
          "requiresBootstrap",
          "requiresNode",
          "requiresDotnet",
          "requiresPlaywright",
          "cacheProfile",
          "timeoutMinutes",
          "shardable",
          "defaultShards",
          "risk",
          "cadence",
          "requiredFor",
          "coverage",
          "artifacts",
          "evidence",
          "ciJob",
          "localOnly",
          "nightlyOnly"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "owner": { "type": "string" },
          "command": { "type": "string", "minLength": 1 },
          "dependsOn": { "type": "array", "items": { "type": "string" } },
          "services": { "type": "array", "items": { "type": "string" } },
          "parallelizable": { "type": "boolean" },
          "exclusiveResources": { "type": "array", "items": { "type": "string" } },
          "phase": { "type": "number", "minimum": 0 },
          "cost": { "type": "string", "enum": ["low", "medium", "high", "very-high"] },
          "resourceClass": { "type": "string", "enum": ["cpu", "io", "browser", "network", "benchmark", "database"] },
          "maxParallel": { "type": "number", "minimum": 1 },
          "requiresBootstrap": { "type": "string", "enum": ["none", "frontend", "backend", "full"] },
          "selfBootstraps": { "type": "boolean" },
          "workflowBootstraps": { "type": "boolean" },
          "requiresNode": { "type": "boolean" },
          "requiresDotnet": { "type": "boolean" },
          "requiresPlaywright": { "type": "string", "enum": ["none", "chromium", "all"] },
          "playwrightWorkers": { "type": "integer", "minimum": 1 },
          "cacheProfile": { "type": "string", "enum": ["none", "frontend", "backend", "full"] },
          "timeoutMinutes": { "type": "number", "minimum": 1 },
          "shardable": { "type": "boolean" },
          "defaultShards": { "type": "number", "minimum": 1 },
          "risk": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "cadence": { "type": "string", "enum": ["pr", "push", "nightly", "release-manual"] },
          "requiredFor": { "type": "string", "enum": ["fast", "production", "release-final", "none"] },
          "coverage": { "type": "array", "items": { "type": "string" } },
          "artifacts": { "type": "array", "items": { "type": "string" } },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "ciJob": { "type": "string" },
          "localOnly": { "type": "boolean" },
          "nightlyOnly": { "type": "boolean" },
          "manualOnly": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
