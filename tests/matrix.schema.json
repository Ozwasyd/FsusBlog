{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FsusBlog Test Matrix",
  "type": "object",
  "required": ["version", "tiers"],
  "properties": {
    "version": { "type": "string", "pattern": "^fsusblog-test-matrix-v[0-9]+$" },
    "namespaceTemplate": { "type": "string" },
    "localProfiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["budgetMs", "memoryReserveShare", "bundles", "summaryOnly"],
        "properties": {
          "budgetMs": { "type": "number", "minimum": 1 },
          "enforceBudget": { "type": "boolean" },
          "memoryReserveShare": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
          "summaryOnly": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "bundles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "command", "deadlineWeight", "dependsOn", "members", "resourceClass", "cpuWeight", "memoryWeight", "minCpuUnits", "exclusiveResources"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
                "command": { "type": "string", "minLength": 1 },
                "deadlineWeight": { "type": "number", "exclusiveMinimum": 0 },
                "minimumDeadlineShare": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
                "dependsOn": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
                "members": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
                "resourceClass": { "type": "string", "enum": ["cpu", "io", "browser", "network", "benchmark", "database"] },
                "cpuWeight": { "type": "number", "exclusiveMinimum": 0 },
                "memoryWeight": { "type": "number", "exclusiveMinimum": 0 },
                "minCpuUnits": { "type": "integer", "minimum": 1 },
                "artifactSubstitutions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
                "exclusiveResources": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "owner",
          "command",
          "dependsOn",
          "services",
          "parallelizable",
          "exclusiveResources",
          "phase",
          "cost",
          "resourceClass",
          "cpuWeight",
          "memoryWeight",
          "minCpuUnits",
          "requiresBootstrap",
          "requiresNode",
          "requiresDotnet",
          "requiresPlaywright",
          "cacheProfile",
          "timeoutMinutes",
          "shardable",
          "risk",
          "cadence",
          "requiredFor",
          "coverage",
          "artifacts",
          "evidence",
          "ciJob",
          "localOnly",
          "nightlyOnly"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "owner": { "type": "string" },
          "command": { "type": "string", "minLength": 1 },
          "dependsOn": { "type": "array", "items": { "type": "string" } },
          "services": { "type": "array", "items": { "type": "string" } },
          "parallelizable": { "type": "boolean" },
          "serialReason": { "type": "string", "minLength": 1 },
          "exclusiveResources": { "type": "array", "items": { "type": "string" } },
          "phase": { "type": "number", "minimum": 0 },
          "cost": { "type": "string", "enum": ["low", "medium", "high", "very-high"] },
          "resourceClass": { "type": "string", "enum": ["cpu", "io", "browser", "network", "benchmark", "database"] },
          "cpuWeight": { "type": "number", "exclusiveMinimum": 0 },
          "memoryWeight": { "type": "number", "exclusiveMinimum": 0 },
          "minCpuUnits": { "type": "integer", "minimum": 1 },
          "maxParallel": { "type": "integer", "const": 1 },
          "executionKey": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" },
          "executionVariant": { "type": "string", "enum": ["ordinary", "coverage", "property", "model", "performance", "runtime"] },
          "supersedes": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }, "uniqueItems": true },
          "cacheInputs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "requiresBootstrap": { "type": "string", "enum": ["none", "frontend", "backend", "full"] },
          "selfBootstraps": { "type": "boolean" },
          "workflowBootstraps": { "type": "boolean" },
          "prDefault": { "type": "boolean" },
          "triggerPaths": { "type": "array", "items": { "type": "string" } },
          "triggerFiles": { "type": "array", "items": { "type": "string" } },
          "triggerCoverage": { "type": "array", "items": { "type": "string" } },
          "triggerReason": { "type": "string" },
          "smartGateMode": { "type": "string", "enum": ["always", "conditional", "full-only"] },
          "retentionClass": { "type": "string", "enum": ["must-keep", "conditional", "redundant-candidate", "obsolete"] },
          "requiresNode": { "type": "boolean" },
          "requiresDotnet": { "type": "boolean" },
          "requiresPlaywright": { "type": "string", "enum": ["none", "chromium", "all"] },
          "cacheProfile": { "type": "string", "enum": ["none", "frontend", "backend", "full"] },
          "timeoutMinutes": { "type": "number", "minimum": 1 },
          "shardable": { "type": "boolean" },
          "defaultShards": { "type": "integer", "const": 1 },
          "risk": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "cadence": { "type": "string", "enum": ["pr", "push", "nightly", "release-manual"] },
          "requiredFor": { "type": "string", "enum": ["fast", "production", "release-final", "none"] },
          "coverage": { "type": "array", "items": { "type": "string" } },
          "artifacts": { "type": "array", "items": { "type": "string" } },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "ciJob": { "type": "string" },
          "localOnly": { "type": "boolean" },
          "nightlyOnly": { "type": "boolean" },
          "manualOnly": { "type": "boolean" }
        },
        "allOf": [
          {
            "if": { "properties": { "parallelizable": { "const": false } }, "required": ["parallelizable"] },
            "then": { "required": ["maxParallel"] },
            "else": { "not": { "required": ["maxParallel"] } }
          },
          {
            "if": { "properties": { "shardable": { "const": false } }, "required": ["shardable"] },
            "then": { "required": ["defaultShards"] },
            "else": { "not": { "required": ["defaultShards"] } }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
