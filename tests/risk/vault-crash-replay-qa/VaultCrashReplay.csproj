<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <Reference Include="FsusBlog.Server"><HintPath>$(VaultOperationSourceRoot)/src/backend/bin/Debug/net10.0/FsusBlog.Server.dll</HintPath></Reference>
        <Reference Include="FsusBlog.Shared"><HintPath>$(VaultOperationSourceRoot)/src/shared/bin/Debug/net10.0/FsusBlog.Shared.dll</HintPath></Reference>
        <PackageReference Include="Npgsql" />
        <PackageReference Include="SqlSugarCoreNoDrive" />
        <PackageReference Include="xunit" />
        <Compile Include="Worker.cs" />
        <Compile Include="$(VaultOperationSourceRoot)/tests/backend/Unit/ArticleVaultOperationProtocolTests.cs" Link="PublishedFixture.cs" />
    </ItemGroup>
    <Target Name="RequirePublishedSource" BeforeTargets="PrepareForBuild">
        <Error Condition="'$(VaultOperationSourceRoot)' == ''" Text="Supply the exact published source worktree through VaultOperationSourceRoot." />
    </Target>
</Project>
