    <ItemGroup>
        <Reference Include="FsusBlog.Shared"><HintPath>$(VaultRecoverySourceRoot)/src/shared/bin/Debug/net10.0/FsusBlog.Shared.dll</HintPath></Reference>
        <PackageReference Include="xunit" />
        <Compile Include="$(VaultRecoverySourceRoot)/tests/backend/Unit/ArticleVaultScalarMetadataMergeTests.cs" Link="PublishedScalarFixture.cs" />
