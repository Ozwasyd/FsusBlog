{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://fsusblog.local/schemas/test-optimization-snapshot.schema.json",
    "title": "FsusBlog test optimization evidence snapshot",
    "type": "object",
    "required": [
        "schema",
        "coverage"
    ],
    "properties": {
        "schema": {
            "const": "fsusblog.test-optimization-snapshot.v1"
        },
        "capturedAt": {
            "type": "string",
            "format": "date-time"
        },
        "coverage": {
            "type": "object",
            "required": [
                "backend",
                "frontend",
                "merged"
            ],
            "properties": {
                "backend": {
                    "$ref": "#/$defs/coverageSummary"
                },
                "frontend": {
                    "$ref": "#/$defs/coverageSummary"
                },
                "merged": {
                    "$ref": "#/$defs/coverageSummary"
                }
            },
            "additionalProperties": false
        },
        "criticalMutationSlice": {
            "$ref": "#/$defs/mutationSlice"
        }
    },
    "additionalProperties": false,
    "$defs": {
        "coverageSummary": {
            "type": "object",
            "required": [
                "summary"
            ],
            "properties": {
                "summary": {
                    "type": "object",
                    "required": [
                        "linecoverage",
                        "branchcoverage"
                    ],
                    "properties": {
                        "linecoverage": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100
                        },
                        "branchcoverage": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100
                        }
                    },
                    "additionalProperties": true
                },
                "generatedAt": {
                    "type": "string",
                    "format": "date-time"
                }
            },
            "additionalProperties": true
        },
        "mutationSlice": {
            "type": "object",
            "properties": {
                "score": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                },
                "scope": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    },
                    "uniqueItems": true
                },
                "sliceId": {
                    "type": "string",
                    "minLength": 1
                },
                "mutantCount": {
                    "type": "integer",
                    "minimum": 0
                }
            },
            "additionalProperties": true
        }
    }
}
