      "routes": ["/api/read-proof/challenge", "/api/read-proof/submit"],
      "issue": "#99",
      "reason": "Human read-proof is an internal application API and must move to request/response AEDS frames."
    },
    {
      "id": "read-proof-json-migration-frontend",
      "classification": "must-migrate",
      "scope": "frontend",
      "file": "src/frontend/src/api/readProof.ts",
      "patterns": ["JsonApiResponse", "response.json", "application/json", "JSON.stringify", "/api/read-proof"],
      "routes": ["/api/read-proof/challenge", "/api/read-proof/submit"],
      "issue": "#99",
      "reason": "Frontend read-proof JSON adapter is a tracked migration compatibility layer."
    },
    {
