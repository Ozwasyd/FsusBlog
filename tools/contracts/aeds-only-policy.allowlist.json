{
  "version": "aeds-only-policy-v1",
  "entries": [
    {
      "id": "health-live-json",
      "classification": "allowed-exemption",
      "scope": "backend",
      "file": "src/backend/Infrastructure/Operations/ProductionHealth.cs",
      "patterns": ["ProductionLivenessProbe.CreateReport"],
      "routes": ["/health/live"],
      "reason": "Kubernetes/systemd/monitoring liveness probes require a JSON health document outside the internal application API surface."
    },
    {
      "id": "health-ready-json",
      "classification": "allowed-exemption",
      "scope": "backend",
      "file": "src/backend/Infrastructure/Operations/ProductionHealth.cs",
      "patterns": ["TypedResults.Json(report"],
      "routes": ["/health/ready"],
      "reason": "Kubernetes/systemd/monitoring readiness probes require a JSON health document outside the internal application API surface."
    },
    {
      "id": "ops-crawler-ranges-json",
      "classification": "allowed-exemption",
      "scope": "backend",
      "file": "src/backend/Infrastructure/Operations/ProductionHealth.cs",
      "patterns": ["TypedResults.Json(new"],
      "routes": ["/api/ops/crawler-ranges/status"],
      "reason": "Crawler range status is an authenticated ops probe; the production admin UI uses /api/binary/admin/security/anti-crawler/crawler-ranges/status."
    },
    {
      "id": "feed-json-standard",
      "classification": "allowed-exemption",
      "scope": "backend",
      "file": "src/backend/Modules/Endpoints/DistributionEndpoints.cs",
      "patterns": ["BuildJsonFeedAsync", "application/feed+json", "JsonSerializer.Serialize"],
      "routes": ["/feed/feed.json"],
      "reason": "JSON Feed is an external syndication standard and is not an internal application API."
    },
    {
      "id": "public-aot-manifest-tooling-json",
      "classification": "allowed-exemption",
      "scope": "backend",
      "file": "src/backend/Modules/Endpoints/PublicAotEndpoints.cs",
      "patterns": ["JsonApiResponse<PublicAotRouteManifestResponse>", "JsonApiResponse<PublicAotSsrHealthReport>", "/internal/public-aot"],
      "routes": ["/internal/public-aot/manifest", "/internal/public-aot/health"],
      "reason": "Build/backfill tooling manifest and SSR worker diagnostics, protected by optional manifest token; not browser runtime application API."
    },
    {
      "id": "authoring-internal-binary-bridge-json",
      "classification": "migration-legacy-temporary",
      "scope": "backend",
      "file": "src/backend/Modules/Endpoints/AuthoringEndpoints.cs",
      "patterns": ["JsonApiResponse", "Results.Json"],
      "routes": ["/_fsus/internal/binary-bridge/author/**"],
      "issue": "#105",
      "reason": "Authoring JSON envelopes are protected by BinaryBridgeInternalOnlyFilter and only reachable from AuthoringBinaryBridgeMiddleware while the bridge is flattened."
    },
    {
      "id": "security-internal-binary-bridge-json",
      "classification": "migration-legacy-temporary",
      "scope": "backend",
      "file": "src/backend/Modules/Endpoints/SecurityEndpoints.cs",
      "patterns": ["JsonApiResponse", "Results.Json"],
      "routes": ["/_fsus/internal/binary-bridge/admin/security/**"],
      "issue": "#105",
      "reason": "Security JSON envelopes are protected by BinaryBridgeInternalOnlyFilter and only reachable from SecurityBinaryBridgeMiddleware while the bridge is flattened."
    }
  ]
}
