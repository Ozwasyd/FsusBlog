{
  "version": "aeds-only-policy-v1",
  "entries": [
    {
      "id": "health-probes-json",
      "classification": "allowed-exemption",
      "scope": "backend",
      "file": "src/backend/Infrastructure/Operations/ProductionHealth.cs",
      "patterns": ["TypedResults.Json"],
      "routes": ["/health/live", "/health/ready"],
      "reason": "Kubernetes/systemd/monitoring probes require JSON health documents outside the internal application API surface."
    },
    {
      "id": "feed-json-standard",
      "classification": "allowed-exemption",
      "scope": "backend",
      "file": "src/backend/Modules/Endpoints/DistributionEndpoints.cs",
      "patterns": ["BuildJsonFeedAsync", "application/feed+json", "JsonSerializer.Serialize"],
      "routes": ["/feed/feed.json"],
      "reason": "JSON Feed is an external syndication standard and is not an internal application API."
    },
    {
      "id": "public-aot-manifest-tooling-json",
      "classification": "allowed-exemption",
      "scope": "backend",
      "file": "src/backend/Modules/Endpoints/PublicAotEndpoints.cs",
      "patterns": ["JsonApiResponse<PublicAotRouteManifestResponse>", "/internal/public-aot"],
      "routes": ["/internal/public-aot/manifest"],
      "reason": "Build/backfill tooling manifest, protected by optional manifest token; not browser runtime application API."
    },
    {
      "id": "public-related-reading-json-migration",
      "classification": "must-migrate",
      "scope": "cross-stack",
      "file": "src/backend/Modules/Endpoints/DistributionEndpoints.cs",
      "patterns": ["JsonApiResponse<RelatedReadingResponse>", "/api/public/articles"],
      "routes": ["/api/public/articles/{articleId}/related"],
      "issue": "#98",
      "reason": "Public related-reading is an internal public runtime API and must move to an AEDS frame contract."
    },
    {
      "id": "frontend-related-reading-json-migration",
      "classification": "must-migrate",
      "scope": "frontend",
      "file": "src/frontend/src/api/article.ts",
      "patterns": ["JsonApiResponse", "response.json", "application/json", "/api/public/articles"],
      "routes": ["/api/public/articles/{articleId}/related"],
      "issue": "#98",
      "reason": "Frontend related-reading adapter is kept only until the AEDS migration lands."
    },
    {
      "id": "read-proof-json-migration-backend",
      "classification": "must-migrate",
      "scope": "backend",
      "file": "src/backend/Modules/Endpoints/ReadProofEndpoints.cs",
