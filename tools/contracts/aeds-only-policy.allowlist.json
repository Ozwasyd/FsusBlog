{
    "version": "aeds-only-policy-v1",
    "entries": [
        {
            "id": "health-live-json",
            "classification": "allowed-exemption",
            "scope": "backend",
            "file": "src/backend/Infrastructure/Operations/ProductionHealth.cs",
            "patterns": [
                "ProductionLivenessProbe.CreateReport"
            ],
            "routes": [
                "/health/live"
            ],
            "reason": "Kubernetes/systemd/monitoring liveness probes require a JSON health document outside the internal application API surface."
        },
        {
            "id": "health-ready-json",
            "classification": "allowed-exemption",
            "scope": "backend",
            "file": "src/backend/Infrastructure/Operations/ProductionHealth.cs",
            "patterns": [
                "ProductionReadinessPublicReport.Create(report)"
            ],
            "routes": [
                "/health/ready"
            ],
            "reason": "Kubernetes/systemd/monitoring readiness probes require a minimal JSON health document outside the internal application API surface."
        },
        {
            "id": "ops-ready-detail-json",
            "classification": "allowed-exemption",
            "scope": "backend",
            "file": "src/backend/Infrastructure/Operations/ProductionHealth.cs",
            "patterns": [
                "TypedResults.Json(report"
            ],
            "routes": [
                "/api/ops/health/ready-detail"
            ],
            "reason": "Detailed readiness is an authenticated ops probe for operators; public /health/ready exposes only minimal status."
        },
        {
            "id": "ops-crawler-ranges-json",
            "classification": "allowed-exemption",
            "scope": "backend",
            "file": "src/backend/Infrastructure/Operations/ProductionHealth.cs",
            "patterns": [
                "TypedResults.Json(new"
            ],
            "routes": [
                "/api/ops/crawler-ranges/status"
            ],
            "reason": "Crawler range status is an authenticated ops probe; the production admin UI uses /api/binary/admin/security/anti-crawler/crawler-ranges/status."
        },
        {
            "id": "feed-json-standard",
            "classification": "allowed-exemption",
            "scope": "backend",
            "file": "src/backend/Modules/Endpoints/DistributionEndpoints.cs",
            "patterns": [
                "BuildJsonFeedAsync",
                "application/feed+json",
                "JsonSerializer.Serialize"
            ],
            "routes": [
                "/feed/feed.json"
            ],
            "reason": "JSON Feed is an external syndication standard and is not an internal application API."
        },
        {
            "id": "public-aot-manifest-tooling-json",
            "classification": "allowed-exemption",
            "scope": "backend",
            "file": "src/backend/Modules/Endpoints/PublicAotEndpoints.cs",
            "patterns": [
                "JsonApiResponse<PublicAotRouteManifestResponse>",
                "JsonApiResponse<PublicAotSsrHealthReport>",
                "/internal/public-aot"
            ],
            "routes": [
                "/internal/public-aot/manifest",
                "/internal/public-aot/health"
            ],
            "reason": "Build/backfill tooling manifest and SSR worker diagnostics, protected by optional manifest token; not browser runtime application API."
        },
        {
            "id": "integrity-public-verification-json",
            "classification": "allowed-exemption",
            "scope": "backend",
            "file": "src/backend/Modules/Endpoints/IntegrityVerificationEndpoints.cs",
            "patterns": [
                "JsonContentType",
                "Results.Json(result.Body"
            ],
            "routes": [
                "/integrity/keys.json",
                "/integrity/article/{articleId}",
                "/integrity/article/{articleId}/revisions/{revisionNo}",
                "/integrity/revisions/{articleRevisionId}",
                "/integrity/checkpoints/latest",
                "/integrity/checkpoints/{date}",
                "/integrity/log/head"
            ],
            "reason": "Public integrity verification manifests are JSON sidecars for external/offline verification, not internal application API fallback."
        },
        {
            "id": "admin-integrity-console-json",
            "classification": "allowed-exemption",
            "scope": "backend",
            "file": "src/backend/Modules/Endpoints/AdminIntegrityConsoleEndpoints.cs",
            "patterns": [
                "Results.Json",
                "IntegrityVerificationJson.Options"
            ],
            "routes": [
                "/api/admin/integrity/console",
                "/api/admin/integrity/console/proofs/{proofId}/retry"
            ],
            "reason": "Admin-only integrity console is an operations endpoint for proof triage and retry; runtime client APIs remain AEDS/binary."
        },
        {
            "id": "local-auth-fixture-status-json",
            "classification": "allowed-exemption",
            "scope": "backend",
            "file": "src/backend/Modules/Endpoints/LocalAuthFixtureEndpoints.cs",
            "patterns": [
                "Results.Json(new"
            ],
            "routes": [
                "/__local/auth-fixture/status",
                "/api/local/auth-fixture/status"
            ],
            "reason": "Development-only Playwright auth fixture status probe, gated by loopback caller and shared secret; production startup rejects enabling this fixture."
        },
        {
            "id": "local-auth-fixture-lifecycle-json",
            "classification": "allowed-exemption",
            "scope": "backend",
            "file": "src/backend/Modules/Endpoints/LocalAuthFixtureEndpoints.cs",
            "patterns": [
                "CancellationToken cancellationToken) => Results.Json("
            ],
            "routes": [
                "/api/local/auth-fixture/prepare",
                "/api/local/auth-fixture/verify"
            ],
            "reason": "The auth-session fixture producer consumes these Development-only lifecycle receipts behind an explicit gate, shared secret and loopback check. Retain JSON only for this tooling consumer; remove the exemption if the tooling route is retired or becomes an application API."
        },
        {
            "id": "local-audit-fixture-json",
            "classification": "allowed-exemption",
            "scope": "backend",
            "file": "src/backend/Modules/Endpoints/LocalAuditFixtureEndpoints.cs",
            "patterns": [
                "Results.Json(receipt)"
            ],
            "routes": [
                "/__local/audit-fixture/prepare"
            ],
            "reason": "The audit-records fixture producer consumes this Development-only receipt behind an explicit gate, shared secret and loopback check. Retain JSON only for this tooling consumer; remove the exemption if the tooling route is retired or becomes an application API."
        },
        {
            "id": "local-account-profile-preference-fixture-json",
            "classification": "allowed-exemption",
            "scope": "backend",
            "file": "src/backend/Modules/Endpoints/LocalAccountProfilePreferenceFixtureEndpoints.cs",
            "patterns": [
                "Results.Json(result, s_jsonOptions)",
                "Results.Json(verification, s_jsonOptions)"
            ],
            "routes": [
                "/__local/account-profile-preferences/prepare",
                "/__local/account-profile-preferences/verify"
            ],
            "reason": "The account-profile-preferences fixture producer consumes these Development-only lifecycle receipts behind an explicit gate, shared secret and loopback check. Retain JSON only for this tooling consumer; remove the exemption if the tooling route is retired or becomes an application API."
        },
        {
            "id": "local-comment-fixture-json",
            "classification": "allowed-exemption",
            "scope": "backend",
            "file": "src/backend/Modules/Endpoints/LocalCommentFixtureEndpoints.cs",
            "patterns": [
                "Results.Json(await seeder.PrepareAsync(plan, cancellationToken)",
                "Results.Json(await seeder.CleanupAsync(receipt, cancellationToken)",
                "Results.Json(new"
            ],
            "routes": [
                "/api/local/comment-fixture/prepare",
                "/api/local/comment-fixture/cleanup"
            ],
            "reason": "The comment-moderation fixture producer consumes Development-only lifecycle and failure-recovery receipts behind an explicit gate, shared secret and loopback check. Retain JSON for tool-owned recovery; remove the exemption if these tooling routes are retired or become application APIs."
        },
        {
            "id": "local-messaging-fixture-json",
            "classification": "allowed-exemption",
            "scope": "backend",
            "file": "src/backend/Modules/Endpoints/LocalMessagingFixtureEndpoints.cs",
            "patterns": [
                "Results.Json(result)"
            ],
            "routes": [
                "/api/local/messaging-fixture/prepare"
            ],
            "reason": "The account-messaging fixture producer consumes this Development-only receipt behind an explicit gate, shared secret and loopback check. Retain JSON only for this tooling consumer; remove the exemption if the tooling route is retired or becomes an application API."
        },
        {
            "id": "local-security-fixture-json",
            "classification": "allowed-exemption",
            "scope": "backend",
            "file": "src/backend/Modules/Endpoints/LocalSecurityFixtureEndpoints.cs",
            "patterns": [
                "Results.Json(await invoke(root, body, binding, cancellationToken)"
            ],
            "routes": [
                "/__local/security-fixture/apply",
                "/__local/security-fixture/observe",
                "/__local/security-fixture/cleanup",
                "/__local/security-fixture/observe-cleanup"
            ],
            "reason": "The security-state fixture producer consumes Development/Test-only domain receipts behind an explicit gate, shared secret and loopback check; Production does not map them. Retain JSON only for this tooling consumer; remove the exemption if the tooling routes are retired or become application APIs."
        },
        {
            "id": "runtime-cache-redis-fault-probe-json",
            "classification": "allowed-exemption",
            "scope": "backend",
            "file": "src/backend/Modules/Endpoints/RuntimeCacheFaultAndRevocationScenarioEndpoints.cs",
            "patterns": [
                "return Results.Json("
            ],
            "routes": [
                "/_fsus/testing/runtime-cache/redis-fault/{operationClass}"
            ],
            "reason": "The runtime-cache evidence runner consumes Redis fault classification, not application data. The parent maps this probe only in Development/Test with a configured evidence secret, and the handler requires middleware-authenticated evidence access. Remove the exemption when the probe is retired or becomes an application API."
        },
        {
            "id": "local-demo-fixture-json",
            "classification": "allowed-exemption",
            "scope": "backend",
            "file": "src/backend/Modules/Endpoints/LocalDemoFixtureEndpoints.cs",
            "patterns": [
                "Results.Json(result)"
            ],
            "routes": [
                "/api/local/demo-fixture/prepare"
            ],
            "reason": "Development-only demo fixture producer response, gated by loopback caller and a shared secret; production startup rejects enabling this fixture."
        },
        {
            "id": "local-public-content-fixture-json",
            "classification": "allowed-exemption",
            "scope": "backend",
            "file": "src/backend/Modules/Endpoints/LocalPublicContentFixtureEndpoints.cs",
            "patterns": [
                "Results.Json(result)",
                "Results.Json(temporal.Observe("
            ],
            "routes": [
                "/api/local/public-content-fixture/prepare",
                "/__local/public-content-fixture/prepare",
                "/__local/temporal-observation"
            ],
            "reason": "Development-only public-content and temporal fixture responses, gated by loopback caller and a shared secret; production startup rejects enabling these fixtures."
        },
        {
            "id": "test-release-schema-qualification-json",
            "classification": "allowed-exemption",
            "scope": "backend",
            "file": "src/backend/Modules/Endpoints/ReleaseSchemaQualificationEndpoints.cs",
            "patterns": [
                "Results.Json(new",
                "Results.Json("
            ],
            "routes": [
                "/api/release-evidence/schema-bridge/write",
                "/api/release-evidence/schema-qualification/readiness"
            ],
            "reason": "Test-only release rehearsal probes, absent unless the Test environment and qualification switch are both enabled; production runtime application APIs remain AEDS/binary."
        },
        {
            "id": "csp-browser-report-ingress-json",
            "classification": "allowed-exemption",
            "scope": "backend",
            "file": "src/backend/Modules/Endpoints/CspReportEndpoints.cs",
            "patterns": [
                "mediaType.Equals(\"application/json\""
            ],
            "routes": [
                "/csp-report"
            ],
            "reason": "CSP violation reports are browser/platform ingress documents, not an internal application API or JSON response fallback."
        }
    ]
}
