+using System;
+using System.Collections.Generic;
+using System.Linq;
+using Microsoft.CodeAnalysis;
+using Microsoft.CodeAnalysis.CSharp;
+using Microsoft.CodeAnalysis.CSharp.Syntax;
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+using Shouldly;
+using Stryker.Abstractions;
+using Stryker.Core.Mutants;
+using Stryker.Core.Mutators;
+
+namespace Stryker.Core.UnitTest.Mutants;
+
+[TestClass]
+public class CsharpMutationCandidateValidatorTests : TestBase
+{
+    [TestMethod]
+    public void RejectsOnlyTheNonCompilingIntegralExclusiveOrCandidate()
+    {
+        var (root, model) = Build("class C { ushort M(ushort crc, byte value) => (ushort)(crc ^ value); }");
+        var node = root.DescendantNodes().OfType<BinaryExpressionSyntax>()
+            .Single(expression => expression.IsKind(SyntaxKind.ExclusiveOrExpression));
+        var candidates = new BinaryExpressionMutator().ApplyMutations(node, model).ToArray();
+        var validator = new CsharpMutationCandidateValidator();
+
+        validator.Validate(node, candidates.Single(candidate => candidate.Type == Mutator.Logical), model)
+            .IsValid.ShouldBeFalse();
+        validator.Validate(node, candidates.Single(candidate => candidate.Type == Mutator.Bitwise), model)
+            .IsValid.ShouldBeTrue();
+    }
+
+    [TestMethod]
+    public void RejectsOnlyTheNonCompilingBooleanExclusiveOrCandidate()
+    {
+        var (root, model) = Build("class C { bool M(bool left, bool right) => left ^ right; }");
+        var node = root.DescendantNodes().OfType<BinaryExpressionSyntax>().Single();
+        var candidates = new BinaryExpressionMutator().ApplyMutations(node, model).ToArray();
+        var validator = new CsharpMutationCandidateValidator();
+
+        validator.Validate(node, candidates.Single(candidate => candidate.Type == Mutator.Logical), model)
+            .IsValid.ShouldBeTrue();
+        validator.Validate(node, candidates.Single(candidate => candidate.Type == Mutator.Bitwise), model)
+            .IsValid.ShouldBeFalse();
+    }
+
+    [TestMethod]
+    public void RejectsBlockRemovalThatBreaksDefiniteAssignment()
+    {
+        var (root, model) = Build("class C { int M() { int length; { length = 1; } return length; } }");
+        var block = root.DescendantNodes().OfType<BlockSyntax>()
+            .Single(candidate => candidate.Parent is BlockSyntax);
+        var mutation = new BlockMutator().ApplyMutations(block, model).Single();
+
+        var result = new CsharpMutationCandidateValidator().Validate(block, mutation, model);
+
+        result.IsValid.ShouldBeFalse();
+        result.Reason.ShouldContain("CS0165");
+    }
+
+    [TestMethod]
+    public void KeepsBlockRemovalWhenDefiniteAssignmentIsUnaffected()
+    {
+        var (root, model) = Build("class C { void M() { { int value = 1; } } }");
+        var block = root.DescendantNodes().OfType<BlockSyntax>()
+            .Single(candidate => candidate.Parent is BlockSyntax);
+        var mutation = new BlockMutator().ApplyMutations(block, model).Single();
+
+        new CsharpMutationCandidateValidator().Validate(block, mutation, model)
+            .IsValid.ShouldBeTrue();
+    }
+
+    [TestMethod]
+    public void RejectsDisjointAndPatternButKeepsOverlappingPattern()
+    {
+        var (disjointRoot, disjointModel) = Build("class C { bool M(int value) => value is 40 or 43; }");
+        var disjoint = disjointRoot.DescendantNodes().OfType<BinaryPatternSyntax>().Single();
+        var disjointMutation = new BinaryPatternMutator().ApplyMutations(disjoint, disjointModel).Single();
+        var validator = new CsharpMutationCandidateValidator();
+
+        validator.Validate(disjoint, disjointMutation, disjointModel).IsValid.ShouldBeFalse();
+
+        var (overlappingRoot, overlappingModel) = Build("class C { bool M(int value) => value is > 0 or < 10; }");
+        var overlapping = overlappingRoot.DescendantNodes().OfType<BinaryPatternSyntax>().Single();
+        var overlappingMutation = new BinaryPatternMutator().ApplyMutations(overlapping, overlappingModel).Single();
+
+        validator.Validate(overlapping, overlappingMutation, overlappingModel).IsValid.ShouldBeTrue();
+    }
+
+    [TestMethod]
+    public void RejectsStaticLoopProgressReversal()
+    {
+        var (root, model) = Build("class C { void M() { for (int bit = 0; bit < 8; bit++) { int value = bit; } } }");
+        var update = root.DescendantNodes().OfType<PostfixUnaryExpressionSyntax>().Single();
+        var mutation = new PostfixUnaryMutator().ApplyMutations(update, model).Single();
+
+        var result = new CsharpMutationCandidateValidator().Validate(update, mutation, model);
+
+        result.IsValid.ShouldBeFalse();
+        result.Reason.ShouldBe("static-loop-progress-reversal");
+    }
+
+    [TestMethod]
+    public void KeepsLoopUpdateCandidateWhenAnExitMakesTerminationUncertain()
+    {
+        var (root, model) = Build("class C { void M() { for (int bit = 0; bit < 8; bit++) { if (bit == 4) break; } } }");
+        var update = root.DescendantNodes().OfType<PostfixUnaryExpressionSyntax>().Single();
+        var mutation = new PostfixUnaryMutator().ApplyMutations(update, model).Single();
+
+        new CsharpMutationCandidateValidator().Validate(update, mutation, model)
+            .IsValid.ShouldBeTrue();
+    }
+
+    private static (CompilationUnitSyntax Root, SemanticModel Model) Build(string source)
+    {
+        var syntaxTree = CSharpSyntaxTree.ParseText(source);
+        Type[] types = [typeof(object), typeof(List<>), typeof(Enumerable)];
+        var references = types.Select(type => MetadataReference.CreateFromFile(type.Assembly.Location));
+        var compilation = CSharpCompilation.Create(
+            "CandidateValidationTests",
+            [syntaxTree],
+            references,
+            new CSharpCompilationOptions(OutputKind.DynamicallyLinkedLibrary));
+        compilation.GetDiagnostics().Where(diagnostic => diagnostic.Severity == DiagnosticSeverity.Error)
+            .ShouldBeEmpty();
+        return ((CompilationUnitSyntax)syntaxTree.GetRoot(), compilation.GetSemanticModel(syntaxTree));
+    }
+}
