@@ -0,0 +1,267 @@
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.Linq;
+using Microsoft.CodeAnalysis;
+using Microsoft.CodeAnalysis.CSharp;
+using Microsoft.CodeAnalysis.CSharp.Syntax;
+using Stryker.Abstractions;
+
+namespace Stryker.Core.Mutants;
+
+public readonly record struct MutationCandidateValidation(bool IsValid, string Reason)
+{
+    public static MutationCandidateValidation Valid { get; } = new(true, null);
+
+    public static MutationCandidateValidation Rejected(string reason) => new(false, reason);
+}
+
+public interface IMutationCandidateValidator
+{
+    MutationCandidateValidation Validate(SyntaxNode originalNode, Mutation mutation, SemanticModel semanticModel);
+}
+
+public sealed class CsharpMutationCandidateValidator : IMutationCandidateValidator
+{
+    private readonly HashSet<SyntaxTree> _validatedSourceTrees = [];
+
+    public MutationCandidateValidation Validate(SyntaxNode originalNode, Mutation mutation, SemanticModel semanticModel)
+    {
+        ArgumentNullException.ThrowIfNull(originalNode);
+        ArgumentNullException.ThrowIfNull(mutation);
+        ArgumentNullException.ThrowIfNull(semanticModel);
+
+        if (IsLoopProgressReversal(originalNode, mutation.ReplacementNode, semanticModel))
+        {
+            return MutationCandidateValidation.Rejected("static-loop-progress-reversal");
+        }
+
+        if (!RequiresCompilationValidation(originalNode, mutation))
+        {
+            return MutationCandidateValidation.Valid;
+        }
+
+        var originalTree = originalNode.SyntaxTree;
+        if (_validatedSourceTrees.Add(originalTree))
+        {
+            var originalErrors = semanticModel.GetDiagnostics()
+                .Where(diagnostic => diagnostic.Severity == DiagnosticSeverity.Error)
+                .ToArray();
+            if (originalErrors.Length != 0)
+            {
+                throw new InvalidOperationException(
+                    $"Cannot validate mutation candidates in a source tree with compiler errors: {string.Join(", ", originalErrors.Select(error => error.Id).Distinct())}");
+            }
+        }
+
+        var marker = new SyntaxAnnotation();
+        var sourceRoot = originalTree.GetRoot();
+        var trackedRoot = sourceRoot.ReplaceNode(originalNode, originalNode.WithAdditionalAnnotations(marker));
+        var trackedNode = trackedRoot.GetAnnotatedNodes(marker).Single();
+        var replacement = mutation.ReplacementNode.WithTriviaFrom(trackedNode);
+        var candidateRoot = trackedRoot.ReplaceNode(trackedNode, replacement);
+        var candidateTree = originalTree.WithRootAndOptions(candidateRoot, originalTree.Options);
+        var candidateCompilation = semanticModel.Compilation.ReplaceSyntaxTree(originalTree, candidateTree);
+        var candidateErrors = candidateCompilation.GetSemanticModel(candidateTree).GetDiagnostics()
+            .Where(diagnostic => diagnostic.Severity == DiagnosticSeverity.Error)
+            .ToArray();
+
+        return candidateErrors.Length == 0
+            ? MutationCandidateValidation.Valid
+            : MutationCandidateValidation.Rejected(
+                $"compiler-error:{string.Join(",", candidateErrors.Select(error => error.Id).Distinct().OrderBy(id => id))}");
+    }
+
+    private static bool RequiresCompilationValidation(SyntaxNode originalNode, Mutation mutation) =>
+        mutation.Type == Mutator.Block ||
+        originalNode is BinaryPatternSyntax ||
+        originalNode.IsKind(SyntaxKind.ExclusiveOrExpression);
+
+    private static bool IsLoopProgressReversal(SyntaxNode originalNode, SyntaxNode replacementNode, SemanticModel semanticModel)
+    {
+        if (!TryGetUpdate(originalNode, out var originalOperand, out var originalDirection) ||
+            !TryGetUpdate(replacementNode, out _, out var replacementDirection) ||
+            originalDirection == replacementDirection ||
+            originalOperand is not IdentifierNameSyntax identifier ||
+            originalNode.Parent is not ForStatementSyntax loop ||
+            loop.Incrementors.Count != 1 ||
+            loop.Declaration is null ||
+            loop.Declaration.Variables.Count != 1 ||
+            loop.Condition is not BinaryExpressionSyntax condition ||
+            HasUncertainExitOrSideEffect(loop.Statement))
+        {
+            return false;
+        }
+
+        var loopSymbol = semanticModel.GetSymbolInfo(identifier).Symbol as ILocalSymbol;
+        var declaration = loop.Declaration.Variables[0];
+        if (loopSymbol is null ||
+            !SymbolEqualityComparer.Default.Equals(loopSymbol, semanticModel.GetDeclaredSymbol(declaration)) ||
+            declaration.Initializer is null ||
+            !TryGetIntegralConstant(semanticModel, declaration.Initializer.Value, out var initialValue) ||
+            !TryNormalizeCondition(condition, loopSymbol, semanticModel, out var conditionKind, out var bound) ||
+            !ConditionIsInitiallyTrue(initialValue, bound, conditionKind) ||
+            BodyWritesSymbol(loop.Statement, loopSymbol, semanticModel))
+        {
+            return false;
+        }
+
+        var expectedDirection = conditionKind switch
+        {
+            SyntaxKind.LessThanExpression or SyntaxKind.LessThanOrEqualExpression => 1,
+            SyntaxKind.GreaterThanExpression or SyntaxKind.GreaterThanOrEqualExpression => -1,
+            _ => 0
+        };
+
+        return expectedDirection != 0 &&
+            originalDirection == expectedDirection &&
+            replacementDirection == -expectedDirection;
+    }
+
+    private static bool TryGetUpdate(SyntaxNode node, out ExpressionSyntax operand, out int direction)
+    {
+        switch (node)
+        {
+            case PostfixUnaryExpressionSyntax postfix when postfix.IsKind(SyntaxKind.PostIncrementExpression):
+                operand = postfix.Operand;
+                direction = 1;
+                return true;
+            case PostfixUnaryExpressionSyntax postfix when postfix.IsKind(SyntaxKind.PostDecrementExpression):
+                operand = postfix.Operand;
+                direction = -1;
+                return true;
+            case PrefixUnaryExpressionSyntax prefix when prefix.IsKind(SyntaxKind.PreIncrementExpression):
+                operand = prefix.Operand;
+                direction = 1;
+                return true;
+            case PrefixUnaryExpressionSyntax prefix when prefix.IsKind(SyntaxKind.PreDecrementExpression):
+                operand = prefix.Operand;
+                direction = -1;
+                return true;
+            default:
+                operand = null;
+                direction = 0;
+                return false;
+        }
+    }
+
+    private static bool TryNormalizeCondition(BinaryExpressionSyntax condition, ILocalSymbol loopSymbol,
+        SemanticModel semanticModel, out SyntaxKind conditionKind, out decimal bound)
+    {
+        if (IsSymbol(condition.Left, loopSymbol, semanticModel) &&
+            TryGetIntegralConstant(semanticModel, condition.Right, out bound))
+        {
+            conditionKind = condition.Kind();
+            return IsDirectionalComparison(conditionKind);
+        }
+
+        if (IsSymbol(condition.Right, loopSymbol, semanticModel) &&
+            TryGetIntegralConstant(semanticModel, condition.Left, out bound))
+        {
+            conditionKind = condition.Kind() switch
+            {
+                SyntaxKind.LessThanExpression => SyntaxKind.GreaterThanExpression,
+                SyntaxKind.LessThanOrEqualExpression => SyntaxKind.GreaterThanOrEqualExpression,
+                SyntaxKind.GreaterThanExpression => SyntaxKind.LessThanExpression,
+                SyntaxKind.GreaterThanOrEqualExpression => SyntaxKind.LessThanOrEqualExpression,
+                _ => SyntaxKind.None
+            };
+            return conditionKind != SyntaxKind.None;
+        }
+
+        conditionKind = SyntaxKind.None;
+        bound = 0;
+        return false;
+    }
+
+    private static bool IsDirectionalComparison(SyntaxKind kind) => kind is
+        SyntaxKind.LessThanExpression or
+        SyntaxKind.LessThanOrEqualExpression or
+        SyntaxKind.GreaterThanExpression or
+        SyntaxKind.GreaterThanOrEqualExpression;
+
+    private static bool ConditionIsInitiallyTrue(decimal initialValue, decimal bound, SyntaxKind kind) => kind switch
+    {
+        SyntaxKind.LessThanExpression => initialValue < bound,
+        SyntaxKind.LessThanOrEqualExpression => initialValue <= bound,
+        SyntaxKind.GreaterThanExpression => initialValue > bound,
+        SyntaxKind.GreaterThanOrEqualExpression => initialValue >= bound,
+        _ => false
+    };
+
+    private static bool IsSymbol(ExpressionSyntax expression, ISymbol symbol, SemanticModel semanticModel) =>
+        expression is IdentifierNameSyntax &&
+        SymbolEqualityComparer.Default.Equals(semanticModel.GetSymbolInfo(expression).Symbol, symbol);
+
+    private static bool TryGetIntegralConstant(SemanticModel semanticModel, ExpressionSyntax expression, out decimal value)
+    {
+        var constant = semanticModel.GetConstantValue(expression);
+        if (!constant.HasValue || constant.Value is not IConvertible convertible)
+        {
+            value = 0;
+            return false;
+        }
+
+        try
+        {
+            value = convertible.ToDecimal(CultureInfo.InvariantCulture);
+            return semanticModel.GetTypeInfo(expression).ConvertedType?.SpecialType is
+                SpecialType.System_SByte or
+                SpecialType.System_Byte or
+                SpecialType.System_Int16 or
+                SpecialType.System_UInt16 or
+                SpecialType.System_Int32 or
+                SpecialType.System_UInt32 or
+                SpecialType.System_Int64 or
+                SpecialType.System_UInt64;
+        }
+        catch (FormatException)
+        {
+            value = 0;
+            return false;
+        }
+        catch (InvalidCastException)
+        {
+            value = 0;
+            return false;
+        }
+        catch (OverflowException)
+        {
+            value = 0;
+            return false;
+        }
+    }
+
+    private static bool HasUncertainExitOrSideEffect(StatementSyntax statement) => statement.DescendantNodesAndSelf().Any(node => node is
+        AnonymousFunctionExpressionSyntax or
+        AwaitExpressionSyntax or
+        BreakStatementSyntax or
+        GotoStatementSyntax or
+        InvocationExpressionSyntax or
+        LocalFunctionStatementSyntax or
+        ReturnStatementSyntax or
+        ThrowExpressionSyntax or
+        ThrowStatementSyntax or
+        YieldStatementSyntax);
+
+    private static bool BodyWritesSymbol(StatementSyntax statement, ISymbol symbol, SemanticModel semanticModel)
+    {
+        foreach (var identifier in statement.DescendantNodes().OfType<IdentifierNameSyntax>())
+        {
+            if (!SymbolEqualityComparer.Default.Equals(semanticModel.GetSymbolInfo(identifier).Symbol, symbol))
+            {
+                continue;
+            }
+
+            if (identifier.Parent is PrefixUnaryExpressionSyntax or PostfixUnaryExpressionSyntax ||
+                identifier.Parent is AssignmentExpressionSyntax assignment && assignment.Left.Span.Contains(identifier.Span) ||
+                identifier.Parent is ArgumentSyntax argument && argument.RefKindKeyword.Kind() is
+                    SyntaxKind.RefKeyword or SyntaxKind.OutKeyword)
+            {
+                return true;
+            }
+        }
+
+        return false;
+    }
+}
