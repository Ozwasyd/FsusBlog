+    private static bool IsExpressionTreeArgument(ArgumentSyntax argument, int argumentIndex, IMethodSymbol method)
+    {
+        if (method == null)
+        {
+            return false;
+        }
+        var parameter = argument.NameColon == null
+            ? method.Parameters.ElementAtOrDefault(argumentIndex)
+            : method.Parameters.FirstOrDefault(candidate => candidate.Name == argument.NameColon.Name.Identifier.Text);
