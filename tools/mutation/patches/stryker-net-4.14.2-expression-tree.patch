+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Linq.Expressions;
+using Microsoft.CodeAnalysis;
+using Microsoft.CodeAnalysis.CSharp;
+using Microsoft.CodeAnalysis.CSharp.Syntax;
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+using Shouldly;
+using Stryker.Abstractions;
+using Stryker.Abstractions.Options;
+using Stryker.Configuration.Options;
+using Stryker.Core.InjectedHelpers;
+using Stryker.Core.Mutants;
+
+namespace Stryker.Core.UnitTest.Mutants;
+
+[TestClass]
+public class CsharpExpressionTreeInstrumentationTests : TestBase
+{
+    [TestMethod]
+    public void KeepsSelectorsOutsideExpressionTreeLambdasAndRetainsEveryMutant()
+    {
+        const string source = """
+            using System;
+            using System.Linq;
+            using System.Linq.Expressions;
+            class Row { public int Id { get; set; } public string Consumer { get; set; } }
+            class C
+            {
+                static IQueryable<Row> Where(IQueryable<Row> rows, Expression<Func<Row, bool>> predicate) => rows;
+                IQueryable<Row> Query(IQueryable<Row> rows, int id, string consumer) =>
+                    Where(rows, row => row.Id == id && row.Consumer == consumer);
+            }
+            """;
+        var syntaxTree = CSharpSyntaxTree.ParseText(source);
+        Type[] referenceTypes = [typeof(object), typeof(List<>), typeof(Enumerable), typeof(IQueryable<>), typeof(Expression<>)];
+        var compilation = CSharpCompilation.Create("ExpressionTreeInstrumentation")
+            .WithOptions(new CSharpCompilationOptions(OutputKind.DynamicallyLinkedLibrary))
+            .AddReferences(referenceTypes.Select(type => MetadataReference.CreateFromFile(type.Assembly.Location)))
+            .AddSyntaxTrees(syntaxTree);
+        var injection = new CodeInjection();
+        var semanticModel = compilation.GetSemanticModel(syntaxTree);
+        var sourceLambda = syntaxTree.GetRoot().DescendantNodes().OfType<LambdaExpressionSyntax>().Single();
+        semanticModel.GetTypeInfo(sourceLambda).ConvertedType?.ToDisplayString()
+            .ShouldBe("System.Linq.Expressions.Expression<System.Func<Row, bool>>");
+        semanticModel.GetTypeInfo(sourceLambda).ConvertedType?.ToDisplayString()
+            .StartsWith("System.Linq.Expressions.Expression<", StringComparison.Ordinal)
+            .ShouldBeTrue();
+        var sourceInvocation = sourceLambda.Ancestors().OfType<InvocationExpressionSyntax>().First();
+        var sourceMethod = semanticModel.GetSymbolInfo(sourceInvocation).Symbol.ShouldBeAssignableTo<IMethodSymbol>();
+        sourceMethod.Parameters.Last().Type.ToDisplayString()
+            .ShouldBe("System.Linq.Expressions.Expression<System.Func<Row, bool>>");
+        var orchestrator = new CsharpMutantOrchestrator(
+            new MutantPlacer(injection),
+            options: new StrykerOptions
+            {
+                MutationLevel = MutationLevel.Complete,
+                OptimizationMode = OptimizationModes.CoverageBasedTest
+            });
+
+        var mutatedRoot = orchestrator.Mutate(syntaxTree, semanticModel).GetRoot();
+        var originalLambda = syntaxTree.GetRoot().DescendantNodes().OfType<LambdaExpressionSyntax>().Single();
+        var expressionTreeMutants = orchestrator.Mutants
+            .Where(mutant => mutant.Mutation.OriginalNode.AncestorsAndSelf().Contains(originalLambda))
+            .ToArray();
+
+        expressionTreeMutants.ShouldNotBeEmpty();
+        expressionTreeMutants.ShouldAllBe(mutant => mutant.ResultStatus == MutantStatus.Pending);
+        mutatedRoot.DescendantNodes().OfType<LambdaExpressionSyntax>()
+            .ShouldAllBe(lambda => !lambda.ToString().Contains("MutantControl.IsActive", StringComparison.Ordinal));
+        mutatedRoot.DescendantNodes().OfType<LambdaExpressionSyntax>()
+            .Any(lambda => SyntaxFactory.AreEquivalent(lambda, originalLambda))
+            .ShouldBeTrue();
+
+        foreach (var mutant in expressionTreeMutants)
+        {
+            var selector = $"{injection.HelperNamespace}.MutantControl.IsActive({mutant.Id})";
+            mutatedRoot.DescendantNodes().OfType<InvocationExpressionSyntax>()
+                .Where(invocation => invocation.ToString() == selector)
+                .ShouldHaveSingleItem()
+                .Ancestors().OfType<LambdaExpressionSyntax>().ShouldBeEmpty();
+        }
+    }
+
+    [TestMethod]
+    public void KeepsDelegateLambdaInstrumentationInsideTheLambda()
+    {
+        const string source = "class C { bool Query(System.Func<int, bool> predicate) => predicate(1); bool M() => Query(value => value > 0); }";
+        var syntaxTree = CSharpSyntaxTree.ParseText(source);
+        Type[] referenceTypes = [typeof(object), typeof(Func<,>)];
+        var compilation = CSharpCompilation.Create("DelegateInstrumentation")
+            .WithOptions(new CSharpCompilationOptions(OutputKind.DynamicallyLinkedLibrary))
+            .AddReferences(referenceTypes.Select(type => MetadataReference.CreateFromFile(type.Assembly.Location)))
+            .AddSyntaxTrees(syntaxTree);
+        var injection = new CodeInjection();
+        var orchestrator = new CsharpMutantOrchestrator(
+            new MutantPlacer(injection),
+            options: new StrykerOptions
+            {
+                MutationLevel = MutationLevel.Complete,
+                OptimizationMode = OptimizationModes.CoverageBasedTest
+            });
+
+        var mutatedRoot = orchestrator.Mutate(syntaxTree, compilation.GetSemanticModel(syntaxTree)).GetRoot();
+        var lambda = mutatedRoot.DescendantNodes().OfType<LambdaExpressionSyntax>().Single();
+
+        lambda.ToString().ShouldContain("MutantControl.IsActive");
+    }
+}
